@code {
    // Vista local: snapshot de logs/valores tomado en cada re-render
    private IReadOnlyList<MonitorLogEntry> _logs = Array.Empty<MonitorLogEntry>();
    private List<SignalValue> _currentValues = new();
    private Dictionary<int, double> _previousSnapshot = new();

    private string _searchString = "";
    private bool _isSending = false;
    private bool _isLoadingSignals = false;

    private Func<SignalValue, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (x.Tag.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.Nombre.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    };

    protected override async Task OnInitializedAsync()
    {
        // Carga inicial de señales para construir la vista (aunque aún no haya valores en vivo)
        await LoadSignalViewAsync();
        SyncFromService();
        MonitorState.OnStateChanged += OnMonitorStateChanged;
    }

    /// <summary>
    /// Callback del servicio → refresca snapshot y solicita re-render en el hilo de UI.
    /// </summary>
    private void OnMonitorStateChanged()
    {
        SyncFromService();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Copia los datos del servicio al estado local del componente para renderizarlos.
    /// </summary>
    private void SyncFromService()
    {
        _logs = MonitorState.Logs;

        var liveValues = MonitorState.GetCurrentValues();

        // Actualizar los SignalValue con los valores en vivo
        foreach (var sv in _currentValues)
        {
            if (liveValues.TryGetValue(sv.Id, out var physVal))
            {
                bool changed = _previousSnapshot.TryGetValue(sv.Id, out var prev) && Math.Abs(prev - physVal) > 0.00001;
                sv.FormattedValue = FormatSignalValue(sv, physVal);
                sv.RawValue = physVal;
                sv.HasChanged = changed;
            }
        }
        _previousSnapshot = liveValues;
    }

    /// <summary>
    /// Carga las señales de DB para construir la lista de SignalValue (estructura de vista).
    /// </summary>
    private async Task LoadSignalViewAsync()
    {
        _isLoadingSignals = true;
        try
        {
            var signals = await DataService.GetSignalsAsync();
            _currentValues = signals.Select(sig => new SignalValue
            {
                Id = sig.Id,
                Tag = sig.Tag,
                Nombre = sig.Nombre,
                TipoVariable = sig.TipoVariable,
                Unidad = sig.Unidad ?? "",
                FormattedValue = FormatSignalValue(sig, sig.ValorActual),
                RawValue = sig.ValorActual,
                HasChanged = false,
                IsAscii = sig.IsAscii,
                NodoNumero = sig.NodoNumero,
                NodoDescripcion = sig.NodoDescripcion
            }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar señales: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingSignals = false;
        }
    }

    private async Task ToggleConnection()
    {
        if (MonitorState.IsConnected)
        {
            MonitorState.Disconnect();
            Snackbar.Add("Desconectado", Severity.Info);
        }
        else
        {
            if (string.IsNullOrWhiteSpace(MonitorState.IpAddress))
            {
                Snackbar.Add("Introduce una dirección IP válida", Severity.Warning);
                return;
            }
            await MonitorState.ConnectAsync();
            Snackbar.Add("Conectado a la tarjeta de comunicaciones", Severity.Success);
        }
    }

    private void ToggleMonitoring()
    {
        if (MonitorState.IsMonitoring)
        {
            MonitorState.StopMonitoring();
            Snackbar.Add("Monitorización detenida", Severity.Info);
        }
        else
        {
            MonitorState.StartMonitoring();
            Snackbar.Add("Monitorización continua iniciada", Severity.Success);
        }
    }

    private async Task TestSendPayload()
    {
        _isSending = true;
        StateHasChanged();
        try
        {
            await MonitorState.SendTestFrameAsync();
            SyncFromService();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al enviar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSending = false;
            StateHasChanged();
        }
    }

    private void ClearLogs()
    {
        MonitorState.ClearLogs();
    }

    private static string FormatSignalValue(SignalValue sv, double value)
    {
        if (sv.IsAscii)
            return ((char)Math.Max(0, Math.Min(255, value))).ToString();

        return value.ToString("0.##") + (string.IsNullOrEmpty(sv.Unidad) ? "" : " " + sv.Unidad);
    }

    private static string FormatSignalValue(Signal signal, double value)
    {
        if (signal.IsAscii)
            return ((char)Math.Max(0, Math.Min(255, value))).ToString();
        else if (signal.BitCount > 1 && signal.BitTextoActivo != null && signal.BitTextoActivo.Any(t => !string.IsNullOrEmpty(t)))
        {
            var activeBits = new List<string>();
            int intVal = (int)value;
            for (int i = 0; i < 16; i++)
            {
                if ((intVal & (1 << i)) != 0 && !string.IsNullOrEmpty(signal.BitTextoActivo[i]))
                    activeBits.Add(signal.BitTextoActivo[i]!);
            }
            return activeBits.Count > 0 ? string.Join(", ", activeBits) : "0 (Todo OK)";
        }
        else
            return value.ToString(signal.Formato) + (string.IsNullOrEmpty(signal.Unidad) ? "" : " " + signal.Unidad);
    }

    public void Dispose()
    {
        MonitorState.OnStateChanged -= OnMonitorStateChanged;
    }

    private class SignalValue
    {
        public int Id { get; set; }
        public string Tag { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string TipoVariable { get; set; } = "";
        public string Unidad { get; set; } = "";
        public string FormattedValue { get; set; } = "";
        public double RawValue { get; set; }
        public bool HasChanged { get; set; }
        public bool IsAscii { get; set; }
        public int NodoNumero { get; set; }
        public string NodoDescripcion { get; set; } = "";
    }
}
