@page "/monitor"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@using ApsMonitor.Models
@using ApsMonitor.Services
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject SepsaProtocolClient SepsaClient
@inject ApsDataService DataService
@implements IDisposable

<div class="d-flex justify-space-between align-center mb-4 mt-n2">
    <MudText Typo="Typo.h5" Class="fw-bold">Monitor en Tiempo Real</MudText>
    <MudChip T="string" Color="@(_isConnected ? Color.Success : Color.Error)" Variant="Variant.Filled" Size="Size.Small">
        @(_isConnected ? "Conectado" : "Desconectado")
    </MudChip>
</div>

<MudGrid>
    <!-- Configuración Card -->
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 h-100 configuration-panel" Elevation="0">
            <MudText Typo="Typo.subtitle2" Class="text-muted mb-4 d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.SettingsEthernet" Size="Size.Small" Class="mr-2" />
                CONFIGURACIÓN DE RED
            </MudText>

            <MudTextField @bind-Value="_ipAddress" Label="Dirección IP de la Tarjeta" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 custom-input" Placeholder="Ej: 192.168.1.100" />
            <MudTextField @bind-Value="_port" Label="Puerto HTTP / Endpoint" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 custom-input" Placeholder="Ej: 80 / 8080" />
            <MudTextField @bind-Value="_payloadHex" Label="Payload SEPSA" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4 custom-input" Placeholder="Ej: 00 00 00 00 00 00 00" />

            <MudButton Variant="Variant.Filled" Color="@(_isConnected ? Color.Error : Color.Success)" FullWidth="true" OnClick="ToggleConnection" Class="fw-bold" Disabled="@_isConnecting">
                @if (_isConnecting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Conectando...</span>
                }
                else if (_isConnected)
                {
                    <MudIcon Icon="@Icons.Material.Filled.PowerOff" Class="mr-2" />
                    <span>Desconectar</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Power" Class="mr-2" />
                    <span>Conectar</span>
                }
            </MudButton>

            @if (_isConnected)
            {
                <MudButton Variant="Variant.Filled"
                           Color="@(_isMonitoring ? Color.Warning : Color.Primary)"
                           FullWidth="true"
                           OnClick="ToggleMonitoring"
                           Class="mt-2 fw-bold">
                    @if (_isMonitoring)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Detener Monitorización</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Sensors" Class="mr-2" />
                        <span>Monitorizar</span>
                    }
                </MudButton>
            }

            <MudDivider Class="my-4 custom-divider" />

            <MudText Typo="Typo.subtitle2" Class="text-muted mb-2">Acciones de Prueba</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="TestSendPayload" Disabled="!_isConnected || _isSending || _isMonitoring" Class="mb-2">
                @if (_isSending)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Enviando...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Send" Class="mr-2" />
                    <span>Enviar Trama de Prueba</span>
                }
            </MudButton>
        </MudPaper>
    </MudItem>

    <!-- Consola de Monitorización -->
    <MudItem xs="12" md="8">
        <div class="console-panel-wrapper">
            <MudPaper Class="pa-0 h-100 console-panel d-flex flex-column" Elevation="0">
                <!-- Header Bar -->
                <div class="console-header">
                    <div class="console-header-left">
                        <div class="console-title-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Small" />
                        </div>
                        <span class="console-title">TRÁFICO DE RED</span>
                        @if (_isConnected)
                        {
                            <span class="console-live-dot"></span>
                            <span class="console-live-text">LIVE</span>
                        }
                    </div>
                    <div class="console-header-right">
                        <div class="console-stat stat-tx">
                            <span class="stat-badge">TX</span>
                            <span class="stat-count">@_logs.Count(l => l.IsSent)</span>
                        </div>
                        <div class="console-stat stat-rx">
                            <span class="stat-badge">RX</span>
                            <span class="stat-count">@_logs.Count(l => !l.IsSent && !l.IsError)</span>
                        </div>
                        <div class="console-stat stat-er">
                            <span class="stat-badge">ER</span>
                            <span class="stat-count">@_logs.Count(l => l.IsError)</span>
                        </div>
                        <div class="console-header-divider"></div>
                        <MudIconButton Icon="@Icons.Material.Filled.ClearAll" Size="Size.Small" Class="console-clear-btn" OnClick="ClearLogs" Title="Limpiar Consola" />
                    </div>
                </div>

                <!-- Console Body -->
                <div class="console-output flex-grow-1">
                    <div class="console-scanlines"></div>
                    @if (_logs.Count == 0)
                    {
                        <div class="console-empty">
                            <div class="console-empty-icon">
                                <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Size="Size.Large" />
                            </div>
                            <span class="console-empty-text">Esperando tráfico de red...</span>
                            <span class="console-empty-sub">Conecta a un dispositivo y envía una trama para comenzar</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var log in _logs)
                        {
                            <div class="log-entry @(log.IsError ? "log-error" : (log.IsSent ? "log-tx" : "log-rx"))">
                                <span class="log-line-marker">›</span>
                                <span class="log-time">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                                <span class="log-dir-badge @(log.IsError ? "badge-er" : (log.IsSent ? "badge-tx" : "badge-rx"))">
                                    @(log.IsSent ? "TX" : (log.IsError ? "ER" : "RX"))
                                </span>
                                <span class="log-msg">@log.Message</span>
                            </div>
                        }
                    }
                </div>

                <!-- Footer -->
                <div class="console-footer">
                    <span>@_logs.Count entradas</span>
                    <span>máx. 100</span>
                </div>
            </MudPaper>
        </div>
    </MudItem>
</MudGrid>

<MudDivider Class="my-6 custom-divider" />

<!-- Sección de Variables en Tiempo Real -->
<div class="d-flex justify-space-between align-center mb-3">
    <div class="d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.Sensors" Color="Color.Info" Class="mr-2" />
        <div>
            <MudText Typo="Typo.h6" Class="fw-bold">Variables del Sistema</MudText>
            <MudText Typo="Typo.caption" Class="text-muted">Valores en tiempo real decodificados de la comunicación con la tarjeta</MudText>
        </div>
    </div>
    <div class="d-flex align-center gap-3">
        <MudTextField @bind-Value="_searchString" Immediate="true" Placeholder="Buscar señal..." 
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" 
                      IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" 
                      Style="max-width:300px; background-color:#1a222c;" />
        <MudText Typo="Typo.caption" Class="text-muted d-none d-md-flex">Despliega un nodo para ver sus valores en tiempo real</MudText>
    </div>
</div>

@if (_isLoadingSignals)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else if (_currentValues.Count == 0)
{
    <MudPaper Class="pa-8 d-flex flex-column align-center justify-center session-empty" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.SensorsOff" Size="Size.Large" Color="Color.Default" Class="mb-3" Style="font-size: 48px;" />
        <MudText Typo="Typo.subtitle1" Class="text-muted mb-1">No hay señales configuradas</MudText>
        <MudText Typo="Typo.body2" Class="text-muted">Añade señales desde la sección de Señales para visualizarlas en el monitor</MudText>
    </MudPaper>
}
else
{
    <MudExpansionPanels MultiExpansion="true" Class="nodes-container">
        @foreach (var group in _currentValues.Where(v => _quickFilter(v)).GroupBy(v => v.NodoNumero).OrderBy(g => g.Key))
        {
            var nodeNum = group.Key;
            var nodeDesc = group.First().NodoDescripcion;
            var changingCount = group.Count(v => v.HasChanged);

            <MudExpansionPanel Class="node-panel mb-2 rounded-lg">
                <TitleContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Router" Color="Color.Info" Class="mr-3" />
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">Nodo @nodeNum: @nodeDesc</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">@group.Count() señales en este nodo</MudText>
                        </div>
                        @if (changingCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.Timeline">
                                @changingCount variando
                            </MudChip>
                        }
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudPaper Elevation="0" Class="pa-2 mt-2" Style="background-color: #1a222c;">
                        <MudDataGrid T="SignalValue" Items="@group" Dense="true" Hover="true" Elevation="0">
                            <Columns>
                                <PropertyColumn Property="x => x.Tag" Title="Tag" CellStyle="width: 150px;" HeaderStyle="width: 150px;" />
                                <PropertyColumn Property="x => x.Nombre" Title="Nombre" CellStyle="width: 350px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" HeaderStyle="width: 350px;" />
                                <TemplateColumn Title="Valor" CellStyle="width: 250px;" HeaderStyle="width: 250px;">
                                    <CellTemplate>
                                        <div class="@(context.Item.HasChanged ? "value-changed" : "")" style="width: 230px; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            @context.Item.FormattedValue
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.Unidad" Title="Unidad" Width="80px" />
                                <TemplateColumn Title="Raw Value" CellStyle="width: 120px;" HeaderStyle="width: 120px;">
                                    <CellTemplate>
                                        <div style="font-variant-numeric: tabular-nums;">
                                            @context.Item.RawValue
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    </MudPaper>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

<style>
    /* ── Configuration Panel ── */
    .configuration-panel {
        background-color: #1a222c;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 12px;
    }
    .text-muted {
        color: #94a3b8 !important;
    }
    .custom-input .mud-input {
        background-color: rgba(0,0,0,0.2) !important;
    }
    .custom-divider {
        border-color: rgba(255,255,255,0.05) !important;
    }

    /* ── Console Panel Wrapper ── */
    .console-panel-wrapper {
        position: relative;
        height: 100%;
        border-radius: 12px;
        overflow: hidden;
    }
    .console-panel-wrapper::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #3b82f6, #8b5cf6, #06b6d4);
        z-index: 2;
        border-radius: 12px 12px 0 0;
    }
    .console-panel {
        background-color: #111827 !important;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
        min-height: 400px;
    }

    /* ── Console Header ── */
    .console-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        background: rgba(0,0,0,0.25);
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .console-header-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .console-title-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(139,92,246,0.2));
        color: #818cf8;
    }
    .console-title {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #94a3b8;
    }
    .console-live-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 6px #22c55e;
        animation: livePulse 1.5s ease-in-out infinite;
        margin-left: 6px;
    }
    .console-live-text {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: #22c55e;
    }

    /* ── Header Stats ── */
    .console-header-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .console-stat {
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .stat-badge {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 2px 6px;
        border-radius: 4px;
    }
    .stat-count {
        font-size: 0.75rem;
        font-weight: 600;
        font-family: 'Consolas', monospace;
        color: #cbd5e1;
    }
    .stat-tx .stat-badge {
        background: rgba(59,130,246,0.15);
        color: #60a5fa;
    }
    .stat-rx .stat-badge {
        background: rgba(16,185,129,0.15);
        color: #34d399;
    }
    .stat-er .stat-badge {
        background: rgba(239,68,68,0.15);
        color: #f87171;
    }
    .console-header-divider {
        width: 1px;
        height: 20px;
        background: rgba(255,255,255,0.08);
    }
    .console-clear-btn {
        color: #64748b !important;
