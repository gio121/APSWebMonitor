@page "/monitor"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<div class="d-flex justify-space-between align-center mb-4 mt-n2">
    <MudText Typo="Typo.h5" Class="fw-bold">Monitor en Tiempo Real</MudText>
    <MudChip T="string" Color="@(_isConnected ? Color.Success : Color.Error)" Variant="Variant.Filled" Size="Size.Small">
        @(_isConnected ? "Conectado" : "Desconectado")
    </MudChip>
</div>

<MudGrid>
    <!-- Configuración Card -->
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 h-100 configuration-panel" Elevation="0">
            <MudText Typo="Typo.subtitle2" Class="text-muted mb-4 d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.SettingsEthernet" Size="Size.Small" Class="mr-2" />
                CONFIGURACIÓN DE RED
            </MudText>

            <MudTextField @bind-Value="_ipAddress" Label="Dirección IP de la Tarjeta" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 custom-input" Placeholder="Ej: 192.168.1.100" />
            <MudTextField @bind-Value="_port" Label="Puerto HTTP / Endpoint" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4 custom-input" Placeholder="Ej: 80 / /api/send" />

            <MudButton Variant="Variant.Filled" Color="@(_isConnected ? Color.Error : Color.Success)" FullWidth="true" OnClick="ToggleConnection" Class="fw-bold" Disabled="@_isConnecting">
                @if (_isConnecting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Conectando...</span>
                }
                else if (_isConnected)
                {
                    <MudIcon Icon="@Icons.Material.Filled.PowerOff" Class="mr-2" />
                    <span>Desconectar</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Power" Class="mr-2" />
                    <span>Conectar</span>
                }
            </MudButton>

            <MudDivider Class="my-4 custom-divider" />

            <MudText Typo="Typo.subtitle2" Class="text-muted mb-2">Acciones de Prueba</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="TestSendPayload" Disabled="!_isConnected || _isSending" Class="mb-2">
                @if (_isSending)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Enviando...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Send" Class="mr-2" />
                    <span>Enviar Trama de Prueba</span>
                }
            </MudButton>
        </MudPaper>
    </MudItem>

    <!-- Consola de Monitorización -->
    <MudItem xs="12" md="8">
        <div class="console-panel-wrapper">
            <MudPaper Class="pa-0 h-100 console-panel d-flex flex-column" Elevation="0">
                <!-- Header Bar -->
                <div class="console-header">
                    <div class="console-header-left">
                        <div class="console-title-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Small" />
                        </div>
                        <span class="console-title">TRÁFICO DE RED</span>
                        @if (_isConnected)
                        {
                            <span class="console-live-dot"></span>
                            <span class="console-live-text">LIVE</span>
                        }
                    </div>
                    <div class="console-header-right">
                        <div class="console-stat stat-tx">
                            <span class="stat-badge">TX</span>
                            <span class="stat-count">@_logs.Count(l => l.IsSent)</span>
                        </div>
                        <div class="console-stat stat-rx">
                            <span class="stat-badge">RX</span>
                            <span class="stat-count">@_logs.Count(l => !l.IsSent && !l.IsError)</span>
                        </div>
                        <div class="console-stat stat-er">
                            <span class="stat-badge">ER</span>
                            <span class="stat-count">@_logs.Count(l => l.IsError)</span>
                        </div>
                        <div class="console-header-divider"></div>
                        <MudIconButton Icon="@Icons.Material.Filled.ClearAll" Size="Size.Small" Class="console-clear-btn" OnClick="ClearLogs" Title="Limpiar Consola" />
                    </div>
                </div>

                <!-- Console Body -->
                <div class="console-output flex-grow-1">
                    <div class="console-scanlines"></div>
                    @if (_logs.Count == 0)
                    {
                        <div class="console-empty">
                            <div class="console-empty-icon">
                                <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Size="Size.Large" />
                            </div>
                            <span class="console-empty-text">Esperando tráfico de red...</span>
                            <span class="console-empty-sub">Conecta a un dispositivo y envía una trama para comenzar</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var log in _logs)
                        {
                            <div class="log-entry @(log.IsError ? "log-error" : (log.IsSent ? "log-tx" : "log-rx"))">
                                <span class="log-line-marker">›</span>
                                <span class="log-time">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                                <span class="log-dir-badge @(log.IsError ? "badge-er" : (log.IsSent ? "badge-tx" : "badge-rx"))">
                                    @(log.IsSent ? "TX" : (log.IsError ? "ER" : "RX"))
                                </span>
                                <span class="log-msg">@log.Message</span>
                            </div>
                        }
                    }
                </div>

                <!-- Footer -->
                <div class="console-footer">
                    <span>@_logs.Count entradas</span>
                    <span>máx. 100</span>
                </div>
            </MudPaper>
        </div>
    </MudItem>
</MudGrid>

<style>
    /* ── Configuration Panel ── */
    .configuration-panel {
        background-color: #1a222c;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 12px;
    }
    .text-muted {
        color: #94a3b8 !important;
    }
    .custom-input .mud-input {
        background-color: rgba(0,0,0,0.2) !important;
    }
    .custom-divider {
        border-color: rgba(255,255,255,0.05) !important;
    }

    /* ── Console Panel Wrapper ── */
    .console-panel-wrapper {
        position: relative;
        height: 100%;
        border-radius: 12px;
        overflow: hidden;
    }
    .console-panel-wrapper::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #3b82f6, #8b5cf6, #06b6d4);
        z-index: 2;
        border-radius: 12px 12px 0 0;
    }
    .console-panel {
        background-color: #111827 !important;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
        min-height: 400px;
    }

    /* ── Console Header ── */
    .console-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        background: rgba(0,0,0,0.25);
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .console-header-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .console-title-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(139,92,246,0.2));
        color: #818cf8;
    }
    .console-title {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #94a3b8;
    }
    .console-live-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 6px #22c55e;
        animation: livePulse 1.5s ease-in-out infinite;
        margin-left: 6px;
    }
    .console-live-text {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: #22c55e;
    }

    /* ── Header Stats ── */
    .console-header-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .console-stat {
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .stat-badge {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 2px 6px;
        border-radius: 4px;
    }
    .stat-count {
        font-size: 0.75rem;
        font-weight: 600;
        font-family: 'Consolas', monospace;
        color: #cbd5e1;
    }
    .stat-tx .stat-badge {
        background: rgba(59,130,246,0.15);
        color: #60a5fa;
    }
    .stat-rx .stat-badge {
        background: rgba(16,185,129,0.15);
        color: #34d399;
    }
    .stat-er .stat-badge {
        background: rgba(239,68,68,0.15);
        color: #f87171;
    }
    .console-header-divider {
        width: 1px;
        height: 20px;
        background: rgba(255,255,255,0.08);
    }
    .console-clear-btn {
        color: #64748b !important;
        transition: color 0.2s;
    }
    .console-clear-btn:hover {
        color: #e2e8f0 !important;
    }

    /* ── Console Output Body ── */
    .console-output {
        position: relative;
        background-color: #0a0f1a;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 0.8rem;
        overflow-y: auto;
        max-height: 460px;
        padding: 12px 16px;
    }
    .console-scanlines {
        pointer-events: none;
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
            0deg,
            transparent,
            transparent 2px,
            rgba(0,0,0,0.04) 2px,
            rgba(0,0,0,0.04) 4px
        );
        z-index: 1;
    }

    /* ── Empty State ── */
    .console-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 300px;
        gap: 8px;
    }
    .console-empty-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: rgba(100,116,139,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #475569;
        margin-bottom: 4px;
    }
    .console-empty-text {
        font-size: 0.85rem;
        color: #64748b;
        font-weight: 500;
    }
    .console-empty-sub {
        font-size: 0.72rem;
        color: #475569;
    }

    /* ── Log Entries ── */
    .log-entry {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 5px 8px;
        border-radius: 6px;
        margin-bottom: 2px;
        border-left: 2px solid transparent;
        animation: logFadeIn 0.3s ease-out;
        position: relative;
        z-index: 2;
    }
    .log-entry:hover {
        background-color: rgba(255,255,255,0.03);
    }
    .log-line-marker {
        color: #334155;
        font-size: 0.7rem;
        min-width: 8px;
    }
    .log-time {
        color: #475569;
        min-width: 90px;
        font-size: 0.75rem;
    }

    /* ── Direction Badges ── */
    .log-dir-badge {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 1px 7px;
        border-radius: 4px;
        min-width: 28px;
        text-align: center;
        line-height: 1.6;
    }
    .badge-tx {
        background: rgba(59,130,246,0.12);
        color: #60a5fa;
        box-shadow: 0 0 8px rgba(59,130,246,0.08);
    }
    .badge-rx {
        background: rgba(16,185,129,0.12);
        color: #34d399;
        box-shadow: 0 0 8px rgba(16,185,129,0.08);
    }
    .badge-er {
        background: rgba(239,68,68,0.12);
        color: #f87171;
        box-shadow: 0 0 8px rgba(239,68,68,0.08);
    }

    /* ── Row Accent Colors ── */
    .log-tx {
        border-left-color: rgba(59,130,246,0.4);
    }
    .log-tx .log-msg {
        color: #93c5fd;
    }
    .log-tx .log-line-marker {
        color: rgba(59,130,246,0.4);
    }
    .log-rx {
        border-left-color: rgba(16,185,129,0.4);
    }
    .log-rx .log-msg {
        color: #6ee7b7;
    }
    .log-rx .log-line-marker {
        color: rgba(16,185,129,0.4);
    }
    .log-error {
        border-left-color: rgba(239,68,68,0.4);
        background: rgba(239,68,68,0.03);
    }
    .log-error .log-msg {
        color: #fca5a5;
    }
    .log-error .log-line-marker {
        color: rgba(239,68,68,0.4);
    }
    .log-msg {
        word-break: break-all;
        flex: 1;
    }

    /* ── Console Footer ── */
    .console-footer {
        display: flex;
        justify-content: space-between;
        padding: 6px 16px;
        font-size: 0.65rem;
        color: #475569;
        border-top: 1px solid rgba(255,255,255,0.04);
        background: rgba(0,0,0,0.15);
        font-family: 'Consolas', monospace;
        letter-spacing: 0.3px;
    }

    /* ── Animations ── */
    @@keyframes livePulse {
        0%, 100% { opacity: 1; box-shadow: 0 0 6px #22c55e; }
        50% { opacity: 0.4; box-shadow: 0 0 2px #22c55e; }
    }
    @@keyframes logFadeIn {
        from { opacity: 0; transform: translateX(-6px); }
        to { opacity: 1; transform: translateX(0); }
    }
</style>

@code {
    private string _ipAddress = "192.168.1.100";
    private string _port = "80";
    private bool _isConnected = false;
    private bool _isConnecting = false;
    private bool _isSending = false;
    private List<LogEntry> _logs = new();
    private static readonly HttpClient _httpClient = new HttpClient();

    private async Task ToggleConnection()
    {
        if (_isConnected)
        {
            _isConnected = false;
            LogMsg("Sistema", "Desconectado. Deteniendo monitorización.", false, false);
            Snackbar.Add("Monitorización detenida", Severity.Info);
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_ipAddress))
            {
                Snackbar.Add("Introduce una dirección IP válida", Severity.Warning);
                return;
            }

            _isConnecting = true;
            StateHasChanged();
            
            // Simulate connection delay
            await Task.Delay(500);
            
            _isConnected = true;
            _isConnecting = false;
            
            var baseUrl = $"http://{_ipAddress}:{_port}";
            LogMsg("Sistema", $"Conectado a {baseUrl}. Listo para enviar/recibir.", false, false);
            Snackbar.Add("Conectado a la tarjeta de comunicaciones", Severity.Success);
        }
    }

    private async Task TestSendPayload()
    {
        if (!_isConnected) return;
        
        _isSending = true;
        StateHasChanged();

        try
        {
            var targetUrl = $"http://{_ipAddress}:{_port}/api/send";
            var payloadArray = new int[] { 85, 15, 0, 2, 1, 26, 0, 0, 0, 0, 0, 0, 0, 131 };
            
            var requestContent = new { payload = payloadArray };
            
            LogMsg("Trama", $"Enviando POST a {targetUrl} con payload: [{string.Join(", ", payloadArray)}]", true, false);

            var response = await _httpClient.PostAsJsonAsync(targetUrl, requestContent);
            
            if (response.IsSuccessStatusCode)
            {
                var responseStr = await response.Content.ReadAsStringAsync();
                LogMsg("Respuesta", $"Código {response.StatusCode}. Contenido: {responseStr}", false, false);
            }
            else
            {
                LogMsg("Error", $"Fallo en la petición. Código: {response.StatusCode}", false, true);
            }
        }
        catch (Exception ex)
        {
            LogMsg("Excepción", ex.Message, false, true);
            Snackbar.Add($"Error al enviar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSending = false;
            StateHasChanged();
        }
    }

    private void LogMsg(string prefix, string message, bool isSent, bool isError)
    {
        _logs.Add(new LogEntry
        {
            Timestamp = DateTime.Now,
            Message = $"[{prefix}] {message}",
            IsSent = isSent,
            IsError = isError
        });
        
        // Keep only last 100 logs
        if (_logs.Count > 100)
        {
            _logs.RemoveAt(0);
        }
        
        // Use JS interop later to auto-scroll to bottom if needed. For now simple enough.
    }

    private void ClearLogs()
    {
        _logs.Clear();
    }

    private class LogEntry
    {
        public DateTime Timestamp { get; set; }
        public string Message { get; set; } = "";
        public bool IsSent { get; set; }
        public bool IsError { get; set; }
    }
}
