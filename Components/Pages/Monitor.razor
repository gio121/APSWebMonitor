    }

    /* ── Console Output Body ── */
    .console-output {
        position: relative;
        background-color: #0a0f1a;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 0.8rem;
        overflow-y: auto;
        max-height: 460px;
        padding: 12px 16px;
    }
    .console-scanlines {
        pointer-events: none;
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
            0deg,
            transparent,
            transparent 2px,
            rgba(0,0,0,0.04) 2px,
