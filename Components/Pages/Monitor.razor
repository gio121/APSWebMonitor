        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 1px 7px;
        border-radius: 4px;
        min-width: 28px;
        text-align: center;
        line-height: 1.6;
    }
    .badge-tx {
        background: rgba(59,130,246,0.12);
        color: #60a5fa;
        box-shadow: 0 0 8px rgba(59,130,246,0.08);
    }
    .badge-rx {
        background: rgba(16,185,129,0.12);
        color: #34d399;
        box-shadow: 0 0 8px rgba(16,185,129,0.08);
    }
    .badge-er {
        background: rgba(239,68,68,0.12);
        color: #f87171;
        box-shadow: 0 0 8px rgba(239,68,68,0.08);
    }

    /* ── Row Accent Colors ── */
    .log-tx {
        border-left-color: rgba(59,130,246,0.4);
    }
    .log-tx .log-msg {
        color: #93c5fd;
    }
    .log-tx .log-line-marker {
        color: rgba(59,130,246,0.4);
    }
    .log-rx {
        border-left-color: rgba(16,185,129,0.4);
    }
    .log-rx .log-msg {
        color: #6ee7b7;
    }
    .log-rx .log-line-marker {
        color: rgba(16,185,129,0.4);
    }
    .log-error {
        border-left-color: rgba(239,68,68,0.4);
        background: rgba(239,68,68,0.03);
    }
    .log-error .log-msg {
        color: #fca5a5;
    }
    .log-error .log-line-marker {
        color: rgba(239,68,68,0.4);
    }
    .log-msg {
        word-break: break-all;
        flex: 1;
    }

    /* ── Console Footer ── */
    .console-footer {
        display: flex;
        justify-content: space-between;
        padding: 6px 16px;
        font-size: 0.65rem;
        color: #475569;
        border-top: 1px solid rgba(255,255,255,0.04);
        background: rgba(0,0,0,0.15);
        font-family: 'Consolas', monospace;
        letter-spacing: 0.3px;
    }

    /* ── Animations ── */
    @@keyframes livePulse {
        0%, 100% { opacity: 1; box-shadow: 0 0 6px #22c55e; }
        50% { opacity: 0.4; box-shadow: 0 0 2px #22c55e; }
    }
    @@keyframes logFadeIn {
        from { opacity: 0; transform: translateX(-6px); }
        to { opacity: 1; transform: translateX(0); }
    }

    /* ── Node Panels & Signals Table ── */
    .nodes-container {
        background: transparent !important;
    }
    .node-panel {
        background-color: #1a222c !important;
        border: 1px solid rgba(255,255,255,0.05);
        color: #e2e8f0 !important;
    }
    .node-panel:hover {
        border-color: rgba(59, 130, 246, 0.3);
    }
    .value-changed {
        color: #3b82f6 !important;
        text-shadow: 0 0 8px rgba(59, 130, 246, 0.4);
    }
    .mud-table-root .mud-table-head .mud-table-cell {
        background-color: #1a222c !important;
        color: #94a3b8;
        font-weight: 500;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .session-empty {
        border: 2px dashed rgba(255,255,255,0.1);
        background-color: #1a222c;
        border-radius: 12px;
        min-height: 200px;
    }
</style>

@code {
    private string _ipAddress = "192.168.15.1";
    private string _port = "8080";
    private bool _isConnected = false;
    private bool _isConnecting = false;
    private bool _isSending = false;
    private bool _isMonitoring = false;
    private CancellationTokenSource? _monitoringCts;
    private string _payloadHex = "00 00";
    private List<LogEntry> _logs = new();

    private List<Signal> _signals = new();
    private Dictionary<int, List<Signal>> _signalsByNode = new();
    private Dictionary<int, int> _nodeSizes = new();
    private List<SignalValue> _currentValues = new();
    private Dictionary<int, double> _previousValues = new();
    private string _searchString = "";
    private bool _isLoadingSignals = false;

    private Func<SignalValue, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (x.Tag.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.Nombre.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadSignalsAsync();
    }

    private async Task LoadSignalsAsync()
    {
        _isLoadingSignals = true;
        try
        {
            _signals = await DataService.GetSignalsAsync();
            _signalsByNode = _signals.GroupBy(s => s.NodoNumero).ToDictionary(g => g.Key, g => g.ToList());
            _nodeSizes = _signalsByNode.ToDictionary(
                kvp => kvp.Key,
                kvp => kvp.Value.Count > 0 ? kvp.Value.Max(s => s.BytePosicion + SessionParserService.GetByteSize(s.TipoVariable)) : 0
            );

            _currentValues = _signals.Select(sig => new SignalValue
            {
                Id = sig.Id,
                Tag = sig.Tag,
                Nombre = sig.Nombre,
                TipoVariable = sig.TipoVariable,
                Unidad = sig.Unidad ?? "",
                FormattedValue = FormatSignalValue(sig, sig.ValorActual),
                RawValue = sig.ValorActual,
                HasChanged = false,
                IsAscii = sig.IsAscii,
                NodoNumero = sig.NodoNumero,
                NodoDescripcion = sig.NodoDescripcion
            }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar señales: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingSignals = false;
        }
    }

    private async Task ToggleConnection()
    {
        if (_isConnected)
        {
            StopMonitoring();
            _isConnected = false;
            LogMsg("Sistema", "Desconectado. Deteniendo monitorización.", false, false);
            Snackbar.Add("Monitorización detenida", Severity.Info);
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_ipAddress))
            {
                Snackbar.Add("Introduce una dirección IP válida", Severity.Warning);
                return;
            }

            _isConnecting = true;
            StateHasChanged();
            
            // Simulate connection delay
            await Task.Delay(500);
            
            _isConnected = true;
            _isConnecting = false;
            
            var baseUrl = $"http://{_ipAddress}:{_port}";
            LogMsg("Sistema", $"Conectado a {baseUrl}. Listo para enviar/recibir.", false, false);
            Snackbar.Add("Conectado a la tarjeta de comunicaciones", Severity.Success);
        }
    }

    private async Task TestSendPayload()
    {
        if (!_isConnected) return;
        
        _isSending = true;
        StateHasChanged();

        try
        {
            var baseUrl = $"{_ipAddress}:{_port}";
            var payload = SepsaProtocolClient.ParsePayload(_payloadHex);
            var frame = SepsaClient.BuildFrame(payload);

            LogMsg("Trama", $"TX {SepsaProtocolClient.ToHex(frame)}", true, false);

            var response = await SepsaClient.SendAsync(baseUrl, frame);
            
            if (response.IsSuccess)
            {
                var responseHex = SepsaProtocolClient.ToHex(response.Payload);
                LogMsg("Respuesta", $"RX {responseHex}", false, false);
                ProcessIncomingFrame(response.Payload);
            }
            else
            {
                LogMsg("Error", $"Fallo en {response.Endpoint}. Codigo: {response.StatusCode}. {response.Error}", false, true);
            }
        }
        catch (Exception ex)
        {
            LogMsg("Excepción", ex.Message, false, true);
            Snackbar.Add($"Error al enviar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSending = false;
            StateHasChanged();
        }
    }

    private void ToggleMonitoring()
    {
        if (!_isConnected) return;

        if (_isMonitoring)
        {
            StopMonitoring();
            LogMsg("Sistema", "Monitorización continua detenida.", false, false);
            Snackbar.Add("Monitorización detenida", Severity.Info);
        }
        else
        {
            _isMonitoring = true;
            _monitoringCts = new CancellationTokenSource();
            LogMsg("Sistema", "Monitorización continua iniciada: enviando tramas 1A y 1D alternadas cada 100ms.", false, false);
            Snackbar.Add("Monitorización continua iniciada", Severity.Success);

            _ = RunMonitoringLoopAsync(_monitoringCts.Token);
        }
    }

    private void StopMonitoring()
    {
        if (_isMonitoring)
        {
            _isMonitoring = false;
            try
            {
                _monitoringCts?.Cancel();
                _monitoringCts?.Dispose();
            }
            catch { }
            _monitoringCts = null;
        }
    }

    private async Task RunMonitoringLoopAsync(CancellationToken cancellationToken)
    {
        byte currentFrameType = 0x1A;

        try
        {
            while (!cancellationToken.IsCancellationRequested && _isConnected)
            {
                var sw = System.Diagnostics.Stopwatch.StartNew();

                try
                {
                    var baseUrl = $"{_ipAddress}:{_port}";
                    var payload = SepsaProtocolClient.ParsePayload(_payloadHex);
                    var frame = SepsaClient.BuildFrame(payload, messageType: currentFrameType);

                    LogMsg("Trama", $"TX [{currentFrameType:X2}] {SepsaProtocolClient.ToHex(frame)}", true, false);

                    using var reqCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
                    reqCts.CancelAfter(500);

                    var response = await SepsaClient.SendAsync(baseUrl, frame, reqCts.Token);
                    if (response.IsSuccess)
                    {
                        var responseHex = SepsaProtocolClient.ToHex(response.Payload);
                        LogMsg("Respuesta", $"RX [{currentFrameType:X2}] {responseHex}", false, false);
                        ProcessIncomingFrame(response.Payload);
                    }
                    else
                    {
                        LogMsg("Error", $"Fallo en {response.Endpoint}. Código: {response.StatusCode}. {response.Error}", false, true);
                    }
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    break;
                }
                catch (OperationCanceledException)
                {
                    LogMsg("Timeout", $"Sin respuesta en trama [{currentFrameType:X2}] tras 500ms", false, true);
                }
                catch (Exception ex)
                {
                    LogMsg("Excepción", $"Error enviando trama [{currentFrameType:X2}]: {ex.Message}", false, true);
                }

                // Alternar tipo de trama: 1A -> 1D -> 1A ...
                currentFrameType = (currentFrameType == 0x1A) ? (byte)0x1D : (byte)0x1A;

                try
                {
                    await InvokeAsync(StateHasChanged);
                }
                catch { }

                sw.Stop();
                var remainingMs = (int)(100 - sw.ElapsedMilliseconds);
                if (remainingMs > 0)
                {
                    await Task.Delay(remainingMs, cancellationToken);
                }
                else
                {
                    await Task.Delay(1, cancellationToken);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Cancelación esperada
        }
        catch (Exception ex)
        {
            LogMsg("Excepción", $"Error en bucle de monitorización: {ex.Message}", false, true);
        }
        finally
        {
            _isMonitoring = false;
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch { }
        }
    }

    public void Dispose()
    {
        StopMonitoring();
    }

    /// <summary>
    /// Decodifica una trama de respuesta según el formato del protocolo SEPSA:
    ///   Byte 0:        SYNC (0xAA)
    ///   Byte 1-2:      NBYTES (longitud total de la trama, Little Endian)
    ///   Byte 3:        DEST (dirección nodo destino)
    ///   Byte 4:        ORIG (dirección nodo origen)
    ///   Byte 5:        FT   (Frame Type)
    ///   Byte 6..N-2:   DATA (datos de señales)
    ///   Byte N-1:      CRC  (1 byte)
    /// Lógica idéntica a SessionParserService.Parse().
    /// </summary>
    private void ProcessIncomingFrame(byte[] frameData)
    {
        if (frameData == null || frameData.Length < 7 || _signals.Count == 0) return;

        // Payload = trama completa - 6 bytes cabecera - 1 byte CRC
        int payloadLength = frameData.Length - 7;
        if (payloadLength <= 0) return;

        // Identificar nodo por tamaño de payload (mismo algoritmo que SessionParserService)
        int? matchingNode = null;
        int minDiff = int.MaxValue;
        foreach (var kvp in _nodeSizes)
        {
            int diff = Math.Abs(payloadLength - kvp.Value);
            if (diff < minDiff)
            {
                minDiff = diff;
                matchingNode = kvp.Key;
            }
        }

        if (matchingNode.HasValue && _signalsByNode.TryGetValue(matchingNode.Value, out var nodeSignals))
        {
            // Extraer datos usando los 6 bytes de cabecera como offset (DATA empieza en byte 6)
            foreach (var sig in nodeSignals)
            {
                int offset = sig.BytePosicion + 6;
                if (offset + SessionParserService.GetByteSize(sig.TipoVariable) <= frameData.Length)
                {
                    double rawValue = SessionParserService.ReadValue(frameData, offset, sig.TipoVariable);
                    double physValue = ApsCalculationUtils.CalculatePhysical(rawValue, sig.Escala, sig.Offset);

                    var cv = _currentValues.FirstOrDefault(v => v.Id == sig.Id);
                    if (cv != null)
                    {
                        bool changed = _previousValues.TryGetValue(sig.Id, out var prev) && Math.Abs(prev - physValue) > 0.00001;
                        _previousValues[sig.Id] = physValue;

                        cv.FormattedValue = FormatSignalValue(sig, physValue);
                        cv.RawValue = rawValue;
                        cv.HasChanged = changed;
                    }
                }
            }
        }
    }

    private static string FormatSignalValue(Signal signal, double value)
    {
        if (signal.IsAscii)
        {
            return ((char)Math.Max(0, Math.Min(255, value))).ToString();
        }
        else if (signal.BitCount > 1 && signal.BitTextoActivo != null && signal.BitTextoActivo.Any(t => !string.IsNullOrEmpty(t)))
        {
            var activeBits = new List<string>();
            int intVal = (int)value;
            for (int i = 0; i < 16; i++)
            {
                if ((intVal & (1 << i)) != 0 && !string.IsNullOrEmpty(signal.BitTextoActivo[i]))
                {
                    activeBits.Add(signal.BitTextoActivo[i]!);
                }
            }
            return activeBits.Count > 0 ? string.Join(", ", activeBits) : "0 (Todo OK)";
        }
        else
        {
            return value.ToString(signal.Formato) + (string.IsNullOrEmpty(signal.Unidad) ? "" : " " + signal.Unidad);
        }
    }

    private void LogMsg(string prefix, string message, bool isSent, bool isError)
    {
        _logs.Add(new LogEntry
        {
            Timestamp = DateTime.Now,
            Message = $"[{prefix}] {message}",
            IsSent = isSent,
            IsError = isError
        });
        
        // Keep only last 100 logs
        if (_logs.Count > 100)
        {
            _logs.RemoveAt(0);
        }
        
        // Use JS interop later to auto-scroll to bottom if needed. For now simple enough.
    }

    private void ClearLogs()
    {
        _logs.Clear();
    }

    private class LogEntry
    {
        public DateTime Timestamp { get; set; }
        public string Message { get; set; } = "";
        public bool IsSent { get; set; }
        public bool IsError { get; set; }
    }

    private class SignalValue
    {
        public int Id { get; set; }
        public string Tag { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string TipoVariable { get; set; } = "";
        public string Unidad { get; set; } = "";
        public string FormattedValue { get; set; } = "";
        public double RawValue { get; set; }
        public bool HasChanged { get; set; }
        public bool IsAscii { get; set; }
        public int NodoNumero { get; set; }
        public string NodoDescripcion { get; set; } = "";
    }
}
