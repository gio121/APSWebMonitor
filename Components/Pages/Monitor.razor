@page "/monitor"
@attribute [Authorize(Policy = "Page:monitor")]
@rendermode InteractiveServer
@using ApsMonitor.Models
@using ApsMonitor.Services
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject MonitorStateService MonitorState
@inject ApsDataService DataService
@inject InfluxWriterService InfluxWriter
@inject IDialogService DialogService
@implements IDisposable

<div class="d-flex justify-space-between align-center mb-4 mt-n2">
    <MudText Typo="Typo.h5" Class="fw-bold">@Ui["Live monitor"]</MudText>
    <div class="d-flex align-center gap-2">
        <MudChip T="string"
                 Color="@(MonitorState.UseTls ? Color.Info : Color.Default)"
                 Variant="Variant.Outlined"
                 Size="Size.Small"
                 OnClick="OpenTlsSettingsDialogAsync"
                 Icon="@(MonitorState.UseTls ? Icons.Material.Filled.EnhancedEncryption : Icons.Material.Filled.SettingsEthernet)">
            @MonitorState.TlsSecurity.ModeDisplayName
        </MudChip>
        <MudChip T="string" Color="@(MonitorState.IsConnected ? Color.Success : Color.Error)" Variant="Variant.Filled" Size="Size.Small">
            @(MonitorState.IsConnected ? "Conectado" : "Desconectado")
        </MudChip>
    </div>
</div>

@* <MudPaper Class="pa-3 mb-4" Elevation="0">
    <MudText Typo="Typo.subtitle2">InfluxDB: @(!_influxStatus.Enabled ? Ui["Disabled"] : _influxStatus.Error != null ? Ui["Check connection"] : _influxStatus.LastWrite != null ? Ui["Sending data"] : Ui["Waiting for samples"])</MudText>
    @if (_influxStatus.Enabled)
    {
        <MudText Typo="Typo.body2">@Ui["Confirmed: {0} · Pending: {1} · Dropped/unconfirmed: {2}", _influxStatus.Written, _influxStatus.Pending, _influxStatus.Dropped]</MudText>
        <MudText Typo="Typo.caption">Last write: @(_influxStatus.LastWrite?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "—") · Session: @(MonitorState.SessionId ?? "—")</MudText>
        @if (_influxStatus.Error != null)
        {
            <MudText Color="Color.Warning">@_influxStatus.Error</MudText>
        }
    }
</MudPaper> *@

<MudGrid>
    <!-- Configuración Card -->
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 h-100 configuration-panel" Elevation="0">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle2" Class="text-muted d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.SettingsEthernet" Size="Size.Small" Class="mr-2" />
                    CONFIGURACIÓN DE RED
                </MudText>
                <MudIconButton Icon="@(MonitorState.UseTls ? Icons.Material.Filled.EnhancedEncryption : Icons.Material.Filled.Security)"
                               Color="@(MonitorState.UseTls ? Color.Success : Color.Default)"
                               Size="Size.Small"
                               Title="Configurar TLS / mTLS y Certificados"
                               OnClick="OpenTlsSettingsDialogAsync" />
            </div>

            <div class="d-flex align-center justify-space-between mb-3 pa-2 rounded" style="background: rgba(59,130,246,0.06); border: 1px solid var(--mud-palette-lines-default);">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@(MonitorState.UseTls ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)"
                             Size="Size.Small"
                             Color="@(MonitorState.UseTls ? Color.Success : Color.Default)" />
                    <div>
                        <MudText Typo="Typo.caption" Class="fw-bold d-block">Modo de Comunicación</MudText>
                        <MudText Typo="Typo.caption" Class="text-muted">@MonitorState.TlsSecurity.ModeDisplayName</MudText>
                    </div>
                </div>
                <div class="d-flex align-center gap-1">
                    <MudSwitch T="bool"
                               Value="@MonitorState.TlsSecurity.UseTls"
                               ValueChanged="@(val => MonitorState.TlsSecurity.UseTls = val)"
                               Color="Color.Success"
                               Label="TLS" />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="OpenTlsSettingsDialogAsync">
                        Certificados
                    </MudButton>
                </div>
            </div>

            <MudTextField @bind-Value="MonitorState.IpAddress" Label="@Ui["Board IP address"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 custom-input" Placeholder="@Ui["E.g. 192.168.1.100"]" Disabled="@MonitorState.IsConnected" />
            @if (MonitorState.UseTls)
            {
                <MudNumericField T="int" @bind-Value="MonitorState.TlsSecurity.HttpsApiPort" Label="Puerto HTTPS API (TLS/mTLS)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 custom-input" Min="1" Max="65535" Disabled="@MonitorState.IsConnected" />
            }
            else
            {
                <MudTextField @bind-Value="MonitorState.Port" Label="@Ui["ControlManager UDP port"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 custom-input" Placeholder="50001" Disabled="@MonitorState.IsConnected" />
            }
            <MudTextField @bind-Value="MonitorState.PayloadHex" Label="Payload SEPSA" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4 custom-input" Placeholder="@Ui["E.g. 00 00 00 00 00 00 00"]" />

            <MudButton Variant="Variant.Filled" Color="@(MonitorState.IsConnected ? Color.Error : Color.Success)" FullWidth="true" OnClick="ToggleConnection" Class="fw-bold" Disabled="@MonitorState.IsConnecting">
                @if (MonitorState.IsConnecting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Connecting...</span>
                }
                else if (MonitorState.IsConnected)
                {
                    <MudIcon Icon="@Icons.Material.Filled.PowerOff" Class="mr-2" />
                    <span>@Ui["Disconnect"]</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Power" Class="mr-2" />
                    <span>@Ui["Connect"]</span>
                }
            </MudButton>

            @if (MonitorState.IsConnected)
            {
                <MudButton Variant="Variant.Filled"
                           Color="@(MonitorState.IsMonitoring ? Color.Warning : Color.Primary)"
                           FullWidth="true"
                           OnClick="ToggleMonitoring"
                           Class="mt-2 fw-bold">
                    @if (MonitorState.IsMonitoring)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>@Ui["Stop monitoring"]</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Sensors" Class="mr-2" />
                        <span>@Ui["Start monitoring"]</span>
                    }
                </MudButton>
            }

            <MudDivider Class="my-4 custom-divider" />

            <MudText Typo="Typo.subtitle2" Class="text-muted mb-2">@Ui["Test actions"]</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="TestSendPayload" Disabled="!MonitorState.IsConnected || _isSending || MonitorState.IsMonitoring" Class="mb-2">
                @if (_isSending)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Sending...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Send" Class="mr-2" />
                    <span>@Ui["Send test frame"]</span>
                }
            </MudButton>
        </MudPaper>
    </MudItem>

    <!-- Consola de Monitorización -->
    <MudItem xs="12" md="8">
        <div class="console-panel-wrapper">
            <MudPaper Class="pa-0 h-100 console-panel d-flex flex-column" Elevation="0">
                <!-- Header Bar -->
                <div class="console-header">
                    <div class="console-header-left">
                        <div class="console-title-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Small" />
                        </div>
                        <span class="console-title">@Ui["NETWORK TRAFFIC"]</span>
                        @if (MonitorState.IsConnected)
                        {
                            <span class="console-live-dot"></span>
                            <span class="console-live-text">LIVE</span>
                        }
                    </div>
                    <div class="console-header-right">
                        <div class="console-stat stat-tx">
                            <span class="stat-badge">TX</span>
                            <span class="stat-count">@MonitorState.TotalTxCount</span>
                        </div>
                        <div class="console-stat stat-rx">
                            <span class="stat-badge">RX</span>
                            <span class="stat-count">@MonitorState.TotalRxCount</span>
                        </div>
                        <div class="console-stat stat-er">
                            <span class="stat-badge">ER</span>
                            <span class="stat-count">@MonitorState.TotalErCount</span>
                        </div>
                        <div class="console-header-divider"></div>
                        <MudIconButton Icon="@Icons.Material.Filled.ClearAll" Size="Size.Small" Class="console-clear-btn" OnClick="ClearLogs" Title="@Ui["Clear console"]" />
                    </div>
                </div>

                <!-- Console Body -->
                <div class="console-output flex-grow-1" id="console-output">
                    <div class="console-scanlines"></div>
                    @if (_logs.Count == 0)
                    {
                        <div class="console-empty">
                            <div class="console-empty-icon">
                                <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Size="Size.Large" />
                            </div>
                            <span class="console-empty-text">@Ui["Waiting for network traffic..."]</span>
                            <span class="console-empty-sub">@Ui["Connect to a device and send a frame to begin"]</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var log in _logs)
                        {
                            <div class="log-entry @(log.IsError ? "log-error" : (log.IsSent ? "log-tx" : "log-rx"))">
                                <span class="log-line-marker">›</span>
                                <span class="log-time">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                                <span class="log-dir-badge @(log.IsError ? "badge-er" : (log.IsSent ? "badge-tx" : "badge-rx"))">
                                    @(log.IsSent ? "TX" : (log.IsError ? "ER" : "RX"))
                                </span>
                                <span class="log-msg">@log.Message</span>
                            </div>
                        }
                    }
                </div>

                <!-- Footer -->
                <div class="console-footer">
                    <span>@_logs.Count entradas</span>
                    <span>@Ui["max. 100"]</span>
                </div>
            </MudPaper>
        </div>
    </MudItem>
</MudGrid>

<MudDivider Class="my-6 custom-divider" />

<!-- Sección de Variables en Tiempo Real -->
<div class="d-flex justify-space-between align-center mb-3">
    <div class="d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.Sensors" Color="Color.Info" Class="mr-2" />
        <div>
            <MudText Typo="Typo.h6" Class="fw-bold">@Ui["System variables"]</MudText>
            <MudText Typo="Typo.caption" Class="text-muted">@Ui["Live values decoded from board communications"]</MudText>
        </div>
    </div>
    <div class="d-flex align-center gap-3">
        <MudTextField @bind-Value="_searchString" Immediate="true" Placeholder="@Ui["Search signal..."]"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" 
                      IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" 
                      Style="max-width:300px; background-color:var(--mud-palette-surface);" />
        <MudText Typo="Typo.caption" Class="text-muted d-none d-md-flex">@Ui["Expand a node to view its live values"]</MudText>
    </div>
</div>

@if (_isLoadingSignals)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else if (_currentValues.Count == 0)
{
    <MudPaper Class="pa-8 d-flex flex-column align-center justify-center session-empty" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.SensorsOff" Size="Size.Large" Color="Color.Default" Class="mb-3" Style="font-size: 48px;" />
        <MudText Typo="Typo.subtitle1" Class="text-muted mb-1">@Ui["No signals configured"]</MudText>
        <MudText Typo="Typo.body2" Class="text-muted">@Ui["Add signals in the Signals section to display them in the monitor"]</MudText>
    </MudPaper>
}
else
{
    <MudExpansionPanels MultiExpansion="true" Class="nodes-container">
        @foreach (var group in _currentValues.Where(v => _quickFilter(v)).GroupBy(v => v.NodoNumero).OrderBy(g => g.Key))
        {
            var nodeNum = group.Key;
            var nodeDesc = group.First().NodoDescripcion;
            var changingCount = group.Count(v => v.HasChanged);

            <MudExpansionPanel Class="node-panel mb-2 rounded-lg">
                <TitleContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Router" Color="Color.Info" Class="mr-3" />
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">@Ui["Node {0}: {1}", nodeNum, nodeDesc]</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">@group.Count() signals in this node</MudText>
                        </div>
                        @if (changingCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.Timeline">
                                @changingCount variando
                            </MudChip>
                        }
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudPaper Elevation="0" Class="pa-2 mt-2" Style="background-color: var(--mud-palette-surface);">
                        <MudDataGrid T="SignalValue" Items="@group" Dense="true" Hover="true" Elevation="0">
                            <Columns>
                                <PropertyColumn Property="x => x.Tag" Title="Tag" CellStyle="width: 150px;" HeaderStyle="width: 150px;" />
                                <PropertyColumn Property="x => x.Nombre" Title="@Ui["Name"]" CellStyle="width: 350px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" HeaderStyle="width: 350px;" />
                                <TemplateColumn Title="@Ui["Value_Lowercase"]" CellStyle="width: 250px;" HeaderStyle="width: 250px;">
                                    <CellTemplate>
                                        <div class="@(context.Item.HasChanged ? "value-changed" : "")" style="width: 230px; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            @context.Item.FormattedValue
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.Unidad" Title="@Ui["Unit"]" Width="80px" />
                                <TemplateColumn Title="Raw Value" CellStyle="width: 120px;" HeaderStyle="width: 120px;">
                                    <CellTemplate>
                                        <div style="font-variant-numeric: tabular-nums;">
                                            @context.Item.RawValue
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    </MudPaper>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

<style>
    /* ── Configuration Panel ── */
    .configuration-panel {
        background-color: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
    }
    .text-muted {
        color: var(--mud-palette-text-secondary) !important;
    }
    .custom-input .mud-input {
        background-color: rgba(0,0,0,0.2) !important;
    }
    .custom-divider {
        border-color: var(--mud-palette-lines-default) !important;
    }

    /* ── Console Panel Wrapper ── */
    .console-panel-wrapper {
        position: relative;
        height: 100%;
        border-radius: 12px;
        overflow: hidden;
    }
    .console-panel-wrapper::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #3b82f6, #8b5cf6, #06b6d4);
        z-index: 2;
        border-radius: 12px 12px 0 0;
    }
    .console-panel {
        background-color: var(--mud-palette-background) !important;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        min-height: 400px;
    }

    /* ── Console Header ── */
    .console-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        background: rgba(0,0,0,0.25);
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }
    .console-header-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .console-title-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(139,92,246,0.2));
        color: #818cf8;
    }
    .console-title {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: var(--mud-palette-text-secondary);
    }
    .console-live-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 6px #22c55e;
        animation: livePulse 1.5s ease-in-out infinite;
        margin-left: 6px;
    }
    .console-live-text {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: #22c55e;
    }

    /* ── Header Stats ── */
    .console-header-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .console-stat {
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .stat-badge {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 2px 6px;
        border-radius: 4px;
    }
    .stat-count {
        font-size: 0.75rem;
        font-weight: 600;
        font-family: 'Consolas', monospace;
        color: var(--mud-palette-text-primary);
    }
    .stat-tx .stat-badge {
        background: rgba(59,130,246,0.15);
        color: #60a5fa;
    }
    .stat-rx .stat-badge {
        background: rgba(16,185,129,0.15);
        color: #34d399;
    }
    .stat-er .stat-badge {
        background: rgba(239,68,68,0.15);
        color: #f87171;
    }
    .console-header-divider {
        width: 1px;
        height: 20px;
        background: rgba(255,255,255,0.08);
    }
    .console-clear-btn {
        color: #64748b !important;
        transition: color 0.2s;
    }
    .console-clear-btn:hover {
        color: var(--mud-palette-text-primary) !important;
    }

    /* ── Console Output Body ── */
    .console-output {
        position: relative;
        background-color: var(--mud-palette-background);
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 0.8rem;
        overflow-y: auto;
        max-height: 460px;
        padding: 12px 16px;
    }
    .console-scanlines {
        pointer-events: none;
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
            0deg,
            transparent,
            transparent 2px,
            rgba(0,0,0,0.04) 2px,
            rgba(0,0,0,0.04) 4px
        );
        z-index: 1;
    }

    /* ── Empty State ── */
    .console-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 300px;
        gap: 8px;
    }
    .console-empty-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: rgba(100,116,139,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #475569;
        margin-bottom: 4px;
    }
    .console-empty-text {
        font-size: 0.85rem;
        color: #64748b;
        font-weight: 500;
    }
    .console-empty-sub {
        font-size: 0.72rem;
        color: #475569;
    }

    /* ── Log Entries ── */
    .log-entry {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 5px 8px;
        border-radius: 6px;
        margin-bottom: 2px;
        border-left: 2px solid transparent;
        animation: logFadeIn 0.3s ease-out;
        position: relative;
        z-index: 2;
    }
    .log-entry:hover {
        background-color: rgba(255,255,255,0.03);
    }
    .log-line-marker {
        color: var(--mud-palette-lines-default);
        font-size: 0.7rem;
        min-width: 8px;
    }
    .log-time {
        color: #475569;
        min-width: 90px;
        font-size: 0.75rem;
    }

    /* ── Direction Badges ── */
    .log-dir-badge {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 1px 7px;
        border-radius: 4px;
        min-width: 28px;
        text-align: center;
        line-height: 1.6;
    }
    .badge-tx {
        background: rgba(59,130,246,0.12);
        color: #60a5fa;
        box-shadow: 0 0 8px rgba(59,130,246,0.08);
    }
    .badge-rx {
        background: rgba(16,185,129,0.12);
        color: #34d399;
        box-shadow: 0 0 8px rgba(16,185,129,0.08);
    }
    .badge-er {
        background: rgba(239,68,68,0.12);
        color: #f87171;
        box-shadow: 0 0 8px rgba(239,68,68,0.08);
    }

    /* ── Row Accent Colors ── */
    .log-tx {
        border-left-color: rgba(59,130,246,0.4);
    }
    .log-tx .log-msg {
        color: #93c5fd;
    }
    .log-tx .log-line-marker {
        color: rgba(59,130,246,0.4);
    }
    .log-rx {
        border-left-color: rgba(16,185,129,0.4);
    }
    .log-rx .log-msg {
        color: #6ee7b7;
    }
    .log-rx .log-line-marker {
        color: rgba(16,185,129,0.4);
    }
    .log-error {
        border-left-color: rgba(239,68,68,0.4);
        background: rgba(239,68,68,0.03);
    }
    .log-error .log-msg {
        color: #fca5a5;
    }
    .log-error .log-line-marker {
        color: rgba(239,68,68,0.4);
    }
    .log-msg {
        word-break: break-all;
        flex: 1;
    }

    /* ── Console Footer ── */
    .console-footer {
        display: flex;
        justify-content: space-between;
        padding: 6px 16px;
        font-size: 0.65rem;
        color: #475569;
        border-top: 1px solid var(--mud-palette-lines-default);
        background: rgba(0,0,0,0.15);
        font-family: 'Consolas', monospace;
        letter-spacing: 0.3px;
    }

    /* ── Animations ── */
    @@keyframes livePulse {
        0%, 100% { opacity: 1; box-shadow: 0 0 6px #22c55e; }
        50% { opacity: 0.4; box-shadow: 0 0 2px #22c55e; }
    }
    @@keyframes logFadeIn {
        from { opacity: 0; transform: translateX(-6px); }
        to { opacity: 1; transform: translateX(0); }
    }

    /* ── Node Panels & Signals Table ── */
    .nodes-container {
        background: transparent !important;
    }
    .node-panel {
        background-color: var(--mud-palette-surface) !important;
        border: 1px solid var(--mud-palette-lines-default);
        color: var(--mud-palette-text-primary) !important;
    }
    .node-panel:hover {
        border-color: rgba(59, 130, 246, 0.3);
    }
    .value-changed {
        color: #3b82f6 !important;
        text-shadow: 0 0 8px rgba(59, 130, 246, 0.4);
