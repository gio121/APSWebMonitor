    /* ── Empty State ── */
    .console-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 300px;
        gap: 8px;
    }
    .console-empty-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: rgba(100,116,139,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #475569;
        margin-bottom: 4px;
    }
    .console-empty-text {
        font-size: 0.85rem;
        color: #64748b;
        font-weight: 500;
    }
    .console-empty-sub {
        font-size: 0.72rem;
        color: #475569;
    }

    /* ── Log Entries ── */
    .log-entry {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 5px 8px;
        border-radius: 6px;
        margin-bottom: 2px;
        border-left: 2px solid transparent;
        animation: logFadeIn 0.3s ease-out;
        position: relative;
        z-index: 2;
    }
    .log-entry:hover {
        background-color: rgba(255,255,255,0.03);
    }
    .log-line-marker {
        color: #334155;
        font-size: 0.7rem;
        min-width: 8px;
