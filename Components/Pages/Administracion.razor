@page "/administracion"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@using ApsMonitor.Models
@using ApsMonitor.Services
@inject ApsDataService DataService
@inject IDialogService DialogService

<div class="administration-page">
    <header class="administration-heading">
        <div class="heading-icon"><MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Large" /></div>
        <div>
            <MudText Typo="Typo.h5" Class="fw-bold">@Ui["Administration"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Ui["Customise your project and manage access to the monitor."]</MudText>
        </div>
    </header>

    <MudGrid Spacing="4">
        <MudItem xs="12" lg="8">
            <ApsMonitor.Components.Dialogs.ProjectBrandingSettings />
        </MudItem>
        <MudItem xs="12" lg="4">
            <MudPaper Class="admin-card users-card" Elevation="0">
                <div class="section-heading">
                    <div class="section-icon"><MudIcon Icon="@Icons.Material.Outlined.People" /></div>
                    <div>
                        <MudText Typo="Typo.h6" Class="fw-bold">@Ui["User management"]</MudText>
                        <MudText Typo="Typo.body2" Class="admin-muted">@Ui["Roles and access permissions"]</MudText>
                    </div>
                </div>
                <p class="admin-description">@Ui["Manage monitor user accounts and credentials."]</p>
                <div class="user-stat">
                    <div class="user-stat-label"><MudIcon Icon="@Icons.Material.Outlined.AdminPanelSettings" Color="Color.Primary" /><span>@Ui["Administrators"]</span></div>
                    <strong>@_adminCount</strong>
                </div>
                <div class="user-stat">
                    <div class="user-stat-label"><MudIcon Icon="@Icons.Material.Outlined.Engineering" Color="Color.Primary" /><span>@Ui["Users with other roles"]</span></div>
                    <strong>@_operatorCount</strong>
                </div>
                <div class="users-action">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Outlined.ManageAccounts" OnClick="OpenUserManagement">@Ui["Manage users"]</MudButton>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            <ApsMonitor.Components.Dialogs.RolePageAccess />
        </MudItem>
    </MudGrid>
</div>
@code {
    private int _adminCount = 0;
    private int _operatorCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserCounts();
    }

    private async Task LoadUserCounts()
    {
        var users = await DataService.GetUsersAsync();
        _adminCount = users.Count(u => u.Role == "Administrador");
        _operatorCount = users.Count(u => u.Role != "Administrador");
    }

    private async Task OpenUserManagement()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ApsMonitor.Components.Dialogs.UserManagementDialog>(ApsMonitor.Resources.MonitorResources.Text("User management"), options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadUserCounts();
            StateHasChanged();
        }
    }
}
