@page "/comandos"
@attribute [Authorize(Policy = "Page:comandos")]
@rendermode InteractiveServer
@using ApsMonitor.Models
@using ApsMonitor.Services
@using ApsMonitor.Components.Dialogs
@inject ApsDataService DataService
@implements IDisposable
@inject MonitorStateService Monitor
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="d-flex justify-space-between align-center mb-6">
    <div class="d-flex align-center">
        <MudText Typo="Typo.h5" Class="fw-bold" Color="Color.Info" Style="font-family: monospace;">>_</MudText>
        <MudText Typo="Typo.h5" Class="fw-bold ml-2">@Ui["Commands"]</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" Class="rounded-lg" OnClick="OpenNewCommandDialog">@Ui["New command"]</MudButton>
</div>

@if (!Monitor.IsMonitoring || Monitor.IsReprogramming)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">@Ui["Start monitoring to send commands to Control."]</MudAlert>
}

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid Class="mb-6">
        @foreach (var cmd in _commands)
        {
            <MudItem xs="12" sm="6" md="4" lg="4">
                <MudPaper Class="pa-4 command-card h-100 d-flex flex-column" Elevation="0">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">@cmd.Nombre</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="command-value-chip">@CommandLabel(cmd)</MudChip>
                    </div>
                    
                    <MudText Typo="Typo.caption" Class="text-muted mb-4 d-block">
                        Confirmation: @(cmd.RequiereConfirmacion ? Ui["Yes"] : Ui["No"]) &middot; Style: @cmd.Estilo
                    </MudText>
                    @if (cmd.FrameType == 0x6A)
                    {
                        <MudText Typo="Typo.body2" Class="mb-3">@VariableLabel(cmd) · Raw value: @cmd.VariableValue</MudText>
                    }
                    @if (cmd.FrameType is not (0x6A or 0x7A))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning" Class="mb-3">@Ui["Edit to configure as a 6A or 7A command."]</MudText>
                    }
                    
                    <div class="mt-auto d-flex align-center gap-3">
                        <MudButton Variant="Variant.Outlined" 
                                   StartIcon="@Icons.Material.Filled.PlayArrow" 
                                   Size="Size.Small" 
                                   Class="exec-btn"
                                   Disabled="@(!CanSend(cmd))"
                                   OnClick="@(() => ExecuteCommand(cmd))">
                            @Ui["Send to Control"]
                        </MudButton>
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Class="text-muted icon-btn" OnClick="@(() => OpenEditCommandDialog(cmd))" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" Class="icon-btn-error" OnClick="@(() => DeleteCommand(cmd))" />
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudPaper Class="log-panel mt-6" Elevation="0">
        <div class="pa-4 border-bottom border-dark">
            <MudText Typo="Typo.subtitle1" Class="fw-bold">@Ui["Execution log"]</MudText>
        </div>
        <div class="pa-4 log-content">
            @if (!_events.Any())
            {
                <MudText Typo="Typo.body2" Class="text-muted">@Ui["No events"]</MudText>
            }
            else
            {
                @foreach(var ev in _events)
                {
                    <div class="log-entry mb-2">
                        <span class="log-time text-muted mr-2">[@ev.Fecha.ToString("HH:mm:ss")]</span>
                        <span class="log-msg">@ev.Mensaje</span>
                        @if(!string.IsNullOrEmpty(ev.Estado))
                        {
                            <span class="log-status ml-2" style="color: @(ev.Estado is "OK" or "ENVIADO" ? "#4caf50" : "#f44336")">[@MonitorLocalization.EventStatus(ev.Estado)]</span>
                        }
                    </div>
                }
            }
        </div>
    </MudPaper>
}

<style>
    .command-card {
        background-color: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
    }
    .command-card:hover {
        border-color: var(--mud-palette-lines-default);
    }
    .command-value-chip {
        border-color: var(--mud-palette-lines-default) !important;
        color: var(--mud-palette-text-primary) !important;
        background-color: var(--mud-palette-background) !important;
        font-family: monospace;
    }
    .text-muted {
        color: var(--mud-palette-text-secondary) !important;
    }
    .exec-btn {
        text-transform: none;
        color: var(--mud-palette-text-primary);
        border-color: var(--mud-palette-lines-default);
        border-radius: 4px;
    }
    .icon-btn {
        color: var(--mud-palette-text-secondary) !important;
    }
    .icon-btn:hover {
        color: var(--mud-palette-text-primary) !important;
    }
    .icon-btn-error:hover {
        background-color: rgba(244, 67, 54, 0.1) !important;
    }
    
    .log-panel {
        background-color: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        min-height: 200px;
    }
    .border-dark {
        border-bottom: 1px solid var(--mud-palette-lines-default) !important;
    }
    .log-content {
        font-family: monospace;
        font-size: 13px;
        max-height: 300px;
        overflow-y: auto;
    }
    .log-msg {
        color: var(--mud-palette-text-primary);
    }
</style>

@code {
    private List<ScadaCommand> _commands = new();
    private List<EventMessage> _events = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _lastCanSend = MonitoringReady;
        Monitor.OnStateChanged += OnMonitorChanged;
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _commands = await DataService.GetCommandsAsync();
        _signals = await DataService.GetSignalsAsync(includeDeleted: true);

        _events = await DataService.GetEventsAsync();
        _isLoading = false;
        StateHasChanged();
    }

    private async Task OpenNewCommandDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CommandDialog>(ApsMonitor.Resources.MonitorResources.Text("New command"), options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadData();
            Snackbar.Add(ApsMonitor.Resources.MonitorResources.Text("Command created successfully"), Severity.Success);
        }
    }

    private async Task OpenEditCommandDialog(ScadaCommand command)
    {
        var parameters = new DialogParameters { ["Command"] = command };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CommandDialog>(ApsMonitor.Resources.MonitorResources.Text("Edit command"), parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadData();
            Snackbar.Add(ApsMonitor.Resources.MonitorResources.Text("Command updated"), Severity.Info);
        }
    }

    private async Task DeleteCommand(ScadaCommand command)
    {
        try
        {
            var result = await DialogService.ShowMessageBoxAsync(
                ApsMonitor.Resources.MonitorResources.Text("Delete"),
                ApsMonitor.Resources.MonitorResources.Format("Delete command '{0}'?",command.Nombre),
                yesText: ApsMonitor.Resources.MonitorResources.Text("Delete"), cancelText: ApsMonitor.Resources.MonitorResources.Text("Cancel"));

            if (result == true)
            {
                await DataService.DeleteCommandAsync(command.Id);
                await LoadData();
            }
        }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private bool _sending, _disposed;
    private bool _lastCanSend;
    private List<Signal> _signals = [];
    private bool MonitoringReady => Monitor.IsConnected && Monitor.IsMonitoring && !Monitor.IsReprogramming;
    private bool CanSend(ScadaCommand command) => !_sending && MonitoringReady && command.FrameType is 0x6A or 0x7A;
    private string CommandLabel(ScadaCommand command) => command.FrameType.HasValue
        ? $"{command.FrameType:X2} · SC {command.Subcommand:X4}" : ApsMonitor.Resources.MonitorResources.Text("Not configured");
    private string VariableLabel(ScadaCommand command) => _signals.FirstOrDefault(s => s.Id == command.SignalId)?.BindingLabel ?? ApsMonitor.Resources.MonitorResources.Text("Variable unavailable");
    private void OnMonitorChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (_lastCanSend == MonitoringReady) return;
            _lastCanSend = MonitoringReady;
            StateHasChanged();
        });
    }

    private async Task ExecuteCommand(ScadaCommand command)
    {
        if (!CanSend(command)) return;
        _sending = true;
        try
        {
            var signal = command.SignalId.HasValue ? await DataService.GetSignalAsync(command.SignalId.Value) : null;
            var frame = ControlCommandProtocol.Build(command, signal);
            string details = CommandLabel(command) + (command.FrameType == 0x6A ? $" · {VariableLabel(command)} = {command.VariableValue} (bruto)" : "");
            if (command.RequiereConfirmacion)
            {
                var confirmed = await DialogService.ShowMessageBoxAsync(ApsMonitor.Resources.MonitorResources.Text("Confirm command to Control"),
                    ApsMonitor.Resources.MonitorResources.Format("{0}: {1}. Send?",command.Nombre,details), yesText: ApsMonitor.Resources.MonitorResources.Text("Send"), cancelText: ApsMonitor.Resources.MonitorResources.Text("Cancel"));
                if (confirmed != true) return;
            }
            // The service rechecks monitoring after waiting for the shared transport.
            bool sent = await Monitor.SendControlCommandAsync(command);
            await DataService.AddEventAsync(new EventMessage
            {
                Fecha = DateTime.Now,
                Mensaje = $"{command.Nombre}: {details}. " + (sent ? ApsMonitor.Resources.MonitorResources.Format("TX {0}. Execution not confirmed.",SepsaProtocolClient.ToHex(frame)) : ApsMonitor.Resources.MonitorResources.Text("Unable to send; check monitoring and the monitor log.")),
                Estado = sent ? "ENVIADO" : "ERROR"
            });
            Snackbar.Add(sent ? ApsMonitor.Resources.MonitorResources.Text("Command sent to Control; execution not confirmed.") : ApsMonitor.Resources.MonitorResources.Text("Unable to send the command to Control."), sent ? Severity.Success : Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally
        {
            _sending = false;
            _events = await DataService.GetEventsAsync();
        }
    }

    public void Dispose() { _disposed = true; Monitor.OnStateChanged -= OnMonitorChanged; }
}
