@page "/comandos"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@using ApsMonitor.Models
@using ApsMonitor.Services
@using ApsMonitor.Components.Dialogs
@inject ApsDataService DataService
@implements IDisposable
@inject MonitorStateService Monitor
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="d-flex justify-space-between align-center mb-6">
    <div class="d-flex align-center">
        <MudText Typo="Typo.h5" Class="fw-bold" Color="Color.Info" Style="font-family: monospace;">>_</MudText>
        <MudText Typo="Typo.h5" Class="fw-bold ml-2">Comandos</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" Class="rounded-lg" OnClick="OpenNewCommandDialog">Nuevo Comando</MudButton>
</div>

@if (!Monitor.IsMonitoring || Monitor.IsReprogramming)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">Active la monitorización para enviar comandos a control.</MudAlert>
}

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid Class="mb-6">
        @foreach (var cmd in _commands)
        {
            <MudItem xs="12" sm="6" md="4" lg="4">
                <MudPaper Class="pa-4 command-card h-100 d-flex flex-column" Elevation="0">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">@cmd.Nombre</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="command-value-chip">@CommandLabel(cmd)</MudChip>
                    </div>
                    
                    <MudText Typo="Typo.caption" Class="text-muted mb-4 d-block">
                        Confirmación: @(cmd.RequiereConfirmacion ? "Sí" : "No") &middot; Estilo: @cmd.Estilo
                    </MudText>
                    @if (cmd.FrameType == 0x6A)
                    {
                        <MudText Typo="Typo.body2" Class="mb-3">@VariableLabel(cmd) · Valor bruto: @cmd.VariableValue</MudText>
                    }
                    @if (cmd.FrameType is not (0x6A or 0x7A))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning" Class="mb-3">Editar para configurar como comando 6A o 7A.</MudText>
                    }
                    
                    <div class="mt-auto d-flex align-center gap-3">
                        <MudButton Variant="Variant.Outlined" 
                                   StartIcon="@Icons.Material.Filled.PlayArrow" 
                                   Size="Size.Small" 
                                   Class="exec-btn"
                                   Disabled="@(!CanSend(cmd))"
                                   OnClick="@(() => ExecuteCommand(cmd))">
                            Enviar a control
                        </MudButton>
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Class="text-muted icon-btn" OnClick="@(() => OpenEditCommandDialog(cmd))" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" Class="icon-btn-error" OnClick="@(() => DeleteCommand(cmd))" />
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudPaper Class="log-panel mt-6" Elevation="0">
        <div class="pa-4 border-bottom border-dark">
            <MudText Typo="Typo.subtitle1" Class="fw-bold">Log de Ejecución</MudText>
        </div>
        <div class="pa-4 log-content">
            @if (!_events.Any())
            {
                <MudText Typo="Typo.body2" Class="text-muted">Sin eventos</MudText>
            }
            else
            {
                @foreach(var ev in _events)
                {
                    <div class="log-entry mb-2">
                        <span class="log-time text-muted mr-2">[@ev.Fecha.ToString("HH:mm:ss")]</span>
                        <span class="log-msg">@ev.Mensaje</span>
                        @if(!string.IsNullOrEmpty(ev.Estado))
                        {
                            <span class="log-status ml-2" style="color: @(ev.Estado is "OK" or "ENVIADO" ? "#4caf50" : "#f44336")">[@ev.Estado]</span>
                        }
                    </div>
                }
            }
        </div>
    </MudPaper>
}

<style>
    .command-card {
        background-color: #1a222c;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 8px;
    }
    .command-card:hover {
        border-color: rgba(255,255,255,0.1);
    }
    .command-value-chip {
        border-color: rgba(255,255,255,0.1) !important;
        color: #e2e8f0 !important;
        background-color: #111827 !important;
        font-family: monospace;
    }
    .text-muted {
        color: #94a3b8 !important;
    }
    .exec-btn {
        text-transform: none;
        color: #e2e8f0;
        border-color: rgba(255,255,255,0.1);
        border-radius: 4px;
    }
    .icon-btn {
        color: #94a3b8 !important;
    }
    .icon-btn:hover {
        color: #e2e8f0 !important;
    }
    .icon-btn-error:hover {
        background-color: rgba(244, 67, 54, 0.1) !important;
    }
    
    .log-panel {
        background-color: #1a222c;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 8px;
        min-height: 200px;
    }
    .border-dark {
        border-bottom: 1px solid rgba(255,255,255,0.05) !important;
    }
    .log-content {
        font-family: monospace;
        font-size: 13px;
        max-height: 300px;
        overflow-y: auto;
    }
    .log-msg {
        color: #e2e8f0;
    }
</style>

@code {
    private List<ScadaCommand> _commands = new();
    private List<EventMessage> _events = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _lastCanSend = MonitoringReady;
        Monitor.OnStateChanged += OnMonitorChanged;
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _commands = await DataService.GetCommandsAsync();
        _signals = await DataService.GetSignalsAsync(includeDeleted: true);

        _events = await DataService.GetEventsAsync();
        _isLoading = false;
        StateHasChanged();
    }

    private async Task OpenNewCommandDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CommandDialog>("Nuevo Comando", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadData();
            Snackbar.Add("Comando creado correctamente", Severity.Success);
        }
    }

    private async Task OpenEditCommandDialog(ScadaCommand command)
    {
        var parameters = new DialogParameters { ["Command"] = command };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CommandDialog>("Editar Comando", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadData();
            Snackbar.Add("Comando modificado", Severity.Info);
        }
    }

    private async Task DeleteCommand(ScadaCommand command)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Eliminar", 
            $"¿Eliminar el comando '{command.Nombre}'?", 
            yesText: "Eliminar", cancelText: "Cancelar");
            
        if (result == true)
        {
            await DataService.DeleteCommandAsync(command.Id);
            await LoadData();
        }
    }

    private bool _sending, _disposed;
    private bool _lastCanSend;
    private List<Signal> _signals = [];
    private bool MonitoringReady => Monitor.IsConnected && Monitor.IsMonitoring && !Monitor.IsReprogramming;
    private bool CanSend(ScadaCommand command) => !_sending && MonitoringReady && command.FrameType is 0x6A or 0x7A;
    private string CommandLabel(ScadaCommand command) => command.FrameType.HasValue
        ? $"{command.FrameType:X2} · SC {command.Subcommand:X4}" : "Sin configurar";
    private string VariableLabel(ScadaCommand command) => _signals.FirstOrDefault(s => s.Id == command.SignalId)?.BindingLabel ?? "Variable no disponible";
    private void OnMonitorChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (_lastCanSend == MonitoringReady) return;
            _lastCanSend = MonitoringReady;
            StateHasChanged();
        });
    }

    private async Task ExecuteCommand(ScadaCommand command)
    {
        if (!CanSend(command)) return;
        _sending = true;
        try
        {
            var signal = command.SignalId.HasValue ? await DataService.GetSignalAsync(command.SignalId.Value) : null;
            var frame = ControlCommandProtocol.Build(command, signal);
            string details = CommandLabel(command) + (command.FrameType == 0x6A ? $" · {VariableLabel(command)} = {command.VariableValue} (bruto)" : "");
            if (command.RequiereConfirmacion)
            {
                var confirmed = await DialogService.ShowMessageBoxAsync("Confirmar envío a control",
                    $"{command.Nombre}: {details}. ¿Enviar?", yesText: "Enviar", cancelText: "Cancelar");
                if (confirmed != true) return;
            }
            // The service rechecks monitoring after waiting for the shared transport.
            bool sent = await Monitor.SendControlCommandAsync(command);
            await DataService.AddEventAsync(new EventMessage
            {
                Fecha = DateTime.Now,
                Mensaje = $"{command.Nombre}: {details}. " + (sent ? $"TX {SepsaProtocolClient.ToHex(frame)}. Sin confirmación de ejecución." : "No se pudo enviar; revise la monitorización y el log del monitor."),
                Estado = sent ? "ENVIADO" : "ERROR"
            });
            Snackbar.Add(sent ? "Comando enviado a control; ejecución no confirmada." : "No se pudo enviar el comando a control.", sent ? Severity.Success : Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally
        {
            _sending = false;
            _events = await DataService.GetEventsAsync();
        }
    }

    public void Dispose() { _disposed = true; Monitor.OnStateChanged -= OnMonitorChanged; }
}
