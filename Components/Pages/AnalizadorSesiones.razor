@page "/analizador-sesiones"
@attribute [Authorize(Policy = "Page:analizador-sesiones")]
@rendermode InteractiveServer
@using System.Text
@inject SessionAnalyzerService Analyzer
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<div class="d-flex justify-space-between align-start mb-5 mt-n2 flex-wrap gap-3">
    <div><MudText Typo="Typo.h5" Class="fw-bold">@Ui["Session analyser"]</MudText><MudText Typo="Typo.body2" Class="text-muted">@Ui["Load a CMFX and one or more DAT files to compare them."]</MudText></div>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Settings" OnClick="OpenCmfx">@Ui["Load CMFX"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle" OnClick="OpenDat" Disabled="@(!_elements.Any())">@Ui["Add DAT"]</MudButton>
    </div>
</div>

<InputFile id="cmfxPicker" OnChange="LoadCmfx" accept=".cmfx" style="display:none" />
<InputFile id="datPicker" OnChange="LoadDat" accept=".dat" multiple style="display:none" />

<MudGrid>
    <MudItem xs="12" lg="7">
        <MudPaper Class="pa-4 analyzer-panel" Elevation="0">
            <div class="d-flex justify-space-between align-center mb-4"><div><MudText Typo="Typo.subtitle1" Class="fw-bold">@Ui["Sessions to analyse"]</MudText><MudText Typo="Typo.caption" Class="text-muted">@(_elements.Any() ? $"CMFX: {_cmfxName} · {_elements.Select(x => x.KeyName).Distinct().Count()} variables" : Ui["Load the CMFX configuration file first."])</MudText></div><MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@Ui["{0} sessions", _sessions.Count]</MudChip></div>
            @if (!_sessions.Any())
            {
                <div class="analyzer-dropzone pa-8 d-flex flex-column align-center"><MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="Color.Primary" Style="font-size:42px" /><MudText Class="mt-2">@Ui["Add DAT files to begin"]</MudText></div>
            }
            else
            {
                @foreach (var session in _sessions)
                {
                    <div class="session-row d-flex align-center gap-3 mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                        <div class="flex-grow-1"><MudText Typo="Typo.body2" Class="fw-bold">@session.Name</MudText><MudText Typo="Typo.caption" Class="text-muted">@session.RangeFrom.ToString("dd/MM HH:mm:ss") — @session.RangeTo.ToString("dd/MM HH:mm:ss") · @session.SelectedKeys.Count variables</MudText></div>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => SelectSession(session))" AriaLabel="@Ui["Configure session"]" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" OnClick="@(() => RemoveSession(session))" AriaLabel="@Ui["Remove session"]" />
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="5">
        <MudPaper Class="pa-4 analyzer-panel h-100" Elevation="0">
            <MudText Typo="Typo.subtitle1" Class="fw-bold">@Ui["Summary"]</MudText><MudDivider Class="my-4" />
            <div class="d-flex justify-space-between mb-2"><span class="text-muted">CMFX</span><span>@(_cmfxName ?? Ui["Not loaded"])</span></div>
            <div class="d-flex justify-space-between mb-2"><span class="text-muted">@Ui["Sessions"]</span><span>@_sessions.Count</span></div>
            <div class="d-flex justify-space-between mb-4"><span class="text-muted">Variables</span><span>@_sessions.Sum(x => x.SelectedKeys.Count)</span></div>
            <MudButton FullWidth Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.QueryStats" Disabled="@(!_sessions.Any() || !_sessions.Any(x => x.SelectedKeys.Any()) || _busy)" OnClick="RunAnalysis">@(_busy ? "Analizando..." : Ui["View chart"])</MudButton>
            <MudButton FullWidth Variant="Variant.Outlined" Class="mt-2" StartIcon="@Icons.Material.Filled.Download" Disabled="@(_result is null || _result.RowCount == 0)" OnClick="ExportCsv">@Ui["Export CSV"]</MudButton>
        </MudPaper>
    </MudItem>

    @if (_editing is not null)
    {
        <MudItem xs="12"><MudPaper Class="pa-4 analyzer-panel"><div class="d-flex justify-space-between align-center"><div><MudText Typo="Typo.subtitle1" Class="fw-bold">Configure @_editing.Name</MudText><MudText Typo="Typo.caption" Class="text-muted">@Ui["The range uses the entire DAT by default. Select variables or digital bits."]</MudText></div><div class="d-flex gap-2"><MudButton Variant="Variant.Text" OnClick="CloseEditor">@Ui["Close"]</MudButton>@if (_result is not null) { <MudButton Variant="Variant.Text" StartIcon="@(_variablesCollapsed ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)" OnClick="ToggleVariablesPanel">@(_variablesCollapsed ? Ui["Show variables"] : Ui["Minimise variables"])</MudButton> }</div></div>
            <MudCollapse Expanded="@(!_variablesCollapsed)">
            <MudDivider Class="my-3" />
            <div class="d-flex gap-4 flex-wrap mb-3"><MudNumericField T="int" Label="@Ui["Time offset (h)"]" @bind-Value="_editing.TimeOffsetHours" Min="-24" Max="24" Style="max-width:220px" /><MudText Typo="Typo.caption" Class="align-self-center text-muted">Current range: @_editing.RangeFrom.ToString("dd/MM/yyyy HH:mm:ss") — @_editing.RangeTo.ToString("dd/MM/yyyy HH:mm:ss")</MudText></div>
            <MudTextField @bind-Value="_filter" Immediate Placeholder="@Ui["Search variable..."]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />
            <div class="d-flex gap-2 mb-2"><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SelectAll">@Ui["Select all"]</MudButton><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearAll">@Ui["Clear all"]</MudButton></div>
            <div class="variables-grid">
                @foreach (var element in FilteredElements())
                {
                    var key = element.KeyName;
                    <div class="variable-row"><MudCheckBox T="bool" Value="@_editing.SelectedKeys.Contains(key)" ValueChanged="@(checkedValue => ToggleKey(key, checkedValue))" Label="@key" />
                    @if (element.BitNames.Any()) { <MudExpansionPanels><MudExpansionPanel Text="@Ui["Digital bits"]"><div class="d-flex flex-wrap gap-2">@foreach (var bit in element.BitNames.OrderBy(x => x.Key)) { var bitIndex = bit.Key; <MudCheckBox T="bool" Value="@IsBitSelected(key, bitIndex)" ValueChanged="@(checkedValue => ToggleBit(key, bitIndex, checkedValue))" Label="@($"{bitIndex}: {bit.Value}")" /> }</div></MudExpansionPanel></MudExpansionPanels> }</div>
                }
            </div>
            </MudCollapse>
        </MudPaper></MudItem>
    }

    <MudItem xs="12"><MudPaper Class="pa-4 analyzer-panel"><MudText Typo="Typo.subtitle1" Class="fw-bold">@Ui["Result"]</MudText><MudText Typo="Typo.caption" Class="text-muted">@Ui["Use the scroll wheel to zoom and the legend to hide series."]</MudText><div id="sessionAnalyzerChart" class="chart-placeholder mt-3 @(_variablesCollapsed && _result is not null ? "chart-expanded" : "")">@if (_result is null) { <div class="chart-empty text-muted">@Ui["The chart will appear here after running the analysis."]</div> }</div></MudPaper></MudItem>
</MudGrid>

<style>
 .analyzer-panel { background:var(--mud-palette-surface); border:1px solid var(--mud-palette-lines-default); border-radius:12px; } .text-muted { color:var(--mud-palette-text-secondary) !important; } .analyzer-dropzone { border:1px dashed rgba(59,130,246,.45); border-radius:10px; } .session-row { border:1px solid var(--mud-palette-lines-default); border-radius:9px; padding:11px 13px; } .variables-grid { max-height:440px; overflow:auto; border:1px solid var(--mud-palette-lines-default); border-radius:8px; padding:8px; } .variable-row { padding:3px 8px; border-bottom:1px solid var(--mud-palette-lines-default); } .chart-placeholder { width:100%; min-height:440px; height:440px; position:relative; } .chart-placeholder.chart-expanded { height:min(70vh, 760px); min-height:560px; } .chart-placeholder .modebar-container { position:absolute !important; top:8px !important; right:12px !important; left:auto !important; } .chart-placeholder .modebar { position:static !important; } .chart-empty { height:100%; display:flex; align-items:center; justify-content:center; }
</style>

@code {
    private readonly List<AnalyzerSession> _sessions = []; private List<AnalyzerValueElement> _elements = []; private AnalyzerSession? _editing; private AnalyzerResult? _result; private string? _cmfxName; private string _filter = ""; private bool _busy; private bool _variablesCollapsed;
    private async Task OpenCmfx() => await JS.InvokeVoidAsync("eval", "document.getElementById('cmfxPicker').click()");
    private async Task OpenDat() => await JS.InvokeVoidAsync("eval", "document.getElementById('datPicker').click()");
    private async Task LoadCmfx(InputFileChangeEventArgs e) { try { using var s=e.File.OpenReadStream(50*1024*1024); using var ms=new MemoryStream(); await s.CopyToAsync(ms); _elements=Analyzer.LoadConfig(ms.ToArray()); _cmfxName=e.File.Name; foreach(var session in _sessions) session.SelectedKeys=_elements.Select(x=>x.KeyName).Distinct().ToList(); Snackbar.Add($"CMFX cargado: {_elements.Select(x=>x.KeyName).Distinct().Count()} variables.", Severity.Success); } catch(Exception ex) { Snackbar.Add(ApsMonitor.Resources.MonitorResources.Format("CMFX error: {0}",ex.Message), Severity.Error); } }
    private async Task LoadDat(InputFileChangeEventArgs e) { foreach(var file in e.GetMultipleFiles(20)) { try { using var s=file.OpenReadStream(300*1024*1024); using var ms=new MemoryStream(); await s.CopyToAsync(ms); var content=ms.ToArray(); var range=Analyzer.GetDateRange(content); _sessions.Add(new AnalyzerSession { Name=file.Name, Content=content, RangeFrom=range.Min, RangeTo=range.Max, SelectedKeys=_elements.Select(x=>x.KeyName).Distinct().ToList() }); } catch(Exception ex) { Snackbar.Add(ApsMonitor.Resources.MonitorResources.Format("Unable to load {0}: {1}",file.Name,ex.Message), Severity.Error); } } }
    private void SelectSession(AnalyzerSession session) { _editing=session; _variablesCollapsed=false; } private void CloseEditor() => _editing=null; private async Task ToggleVariablesPanel() { _variablesCollapsed=!_variablesCollapsed; await InvokeAsync(StateHasChanged); await Task.Delay(50); await JS.InvokeVoidAsync("sessionAnalyzer.resize", "sessionAnalyzerChart"); } private void RemoveSession(AnalyzerSession session) { if(_editing==session) _editing=null; _sessions.Remove(session); }
    private IEnumerable<AnalyzerValueElement> FilteredElements() => _elements.Where(x => string.IsNullOrWhiteSpace(_filter) || x.KeyName.Contains(_filter, StringComparison.OrdinalIgnoreCase));
    private void ToggleKey(string key, bool value) { if(_editing is null)return; if(value) { if(!_editing.SelectedKeys.Contains(key)) _editing.SelectedKeys.Add(key); } else { _editing.SelectedKeys.Remove(key); _editing.DigitalBits.Remove(key); } }
    private bool IsBitSelected(string key, int bit) => _editing?.DigitalBits.TryGetValue(key, out var bits)==true && bits.Contains(bit);
    private void ToggleBit(string key, int bit, bool value) { if(_editing is null)return; if(value) { if(!_editing.SelectedKeys.Contains(key)) _editing.SelectedKeys.Add(key); if(!_editing.DigitalBits.TryGetValue(key,out var bits)) _editing.DigitalBits[key]=bits=[]; if(!bits.Contains(bit))bits.Add(bit); } else if(_editing.DigitalBits.TryGetValue(key,out var bits)) { bits.Remove(bit); if(!bits.Any())_editing.DigitalBits.Remove(key); } }
    private void SelectAll() { if(_editing is not null) _editing.SelectedKeys=_elements.Select(x=>x.KeyName).Distinct().ToList(); } private void ClearAll() { if(_editing is not null) { _editing.SelectedKeys=[]; _editing.DigitalBits=[]; } }
    private async Task RunAnalysis() { _busy=true; try { _result=await Task.Run(()=>Analyzer.Analyze(_sessions,_elements)); if(_result.RowCount==0) { Snackbar.Add(ApsMonitor.Resources.MonitorResources.Text("No data found for the selected ranges."),Severity.Warning); return; } var chartData=_result.Sessions.Select(s=>new { name=s.Name, keys=s.Keys, rows=s.Rows.Select(r=>new { timestamp=r.Timestamp.ToString("yyyy-MM-ddTHH:mm:ss.fff"), values=r.Values }) }); await JS.InvokeVoidAsync("sessionAnalyzer.draw","sessionAnalyzerChart",chartData, new { time = ApsMonitor.Resources.MonitorResources.Text("Time"), value = ApsMonitor.Resources.MonitorResources.Text("Value_Lowercase") }); Snackbar.Add(ApsMonitor.Resources.MonitorResources.Format("Analysis complete: {0:N0} samples.",_result.RowCount),Severity.Success); } catch(Exception ex) { Snackbar.Add(ApsMonitor.Resources.MonitorResources.Format("Analysis failed: {0}",ex.Message),Severity.Error); } finally { _busy=false; } }
    private async Task ExportCsv() { if(_result is null)return; var sb=new StringBuilder(ApsMonitor.Resources.MonitorResources.Text("SessionAnalysisCsvHeader")); foreach(var s in _result.Sessions) foreach(var r in s.Rows) foreach(var v in r.Values) sb.Append('"').Append(s.Name.Replace("\"","\"\"")).Append("\";").Append(r.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")).Append(";\"").Append(v.Key.Replace("\"","\"\"")).Append("\";").Append(v.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)).Append("\r\n"); await JS.InvokeVoidAsync("sessionAnalyzer.download",ApsMonitor.Resources.MonitorResources.Text("session_analysis.csv"),sb.ToString()); }
}
