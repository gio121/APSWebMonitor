@page "/sinoptico/{WindowId:int}"
@using System.Text.Json
@using ApsMonitor.Models
@using ApsMonitor.Services
@inject ApsDataService DataService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject SessionStateService SessionState
@implements IDisposable
@rendermode InteractiveServer

<div class="sinoptico-wrapper ml-n4 mr-n8 mt-n8">
    <div class="editor-header d-flex justify-space-between align-center px-4 py-2">
    <div class="d-flex align-center">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" OnClick="@(() => NavigationManager.NavigateTo("/ventanas"))" />
        <MudText Typo="Typo.h6" Class="fw-bold ml-2">@(_window?.Nombre ?? "Cargando...")</MudText>
        <MudText Typo="Typo.caption" Class="text-muted ml-2 mt-1">(Sinóptico)</MudText>
    </div>
    <div class="d-flex gap-2">
        <MudButton Variant="@(_showGrid ? Variant.Filled : Variant.Outlined)" Color="Color.Info" StartIcon="@Icons.Material.Filled.GridOn" OnClick="ToggleGrid">Rejilla</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSinoptico">Guardar</MudButton>
    </div>
</div>

<div class="editor-container d-flex">
    <!-- LEFT PANEL: ELEMENTS -->
    <div class="sidebar left-sidebar d-flex flex-column pa-2">
        <div class="d-flex gap-2 mb-4 px-2">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="DuplicateSelected" Disabled="@(_selectedElement == null)" Class="flex-grow-1">Duplicar</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="DeleteSelected" Disabled="@(_selectedElement == null)" Class="flex-grow-1">Eliminar</MudButton>
        </div>

        <MudText Typo="Typo.caption" Class="text-muted fw-bold mb-2 px-2 text-uppercase">Elementos</MudText>
        <div class="elements-list">
            @foreach (var type in elementTypes)
            {
                <div class="element-item d-flex align-center px-2 py-1" draggable="true" @ondragstart="@(e => OnDragStartPalette(type))">
                    <MudIcon Icon="@GetIconForType(type)" Size="Size.Small" Color="Color.Info" Class="mr-2" />
                    <MudText Typo="Typo.body2">@type</MudText>
                </div>
            }
        </div>
    </div>

    <!-- CENTER PANEL: CANVAS -->
    <div class="main-canvas-area flex-grow-1">
        <div class="canvas mx-auto mt-4" 
             @onclick="ClearSelection" 
             @onmousemove="OnMouseMoveCanvas" 
             @onmouseup="OnMouseUpCanvas" 
             @onmouseleave="EndAction"
             @ondrop="OnCanvasDrop" 
             @ondragover="OnDragOver" 
             @ondragover:preventDefault>
            @if (_showGrid)
            {
                <div class="grid-background"></div>
            }
            @foreach (var el in _elements)
            {
                <div class="canvas-element @(el == _selectedElement ? "selected" : "")" 
                     style="left: @(el.X)px; top: @(el.Y)px; width: @(el.Width)px; height: @(el.Height)px; transform: rotate(@(el.Rotation)deg);"
                     @onmousedown="@(e => StartMove(e, el))"
                     @onclick="@(e => SelectElement(e, el))" 
                     @onclick:stopPropagation>
                    
                    @if (el == _selectedElement)
                    {
                        <div class="resize-handle" @onmousedown="@(e => StartResize(e, el))" @onmousedown:stopPropagation></div>
                    }

                    @if (el.Type == "Etiqueta")
                    {
                        <div class="element-content label-content d-flex align-center justify-center p-1" 
                             style="color: @el.Color; font-size: @(el.FontSize)px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            @el.Text
                        </div>
                    }
                    else if (el.Type == "Señal")
                    {
                        <div class="element-content signal-content d-flex flex-column" style="border-color: @(el.Color + "44"); color: @el.Color;">
                            <span class="signal-name" style="font-size: @(Math.Round(el.FontSize * 0.7))px;">@el.Text</span>
                            <span class="signal-value fw-bold" style="font-size: @(el.FontSize)px; font-variant-numeric: tabular-nums;">
                                @GetSignalValueText(el.SignalId)
                            </span>
                        </div>
                    }
                    else if (el.Type == "Comando")
                    {
                        <div class="element-content command-content d-flex align-center justify-center" style="border-color: @el.Color; color: @el.Color;">
                            @el.Text
                        </div>
                    }
                    else if (el.Type == "Caja")
                    {
                        <div class="element-content box-content d-flex align-center justify-center shadow-sm" 
                             style="border-color: @el.Color; color: #111827; background-color: #f0f4f8; font-weight: 500;">
                            @el.Text
                        </div>
                    }
                    else if (el.Type == "Linea H" || el.Type == "Linea V")
                    {
                        <div class="element-content line-content" style="background-color: @el.Color;"></div>
                    }
                    else
                    {
                        <div class="element-content icon-content">
                            @((MarkupString)GetIconMarkup(el))
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- RIGHT PANEL: PROPERTIES -->
    <div class="sidebar right-sidebar pa-4">
        <MudText Typo="Typo.caption" Class="text-muted fw-bold mb-4 d-block text-uppercase">Propiedades</MudText>
        
        @if (_selectedElement != null)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-4 text-info">@_selectedElement.Type</MudText>

            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_selectedElement.X" Label="X" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_selectedElement.Y" Label="Y" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_selectedElement.Width" Label="Ancho" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_selectedElement.Height" Label="Alto" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_selectedElement.ProportionalScale" Label="Escala Proporcional" Color="Color.Primary" Dense="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudNumericField @bind-Value="_selectedElement.Rotation" Label="Rotación" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudColorPicker Label="Color" @bind-Text="_selectedElement.Color" Style="@($"color: {_selectedElement.Color};")" Variant="Variant.Outlined" Margin="Margin.Dense" DisableAlpha="true" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="text-muted fw-bold d-block text-uppercase mb-2">Organizar</MudText>
                    <div class="d-flex gap-2">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.VerticalAlignTop" Size="Size.Small" OnClick="BringToFront" Class="flex-grow-1">Traer al frente</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.VerticalAlignBottom" Size="Size.Small" OnClick="SendToBack" Class="flex-grow-1">Enviar al fondo</MudButton>
                    </div>
                </MudItem>
                
                @if (_selectedElement.Type == "Etiqueta" || _selectedElement.Type == "Señal")
                {
                    <MudItem xs="12">
                        <MudAutocomplete T="Signal" 
                                         Label="Señal vinculada" 
                                         Value="@(_availableSignals.FirstOrDefault(s => s.Id == _selectedElement.SignalId))"
                                         SearchFunc="@SearchSignals"
                                         ToStringFunc="@(s => s == null ? null : $"{s.Tag} (Nodo {s.NodoNumero})")"
                                         ValueChanged="@(s => OnSignalSelected(s?.Id))"
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         Dense="true"
                                         Clearable="true"
                                         MaxItems="1000"
                                         Placeholder="Buscar señal..." />
                    </MudItem>
                }

                @if (_selectedElement.Type == "Contactor" || _selectedElement.Type == "Contactor V")
                {
                    <MudItem xs="12">
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.caption" Class="text-muted fw-bold d-block text-uppercase mb-2">Estado</MudText>
                        <MudAutocomplete T="Signal" 
                                         Label="Señal de Estado" 
                                         Value="@(_availableSignals.FirstOrDefault(s => s.Id == _selectedElement.StateSignalId))"
                                         SearchFunc="@SearchSignals"
                                         ToStringFunc="@(s => s == null ? null : $"{s.Tag} (Nodo {s.NodoNumero})")"
                                         ValueChanged="@(s => _selectedElement.StateSignalId = s?.Id)"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" MaxItems="1000" />
                        <MudSelect T="int?" Label="Bit de Estado" @bind-Value="_selectedElement.StateSignalBit" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="mt-2">
                            <MudSelectItem Value="@((int?)null)">Ninguno</MudSelectItem>
                            @{
                                var stateSig = _availableSignals.FirstOrDefault(s => s.Id == _selectedElement.StateSignalId);
                                int stateBits = stateSig?.BitCount ?? 16;
                            }
                            @for (int i = 0; i < stateBits; i++)
                            {
                                int bit = i;
                                <MudSelectItem Value="@((int?)bit)">Bit @bit</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.caption" Class="text-muted fw-bold d-block text-uppercase mb-2">Comando</MudText>
                        <MudAutocomplete T="Signal" 
                                         Label="Señal de Comando" 
                                         Value="@(_availableSignals.FirstOrDefault(s => s.Id == _selectedElement.CommandSignalId))"
                                         SearchFunc="@SearchSignals"
                                         ToStringFunc="@(s => s == null ? null : $"{s.Tag} (Nodo {s.NodoNumero})")"
                                         ValueChanged="@(s => _selectedElement.CommandSignalId = s?.Id)"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" MaxItems="1000" />
                        <MudSelect T="int?" Label="Bit de Comando" @bind-Value="_selectedElement.CommandSignalBit" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="mt-2">
                            <MudSelectItem Value="@((int?)null)">Ninguno</MudSelectItem>
                            @{
                                var cmdSig = _availableSignals.FirstOrDefault(s => s.Id == _selectedElement.CommandSignalId);
                                int cmdBits = cmdSig?.BitCount ?? 16;
                            }
                            @for (int i = 0; i < cmdBits; i++)
                            {
                                int bit = i;
                                <MudSelectItem Value="@((int?)bit)">Bit @bit</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudDivider Class="my-2" />
                        <MudColorPicker Label="Color de Fallo" @bind-Text="_selectedElement.ErrorColor" Style="@($"color: {_selectedElement.ErrorColor};")" Variant="Variant.Outlined" Margin="Margin.Dense" DisableAlpha="true" />
                    </MudItem>
                }
                
                @if (_selectedElement.Type == "Etiqueta" || _selectedElement.Type == "Señal" || _selectedElement.Type == "Comando" || _selectedElement.Type == "Caja")
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_selectedElement.Text" Label="Etiqueta" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudNumericField @bind-Value="_selectedElement.FontSize" Label="Tamaño de Fuente" Variant="Variant.Outlined" Margin="Margin.Dense" Min="6" Max="100" />
                    </MudItem>
                }
                
                @if (_selectedElement.Type == "Comando")
                {
                    <MudItem xs="12">
                        <MudSelect T="string" Label="Comando a enviar" 
                                   Value="@_selectedElement.CommandValue" 
                                   ValueChanged="OnCommandSelected"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Dense="true">
                            @foreach (var cmd in _availableCommands)
                            {
                                <MudSelectItem Value="@cmd.CommandValue">@cmd.Nombre (@cmd.Tipo)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="text-muted">Seleccione un elemento</MudText>
        }
    </div>
</div>
</div>

<style>
    .sinoptico-wrapper {
        height: calc(100vh - 96px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .resize-handle {
        position: absolute;
        width: 12px;
        height: 12px;
        background-color: #594ae2;
        bottom: -6px;
        right: -6px;
        cursor: nwse-resize;
        z-index: 100;
        border: 2px solid #fff;
        border-radius: 2px;
        box-shadow: 0 0 4px rgba(0,0,0,0.5);
    }
    .resize-handle:hover {
        background-color: #7e6fff;
        transform: scale(1.2);
    }
    .editor-header {
        border-bottom: 1px solid rgba(255,255,255,0.05);
        background-color: #151921;
        height: 60px;
        flex-shrink: 0;
    }
    .editor-container {
        flex-grow: 1;
        background-color: #0f1218;
        overflow: hidden;
    }
    .sidebar {
        background-color: #19212d;
        width: 260px;
        border-right: 1px solid rgba(255,255,255,0.05);
        overflow-y: auto;
    }
    .right-sidebar {
        border-right: none;
        border-left: 1px solid rgba(255,255,255,0.05);
    }
    .main-canvas-area {
        position: relative;
        overflow: auto;
    }
    .canvas {
        min-width: 150%;
        min-height: 150%;
        background-color: transparent;
        position: relative;
    }
    .grid-background {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        pointer-events: none;
        background-size: 20px 20px;
        background-image: 
            linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    }
    .element-item {
        cursor: grab;
        border-radius: 4px;
    }
    .element-item:hover {
        background-color: rgba(255,255,255,0.05);
    }
    
    /* Elements on Canvas */
    .canvas-element {
        position: absolute;
        cursor: grab;
        user-select: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .canvas-element:active {
        cursor: grabbing;
    }
    .canvas-element.selected {
        outline: 2px solid var(--mud-palette-info);
    }
    
    .element-content {
        width: 100%;
        height: 100%;
    }
    .label-content {
        color: #e2e8f0;
        text-align: center;
        line-height: 1;
    }
    .signal-content {
        background-color: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 4px;
        padding: 8px;
        color: #e2e8f0;
    }
    .signal-name {
        font-size: 10px;
        color: #94a3b8;
    }
    .signal-value {
        font-size: 16px;
    }
    .icon-content {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }
    .icon-content svg {
        width: 100% !important;
        height: 100% !important;
    }
    .line-content {
        background-color: var(--mud-palette-warning);
        width: 100%;
        height: 100%;
    }
    .command-content {
        background-color: #0d1a10;
        border: 1px solid #2e7d32;
        border-radius: 6px;
        color: #4caf50;
        font-weight: 500;
        font-size: 14px;
        text-align: center;
        padding: 4px;
    }
    .box-content {
        background-color: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 4px;
        color: #e2e8f0;
        font-size: 14px;
        text-align: center;
        padding: 4px;
        overflow: hidden;
    }
    
    .op-10 { opacity: 0.1; }
</style>

@code {
    [Parameter] public int WindowId { get; set; }
    
    private Window? _window;
    private List<Signal> _availableSignals = new();
    private List<ScadaCommand> _availableCommands = new();
    private List<SinopticoElement> _elements = new();
    private SinopticoElement? _selectedElement;
    
    private bool _showGrid = true;
    
    private string[] elementTypes = { "Etiqueta", "Señal", "Comando", "Caja", "Linea H", "Linea V", "Diodo", "Dotline", "Resistencia", "Bobina", "Descargador", "Transformador", "Fusible", "Interruptor", "Seccionador", "Contactor", "Contactor V", "Borne", "Rectificador", "Inversor", "Convertidor", "Trifasico", "Ventilador", "Condensador" };
    
    // Resize/Move state
    private bool _isResizing;
    private bool _isMoving;
    private SinopticoElement? _activeElement;
    private double _startX, _startY;
    private double _startWidth, _startHeight;
    private double _startElX, _startElY;
    private double _startAspectRatio;

    // Drag state (Palette)
    private string _draggedType = "";
    private SinopticoElement? _draggedElement;
    private double _dragOffsetX;
    private double _dragOffsetY;

    protected override async Task OnInitializedAsync()
    {
        var allWindows = await DataService.GetWindowsAsync();
        _window = allWindows.FirstOrDefault(w => w.Id == WindowId);
        _availableSignals = await DataService.GetSignalsAsync();
        _availableCommands = await DataService.GetCommandsAsync();
        
        if (_window != null && !string.IsNullOrWhiteSpace(_window.ContentJson))
        {
            try
            {
                _elements = JsonSerializer.Deserialize<List<SinopticoElement>>(_window.ContentJson) ?? new();
            }
            catch
            {
                _elements = new();
            }
        }
        
        SessionState.OnStateChanged += SyncValues;
    }

    private void SyncValues()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetSignalValueText(int? signalId)
    {
        if (!SessionState.IsLoaded || !signalId.HasValue) return "--";

        var values = SessionState.GetCurrentValues();
        if (values.TryGetValue(signalId.Value, out double val))
        {
            var sig = _availableSignals.FirstOrDefault(s => s.Id == signalId.Value);
            if (sig != null)
            {
                if (sig.IsAscii)
                {
                    return ((char)Math.Max(0, Math.Min(255, val))).ToString();
                }
                if (sig.BitCount > 1 && sig.BitTextoActivo.Any(t => !string.IsNullOrEmpty(t)))
                {
                    var activeBits = new List<string>();
                    int intVal = (int)val;
                    for (int i = 0; i < 16; i++)
                    {
                        if ((intVal & (1 << i)) != 0 && !string.IsNullOrEmpty(sig.BitTextoActivo[i]))
                        {
                            activeBits.Add(sig.BitTextoActivo[i]!);
                        }
                    }
                    return activeBits.Count > 0 ? string.Join(", ", activeBits) : "0 (Todo OK)";
                }
                
                return val.ToString(sig.Formato) + (string.IsNullOrWhiteSpace(sig.Unidad) ? "" : $" {sig.Unidad}");
            }
            return val.ToString("0.00");
        }
        return "--";
    }

    public void Dispose()
    {
        SessionState.OnStateChanged -= SyncValues;
    }

    private string GetIconForType(string type) => SinopticoIconProvider.GetIcon(type);

    private void ToggleGrid() => _showGrid = !_showGrid;

    private async Task OnSignalSelected(int? signalId)
    {
        if (_selectedElement == null) return;
        
        _selectedElement.SignalId = signalId;
        
        if (signalId.HasValue)
        {
            var signal = _availableSignals.FirstOrDefault(s => s.Id == signalId.Value);
            if (signal != null)
            {
                if (_selectedElement.Type == "Etiqueta" || _selectedElement.Type == "Señal")
                {
                    _selectedElement.Text = signal.Nombre;
                }
            }
        }
    }

    private async Task OnCommandSelected(string commandValue)
    {
        if (_selectedElement == null) return;
        _selectedElement.CommandValue = commandValue;
        
        var cmd = _availableCommands.FirstOrDefault(c => c.CommandValue == commandValue);
        if (cmd != null)
        {
            if (_selectedElement.Text == "Comando" || string.IsNullOrWhiteSpace(_selectedElement.Text))
            {
                _selectedElement.Text = cmd.Nombre;
            }
        }
    }

    private async Task<IEnumerable<Signal>> SearchSignals(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return _availableSignals;

        return _availableSignals.Where(x => 
            x.Nombre.Contains(value, StringComparison.InvariantCultureIgnoreCase) || 
            x.Tag.Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
            x.NodoNumero.ToString() == value ||
            (x.NodoDescripcion?.Contains(value, StringComparison.InvariantCultureIgnoreCase) ?? false));
    }
    
    private void ClearSelection() => _selectedElement = null;
    
    private void SelectElement(MouseEventArgs e, SinopticoElement el) => _selectedElement = el;

    private void OnDragStartPalette(string type)
    {
        _draggedType = type;
    }
    
    private void OnDragOver(DragEventArgs e) { } // Needed to allow drop

    private void OnCanvasDrop(DragEventArgs e)
    {
        // Snap to grid (20px)
        double snap = 20;
        double x = Math.Round(e.OffsetX / snap) * snap;
        double y = Math.Round(e.OffsetY / snap) * snap;

        if (!string.IsNullOrEmpty(_draggedType))
        {
            // Drop from palette
            var newEl = new SinopticoElement 
            { 
                Type = _draggedType, 
                X = x, 
                Y = y,
                Text = _draggedType == "Etiqueta" || _draggedType == "Señal" ? _draggedType : ""
            };
            
            // Default sizes based on type
            if (_draggedType == "Señal") { newEl.Width = 160; newEl.Height = 60; }
            else if (_draggedType.Contains("Linea")) { newEl.Width = (_draggedType == "Linea H") ? 100 : 4; newEl.Height = (_draggedType == "Linea V") ? 100 : 4; }
            else if (_draggedType == "Contactor V") { newEl.Width = 30; newEl.Height = 60; }
            else { newEl.Width = 60; newEl.Height = 30; }

            _elements.Add(newEl);
            _selectedElement = newEl;
            _draggedType = "";
        }
    }

    private void StartMove(MouseEventArgs e, SinopticoElement el)
    {
        _isMoving = true;
        _activeElement = el;
        _startX = e.ClientX;
        _startY = e.ClientY;
        _startElX = el.X;
        _startElY = el.Y;
        _selectedElement = el;
    }

    private void StartResize(MouseEventArgs e, SinopticoElement el)
    {
        _isResizing = true;
        _activeElement = el;
        _startX = e.ClientX;
        _startY = e.ClientY;
        _startWidth = el.Width;
        _startHeight = el.Height;
        _startAspectRatio = el.Height > 0 ? el.Width / el.Height : 1;
    }

    private void OnMouseMoveCanvas(MouseEventArgs e)
    {
        if (_activeElement == null) return;
        
        double snap = 1;
        double deltaX = e.ClientX - _startX;
        double deltaY = e.ClientY - _startY;

        if (_isResizing)
        {
            double newWidth = _startWidth + deltaX;
            double newHeight = _startHeight + deltaY;
            
            if (_activeElement.ProportionalScale)
            {
                // Prioritize Width for delta calculation
                newWidth = Math.Max(10, Math.Round(newWidth / snap) * snap);
                newHeight = newWidth / _startAspectRatio;
            }
            else
            {
                newWidth = Math.Max(10, Math.Round(newWidth / snap) * snap);
                newHeight = Math.Max(10, Math.Round(newHeight / snap) * snap);
            }

            _activeElement.Width = newWidth;
            _activeElement.Height = newHeight;
            StateHasChanged();
        }
        else if (_isMoving)
        {
            double newX = _startElX + deltaX;
            double newY = _startElY + deltaY;
            
            _activeElement.X = Math.Round(newX / snap) * snap;
            _activeElement.Y = Math.Round(newY / snap) * snap;
            
            StateHasChanged();
        }
    }

    private void OnMouseUpCanvas(MouseEventArgs e)
    {
        EndAction();
    }

    private void EndAction()
    {
        _isResizing = false;
        _isMoving = false;
        _activeElement = null;
    }

    private string GetIconMarkup(SinopticoElement el)
    {
        var icon = SinopticoIconProvider.GetIcon(el.Type);
        var color = el.Color;
        
        if (string.IsNullOrEmpty(icon)) return "";

        if (icon.StartsWith("<svg"))
        {
            var svg = icon.Replace("<svg", "<svg width='100%' height='100%' preserveAspectRatio='none' style='display: block;'");
            return svg.Replace("currentColor", color).Replace("#000000", color);
        }
        else if (icon.StartsWith("<path"))
        {
            return $"<svg viewBox='0 0 24 24' width='100%' height='100%' preserveAspectRatio='none' style='display: block;'><g fill='{color}'>{icon}</g></svg>";
        }
        else
        {
            return $"<svg viewBox='0 0 24 24' width='100%' height='100%' preserveAspectRatio='none' style='display: block;'><path d='{icon}' fill='{color}' /></svg>";
        }
    }

    private void DuplicateSelected()
    {
        if (_selectedElement != null)
        {
            var dupe = new SinopticoElement
            {
                Type = _selectedElement.Type,
                X = _selectedElement.X + 20,
                Y = _selectedElement.Y + 20,
                Width = _selectedElement.Width,
                Height = _selectedElement.Height,
                Rotation = _selectedElement.Rotation,
                Text = _selectedElement.Text,
                FontSize = _selectedElement.FontSize,
                SignalId = _selectedElement.SignalId,
                Color = _selectedElement.Color,
                CommandValue = _selectedElement.CommandValue,
                CommandSignalId = _selectedElement.CommandSignalId,
                CommandSignalBit = _selectedElement.CommandSignalBit,
                StateSignalId = _selectedElement.StateSignalId,
                StateSignalBit = _selectedElement.StateSignalBit,
                ErrorColor = _selectedElement.ErrorColor
            };
            _elements.Add(dupe);
            _selectedElement = dupe;
        }
    }

    private void BringToFront()
    {
        if (_selectedElement != null)
        {
            _elements.Remove(_selectedElement);
            _elements.Add(_selectedElement);
            StateHasChanged();
        }
    }

    private void SendToBack()
    {
        if (_selectedElement != null)
        {
            _elements.Remove(_selectedElement);
            _elements.Insert(0, _selectedElement);
            StateHasChanged();
        }
    }

    private void DeleteSelected()
    {
        if (_selectedElement != null)
        {
            _elements.Remove(_selectedElement);
            _selectedElement = null;
        }
    }

    private async Task SaveSinoptico()
    {
        if (_window != null)
        {
            _window.ContentJson = JsonSerializer.Serialize(_elements);
            await DataService.UpdateWindowAsync(_window);
            Snackbar.Add("Sinóptico guardado correctamente", Severity.Success);
        }
    }
}
