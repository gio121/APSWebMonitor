@page "/logs"
@attribute [Authorize(Policy = "Page:logs")]
@rendermode InteractiveServer
@using System.Text
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject MonitorStateService MonitorState
@inject IDialogService DialogService
@implements IDisposable

<div class="d-flex justify-space-between align-center mb-6">
    <div>
        <MudText Typo="Typo.h5" Class="fw-bold">Logs</MudText>
        <MudText Typo="Typo.body2" Class="text-muted">@Ui["APS system records from a log file"]</MudText>
    </div>
    <div class="d-flex gap-2 align-center">
        <MudButton Variant="Variant.Outlined"
                   Color="@(MonitorState.UseTls ? Color.Success : Color.Default)"
                   StartIcon="@(MonitorState.UseTls ? Icons.Material.Filled.EnhancedEncryption : Icons.Material.Filled.SettingsEthernet)"
                   OnClick="OpenTlsSettingsDialogAsync">
            @MonitorState.TlsSecurity.ModeDisplayName
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetrieveAsync" Disabled="@(_isLoading || string.IsNullOrWhiteSpace(MonitorState.IpAddress))">@Ui["Download from APS"]</MudButton>
        <label class="log-file-button">@Ui["Open file"]<InputFile OnChange="OpenLogsAsync" disabled="@_isLoading" aria-label="@Ui["Open log file"]" /></label>
        <MudButton OnClick="ExportCsvAsync" Disabled="@(_isLoading || _filteredEvents.Count == 0)">@Ui["Export CSV"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadAsync" Disabled="@(_originalBytes is null || _isLoading)">@Ui["Download original"]</MudButton>
    </div>
</div>
<MudText Typo="Typo.caption" Class="mb-3">
    Equipo monitorizado: @MonitorState.IpAddress · @(MonitorState.UseTls ? $"HTTPS mTLS {MonitorState.TlsSecurity.LogGatewayTlsPort} / TLS {ApsLogClient.Port}" : $"TCP {ApsLogClient.Port}")
</MudText>
<MudPaper Class="filter-panel pa-4 mb-5" Elevation="0">
    <MudText Typo="Typo.subtitle2" Class="filter-heading mb-3">@Ui["RECORD FILTERS"]</MudText>
    <MudGrid>
        <MudItem xs="12" md="8"><MudTextField @bind-Value="_searchText" @bind-Value:after="ApplyFilters" Immediate="true" Label="@Ui["Search records"]" Placeholder="@Ui["Date, device, process, PID or message..."]" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" /></MudItem>
        <MudItem xs="12" md="4"><MudSelect T="string" @bind-Value="_process" @bind-Value:after="ApplyFilters" Label="@Ui["Process"]" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem T="string" Value="@string.Empty">@Ui["All"]</MudSelectItem>@foreach (var process in _processes) { <MudSelectItem T="string" Value="@process">@process</MudSelectItem> }</MudSelect></MudItem>
    </MudGrid>
    <MudGrid>
        <MudItem xs="12" md="6"><MudDatePicker @bind-Date="_startDate" @bind-Date:after="ApplyFilters" Label="@Ui["Start date"]" Clearable="true" /></MudItem>
        <MudItem xs="12" md="6"><MudDatePicker @bind-Date="_endDate" @bind-Date:after="ApplyFilters" Label="@Ui["End date"]" Clearable="true" /></MudItem>
    </MudGrid>
    @if (_startDate.HasValue || _endDate.HasValue)
    {
        <MudText Typo="Typo.caption">@Ui["Records without a complete date remain in the results."]</MudText>
    }
    @if (HasActiveFilters) { <MudButton OnClick="ClearFilters">@Ui["Clear filters"]</MudButton> }
</MudPaper>
<MudPaper Class="event-log-panel" Elevation="0">
    <div class="event-log-header px-4 py-3 d-flex justify-space-between align-center">
        <MudText Typo="Typo.subtitle2">@_fileName</MudText>
        <MudText Typo="Typo.caption">@Ui["{0} of {1} records", _filteredEvents.Count, _events.Count]</MudText>
    </div>
    @if (_isLoading)
    { <div class="pa-8 d-flex justify-center"><MudProgressCircular Indeterminate="true" /></div> }
    else if (_filteredEvents.Count == 0)
    { <div class="event-empty"><MudText>@Ui["No records to display"]</MudText><MudText>@Ui["Open an APS log file or change the filters."]</MudText></div> }
    else
    {
        <MudTable @ref="_table" Items="_filteredEvents" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="event-table" RowsPerPage="50">
            <HeaderContent><MudTh>@Ui["DATE AND TIME_Text"]</MudTh><MudTh>@Ui["DEVICE_Text"]</MudTh><MudTh>@Ui["PROCESS_Text"]</MudTh><MudTh>PID</MudTh><MudTh>@Ui["MESSAGE_Text"]</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Ui["Date and time"]" Class="event-date">@context.Timestamp</MudTd>
                <MudTd DataLabel="@Ui["Device"]">@context.Host</MudTd>
                <MudTd DataLabel="@Ui["Process"]">@if (context.Process.Length > 0) { <span class="process-tag">@context.Process</span> }</MudTd>
                <MudTd DataLabel="PID">@context.Pid</MudTd>
                <MudTd DataLabel="@Ui["Message"]" Class="event-description">@context.Message</MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager InfoFormat="@Ui["{first_item}-{last_item} of {all_items}"]" PageSizeOptions="@(new[] { 25, 50, 100 })" RowsPerPageString="Records per page" /></PagerContent>
        </MudTable>
    }
</MudPaper>
<style>
    .event-heading-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; color: #60a5fa; background: rgba(59,130,246,.13); border: 1px solid rgba(96,165,250,.2); border-radius: 10px; }
    .text-muted { color: var(--mud-palette-text-secondary) !important; }
    .filter-panel, .event-log-panel { background: var(--mud-palette-surface); border: 1px solid var(--mud-palette-lines-default); border-radius: 10px; }
    .filter-heading { color: var(--mud-palette-text-secondary); font-size: .7rem; font-weight: 700; letter-spacing: 1.2px; }
    .event-log-header { border-bottom: 1px solid var(--mud-palette-lines-default); background: rgba(0,0,0,.12); border-radius: 10px 10px 0 0; }
    .event-table { background: transparent; }
    .event-table .mud-table-head .mud-table-cell { background: var(--mud-palette-background); color: var(--mud-palette-text-secondary); font-size: .68rem; font-weight: 700; letter-spacing: .8px; border-color: var(--mud-palette-lines-default); }
    .event-table .mud-table-cell { border-color: var(--mud-palette-lines-default); padding-top: 13px; padding-bottom: 13px; }
    .event-date, .event-time { color: var(--mud-palette-text-primary); font-family: Consolas, 'Courier New', monospace; font-size: .78rem; white-space: nowrap; }
    .event-time { color: #64748b; }
    .event-description { color: var(--mud-palette-text-primary); }
    .process-tag { color: #93c5fd; background: rgba(59,130,246,.1); border: 1px solid rgba(59,130,246,.14); border-radius: 4px; padding: 3px 7px; font-family: Consolas, 'Courier New', monospace; font-size: .7rem; white-space: nowrap; }
    .event-empty { min-height: 310px; color: #475569; display: flex; flex-direction: column; align-items: center; justify-content: center; }
</style>
<style>
    .log-file-button { position: relative; display: inline-flex; align-items: center; padding: 6px 16px; border: 1px solid currentColor; border-radius: 4px; cursor: pointer; }
    .log-file-button input { position: absolute; inset: 0; width: 100%; opacity: 0; cursor: pointer; }
    .log-file-button:focus-within { outline: 2px solid #60a5fa; }
    .event-description { white-space: pre-wrap; overflow-wrap: anywhere; }
</style>

@code {
    private List<SyslogEntry> _events = new();
    private List<SyslogEntry> _filteredEvents = new();
    private List<string> _processes = new();
    private string _searchText = string.Empty;
    private string _process = string.Empty;
    private string _fileName = ApsMonitor.Resources.MonitorResources.Text("No file");
    private byte[]? _originalBytes;
    private bool _isLoading;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private MudTable<SyslogEntry>? _table;
    private readonly CancellationTokenSource _lifetime = new();
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_searchText) || !string.IsNullOrEmpty(_process) || _startDate.HasValue || _endDate.HasValue;

    protected override void OnInitialized()
    {
        MonitorState.OnStateChanged += OnStateChanged;
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OpenTlsSettingsDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<TlsSettingsDialog>("Seguridad de Comunicaciones", options);
    }

    private async Task RetrieveAsync()
    {
        if (_isLoading) return;
        _isLoading = true;
        var ip = MonitorState.IpAddress;
        try
        {
            var bytes = await ApsLogClient.DownloadAsync(ip, _lifetime.Token, MonitorState.TlsSecurity);
            await LoadBytesAsync(bytes, $"LOG_unknown_carNum_APS_L1_{DateTime.Now:MM-dd-yyyy_HH-mm-ss}.log");
            Snackbar.Add(ApsMonitor.Resources.MonitorResources.Text("Log downloaded from APS."), Severity.Success);
        }
        catch (OperationCanceledException) when (!_lifetime.IsCancellationRequested)
        { Snackbar.Add($"Tiempo de espera agotado al descargar de {ip}.", Severity.Error); }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        { Snackbar.Add($"No se pudo descargar de {ip}: {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task LoadBytesAsync(byte[] bytes, string fileName)
    {
        using var buffer = new MemoryStream(bytes);
        using var reader = new StreamReader(buffer, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
        var entries = SyslogParser.Parse(await reader.ReadToEndAsync());
        _events = entries;
        _originalBytes = bytes;
        _fileName = fileName;
        _processes = entries.Select(e => e.Process).Where(p => p.Length > 0).Distinct().OrderBy(p => p).ToList();
        ClearFilters();
    }

    private async Task OpenLogsAsync(InputFileChangeEventArgs args)
    {
        _isLoading = true;
        try
        {
            await using var stream = args.File.OpenReadStream(ApsLogClient.MaxFileBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var bytes = buffer.ToArray();
            await LoadBytesAsync(bytes, args.File.Name);
            Snackbar.Add(ApsMonitor.Resources.MonitorResources.Format("File loaded: {0} records.",_events.Count), Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add(ApsMonitor.Resources.MonitorResources.Text("Unable to open the file. Check that it is a text file no larger than 50 MB."), Severity.Error);
        }
        finally { _isLoading = false; }
    }

    private void ApplyFilters()
    {
        var query = _events.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchText))
            query = query.Where(e => e.RawLine.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(_process)) query = query.Where(e => e.Process == _process);
        query = query.Where(e => SyslogParser.MatchesDateRange(e, _startDate, _endDate));
        _filteredEvents = query.ToList();
        _table?.NavigateTo(0);
    }

    private void ClearFilters() { _searchText = string.Empty; _process = string.Empty; _startDate = null; _endDate = null; ApplyFilters(); }

    private async Task ExportCsvAsync()
    {
        var csv = new StringBuilder("Date and time,Equipo,Proceso,PID,Mensaje\r\n");
        foreach (var entry in _filteredEvents)
            csv.AppendLine(string.Join(",", new[] { entry.Timestamp, entry.Host, entry.Process, entry.Pid, entry.Message }.Select(Csv)));
        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csv.ToString())).ToArray();
        await JS.InvokeVoidAsync("apsMonitor.downloadBase64File", Path.GetFileNameWithoutExtension(_fileName) + ".csv", "text/csv;charset=utf-8", Convert.ToBase64String(bytes));
    }

    private static string Csv(string value) => "\"" + value.Replace("\"", "\"\"") + "\"";

    public void Dispose()
    {
        MonitorState.OnStateChanged -= OnStateChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private async Task DownloadAsync()
    {
        if (_originalBytes is null) return;
        await JS.InvokeVoidAsync("apsMonitor.downloadBase64File", _fileName, "text/plain", Convert.ToBase64String(_originalBytes));
    }
}
