    private void ToggleEndianSwap()
    {
        _enableEndianSwap = !_enableEndianSwap;

        if (IsSnifferMode && SnifferService.IsCapturing)
        {
            TrdpDataset? dsDef = null;
            _activeSessionConfig?.CommsDatasets.TryGetValue(_selectedDatasetName, out dsDef);
            SnifferService.UpdateFilter(
                _snifferFilterByComId ? _selectedComId : 0,
                _snifferFilterByComId ? (_selectedFrameOption?.Ip ?? "") : "",
                _selectedDatasetName,
                dsDef,
                _enableEndianSwap);
        }

        if (_latestFrame != null && _activeSessionConfig != null &&
            _activeSessionConfig.CommsDatasets.TryGetValue(_selectedDatasetName, out var ds))
        {
            var rawBytes = GetRawPayload();
            if (rawBytes.Length > 0)
            {
                _latestFrame.Parsed = TrdpPcapParserService.DecodeParsedPayload(rawBytes, ds, _enableEndianSwap);
                ProcessParsedPayload(_latestFrame);
            }
        }
        else if (IsPcapMode && CurrentCapturedFrame != null)
        {
            DisplayCurrentPcapFrame();
        }

        var orderDesc = _enableEndianSwap ? "Little-Endian (Invertido)" : "Big-Endian (Estándar TRDP IEC 61375)";
        Snackbar.Add($"Orden de byte cambiado a: {orderDesc}", Severity.Info);
        StateHasChanged();
    }

    private void HandleFrameReceived(TrdpFrameMessage frame)
    {
        if (_disposed) return;

        _latestFrame = frame;
        _lastFrameTime = DateTime.Now;

        // Throttling: en streaming continuo en vivo (sniffer), limitamos el renderizado a ~12-15 fps (80 ms)
        // para garantizar la estabilidad de la conexión SignalR y evitar saturar el circuito Blazor.
        if (IsSnifferMode)
        {
            var now = DateTime.UtcNow;
            if ((now - _lastUiUpdateTime).TotalMilliseconds < 80)
            {
                return;
            }
            _lastUiUpdateTime = now;
        }

        if ((frame.Parsed == null || _enableEndianSwap) && _activeSessionConfig != null &&
            _activeSessionConfig.CommsDatasets.TryGetValue(_selectedDatasetName, out var ds))
        {
            var rawBytes = frame.RawBytes?.ToArray() ?? GetRawPayload();
            if (rawBytes.Length > 0)
            {
                frame.Parsed = TrdpPcapParserService.DecodeParsedPayload(rawBytes, ds, _enableEndianSwap);
            }
        }

        _lastRenderedFrame = frame;
        ProcessParsedPayload(frame);
        GenerateHexDump(frame);

        _ = InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private void HandleConnectionStateChanged(bool isConnected)
    {
        if (_disposed) return;
        InvokeAsync(StateHasChanged);
    }

    private void HandleStatusMessage(string message)
    {
        if (_disposed) return;
        _lastStatusMessage = message;
        InvokeAsync(StateHasChanged);
    }

    private void ProcessParsedPayload(TrdpFrameMessage frame)
    {
        var newScalars = new Dictionary<string, JsonElement>();
        var newBitFields = new Dictionary<string, Dictionary<string, int>>();

        if (frame.Parsed is not null)
        {
            // Build an offset lookup from the active dataset definition so we can sort by byte position
            var offsetLookup = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            if (_activeSessionConfig != null &&
                _activeSessionConfig.CommsDatasets.TryGetValue(_selectedDatasetName, out var ds))
            {
                foreach (var v in ds.Variables)
                {
                    offsetLookup[v.Id] = v.Offset;
                    // _bits entries share the same offset as their parent variable
                    offsetLookup[$"{v.Id}_bits"] = v.Offset;
                }
            }

            // Sort parsed entries: known variables by offset, unknown ones go last (int.MaxValue)
            var sorted = frame.Parsed
                .OrderBy(kv => offsetLookup.TryGetValue(kv.Key, out int off) ? off : int.MaxValue)
                .ThenBy(kv => kv.Key);

            foreach (var (key, jsonEl) in sorted)
            {
                if (key.EndsWith("_bits") && jsonEl.ValueKind == JsonValueKind.Object)
                {
                    var bitDict = new Dictionary<string, int>();
                    foreach (var prop in jsonEl.EnumerateObject())
                    {
                        if (prop.Value.ValueKind == JsonValueKind.Number)
                            bitDict[prop.Name] = prop.Value.GetInt32();
                    }
                    newBitFields[key] = bitDict;
                }
                else if (jsonEl.ValueKind != JsonValueKind.Object)
                {
                    newScalars[key] = jsonEl;
                }
            }
        }

        // Reemplazo atómico de referencias: previene cualquier InvalidOperationException en el hilo de renderizado
        _scalarVariables = newScalars;
        _bitFields = newBitFields;
    }


    private void GenerateHexDump(TrdpFrameMessage frame)
    {
        byte[] bytes = Array.Empty<byte>();

        if (frame.RawBytes != null && frame.RawBytes.Count > 0)
        {
            bytes = frame.RawBytes.ToArray();
        }
        else if (!string.IsNullOrWhiteSpace(frame.RawHex))
        {
            try
            {
                var cleanHex = frame.RawHex.Replace(" ", "").Replace("-", "");
                bytes = Enumerable.Range(0, cleanHex.Length / 2)
                    .Select(x => Convert.ToByte(cleanHex.Substring(x * 2, 2), 16))
                    .ToArray();
            }
            catch { }
        }

        if (bytes.Length == 0)
        {
            _hexDumpText = "(Sin datos raw disponibles)";
            return;
        }

        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < bytes.Length; i += 16)
        {
            sb.AppendFormat("{0:X4}  ", i);

            // Hex bytes (16 bytes per line)
            for (int j = 0; j < 16; j++)
            {
                if (i + j < bytes.Length)
                    sb.AppendFormat("{0:X2} ", bytes[i + j]);
                else
                    sb.Append("   ");

                if (j == 7) sb.Append(" ");
            }

            sb.Append(" |");

            // ASCII printable
            for (int j = 0; j < 16; j++)
            {
                if (i + j < bytes.Length)
                {
                    byte b = bytes[i + j];
                    sb.Append(b >= 32 && b <= 126 ? (char)b : '.');
                }
            }
            sb.AppendLine("|");
        }

        _hexDumpText = sb.ToString();
    }

    private string FormatValue(JsonElement el)
    {
        return el.ValueKind switch
        {
            JsonValueKind.Number => el.GetDouble().ToString("G6"),
            JsonValueKind.String => el.GetString() ?? "",
            JsonValueKind.True   => "1 (TRUE)",
            JsonValueKind.False  => "0 (FALSE)",
            _ => el.ToString()
        };
    }

    private async Task CopyHexToClipboard()
    {
        if (_latestFrame != null && !string.IsNullOrWhiteSpace(_latestFrame.RawHex))
        {
            Snackbar.Add("Raw Hex copiado al portapapeles.", Severity.Info);
        }
    }

