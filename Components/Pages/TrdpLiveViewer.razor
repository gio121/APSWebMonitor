@code {
    public class TrdpConfiguredFrameOption
    {
        public string Id { get; set; } = string.Empty;
        public string NetworkName { get; set; } = string.Empty;
        public string DatasetName { get; set; } = string.Empty;
        public long ComId { get; set; }
        public string FrameName { get; set; } = string.Empty;
        public string Direction { get; set; } = "Rx";
        public string Ip { get; set; } = string.Empty;

        public string DisplayText => $"[{Direction}] {DatasetName} (ComID: {ComId}) — {NetworkName} ({FrameName})";
    }

    // Modo activo: "sniffer" | "pcap"
    private string _activeMode = "sniffer";
    private bool IsPcapMode => _activeMode == "pcap";
    private bool IsSnifferMode => _activeMode == "sniffer";

    private List<TrdpConfiguredFrameOption> _frameOptions = new();
    private TrdpConfiguredFrameOption? _selectedFrameOption;
    private TrdpSessionConfig? _activeSessionConfig;

    private string _selectedDatasetName = "TCMS_PLCFrame";
    private long _selectedComId = 1048580;

    private TrdpFrameMessage? _latestFrame;
    private DateTime? _lastFrameTime;
    private string _hexDumpText = string.Empty;
    private string _lastStatusMessage = string.Empty;
    private string _filterText = string.Empty;

    // Parsed fields breakdown
    private Dictionary<string, JsonElement> _scalarVariables = new();
    private Dictionary<string, Dictionary<string, int>> _bitFields = new();
    private bool _disposed = false;
    private TrdpFrameMessage? _lastRenderedFrame;
    private DateTime _lastUiUpdateTime = DateTime.MinValue;

    // Frame Structure tab state
    private bool _showSpares = false;
    private bool _enableEndianSwap = false;

    // Sniffer state
    private List<TrdpSnifferDevice> _snifferDevices = new();
    private TrdpSnifferDevice? _selectedSnifferDevice;
    private bool _snifferFilterByComId = true;
    private string _snifferStatusMessage = string.Empty;
    private System.Threading.Timer? _snifferRefreshTimer;

    // PCAP Chunked Player State & Progress
    private string? _tempPcapFilePath;
    private PcapChunkResult? _chunkResult;
    private List<TrdpCapturedFrame> _capturedFrames = new();
    private int _pcapFrameIndex = 0;
    private string _pcapFileName = string.Empty;
    
    // Progress state
    private bool _isLoadingFile = false;
    private bool _isLoadingChunk = false;
    private int _uploadProgressPercent = 0;
    private long _uploadBytesRead = 0;
    private long _totalFileBytes = 0;

    private bool _isPlaying = false;
    private double _playbackSpeed = 1.0;
    private CancellationTokenSource? _playbackCts;

    private int GlobalFrameNumber => _chunkResult != null 
        ? (_chunkResult.CurrentChunkIndex * _chunkResult.ChunkSize) + _pcapFrameIndex + 1 
        : 0;

    private TrdpCapturedFrame? CurrentCapturedFrame => 
        (_capturedFrames.Count > 0 && _pcapFrameIndex >= 0 && _pcapFrameIndex < _capturedFrames.Count) 
            ? _capturedFrames[_pcapFrameIndex] 
            : null;

    protected override async Task OnInitializedAsync()
    {
        // Load configured frame options from active config in DB
        await LoadConfiguredFramesAsync();

        // Sniffer events
        SnifferService.OnFrameCaptured += HandleSnifferFrameCaptured;
        SnifferService.OnCaptureStateChanged += HandleSnifferStateChanged;
        SnifferService.OnStatusMessage += HandleSnifferStatusMessage;

        // Pre-load sniffer interfaces
        RefreshSnifferDevices();
    }

    private async Task OnModeChanged(string newMode)
    {
        // Stop ongoing captures in the current mode before switching
        if (IsSnifferMode && SnifferService.IsCapturing)
        {
            StopSnifferCapture();
        }

        _activeMode = newMode;

        if (IsSnifferMode)
        {
            RefreshSnifferDevices();
        }
        else if (IsPcapMode)
        {
            if (_capturedFrames.Count > 0)
            {
                DisplayCurrentPcapFrame();
            }
        }
    }

    private async Task LoadConfiguredFramesAsync()
    {
        _frameOptions.Clear();
        try
        {
            var configs = await ConfigService.GetAllAsync();
            _activeSessionConfig = configs.FirstOrDefault();
            if (_activeSessionConfig != null)
            {
                // Process Networks -> Subscribers & Publishers
                foreach (var net in _activeSessionConfig.Networks)
                {
                    foreach (var sub in net.Subscribers)
                    {
                        _frameOptions.Add(new TrdpConfiguredFrameOption
                        {
                            Id          = $"sub_{sub.ComId}_{sub.Dataset}",
                            NetworkName = string.IsNullOrWhiteSpace(net.Name) ? "Red Default" : net.Name,
                            DatasetName = sub.Dataset,
                            ComId       = sub.ComId,
                            FrameName   = string.IsNullOrWhiteSpace(sub.Name) ? sub.Dataset : sub.Name,
                            Direction   = "Rx (Suscriptor)",
                            Ip          = sub.Ip
                        });
                    }

                    foreach (var pub in net.Publishers)
                    {
                        _frameOptions.Add(new TrdpConfiguredFrameOption
                        {
                            Id          = $"pub_{pub.ComId}_{pub.Dataset}",
                            NetworkName = string.IsNullOrWhiteSpace(net.Name) ? "Red Default" : net.Name,
                            DatasetName = pub.Dataset,
                            ComId       = pub.ComId,
                            FrameName   = string.IsNullOrWhiteSpace(pub.Name) ? pub.Dataset : pub.Name,
                            Direction   = "Tx (Publicador)",
                            Ip          = pub.Ip
                        });
                    }
                }

                // Add any extra unlisted datasets from CommsDatasets as fallbacks
                foreach (var dsKey in _activeSessionConfig.CommsDatasets.Keys)
                {
                    if (!_frameOptions.Any(f => f.DatasetName == dsKey))
                    {
                        _frameOptions.Add(new TrdpConfiguredFrameOption
                        {
                            Id          = $"ds_{dsKey}",
                            NetworkName = "Dataset General",
                            DatasetName = dsKey,
                            ComId       = 1048580,
                            FrameName   = dsKey,
                            Direction   = "Rx",
                            Ip          = ""
                        });
                    }
                }
            }
        }
        catch { }

        // Default fallback if no config exists in DB
        if (_frameOptions.Count == 0)
        {
            _frameOptions.Add(new TrdpConfiguredFrameOption
            {
                Id          = "default_tcms_plcframe",
                NetworkName = "Red Ramal 1",
                DatasetName = "TCMS_PLCFrame",
                ComId       = 1048580,
                FrameName   = "TCMS_PLCFrame",
                Direction   = "Rx (Suscriptor)"
            });
            _frameOptions.Add(new TrdpConfiguredFrameOption
            {
                Id          = "default_tcms_plcinfo",
                NetworkName = "Red Ramal 1",
                DatasetName = "TCMS_PlcInfo",
                ComId       = 1048581,
                FrameName   = "TCMS_PlcInfo",
                Direction   = "Rx (Suscriptor)"
            });
            _frameOptions.Add(new TrdpConfiguredFrameOption
            {
                Id          = "default_telemetry_aps",
                NetworkName = "Red Ramal 1",
                DatasetName = "TelemetryAPS",
                ComId       = 73531397,
                FrameName   = "Telemetria_Principal",
                Direction   = "Tx (Publicador)"
            });
        }

        // Select first Rx option by default
        _selectedFrameOption = _frameOptions.FirstOrDefault(f => f.Direction.StartsWith("Rx")) ?? _frameOptions.First();
        _selectedDatasetName = _selectedFrameOption.DatasetName;
        _selectedComId       = _selectedFrameOption.ComId;
    }

    private async Task OnFrameOptionChanged(TrdpConfiguredFrameOption option)
    {
        if (option is null) return;
        _selectedFrameOption = option;
        _selectedDatasetName = option.DatasetName;
        _selectedComId       = option.ComId;

        if (IsSnifferMode && SnifferService.IsCapturing)
        {
            // Update sniffer filter in real-time
            TrdpDataset? dsDef = null;
            _activeSessionConfig?.CommsDatasets.TryGetValue(_selectedDatasetName, out dsDef);
            SnifferService.UpdateFilter(
                _snifferFilterByComId ? _selectedComId : 0,
                _snifferFilterByComId ? (option.Ip ?? "") : "",
                _selectedDatasetName,
                dsDef,
                _enableEndianSwap);
            Snackbar.Add($"Filtro sniffer actualizado: {_selectedDatasetName} (ComID: {_selectedComId})", Severity.Info);
        }
        else if (IsPcapMode && !string.IsNullOrEmpty(_tempPcapFilePath))
        {
            // Re-filtrar la captura por el nuevo ComID e IP del dataset seleccionado
            await LoadChunk(0);
            Snackbar.Add($"Filtrado por {_selectedDatasetName} (ComID: {_selectedComId})", Severity.Info);
        }
    }

    // ══════════════════════════════════════════════════════════
    // SNIFFER CONTROL METHODS
    // ══════════════════════════════════════════════════════════

    private void RefreshSnifferDevices()
    {
        try
        {
            _snifferDevices = SnifferService.GetAvailableDevices();
            if (_snifferDevices.Count > 0 && _selectedSnifferDevice == null)
            {
                // Auto-select: prefer a non-loopback interface with an IP in the same subnet as the device host
                _selectedSnifferDevice = _snifferDevices.FirstOrDefault(d =>
                    !d.IsLoopback && !string.IsNullOrEmpty(d.IpAddress) && !d.IpAddress.StartsWith("169.254"))
                    ?? _snifferDevices.First();
            }
            _snifferStatusMessage = $"{_snifferDevices.Count} interfaces detectadas (Npcap).";
        }
        catch (Exception ex)
        {
            _snifferStatusMessage = $"Error al enumerar interfaces: {ex.Message}";
            Snackbar.Add(_snifferStatusMessage, Severity.Error);
        }
        StateHasChanged();
    }

    private void OnSnifferDeviceChanged(TrdpSnifferDevice device)
    {
        _selectedSnifferDevice = device;
    }

    private void StartSnifferCapture()
    {
        if (_selectedSnifferDevice == null)
        {
            Snackbar.Add("Seleccione una interfaz de red para iniciar la captura.", Severity.Warning);
            return;
        }

        TrdpDataset? dsDef = null;
        _activeSessionConfig?.CommsDatasets.TryGetValue(_selectedDatasetName, out dsDef);

        var (success, msg) = SnifferService.StartCapture(
            _selectedSnifferDevice.DeviceId,
            _snifferFilterByComId ? _selectedComId : 0,
            _snifferFilterByComId ? (_selectedFrameOption?.Ip ?? "") : "",
            _selectedDatasetName,
            dsDef,
            _enableEndianSwap);

        if (success)
        {
            Snackbar.Add(msg, Severity.Success);
            _snifferRefreshTimer?.Dispose();
            // Start periodic UI refresh timer (every 250ms) for stats and deferred frame render
            _snifferRefreshTimer = new System.Threading.Timer(_ =>
            {
                _ = InvokeAsync(() =>
                {
                    if (_disposed) return;
                    if (_latestFrame != null && _latestFrame != _lastRenderedFrame)
                    {
                        _lastRenderedFrame = _latestFrame;
                        ProcessParsedPayload(_latestFrame);
                        GenerateHexDump(_latestFrame);
                    }
                    StateHasChanged();
                });
            }, null, 250, 250);
        }
        else
        {
            Snackbar.Add(msg, Severity.Error);
        }
        StateHasChanged();
    }

    private void StopSnifferCapture()
    {
        _snifferRefreshTimer?.Dispose();
        _snifferRefreshTimer = null;

        SnifferService.StopCapture();
        Snackbar.Add("Captura de red detenida.", Severity.Info);
        StateHasChanged();
    }

    private void HandleSnifferFrameCaptured(TrdpFrameMessage frame)
    {
        // Sniffer already provides parsed payload; use the same rendering pipeline
        HandleFrameReceived(frame);
    }

    private void HandleSnifferStateChanged(bool isCapturing)
    {
        if (_disposed) return;
        InvokeAsync(StateHasChanged);
    }

    private void HandleSnifferStatusMessage(string message)
    {
        if (_disposed) return;
        _snifferStatusMessage = message;
        InvokeAsync(StateHasChanged);
    }

    // Modo UDP y REST desactivados (Sniffer y PCAP activos)

    // ══════════════════════════════════════════════════════════
    // PCAP CHUNKED STREAMING & REUSABLE MEMORY PLAYER LOGIC
    // ══════════════════════════════════════════════════════════
    private async Task OnPcapFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _pcapFileName = file.Name;
        StopPlayback();
        _isLoadingFile = true;
        _totalFileBytes = file.Size;
        _uploadBytesRead = 0;
        _uploadProgressPercent = 0;
        StateHasChanged();

        // Borrar archivo temporal previo si existía
        if (!string.IsNullOrEmpty(_tempPcapFilePath))
        {
            PcapParser.DeleteTempFile(_tempPcapFilePath);
            _tempPcapFilePath = null;
        }

        try
        {
            // Soportar hasta 5 GB mediante streaming secuencial a archivo temporal reportando el porcentaje de carga
            using var stream = file.OpenReadStream(maxAllowedSize: 5L * 1024 * 1024 * 1024);
            _tempPcapFilePath = await PcapParser.SaveToTempFileAsync(stream, file.Size, (bytesRead, totalBytes) =>
            {
                _uploadBytesRead = bytesRead;
                if (totalBytes > 0)
                {
                    _uploadProgressPercent = (int)Math.Min(100, Math.Max(0, (double)bytesRead / totalBytes * 100));
                }
                InvokeAsync(StateHasChanged);
            });

            // Cargar el bloque 0 filtrado por el ComID e IP del dataset seleccionado
            string filterIp = _selectedFrameOption?.Ip ?? "";
            _chunkResult = await PcapParser.ReadChunkAsync(_tempPcapFilePath, 0, _selectedComId, filterIp, chunkSize: 200);
            _capturedFrames = _chunkResult.Frames;

            if (_chunkResult.TotalFrames == 0)
            {
                _latestFrame = null;
                Snackbar.Add($"No se encontraron tramas en la captura para el ComID {_selectedComId} ({_selectedDatasetName}). Probando sin filtro o cambiando de dataset.", Severity.Warning);
                return;
            }

            _pcapFrameIndex = 0;
            DisplayCurrentPcapFrame();

            string sizeStr = FormatFileSize(file.Size);
            Snackbar.Add($"Captura cargada ({sizeStr}): {_chunkResult.TotalFrames} tramas coincidentes con ComID {_selectedComId} ({_chunkResult.TotalChunks} bloques).", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al leer captura Wireshark: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingFile = false;
            StateHasChanged();
        }
    }

    private async Task LoadChunk(int chunkIndex)
    {
        if (string.IsNullOrEmpty(_tempPcapFilePath)) return;

        _isLoadingChunk = true;
        StateHasChanged();

        try
        {
            string filterIp = _selectedFrameOption?.Ip ?? "";
            // Cargar el bloque filtrando por el ComID e IP del dataset seleccionado
            _chunkResult = await PcapParser.ReadChunkAsync(_tempPcapFilePath, chunkIndex, _selectedComId, filterIp, chunkSize: 200);
            _capturedFrames = _chunkResult.Frames;
            _pcapFrameIndex = 0;

            if (_capturedFrames.Count > 0)
            {
                DisplayCurrentPcapFrame();
            }
            else
            {
                _latestFrame = null;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar bloque de captura: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingChunk = false;
            StateHasChanged();
        }
    }

    private async Task PrevChunk()
    {
        if (_chunkResult != null && _chunkResult.CurrentChunkIndex > 0)
        {
            StopPlayback();
            await LoadChunk(_chunkResult.CurrentChunkIndex - 1);
        }
    }

    private async Task NextChunk()
    {
        if (_chunkResult != null && _chunkResult.CurrentChunkIndex < _chunkResult.TotalChunks - 1)
        {
            StopPlayback();
            await LoadChunk(_chunkResult.CurrentChunkIndex + 1);
        }
    }

    private void DisplayCurrentPcapFrame()
    {
        var captured = CurrentCapturedFrame;
        if (captured is null) return;

        TrdpDataset? datasetDef = null;
        if (_activeSessionConfig != null && _activeSessionConfig.CommsDatasets.TryGetValue(_selectedDatasetName, out var ds))
        {
            datasetDef = ds;
        }

        var frameMsg = captured.ToFrameMessage(_selectedDatasetName, _selectedComId, datasetDef, _enableEndianSwap);
        HandleFrameReceived(frameMsg);
    }

    private void OnSliderIndexChanged(int newIndex)
    {
        _pcapFrameIndex = Math.Clamp(newIndex, 0, Math.Max(0, _capturedFrames.Count - 1));
        DisplayCurrentPcapFrame();
    }

    private void FirstFrame()
    {
        if (_capturedFrames.Count == 0) return;
        _pcapFrameIndex = 0;
        DisplayCurrentPcapFrame();
    }

    private void PrevFrame()
    {
        if (_capturedFrames.Count == 0) return;
        if (_pcapFrameIndex > 0)
        {
            _pcapFrameIndex--;
            DisplayCurrentPcapFrame();
        }
        else if (_chunkResult != null && _chunkResult.CurrentChunkIndex > 0)
        {
            _ = LoadChunk(_chunkResult.CurrentChunkIndex - 1);
        }
    }

    private void NextFrame()
    {
        if (_capturedFrames.Count == 0) return;
        if (_pcapFrameIndex < _capturedFrames.Count - 1)
        {
            _pcapFrameIndex++;
            DisplayCurrentPcapFrame();
        }
        else if (_chunkResult != null && _chunkResult.CurrentChunkIndex < _chunkResult.TotalChunks - 1)
        {
            // Pasar al siguiente bloque automáticamente al llegar al final del bloque actual
            _ = LoadChunk(_chunkResult.CurrentChunkIndex + 1);
        }
        else
        {
            StopPlayback();
        }
    }

    private void LastFrame()
    {
        if (_capturedFrames.Count == 0) return;
        _pcapFrameIndex = _capturedFrames.Count - 1;
        DisplayCurrentPcapFrame();
    }

    private void TogglePlay()
    {
        if (_isPlaying)
        {
            StopPlayback();
        }
        else
        {
            StartPlayback();
        }
    }

    private void StartPlayback()
    {
        if (_capturedFrames.Count == 0) return;
        if (_pcapFrameIndex >= _capturedFrames.Count - 1 && (_chunkResult == null || _chunkResult.CurrentChunkIndex >= _chunkResult.TotalChunks - 1))
        {
            _pcapFrameIndex = 0;
        }

        _isPlaying = true;
        _playbackCts = new CancellationTokenSource();
        var token = _playbackCts.Token;

        Task.Run(async () =>
        {
            while (!token.IsCancellationRequested && _isPlaying)
            {
                int delayMs = (int)(100 / _playbackSpeed);
                await Task.Delay(delayMs, token);

                await InvokeAsync(() =>
                {
                    NextFrame();
                    StateHasChanged();
                });
            }

            await InvokeAsync(() =>
            {
                _isPlaying = false;
                StateHasChanged();
            });
        }, token);
    }

    private void StopPlayback()
    {
        _isPlaying = false;
        if (_playbackCts != null)
        {
            _playbackCts.Cancel();
            _playbackCts.Dispose();
            _playbackCts = null;
        }
    }

    private void OnSpeedChanged(double newSpeed)
    {
        _playbackSpeed = newSpeed;
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024 * 1024)
            return $"{(bytes / (1024.0 * 1024.0 * 1024.0)):F2} GB";
        if (bytes >= 1024 * 1024)
            return $"{(bytes / (1024.0 * 1024.0)):F1} MB";
        if (bytes >= 1024)
            return $"{(bytes / 1024.0):F0} KB";
        return $"{bytes} B";
    }

