    private List<TrdpDatasetVariable> CurrentDatasetVariables => GetDatasetVariablesSorted();
    private byte[] CurrentRawPayload => GetRawPayload();

    /// <summary>Returns the dataset variables sorted by their byte offset.</summary>
    private List<TrdpDatasetVariable> GetDatasetVariablesSorted()
    {
        if (_activeSessionConfig == null) return new();
        if (!_activeSessionConfig.CommsDatasets.TryGetValue(_selectedDatasetName, out var ds)) return new();
        return ds.Variables.OrderBy(v => v.Offset).ToList();
    }

    /// <summary>Returns the raw payload bytes from the latest received frame.</summary>
    private byte[] GetRawPayload()
    {
        var frame = _latestFrame;
        if (frame == null) return Array.Empty<byte>();
        if (frame.RawBytes != null && frame.RawBytes.Count > 0)
            return frame.RawBytes.ToArray();
        if (!string.IsNullOrWhiteSpace(frame.RawHex))
        {
            try
            {
                var hex = frame.RawHex.Replace(" ", "").Replace("-", "");
                return Enumerable.Range(0, hex.Length / 2)
                    .Select(i => Convert.ToByte(hex.Substring(i * 2, 2), 16))
                    .ToArray();
            }
            catch { }
        }
        return Array.Empty<byte>();
    }

    /// <summary>Returns the CSS badge class for variable data types.</summary>
    private static string GetTypeBadgeClass(string? type)
    {
        if (string.IsNullOrWhiteSpace(type)) return "type-scalar";
        var t = type.ToUpperInvariant();
        if (t.Contains("SPARE")) return "type-spare";
        if (t.Contains("BIT") || t.Contains("BOOL")) return "type-bit";
        return "type-scalar";
    }

    /// <summary>Returns true when the variable represents a bitset/status word rather than an analog measurement.</summary>
    private static bool IsBitsetType(TrdpDatasetVariable v)
    {
        if (v == null) return false;
        var t = (v.Type ?? "").ToUpperInvariant();

        // Variables with unit are scalar measurements (voltages, currents, temperatures, etc.)
        if (!string.IsNullOrWhiteSpace(v.Unit)) return false;

        if (t.Contains("BIT") || t.Contains("BOOL") || t.Contains("FLAG")) return true;

        if (!string.IsNullOrWhiteSpace(v.Description) &&
            (v.Description.Contains("bit0=", StringComparison.OrdinalIgnoreCase) ||
             v.Description.Contains("bit 0", StringComparison.OrdinalIgnoreCase) ||
             v.Description.Contains("bits", StringComparison.OrdinalIgnoreCase)))
            return true;

        var id = v.Id.ToLowerInvariant();
        if (id.Contains("state") || id.Contains("status") || id.Contains("flag") ||
            id.Contains("cmd") || id.Contains("mask") || id.Contains("diag") || id.Contains("mode"))
        {
            return t is "UINT8" or "INT8" or "BYTE" or "UINT16" or "INT16";
        }

        if (t is "UINT8" or "BYTE")
        {
            return true;
        }

        return false;
    }

    private static bool IsBitsetType(string type)
    {
        var t = (type ?? "").ToUpperInvariant();
        return t is "UINT8" or "INT8" or "BYTE" or "SBYTE" or "BCD_BYTE";
    }

    /// <summary>Returns the byte width of the variable (clamped to 4).</summary>
    private static int GetVarByteCount(TrdpDatasetVariable v)
    {
        if (v.Size.HasValue && v.Size.Value > 0)
            return Math.Min(v.Size.Value, 4);
        return Math.Min(SessionParserService.GetByteSize(v.Type), 4);
    }

    /// <summary>Reads raw integer value considering current endianness mode.</summary>
    private ulong ReadRawUlong(byte[] payload, int offset, int byteCount)
    {
        return TrdpPcapParserService.ReadRawUlong(payload, offset, byteCount, _enableEndianSwap);
    }

    /// <summary>Produces the fully decoded physical value string (with engineering unit).</summary>
    private string GetDecodedPhysicalString(TrdpDatasetVariable v, byte[] payload)
    {
        if (payload == null || payload.Length == 0) return "--";
        if (v.Offset < 0 || v.Offset >= payload.Length) return "Offset OOB";

        if (_latestFrame?.Parsed != null && _latestFrame.Parsed.TryGetValue(v.Id, out var jsonEl))
        {
            string unit = string.IsNullOrWhiteSpace(v.Unit) ? "" : $" {v.Unit}";
            return $"{FormatValue(jsonEl)}{unit}";
        }

        string rawDec = GetRawDecimalString(v, payload);
        string u = string.IsNullOrWhiteSpace(v.Unit) ? "" : $" {v.Unit}";
        return $"{rawDec}{u}";
    }

    /// <summary>Returns the raw decimal string before any scale or offset is applied.</summary>
    private string GetRawDecimalString(TrdpDatasetVariable v, byte[] payload)
    {
        if (payload == null || payload.Length == 0) return "--";
        if (v.Offset < 0 || v.Offset >= payload.Length) return "--";

        int byteSize = GetVarByteCount(v);
        var t = (v.Type ?? "").ToUpperInvariant();

        if (t is "FLOAT" or "FLOAT32")
        {
            double fVal = TrdpPcapParserService.ReadNumericValue(payload, v.Offset, v.Type, _enableEndianSwap);
            return fVal.ToString("G6");
        }

        if (t is "INT8" or "SBYTE")
        {
            return ((sbyte)payload[v.Offset]).ToString();
        }

        if (t is "INT16" or "INT")
        {
            if (payload.Length - v.Offset < 2) return "--";
            short sVal = _enableEndianSwap
                ? System.Buffers.Binary.BinaryPrimitives.ReadInt16LittleEndian(payload.AsSpan(v.Offset, 2))
                : System.Buffers.Binary.BinaryPrimitives.ReadInt16BigEndian(payload.AsSpan(v.Offset, 2));
            return sVal.ToString();
        }

        if (t is "INT32")
        {
            if (payload.Length - v.Offset < 4) return "--";
            int iVal = _enableEndianSwap
                ? System.Buffers.Binary.BinaryPrimitives.ReadInt32LittleEndian(payload.AsSpan(v.Offset, 4))
                : System.Buffers.Binary.BinaryPrimitives.ReadInt32BigEndian(payload.AsSpan(v.Offset, 4));
            return iVal.ToString();
        }

        ulong uVal = TrdpPcapParserService.ReadRawUlong(payload, v.Offset, byteSize, _enableEndianSwap);
        return uVal.ToString();
    }

    /// <summary>Returns space-separated hex bytes corresponding to this variable in the raw payload.</summary>
    private static string GetRawHexString(TrdpDatasetVariable v, byte[] payload)
    {
        if (payload == null || payload.Length == 0) return "--";
        int byteSize = GetVarByteCount(v);
        return BuildRawHex(payload, v.Offset, byteSize);
    }

    /// <summary>Returns a space-separated hex string for the variable bytes.</summary>
    private static string BuildRawHex(byte[] payload, int offset, int byteCount)
    {
        if (payload == null || offset < 0 || offset >= payload.Length) return "--";
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < byteCount && offset + i < payload.Length; i++)
        {
            if (i > 0) sb.Append(' ');
            sb.AppendFormat("{0:X2}", payload[offset + i]);
        }
        return sb.ToString();
    }

    /// <summary>
    /// Returns a label for a specific bit index from the variable's description or Id.
    /// Tries to find "bit N" references in the description; otherwise returns empty.
    /// </summary>
    private static string GetBitLabel(TrdpDatasetVariable v, int bitIdx)
    {
        var desc = v.Description ?? "";
        var patterns = new[] { $"bit{bitIdx}=", $"b{bitIdx}=", $"bit {bitIdx}=", $"bit{bitIdx}:" };
        foreach (var p in patterns)
        {
            int idx = desc.IndexOf(p, StringComparison.OrdinalIgnoreCase);
            if (idx >= 0)
            {
                int start = idx + p.Length;
                int end = desc.IndexOfAny(new[] { ',', ';', ' ', '\n' }, start);
                return end < 0 ? desc.Substring(start).Trim() : desc.Substring(start, end - start).Trim();
            }
        }
        return string.Empty;
    }

    /// <summary>Returns the converted value for scalar variables without scale/offset.</summary>
    private double ComputePhysicalValue(byte[] payload, TrdpDatasetVariable v)
    {
        if (payload == null || payload.Length == 0) return 0;
        return TrdpPcapParserService.ReadNumericValue(payload, v.Offset, v.Type, _enableEndianSwap);
    }

    public void Dispose()
    {
        _disposed = true;
        StopPlayback();
        PcapParser.DeleteTempFile(_tempPcapFilePath);

        // Sniffer cleanup
        _snifferRefreshTimer?.Dispose();
        _snifferRefreshTimer = null;
        if (SnifferService.IsCapturing) SnifferService.StopCapture();
        SnifferService.OnFrameCaptured -= HandleSnifferFrameCaptured;
        SnifferService.OnCaptureStateChanged -= HandleSnifferStateChanged;
        SnifferService.OnStatusMessage -= HandleSnifferStatusMessage;
    }
}
