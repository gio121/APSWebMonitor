@page "/trdp-live"
@attribute [Authorize(Policy = "Page:trdp-live")]
@rendermode InteractiveServer
@using ApsMonitor.Models
@using ApsMonitor.Services
@using System.Text.Json
@inject TrdpWebSocketService WsService
@inject TrdpBackendService BackendService
@inject TrdpConfigService ConfigService
@inject TrdpPcapParserService PcapParser
@inject TrdpSnifferService SnifferService
@inject MonitorStateService MonitorState
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Visualizador TRDP en Tiempo Real y Reproductor PCAP</PageTitle>

<!-- ══════════════════════════════════════════════════════════
     HEADER DE ESTADO & CONTROLES DE MODO
══════════════════════════════════════════════════════════ -->
<div class="trdp-live-header">
    <div class="d-flex align-center gap-3">
        <MudIcon Icon="@(IsPcapMode ? Icons.Material.Filled.Movie : Icons.Material.Filled.Router)" Class="trdp-live-icon" />
        <div>
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.h5" Class="fw-bold">
                    @(IsPcapMode ? "Reproductor Wireshark PCAP (Offline)" : "Sniffer TRDP (Captura de Red)")
                </MudText>
                @if (IsSnifferMode)
                {
                    @if (SnifferService.IsCapturing)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Wifi">
                            Capturando en @(SnifferService.ActiveDeviceName ?? "interfaz")
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.WifiOff">
                            Sniffer Detenido
                        </MudChip>
                    }
                }
                else
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.FolderZip">
                        Modo Captura PCAP (Filtrado ComID)
                    </MudChip>
                }
            </div>
            <MudText Typo="Typo.caption" Class="trdp-muted">
                @if (IsPcapMode)
                {
                    @:Reproducción local paginada con filtrado automático por ComID (.pcap, .pcapng, .json)
                }
                else
                {
                    @:Captura directa desde interfaz de red física (Npcap/WinPcap) — todas las tramas TRDP en tiempo real
                }
            </MudText>
        </div>
    </div>

    <!-- Toggle Selector Modo (Sniffer vs Reproductor PCAP) + Toggle BitOrder/Endianness -->
    <div class="d-flex align-center gap-3 flex-wrap">
        <MudToggleGroup T="string" Value="_activeMode" ValueChanged="OnModeChanged" Color="Color.Primary" Size="Size.Small">
            <MudToggleItem Value="@("sniffer")" Text="Sniffer (Red)" Icon="@Icons.Material.Filled.Router" />
            <MudToggleItem Value="@("pcap")" Text="Reproductor Wireshark" Icon="@Icons.Material.Filled.PlayCircle" />
        </MudToggleGroup>

        <MudButton Variant="@(_enableEndianSwap ? Variant.Filled : Variant.Outlined)"
                   Color="@(_enableEndianSwap ? Color.Tertiary : Color.Default)"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.SwapHoriz"
                   OnClick="ToggleEndianSwap"
                   Title="Alternar orden de bytes de datos (Big-Endian estándar TRDP IEC 61375 vs Little-Endian)">
            ByteOrder: @(_enableEndianSwap ? "Little-Endian (Invertido)" : "Big-Endian (Estándar TRDP)")
        </MudButton>

        <!-- Quick Stats (Sniffer) -->
        @if (IsSnifferMode)
        {
            <div class="trdp-stat-box">
                <span class="stat-label">FRECUENCIA</span>
                <span class="stat-value">@SnifferService.RefreshRateHz.ToString("F1") Hz</span>
            </div>
            <div class="trdp-stat-box">
                <span class="stat-label">TRDP</span>
                <span class="stat-value">@SnifferService.MatchingFramesCount</span>
            </div>
            <div class="trdp-stat-box">
                <span class="stat-label">UDP TOTAL</span>
                <span class="stat-value">@SnifferService.PacketsCaptured</span>
            </div>
        }
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     BARRA MODO SNIFFER (CAPTURA DIRECTA DE RED)
══════════════════════════════════════════════════════════ -->
@if (IsSnifferMode)
{
    <MudPaper Elevation="0" Class="pa-3 mb-4 trdp-control-bar">
        <MudGrid Spacing="2" Class="align-center">
            <!-- Network Interface Selector -->
            <MudItem xs="12" sm="5" md="4">
                <MudSelect T="TrdpSnifferDevice" Value="_selectedSnifferDevice"
                           ValueChanged="OnSnifferDeviceChanged"
                           Label="Interfaz de Red (Npcap)" Variant="Variant.Outlined" Margin="Margin.Dense"
                           ToStringFunc="@(d => d?.DisplayText ?? "Seleccionar interfaz...")"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Router">
                    @foreach (var dev in _snifferDevices)
                    {
                        <MudSelectItem Value="@dev">@dev.DisplayText</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Configured Frame / Dataset Selector (shared) -->
            <MudItem xs="12" sm="4" md="3">
                <MudSelect T="TrdpConfiguredFrameOption" Value="_selectedFrameOption"
                           ValueChanged="OnFrameOptionChanged"
                           Label="Dataset / Trama" Variant="Variant.Outlined" Margin="Margin.Dense"
                           ToStringFunc="@(f => f?.DisplayText ?? "Seleccionar trama...")">
                    @foreach (var opt in _frameOptions)
                    {
                        <MudSelectItem Value="@opt">@opt.DisplayText</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- ComID Badge -->
            <MudItem xs="6" sm="3" md="2" Class="d-flex align-center gap-1">
                @if (_selectedFrameOption != null)
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                        ComID: @_selectedFrameOption.ComId
                    </MudChip>
                }
                <MudCheckBox @bind-Value="_snifferFilterByComId" Label="Filtrar" Color="Color.Info"
                             Size="Size.Small" Dense="true"
                             Title="Si está activo, solo se muestran tramas que coincidan con el ComID seleccionado" />
            </MudItem>

            <!-- Action Buttons -->
            <MudItem xs="12" sm="12" md="3" Class="d-flex gap-2 align-center justify-end">
                @if (!SnifferService.IsCapturing)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="StartSnifferCapture" Disabled="@(_selectedSnifferDevice == null)">
                        Capturar
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="RefreshSnifferDevices" Title="Reescanear interfaces de red Npcap">
                        <MudIcon Icon="@Icons.Material.Filled.Refresh" />
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Stop" OnClick="StopSnifferCapture">
                        Detener
                    </MudButton>
                }
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_snifferStatusMessage))
        {
            <div class="mt-2 text-caption trdp-muted d-flex align-center gap-1">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" Style="font-size:0.9rem;" />
                @_snifferStatusMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(SnifferService.LastError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@SnifferService.LastError</MudAlert>
        }
    </MudPaper>
}
else
{
    <!-- ══════════════════════════════════════════════════════════
         BARRA DE REPRODUCTOR PCAP / WIRESHARK (OFFLINE PAGINADO)
    ══════════════════════════════════════════════════════════ -->
    <MudPaper Elevation="0" Class="pa-3 mb-4 trdp-control-bar">
        <MudGrid Spacing="2" Class="align-center">
            <!-- Cargar Archivo PCAP (Hasta 5GB por streaming) -->
            <MudItem xs="12" sm="5" md="4" Class="d-flex align-center gap-2">
                <InputFile id="pcapInput" OnChange="OnPcapFileSelected" accept=".pcap,.pcapng,.json,.cap,.txt" style="display:none;" />
                <label htmlFor="pcapInput" Class="mb-0">
                    <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile" for="pcapInput" Disabled="_isLoadingFile">
                        @if (_isLoadingFile)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="width:16px; height:16px;" />
                            <span>Cargando (@_uploadProgressPercent%)...</span>
                        }
                        else
                        {
                            <span>Abrir Captura Wireshark</span>
                        }
                    </MudButton>
                </label>

                @if (!string.IsNullOrEmpty(_pcapFileName))
                {
                    <span class="text-caption fw-bold text-truncate" style="max-width:180px; color:#38bdf8;" title="@_pcapFileName">
                        @_pcapFileName
                    </span>
                }
            </MudItem>

            <!-- Configured Frame / Dataset Decoder Selector -->
            <MudItem xs="12" sm="7" md="4">
                <MudSelect T="TrdpConfiguredFrameOption" Value="_selectedFrameOption"
                           ValueChanged="OnFrameOptionChanged"
                           Label="Filtrar y Decodificar con Dataset" Variant="Variant.Outlined" Margin="Margin.Dense"
                           ToStringFunc="@(f => f?.DisplayText ?? "Seleccionar trama...")">
                    @foreach (var opt in _frameOptions)
                    {
                        <MudSelectItem Value="@opt">@opt.DisplayText</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Paginación de Bloques / Memoria y Trama Real Wireshark -->
            <MudItem xs="12" sm="12" md="4" Class="d-flex align-center justify-end gap-2 flex-wrap">
                @if (_chunkResult != null)
                {
                    @if (_chunkResult.TotalFrames > 0)
                    {
                        <div class="d-flex align-center gap-1">
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Color="Color.Info"
                                           Disabled="@(_chunkResult.CurrentChunkIndex == 0 || _isLoadingChunk)"
                                           OnClick="PrevChunk" Title="Bloque anterior" />

                            <span class="text-caption fw-bold" style="color:#a78bfa;">
                                Bloque @(_chunkResult.CurrentChunkIndex + 1)/@_chunkResult.TotalChunks
                            </span>

                            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Info"
                                           Disabled="@(_chunkResult.CurrentChunkIndex >= _chunkResult.TotalChunks - 1 || _isLoadingChunk)"
                                           OnClick="NextChunk" Title="Bloque siguiente" />
                        </div>

                        <!-- Número de trama filtrada -->
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Title="Posición dentro de las tramas filtradas">
                            Trama @(GlobalFrameNumber) / @_chunkResult.TotalFrames
                        </MudChip>

                        <!-- Número de Trama Real de Wireshark -->
                        @if (CurrentCapturedFrame != null && CurrentCapturedFrame.WiresharkFrameNumber > 0)
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled"
                                     Icon="@Icons.Material.Filled.Search" Class="fw-bold" 
                                     Title="Número de trama real en el archivo Wireshark original (frame.number)">
                                Trama Wireshark #@CurrentCapturedFrame.WiresharkFrameNumber
                            </MudChip>
                        }
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">
                            Sin tramas para ComID @_selectedComId
                        </MudChip>
                    }
                }
            </MudItem>
        </MudGrid>

        <!-- Barra de Progreso de Carga en Tiempo Real con Porcentaje (%) -->
        @if (_isLoadingFile)
        {
            <div class="mt-2 pa-2 trdp-upload-progress">
                <div class="d-flex justify-space-between align-center mb-1">
                    <span class="text-caption fw-bold" style="color:#38bdf8;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="width:14px; height:14px;" />
                        Cargando captura a disco: @_uploadProgressPercent%
                    </span>
                    <span class="text-caption trdp-muted">
                        @FormatFileSize(_uploadBytesRead) de @FormatFileSize(_totalFileBytes)
                    </span>
                </div>
                <MudProgressLinear Color="Color.Info" Value="@_uploadProgressPercent" Size="Size.Small" Rounded="true" Stripe="true" />
            </div>
        }

        <!-- REPRODUCTOR MULTIMEDIA & SLIDER DEL BLOQUE ACTIVO -->
        @if (_capturedFrames.Count > 0)
        {
            <div class="mt-3 pa-2 trdp-player-panel">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                    <!-- Botones de Control del Reproductor -->
                    <div class="d-flex align-center gap-1">
                        <MudIconButton Icon="@Icons.Material.Filled.FirstPage" Size="Size.Small" Color="Color.Inherit" Title="Ir al inicio del bloque" OnClick="FirstFrame" />
                        <MudIconButton Icon="@Icons.Material.Filled.NavigateBefore" Size="Size.Small" Color="Color.Inherit" Title="Trama anterior" OnClick="PrevFrame" />

                        @if (_isPlaying)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.Pause" OnClick="TogglePlay">
                                Pausa
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="TogglePlay">
                                Reproducir
                            </MudButton>
                        }

                        <MudIconButton Icon="@Icons.Material.Filled.NavigateNext" Size="Size.Small" Color="Color.Inherit" Title="Trama siguiente" OnClick="NextFrame" />
                        <MudIconButton Icon="@Icons.Material.Filled.LastPage" Size="Size.Small" Color="Color.Inherit" Title="Ir al final del bloque" OnClick="LastFrame" />
                    </div>

                    <!-- Timestamps -->
                    <div class="d-flex align-center gap-3">
                        <span class="player-time-label">
                            REL: <span class="player-time-val">+@CurrentCapturedFrame?.RelativeTime.ToString(@"hh\:mm\:ss\.fff")</span>
                        </span>
                        <span class="player-time-label">
                            HORA: <span class="player-time-val">@CurrentCapturedFrame?.Timestamp.ToString("HH:mm:ss.fff")</span>
                        </span>
                    </div>

                    <!-- Velocidad de Reproducción -->
                    <div class="d-flex align-center gap-1">
                        <MudText Typo="Typo.caption" Class="trdp-muted mr-1">Velocidad:</MudText>
                        <MudSelect T="double" Value="_playbackSpeed" ValueChanged="OnSpeedChanged"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="trdp-speed-select">
                            <MudSelectItem Value="0.5">0.5x</MudSelectItem>
                            <MudSelectItem Value="1.0">1.0x (Normal)</MudSelectItem>
                            <MudSelectItem Value="2.0">2.0x</MudSelectItem>
                            <MudSelectItem Value="5.0">5.0x</MudSelectItem>
                            <MudSelectItem Value="10.0">10.0x</MudSelectItem>
                        </MudSelect>
                    </div>
                </div>

                <!-- Slider de Tiempo del Bloque -->
                <MudSlider T="int" Value="_pcapFrameIndex" ValueChanged="OnSliderIndexChanged"
                           Min="0" Max="@(_capturedFrames.Count - 1)" Color="Color.Info" Class="ma-0" />
            </div>
        }
    </MudPaper>
}

<!-- ══════════════════════════════════════════════════════════
     CONTENIDO PRINCIPAL (PARSED & HEX VIEW)
══════════════════════════════════════════════════════════ -->
@if (_latestFrame is null)
{
    <MudPaper Elevation="0" Class="pa-8 text-center trdp-empty-card">
        <MudIcon Icon="@(IsPcapMode ? Icons.Material.Filled.UploadFile : Icons.Material.Filled.Inbox)" Style="font-size:64px; opacity:0.15;" />
        <MudText Typo="Typo.h6" Class="mt-3 trdp-muted">
            @(IsPcapMode ? "No hay tramas para mostrar en este bloque/dataset." : "Esperando datos de trama TRDP...")
        </MudText>
        <MudText Typo="Typo.body2" Class="trdp-muted mt-1">
            @if (IsPcapMode)
            {
                <span>Pulsa <b>Abrir Captura Wireshark</b> para cargar un archivo <code>.pcap</code>, <code>.pcapng</code> o <code>.json</code>. Si ya cargaste uno, verifica que el dataset seleccionado coincida con el <code>ComID</code> de la captura.</span>
            }
            else
            {
                <span>Modo Sniffer de red en tiempo real. Selecciona una interfaz física y pulsa <b>Capturar</b> para escuchar el tráfico TRDP de la red.</span>
            }
        </MudText>
    </MudPaper>
}
else
{
    <MudTabs Rounded="true" ApplyEffectsToContainer="true" Color="Color.Dark" Class="trdp-view-tabs" PanelClass="pt-4">

        <!-- ── Tab 1: Variables Parseadas con Raw Dec y Hex ──────────── -->
        <MudTabPanel Text="Variables Parseadas" Icon="@Icons.Material.Filled.TableChart">

            <div class="d-flex align-center justify-space-between mb-3 flex-wrap gap-2">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">
                        Dataset: <span style="color:#38bdf8;">@_latestFrame.Dataset</span> · ComID: <span style="color:#a78bfa;">@_latestFrame.ComId</span>
                    </MudText>
                    @if (_selectedFrameOption != null)
                    {
                        <MudText Typo="Typo.caption" Class="trdp-muted">
                            Red: @_selectedFrameOption.NetworkName (@_selectedFrameOption.FrameName)
                        </MudText>
                    }
                </div>
                <div class="d-flex align-center gap-3">
                    @if (IsPcapMode && CurrentCapturedFrame != null)
                    {
                        <MudText Typo="Typo.caption" Class="fw-bold" Style="color:#f59e0b;">
                            Wireshark frame.number == @CurrentCapturedFrame.WiresharkFrameNumber
                        </MudText>
                    }
                    <MudText Typo="Typo.caption" Class="trdp-muted">
                        Tamaño payload: @_latestFrame.Size bytes @(IsPcapMode ? "(Wireshark PCAP - TRDP Header Removido)" : "")
                    </MudText>
                </div>
            </div>

            @{
                var dsVars = CurrentDatasetVariables;
                var rawPayload = CurrentRawPayload;
            }

            <!-- Barra de búsqueda y filtros rápidos de variables -->
            <div class="d-flex align-center justify-space-between mb-3 flex-wrap gap-2">
                <div class="d-flex align-center gap-2">
                    <MudTextField @bind-Value="_filterText" Placeholder="Filtrar variables (ej. volt, cur, temp, sts)..." 
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:320px;" />
                    <span class="text-caption trdp-muted">
                        @(dsVars.Count > 0 ? $"{dsVars.Count} variables definidas" : $"{_scalarVariables.Count} variables detectadas")
                    </span>
                </div>
                <div class="d-flex align-center gap-2">
                    <MudToggleIconButton @bind-Toggled="_showSpares"
                                         Icon="@Icons.Material.Filled.VisibilityOff"
                                         ToggledIcon="@Icons.Material.Filled.Visibility"
                                         Title="Mostrar/ocultar campos spare"
                                         Color="Color.Default" ToggledColor="Color.Info"
                                         Size="Size.Small" />
                    <MudText Typo="Typo.caption" Class="trdp-muted">@(_showSpares ? "Spares visibles" : "Spares ocultos")</MudText>
                </div>
            </div>

            <!-- Tabla de Variables con Valor Decodificado, Raw Decimal y Raw Hexadecimal -->
            <MudPaper Elevation="0" Class="pa-2 trdp-vars-table">
                <table class="trdp-table">
                    <thead>
                        <tr>
                            <th style="width:65px;">BYTE</th>
                            <th style="width:230px;">VARIABLE</th>
                            <th style="width:95px;">TIPO</th>
                            <th style="width:220px;">VALOR</th>
                            <th style="width:140px;">RAW (HEX)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (dsVars.Count > 0)
                        {
                            @foreach (var v in dsVars)
                            {
                                bool isSpare = v.Id.StartsWith("spare", StringComparison.OrdinalIgnoreCase)
                                            || (v.Description != null && v.Description.Equals("spare", StringComparison.OrdinalIgnoreCase));
                                if (isSpare && !_showSpares) continue;

                                if (!string.IsNullOrWhiteSpace(_filterText) &&
                                    !v.Id.Contains(_filterText, StringComparison.OrdinalIgnoreCase) &&
                                    !(v.Description ?? "").Contains(_filterText, StringComparison.OrdinalIgnoreCase))
                                    continue;

                                string decVal = GetDecodedPhysicalString(v, rawPayload);
                                string rawHex = GetRawHexString(v, rawPayload);

                                <tr class="@(isSpare ? "trdp-spare-row" : "")">
                                    <td><span class="trdp-offset-badge">@v.Offset</span></td>
                                    <td>
                                        <div class="fw-bold" style="color:var(--mud-palette-text-primary); font-size:0.83rem;">@v.Id</div>
                                        @if (!string.IsNullOrWhiteSpace(v.Description))
                                        {
                                            <div class="trdp-muted" style="font-size:0.72rem;">@v.Description</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="trdp-type-badge @GetTypeBadgeClass(v.Type)">@v.Type</span>
                                    </td>
                                    <td>
                                        <span class="trdp-val-badge">@decVal</span>
                                    </td>
                                    <td>
                                        <code class="trdp-rawbytes">@rawHex</code>
                                    </td>
                                </tr>
                            }
                        }
                        else if (_scalarVariables.Count > 0)
                        {
                            @foreach (var (varName, valObj) in _scalarVariables.ToArray())
                            {
                                if (!string.IsNullOrWhiteSpace(_filterText) && !varName.Contains(_filterText, StringComparison.OrdinalIgnoreCase))
                                    continue;

                                <tr>
                                    <td><span class="trdp-offset-badge">--</span></td>
                                    <td class="fw-bold" style="color:var(--mud-palette-text-primary);">@varName</td>
                                    <td><span class="trdp-type-badge type-scalar">AUTO</span></td>
                                    <td>
                                        <span class="trdp-val-badge">@FormatValue(valObj)</span>
                                    </td>
                                    <td><code class="trdp-rawbytes">--</code></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center trdp-muted py-3">No se detectaron variables para mostrar.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </MudPaper>

        </MudTabPanel>

        <!-- ── Tab 2: Estructura de Trama (Orden de Byte) ────────────── -->
        @if (CurrentDatasetVariables.Count > 0)
        {
            <MudTabPanel Text="Estructura de Trama" Icon="@Icons.Material.Filled.ViewList">
                @{
                    var dsVars = CurrentDatasetVariables;
                    var rawPayload = CurrentRawPayload;
                }

                <!-- Toolbar -->
                <div class="d-flex align-center justify-space-between mb-3 flex-wrap gap-2">
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">
                            <MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Small" Class="mr-1" Style="color:#38bdf8;" />
                            Estructura del dataset <span style="color:#38bdf8;">@_selectedDatasetName</span>
                            <span class="trdp-muted" style="font-size:0.8rem;"> &mdash; @rawPayload.Length bytes payload</span>
                        </MudText>
                    </div>
                    <div class="d-flex align-center gap-3">
                        <MudToggleIconButton @bind-Toggled="_showSpares"
                                             Icon="@Icons.Material.Filled.VisibilityOff"
                                             ToggledIcon="@Icons.Material.Filled.Visibility"
                                             Title="Mostrar/ocultar campos spare"
                                             Color="Color.Default" ToggledColor="Color.Info"
                                             Size="Size.Small" />
                        <MudText Typo="Typo.caption" Class="trdp-muted">@(_showSpares ? "Spares visibles" : "Spares ocultos")</MudText>
                    </div>
                </div>

                <!-- Frame Structure Table -->
                <MudPaper Elevation="0" Class="pa-2 trdp-frame-struct">
                    <table class="trdp-table trdp-struct-table">
                        <thead>
                            <tr>
                                <th style="width:60px;">BYTE</th>
                                <th style="width:180px;">VARIABLE</th>
                                <th style="width:85px;">TIPO</th>
                                <th>VALOR / BITS</th>
                                <th style="width:120px;">RAW HEX</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in dsVars)
                            {
                                bool isSpare = v.Id.StartsWith("spare", StringComparison.OrdinalIgnoreCase)
                                           || (v.Description != null && v.Description.Equals("spare", StringComparison.OrdinalIgnoreCase));
                                if (isSpare && !_showSpares) continue;

                                bool isBitType  = IsBitsetType(v);
                                int byteCount   = GetVarByteCount(v);
                                ulong rawInt    = ReadRawUlong(rawPayload, v.Offset, byteCount);
                                int bitWidth    = byteCount * 8;
                                string rawHex   = BuildRawHex(rawPayload, v.Offset, byteCount);

                                <tr class="@(isSpare ? "trdp-spare-row" : "")">
                                    <!-- Byte offset -->
                                    <td><span class="trdp-offset-badge">@v.Offset</span></td>
                                    <!-- Name + description -->
                                    <td>
                                        <div class="fw-bold" style="color:var(--mud-palette-text-primary); font-size:0.82rem;">@v.Id</div>
                                        @if (!string.IsNullOrWhiteSpace(v.Description))
                                        {
                                            <div class="trdp-muted" style="font-size:0.72rem;">@v.Description</div>
                                        }
                                    </td>
                                    <!-- Type badge -->
                                    <td>
                                        <span class="trdp-type-badge @GetTypeBadgeClass(v.Type)">@v.Type</span>
                                    </td>
                                    <!-- Value / Bits visualization -->
                                    <td>
                                        @if (isBitType)
                                        {
                                            <div class="trdp-bitrow">
                                                @for (int b = bitWidth - 1; b >= 0; b--)
                                                {
                                                    int bitIdx = b;
                                                    bool bitOn = ((rawInt >> bitIdx) & 1) == 1;
                                                    string bitLabel = GetBitLabel(v, bitIdx);
                                                    string bitTitle = string.IsNullOrEmpty(bitLabel) ? $"bit {bitIdx}" : $"bit {bitIdx}: {bitLabel}";
                                                    <div class="trdp-bit @(bitOn ? "bit-on" : "bit-off")" title="@bitTitle">
                                                        <span class="bit-pos">@bitIdx</span>
                                                        <span class="bit-tick">@(bitOn ? "✓" : "·")</span>
                                                        @if (!string.IsNullOrWhiteSpace(bitLabel))
                                                        {
                                                            <span class="bit-label">@bitLabel</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            double physVal = ComputePhysicalValue(rawPayload, v);
                                            string unit = string.IsNullOrWhiteSpace(v.Unit) ? "" : $" {v.Unit}";
                                            <span class="trdp-val-badge">@physVal.ToString("G6")@unit</span>
                                        }
                                    </td>
                                    <!-- Raw hex bytes -->
                                    <td><code class="trdp-rawbytes">@rawHex</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </MudPaper>

            </MudTabPanel>
        }

        <!-- ── Tab 3: Visor Hexadecimal / Wireshark HexDump ──────────── -->
        <MudTabPanel Text="Visor Hexadecimal / Raw" Icon="@Icons.Material.Filled.Code">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle1" Class="fw-bold">Raw HexDump</MudText>

                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyHexToClipboard">
                    Copiar Raw Hex
                </MudButton>
            </div>

            <MudPaper Elevation="0" Class="pa-4 trdp-hex-box">
                <pre class="hexdump-code">@_hexDumpText</pre>
            </MudPaper>
        </MudTabPanel>

    </MudTabs>
}


