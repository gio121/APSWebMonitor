@page "/ventanas"
@attribute [Authorize]
@rendermode InteractiveServer
@using ApsMonitor.Models
@using ApsMonitor.Services
@inject ApsDataService DataService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<div class="d-flex justify-space-between align-center mb-6">
    <MudText Typo="Typo.h5" Class="fw-bold">Ventanas</MudText>
    @if (_isAdmin)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" Class="rounded-lg" OnClick="CrearNuevaVentana">Nueva Ventana</MudButton>
    }
</div>

<MudTextField @bind-Value="searchString" Immediate="true" Placeholder="Buscar ventanas..." Adornment="Adornment.Start" 
              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" 
              Class="mb-6 search-input" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 400px; background-color: #1a222c;" />

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid>
        @foreach (var window in _filteredWindows.Where(FilterWindow))
        {
            <MudItem xs="12" sm="6" md="4" lg="6"> <!-- lg=6 because in screenshot there are two cards per row -->
                <MudPaper Class="pa-4 window-card h-100 d-flex flex-column" Elevation="0">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <div class="flex-grow-1">
                            <div class="d-flex align-center gap-1">
                                <MudText Typo="Typo.subtitle1" Class="fw-bold">@window.Nombre</MudText>
                                @if (_isAdmin)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Inherit" Class="pa-1 op-7" OnClick="@(() => EditarPropiedades(window))" />
                                }
                            </div>
                            <MudText Typo="Typo.body2" Class="text-muted mb-1">@window.Descripcion</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Categoría: @window.Categoria</MudText>
                        </div>
                        <div class="d-flex gap-2">
                            <MudChip T="string" Size="Size.Small" Color="@(window.Tipo == "Sinóptico" ? Color.Info : Color.Default)" Variant="Variant.Filled">
                                @window.Tipo
                            </MudChip>
                            @if (window.IsActive)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Activa</MudChip>
                            }
                        </div>
                    </div>

                    <!-- Admin: selector de roles con acceso -->
                    @if (_isAdmin)
                    {
                        <div class="mt-2 mb-1">
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ManageAccounts"
                                       OnClick="@(() => ToggleAccessPanel(window.Id))">
                                Accesos
                            </MudButton>

                            @if (IsAccessPanelOpen(window.Id))
                            {
                                <div class="access-panel mt-2">
                                    @foreach (var role in _availableRoles)
                                    {
                                        <MudCheckBox T="bool"
                                                     Label="@role"
                                                     Dense="true"
                                                     Color="Color.Info"
                                                     Value="@window.IsRoleAllowed(role)"
                                                     ValueChanged="@(value => ToggleRoleAccess(window, role, value))" />
                                    }
                                </div>
                            }
                        </div>
                    }
                    
                    <div class="mt-auto pt-4 d-flex gap-2 flex-wrap action-buttons">
                        @if (window.Tipo == "Sinóptico")
                        {
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility" Size="Size.Small" Href="@($"/sinoptico/ver/{window.Id}")">Ver</MudButton>
                            @if (_isAdmin)
                            {
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@($"/sinoptico/{window.Id}")">Editar</MudButton>
                            }
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility" Size="Size.Small">Ver</MudButton>
                            @if (_isAdmin)
                            {
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small">Editar</MudButton>
                            }
                        }
                        @if (_isAdmin)
                        {
                            <MudButton Variant="Variant.Outlined" StartIcon="@(window.IsActive ? Icons.Material.Filled.PowerOff : Icons.Material.Filled.PowerSettingsNew)" Size="Size.Small" OnClick="@(() => ToggleActivarVentana(window))">
                                @(window.IsActive ? "Desactivar" : "Activar")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => DuplicarVentana(window))">Duplicar</MudButton>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Class="ml-auto" OnClick="@(() => EliminarVentana(window))">Eliminar</MudButton>
                        }
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

<style>
    .window-card {
        border: 1px solid rgba(255,255,255,0.08);
        background-color: #1a222c;
        border-radius: 8px;
    }
    .text-muted {
        color: #94a3b8 !important;
    }
    .action-buttons .mud-button {
        text-transform: none;
        color: #e2e8f0;
        border-color: rgba(255,255,255,0.1);
        border-radius: 4px;
        background-color: transparent;
    }
    .action-buttons .mud-button-label {
        font-weight: normal;
    }
    .search-input .mud-input {
        border-radius: 6px;
    }
    .op-7 {
        opacity: 0.7;
    }
    .op-7:hover {
        opacity: 1;
    }
    .access-panel {
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 6px;
        background-color: rgba(0,0,0,0.16);
        padding: 8px 12px;
        max-width: 260px;
    }
</style>

@code {
    private List<Window> _windows = new();
    private List<Window> _filteredWindows = new();
    private bool _isLoading = true;
    private bool _isAdmin = false;
    private string _currentRole = "";
    private string searchString = "";
    private List<string> _availableRoles = new();
    private HashSet<int> _expandedAccessWindowIds = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("Administrador");
        _currentRole = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";

        _windows = await DataService.GetWindowsAsync();
        var users = await DataService.GetUsersAsync();
        _availableRoles = users
            .Select(u => u.Role)
            .Where(role => !string.IsNullOrWhiteSpace(role))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(role => role)
            .ToList();

        _filteredWindows = _isAdmin ? _windows : _windows.Where(CanCurrentRoleSeeWindow).ToList();
        _isLoading = false;
    }

    private bool FilterWindow(Window window)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (window.Nombre.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (window.Descripcion.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private bool CanCurrentRoleSeeWindow(Window window)
    {
        return window.IsActive && window.IsRoleAllowed(_currentRole);
    }

    private bool IsAccessPanelOpen(int windowId)
    {
        return _expandedAccessWindowIds.Contains(windowId);
    }

    private void ToggleAccessPanel(int windowId)
    {
        if (!_expandedAccessWindowIds.Add(windowId))
            _expandedAccessWindowIds.Remove(windowId);
    }

    private async Task ToggleRoleAccess(Window window, string role, bool value)
    {
        window.SetRoleAllowed(role, value);
        await DataService.UpdateWindowAsync(window);
        Snackbar.Add($"Acceso de {role} {(value ? "habilitado" : "deshabilitado")} para '{window.Nombre}'", Severity.Info);
        StateHasChanged();
    }

    private async Task CrearNuevaVentana()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ApsMonitor.Components.Dialogs.NewWindowDialog>("Nueva Ventana", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is ApsMonitor.Components.Dialogs.NewWindowDialog.WindowResult windowData)
        {
            var nuevaVentana = new Window
            {
                Nombre = windowData.Name,
                Descripcion = string.IsNullOrWhiteSpace(windowData.Description) ? "Sin descripción" : windowData.Description,
                Categoria = "General",
                Tipo = "Sinóptico",
                IsActive = false,
                AllowedRolesJson = "[\"Administrador\"]",
                ContentJson = "[]" // Canvas vacío
            };
            
            var creada = await DataService.AddWindowAsync(nuevaVentana);
            if (creada != null && creada.Id > 0)
            {
                // Redirigir inmediatamente al editor del sinóptico creado
                NavigationManager.NavigateTo($"/sinoptico/{creada.Id}", forceLoad: false);
            }
        }
    }

    private async Task EditarPropiedades(Window window)
    {
        var parameters = new DialogParameters<ApsMonitor.Components.Dialogs.NewWindowDialog>
        {
            { x => x.WindowName, window.Nombre },
            { x => x.WindowDescription, window.Descripcion },
            { x => x.SubmitButtonText, "Guardar" }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ApsMonitor.Components.Dialogs.NewWindowDialog>("Editar Detalles", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is ApsMonitor.Components.Dialogs.NewWindowDialog.WindowResult windowData)
        {
            window.Nombre = windowData.Name;
            window.Descripcion = windowData.Description;
            
            await DataService.UpdateWindowAsync(window);
            Snackbar.Add("Ventana actualizada correctamente", Severity.Success);
            StateHasChanged();
        }
    }

    private async Task EliminarVentana(Window window)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirmar Eliminación", 
            $"¿Estás seguro de que quieres eliminar la ventana '{window.Nombre}' permanentemente?", 
            yesText: "Eliminar", cancelText: "Cancelar");
            
        if (result == true)
        {
            await DataService.DeleteWindowAsync(window.Id);
            _windows.Remove(window);
            _filteredWindows = _isAdmin ? _windows : _windows.Where(CanCurrentRoleSeeWindow).ToList();
            StateHasChanged();
        }
    }

    private async Task ToggleActivarVentana(Window window)
    {
        window.IsActive = !window.IsActive;
        await DataService.UpdateWindowAsync(window);
        Snackbar.Add($"Ventana '{window.Nombre}' {(window.IsActive ? "activada" : "desactivada")} correctamente", Severity.Success);
        StateHasChanged();
    }

    private async Task DuplicarVentana(Window window)
    {
        var nuevaVentana = new Window
        {
            Nombre = window.Nombre + " (copia)",
            Descripcion = window.Descripcion,
            Categoria = window.Categoria,
            Tipo = window.Tipo,
            IsActive = false,
            AllowedRolesJson = window.AllowedRolesJson,
            ContentJson = window.ContentJson
        };

        var creada = await DataService.AddWindowAsync(nuevaVentana);
        if (creada != null && creada.Id > 0)
        {
            // La añadimos a la lista local para verla instantáneamente
            _windows.Add(creada);
            _filteredWindows = _isAdmin ? _windows : _windows.Where(CanCurrentRoleSeeWindow).ToList();
            Snackbar.Add($"Ventana '{window.Nombre}' duplicada correctamente", Severity.Success);
            StateHasChanged();
        }
    }
}
