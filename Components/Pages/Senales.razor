@page "/senales"
@rendermode InteractiveServer
@using ApsMonitor.Models
@using ApsMonitor.Services
@using ApsMonitor.Components.Dialogs
@using System.Xml.Linq
@inject ApsDataService DataService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject SessionStateService SessionState
@implements IDisposable

<div class="d-flex justify-space-between align-center mb-6">
    <div class="d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.Sensors" Color="Color.Info" Class="mr-2" />
        <MudText Typo="Typo.h5" Class="fw-bold">
            @(SessionState.IsLoaded ? $"Señales (Sesión: {SessionState.FileName})" : "Señales")
        </MudText>
    </div>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteSweep" Class="rounded-lg mr-2" OnClick="DeleteAllSignals">Borrar Todo</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Upload" Class="rounded-lg" OnClick="AbrirSelectorFichero" Disabled="@_isImporting">
            @if (_isImporting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Importando...</span>
            }
            else
            {
                <span>Importar .cmfx</span>
            }
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" Class="rounded-lg ms-2" OnClick="OpenNewSignalDialog">Nueva Señal</MudButton>
    </div>
</div>

<InputFile id="cmfxFileInput" OnChange="ImportarCmfx" Accept=".cmfx" style="display:none" />

<MudTextField @bind-Value="_searchString" Immediate="true" Placeholder="Buscar..." Adornment="Adornment.Start" 
              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" 
              Class="mb-6 search-input" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 400px; background-color: #1a222c;" />

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudExpansionPanels MultiExpansion="true" Class="nodes-container">
        @foreach (var group in _signals.Where(s => _quickFilter(s)).GroupBy(s => s.NodoNumero).OrderBy(g => g.Key))
        {
            var nodeNum = group.Key;
            var nodeDesc = group.First().NodoDescripcion;
            
            <MudExpansionPanel Class="node-panel mb-2 rounded-lg">
                <TitleContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Router" Color="Color.Info" Class="mr-3" />
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">Nodo @nodeNum: @nodeDesc</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">@group.Count() señales configuradas</MudText>
                        </div>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudPaper Elevation="0" Class="pa-2 mt-2" Style="background-color: #1a222c;">
                        <MudDataGrid T="Signal" Items="@group" Dense="true" Hover="true" Elevation="0">
                            <Columns>
                                <PropertyColumn Property="x => x.Nombre" Title="Nombre" />
                                <PropertyColumn Property="x => x.Tag" Title="Tag" />
                                <PropertyColumn Property="x => x.TipoVariable" Title="Tipo" />
                                <PropertyColumn Property="x => x.BytePosicion" Title="Byte" />
                                <TemplateColumn Title="Valor">
                                    <CellTemplate>
                                        @{
                                            var currentVal = GetCurrentValue(context.Item);
                                        }
                                        @if (context.Item.TipoVariable == "UINT8")
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="@(currentVal == 1 ? Color.Success : Color.Dark)" Variant="Variant.Filled">
                                                @(currentVal == 1 ? "ON" : "OFF")
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2">@FormatValue(currentVal, context.Item)</MudText>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Acciones">
                                    <CellTemplate>
                                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => OpenEditSignalDialog(context.Item))" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteSignal(context.Item))" />
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    </MudPaper>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

<style>
    .nodes-container {
        background: transparent !important;
    }
    .node-panel {
        background-color: #1a222c !important;
        border: 1px solid rgba(255,255,255,0.05);
        color: #e2e8f0 !important;
    }
    .node-panel:hover {
        border-color: rgba(59, 130, 246, 0.3);
    }
    .text-muted {
        color: #94a3b8 !important;
    }
    .mud-expand-panel-header {
        padding: 16px 24px !important;
    }
    .mud-table-root .mud-table-head .mud-table-cell {
        background-color: #1a222c !important;
        color: #94a3b8;
        font-weight: 500;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
</style>

@code {
    private List<Signal> _signals = new();
    private bool _isLoading = true;
    private bool _isImporting = false;
    private string _searchString = "";

    private async Task AbrirSelectorFichero()
    {
        await JS.InvokeVoidAsync("eval", "document.getElementById('cmfxFileInput').click()");
    }

    private Func<Signal, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;
        if (x.Tag != null && x.Tag.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (x.Nombre != null && x.Nombre.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        SessionState.OnStateChanged += SyncValues;
    }

    private void SyncValues()
    {
        InvokeAsync(StateHasChanged);
    }

    private double GetCurrentValue(Signal signal)
    {
        if (SessionState.IsLoaded)
        {
            var values = SessionState.GetCurrentValues();
            return values.TryGetValue(signal.Id, out var val) ? val : 0;
        }
        return signal.ValorActual;
    }

    private string FormatValue(double value, Signal signal)
    {
        return value.ToString(signal.Formato) + (string.IsNullOrWhiteSpace(signal.Unidad) ? "" : $" {signal.Unidad}");
    }

    public void Dispose()
    {
        SessionState.OnStateChanged -= SyncValues;
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _signals = await DataService.GetSignalsAsync();
        _isLoading = false;
    }

    private async Task ImportarCmfx(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _isImporting = true;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var doc = await XDocument.LoadAsync(stream, LoadOptions.None, default);

            // 1. Localizar los NODOS (<node_t>)
            var nodes = doc.Descendants("node_t").ToList();
            if (nodes.Count == 0)
            {
                await ProcessDirectSignals(doc, file.Name);
                return;
            }

            int importados = 0;

            foreach (var node in nodes)
            {
                // Extraer info del NODO
                int nodeNumber = ApsCalculationUtils.SafeParseInt(node.Element("pte_address_node_number")?.Value);
                
                // Buscar descripción en sw/description o en la raíz del nodo
                var swDesc = node.Element("sw")?.Element("description");
                var rootDesc = node.Element("description");
                var descSource = swDesc ?? rootDesc;

                var nodeDescElement = descSource?.Elements("localized_string_t")
                                         .FirstOrDefault(d => d.Element("langid")?.Value == "es");
                
                string nodeDescription = nodeDescElement?.Element("stringvalue")?.Value 
                                         ?? (nodeNumber == 1 ? "Control" : $"Nodo {nodeNumber}");

                // 2. Construir mapa keyname → lista de BytePosicion leyendo <elements>/<valuereference_element_t>
                //    Guardamos LISTA de posiciones porque varias señales (spareByte) comparten keyname
                var positionListMap = new Dictionary<string, Queue<int>>(StringComparer.OrdinalIgnoreCase);
                foreach (var vref in node.Descendants("valuereference_element_t"))
                {
                    var kn = vref.Element("keyname")?.Value ?? "";
                    var pos = ApsCalculationUtils.SafeParseInt(vref.Element("position")?.Value, -1);
                    if (!string.IsNullOrWhiteSpace(kn) && pos >= 0)
                    {
                        if (!positionListMap.ContainsKey(kn))
                            positionListMap[kn] = new Queue<int>();
                        positionListMap[kn].Enqueue(pos);
                    }
                }

                // 3. Extraer señales del nodo, deduplicando por keyname (solo la primera aparición)
                //    Esto evita duplicados sin depender de si los elementos están dentro de frame_t o no
                var seenKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                var elements = node.Descendants("value_element_t")
                    .Where(el => {
                        var kn = el.Element("keyname")?.Value ?? "";
                        return !string.IsNullOrWhiteSpace(kn) && seenKeys.Add(kn);
                    })
                    .ToList();
                int sequentialBytePos = 0;

                foreach (var el in elements)
                {
                    var keyname = el.Element("keyname")?.Value ?? "";
                    if (string.IsNullOrWhiteSpace(keyname)) continue;

                    // Ignorar bytes de relleno (spareByte) — comparten nombre y no tienen datos útiles
                    if (keyname.StartsWith("spare", StringComparison.OrdinalIgnoreCase))
                    {
                        // Avanzar la cola de posiciones para no desfasar las siguientes señales
                        if (positionListMap.TryGetValue(keyname, out var spareQ) && spareQ.Count > 0)
                            spareQ.Dequeue();
                        sequentialBytePos += 1; // spare suele ser 1 byte
                        continue;
                    }

                    // Tomar la siguiente posición disponible para este keyname
                    int bytePos;
                    if (positionListMap.TryGetValue(keyname, out var posQ) && posQ.Count > 0)
                        bytePos = posQ.Dequeue();
                    else
                        bytePos = sequentialBytePos;

                    // Descripciones
                    var descriptions = el.Element("description")?.Elements("localized_string_t").ToList();
                    var descEs = descriptions?.FirstOrDefault(d => d.Element("langid")?.Value == "es")?.Element("stringvalue")?.Value;
                    var descEn = descriptions?.FirstOrDefault(d => d.Element("langid")?.Value == "en")?.Element("stringvalue")?.Value;

                    // Info: unidades
                    var infoNode = el.Element("info");
                    var units = infoNode?.Element("units")?.Value?.Trim();

                    // Value info
                    var valueNode = el.Element("value");
                    var valType = valueNode?.Element("valtype")?.Value ?? "UINT16";
                    var scale = ApsCalculationUtils.SafeParseDouble(valueNode?.Element("scale")?.Value, 1);
                    var offset = ApsCalculationUtils.SafeParseDouble(valueNode?.Element("offset")?.Value, 0);

                    var tipoVariable = MapearTipo(valType);

                    // Forzar a UINT16 si es BITFIELD
                    var infoType = infoNode?.Element("type")?.Value ?? "";
                    if (infoType.ToUpper() == "BITFIELD") tipoVariable = "UINT16";

                    var signal = new Signal
                    {
                        Nombre = descEs ?? keyname,
                        Tag = keyname,
                        DescripcionEs = descEs,
                        DescripcionEn = descEn,
                        TipoVariable = tipoVariable,
                        BytePosicion = bytePos,
                        Escala = scale,
                        Offset = offset,
                        Unidad = units ?? "",
                        Formato = tipoVariable == "FLOAT32" ? "0.01" : "0",
                        NodoNumero = nodeNumber,
                        NodoDescripcion = nodeDescription
                    };

                    // Si es BITFIELD, importar textos de bits
                    if (infoType.ToUpper() == "BITFIELD")
                    {
                        ImportarBits(signal, infoNode);
                    }

                    await DataService.AddSignalAsync(signal);
                    sequentialBytePos += GetByteSize(tipoVariable);
                    importados++;
                }
            }

            Snackbar.Add($"Se importaron {importados} señales de {nodes.Count} nodos desde '{file.Name}'.", Severity.Success);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al importar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isImporting = false;
            StateHasChanged();
        }
    }

    private string MapearTipo(string valType) => valType.ToUpper() switch
    {
        "BYTE" or "UNSIGNED_BYTE" or "ASCII_BYTE" => "UINT8",
        "SBYTE" or "SIGNED_BYTE" => "INT8",
        "BCD_BYTE" => "BCD_BYTE",
        "UINT" or "UNSIGNED_WORD" => "UINT16",
        "INT" or "SIGNED_WORD" => "INT16",
        "ULONG" or "UNSIGNED_DWORD" => "UINT32",
        "SIGNED_DWORD" => "INT32",
        "FLOAT" or "FLOAT32" => "FLOAT32",
        _ => valType
    };

    private int GetByteSize(string tipo) => tipo.ToUpper() switch
    {
        "UINT8" or "INT8" or "BCD_BYTE" => 1,
        "UINT16" or "INT16" => 2,
        "UINT32" or "INT32" or "FLOAT32" => 4,
        _ => 2
    };

    private void ImportarBits(Signal signal, XElement? infoNode)
    {
        var infoElements = infoNode?.Element("info_elements")?.Elements("info_value_element_t").ToList();
        if (infoElements == null) return;

        foreach (var bitEl in infoElements)
        {
            int bitIdx = ApsCalculationUtils.SafeParseInt(bitEl.Element("value")?.Value, -1);
            if (bitIdx >= 0 && bitIdx < 16)
            {
                var bitDesc = bitEl.Element("value_description")?
                                 .Elements("localized_string_t")?
                                 .FirstOrDefault(d => d.Element("langid")?.Value == "es")?
                                 .Element("stringvalue")?.Value;
                
                if (!string.IsNullOrWhiteSpace(bitDesc)) signal.BitTextoActivo[bitIdx] = bitDesc;
            }
        }
    }

    private async Task ProcessDirectSignals(XDocument doc, string fileName)
    {
        // Lógica simplificada para XMLs sin estructura de nodos (como el anterior)
        Snackbar.Add("El archivo no tiene estructura de nodos <node_t>.", Severity.Warning);
    }

    private async Task OpenNewSignalDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SignalDialog>("Nueva Señal", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task OpenEditSignalDialog(Signal signal)
    {
        var parameters = new DialogParameters { ["Signal"] = signal };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SignalDialog>("Editar Señal", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task DeleteSignal(Signal signal)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Eliminar", 
            "¿Estás seguro de que deseas eliminar esta señal?", 
            yesText: "Eliminar", cancelText: "Cancelar");
            
        if (result == true)
        {
            await DataService.DeleteSignalAsync(signal.Id);
            await LoadData();
        }
    }

    private async Task DeleteAllSignals()
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Borrar Todo", 
            "¿Estás seguro de que deseas eliminar TODAS las señales? Esta acción no se puede deshacer.", 
            yesText: "Borrar Todo", cancelText: "Cancelar");
            
        if (result == true)
        {
            await DataService.DeleteAllSignalsAsync();
            Snackbar.Add("Todas las señales han sido eliminadas.", Severity.Info);
            await LoadData();
        }
    }
}
