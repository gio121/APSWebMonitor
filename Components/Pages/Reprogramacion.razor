@page "/reprogramacion"
@attribute [Authorize(Policy = "Page:reprogramacion")]
@rendermode InteractiveServer
@implements IDisposable
@using ApsMonitor.Models
@using ApsMonitor.Components.Dialogs
@inject ReprogrammingService Programmer
@inject MonitorStateService Monitor
@inject DhcpServerService DhcpService
@inject IDialogService Dialogs

<PageTitle>@Ui["Firmware update"]</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">@Ui["System firmware update"]</MudText>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-3">@Ui["Destination and connectivity"]</MudText>
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="TargetIp" Label="@Ui["Destination IP address"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                          Placeholder="192.168.1.10"
                          HelperText="@Ui["IP address of the device to update"]"
                          Disabled="Busy" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="string" Label="@Ui["Select detected IP address"]" Margin="Margin.Dense" Dense="true"
                       Variant="Variant.Outlined" ValueChanged="OnDetectedIpSelected"
                       Placeholder="@Ui["Choose detected IP..."]" Disabled="Busy">
                @foreach (var opt in GetDetectedIps())
                {
                    <MudSelectItem Value="@opt.Ip">@opt.Description</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            @if (_selected?.Kind == "Communications")
            {
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Medium" Icon="@Icons.Material.Filled.Security">
                    @Ui["SFTP: Port 22 (SSH)"]
                </MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium" Icon="@Icons.Material.Filled.Router">
                    @Ui["SEPSA UDP: Port 50001"]
                </MudChip>
            }
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-3" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@Ui["Pre-update monitoring:"]</MudText>
            @if (Monitor.IsMonitoring)
            {
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                    @Ui["Active (link verified)"]
                </MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.PauseCircle">
                    @Ui["Stopped"]
                </MudChip>
            }
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @(Monitor.IsMonitoring 
                    ? Ui["The device channel is active. It will pause during the firmware update to transfer frames."]
                    : Ui["Start monitoring to check that the control board responds."])
            </MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2">
            @if (Monitor.IsMonitoring)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Stop" OnClick="StopMonitoring" Disabled="Busy">
                    @Ui["Stop monitoring"]
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartMonitoring" Disabled="Busy">
                    @Ui["Start pre-update monitoring"]
                </MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-6 mb-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-4">@Ui["System software"]</MudText>
    <MudTable T="ReprogrammingSoftware" Items="_software" Hover="true" Bordered="true" Striped="true"
              SelectedItem="_selected" SelectedItemChanged="SelectSoftware" SelectOnRowClick="true" RowClassFunc="RowClass">
        <HeaderContent>
            <MudTh>@Ui["Software component"]</MudTh>
            <MudTh>@Ui["Type / protocol"]</MudTh>
            <MudTh>@Ui["Description / notes"]</MudTh>
            <MudTh>@Ui["Destination IP"]</MudTh>
            <MudTh>@Ui["Selected file"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Ui["Software component"]">
                <MudButton Variant="Variant.Text" Color="@(_selected == context ? Color.Primary : Color.Default)"
                           OnClick="@(() => SelectSoftware(context))" Disabled="Busy">@context.Id</MudButton>
            </MudTd>
            <MudTd DataLabel="@Ui["Type / protocol"]">
                @if (context.Kind == "Communications")
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">SFTP / SSH (p:22)</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">SEPSA UDP (p:50001)</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="@Ui["Description / notes"]">@context.Description</MudTd>
            <MudTd DataLabel="@Ui["Destination IP"]">
                @(_selections.TryGetValue(context.Id, out var sel) ? sel.Target.Address : TargetIp)
            </MudTd>
            <MudTd DataLabel="@Ui["Selected file"]">
                @if (_selections.TryGetValue(context.Id, out var selection))
                {
                    <span>@selection.FileSummary</span>
                    @if (context.Kind == "Communications")
                    {
                        <span class="mud-text-secondary d-block" style="font-size:0.8rem;">
                            @Ui["Remote path:"] <b>@selection.RemotePath</b> @Ui["· User:"] <b>@selection.SftpUser</b>
                        </span>
                    }
                    else
                    {
                        <span class="mud-text-secondary d-block" style="font-size:0.8rem;">
                            @Ui["Signature:"] <b>@selection.Signature</b> @Ui["· Block:"] <b>@selection.BlockSize B</b> @Ui["· UDP port:"] <b>@selection.Target.UdpPort</b>
                        </span>
                    }
                }
                else
                {
                    <span class="mud-text-secondary">@Ui["Not selected"]</span>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
    <MudText Typo="Typo.body2" Class="mt-4 mb-3">@Ui["Select a software component and press «Change file» to choose the file to upload."]</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
        <MudButton OnClick="ChangeFile" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderOpen" Disabled="@(_selected is null || Busy)">@Ui["Change file…"]</MudButton>
        <MudButton OnClick="Start" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SystemUpdateAlt" Disabled="@(CurrentSelection is null || Busy)">@Ui["Update firmware"]</MudButton>
        <MudButton OnClick="Send8ACommand" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Terminal" Disabled="Busy">@Ui["Send 8A command"]</MudButton>
        <MudButton OnClick="ClearSelection" Disabled="@(_selected is null || Busy)">@Ui["Cancel selection"]</MudButton>
    </MudStack>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert> }
</MudPaper>

<MudPaper Class="pa-6" Outlined="true" aria-live="polite">
    <MudText Typo="Typo.h6">@Ui["Firmware update status"]</MudText>
    <MudText Class="my-3">@Programmer.State.Message</MudText>
    <MudProgressLinear Value="Programmer.State.Percent" Color="@(Programmer.State.Success ? Color.Success : Color.Primary)" />
    <MudText Typo="Typo.caption" Class="mt-2">@Programmer.State.Percent.ToString("F0") %</MudText>
    @if (Programmer.State.Running)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-3">@Ui["Keep the device powered and the server running until the update finishes. Monitoring is stopped during the firmware update."]</MudAlert>
    }
</MudPaper>

<style>
    .software-selected > td { background-color: var(--mud-palette-primary-hover) !important; }
    .software-selected > td:first-child { box-shadow: inset 3px 0 var(--mud-palette-primary); }
</style>

@code {
    private readonly ReprogrammingSoftware[] _software = [
        new("SELCONT0001", ApsMonitor.Resources.MonitorResources.Text("C135KI · Control unit"), "Control", "C135KI"),
        new("SELFPGA0001", ApsMonitor.Resources.MonitorResources.Text("C135KF · Control FPGA"), "FPGA", "F22044"),
        new("SELCOMM0001", "C135KX · ECN / Communications", ApsMonitor.Resources.MonitorResources.Text("Communications"), ""),
        new("SELCOMM0002", ApsMonitor.Resources.MonitorResources.Text("C135KD · ECN / communications configuration"), ApsMonitor.Resources.MonitorResources.Text("Communications"), "")
    ];
    private readonly Dictionary<string, ReprogrammingSelection> _selections = new();
    private ReprogrammingSoftware? _selected;
    private bool _editing, _starting, _disposed;
    private string? _error;
    private bool Busy => Programmer.State.Running || _editing || _starting;
    private ReprogrammingSelection? CurrentSelection => _selected is not null && _selections.TryGetValue(_selected.Id, out var value) ? value : null;

    private record DetectedIpOption(string Ip, string Description);
    private string _targetIp = "";
    private string TargetIp
    {
        get => _targetIp;
        set
        {
            if (_targetIp != value)
            {
                _targetIp = value;
                if (!string.IsNullOrWhiteSpace(_targetIp))
                {
                    UpdateSelectionsTargetIp(_targetIp);
                }
            }
        }
    }

    private void UpdateSelectionsTargetIp(string ip)
    {
        foreach (var key in _selections.Keys.ToList())
        {
            var sel = _selections[key];
            _selections[key] = sel with { Target = sel.Target with { Address = ip.Trim() } };
        }
    }

    private List<DetectedIpOption> GetDetectedIps()
    {
        var list = new List<DetectedIpOption>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(Monitor.IpAddress) && seen.Add(Monitor.IpAddress))
        {
            list.Add(new(Monitor.IpAddress, $"{Monitor.IpAddress} (Monitor)"));
        }

        foreach (var lease in DhcpService.GetActiveLeases())
        {
            if (seen.Add(lease.IpAddress))
            {
                var name = !string.IsNullOrWhiteSpace(lease.HostName) ? lease.HostName : lease.MacAddress;
                list.Add(new(lease.IpAddress, $"{lease.IpAddress} (DHCP: {name})"));
            }
        }

        return list;
    }

    private void OnDetectedIpSelected(string? ip)
    {
        if (!string.IsNullOrWhiteSpace(ip))
        {
            TargetIp = ip;
        }
    }

    protected override void OnInitialized()
    {
        Programmer.Changed += Update;
        Monitor.OnStateChanged += Update;
        DhcpService.OnLeasesChanged += OnLeasesChanged;

        _targetIp = !string.IsNullOrWhiteSpace(Monitor.IpAddress)
            ? Monitor.IpAddress
            : (DhcpService.GetActiveLeases().FirstOrDefault()?.IpAddress ?? "192.168.1.10");
    }

    private void OnLeasesChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void Update() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private void SelectSoftware(ReprogrammingSoftware? software) { if (!Busy) { _selected = software; _error = null; } }
    private string RowClass(ReprogrammingSoftware software, int index) => software == _selected ? "software-selected" : "";
    private void ClearSelection() { if (!Busy) { _selected = null; _error = null; } }

    private void StartMonitoring()
    {
        if (!string.IsNullOrWhiteSpace(TargetIp))
        {
            Monitor.IpAddress = TargetIp.Trim();
        }
        _ = Monitor.ConnectAsync().ContinueWith(_ => Monitor.StartMonitoring());
    }

    private void StopMonitoring()
    {
        Monitor.StopMonitoring();
    }

    private async Task ChangeFile()
    {
        if (_selected is null || Busy) return;
        var software = _selected;
        _editing = true;
        _error = null;
        try
        {
            var initialAddress = !string.IsNullOrWhiteSpace(TargetIp)
                ? TargetIp
                : (CurrentSelection?.Target.Address ?? Monitor.IpAddress);

            var parameters = new DialogParameters<ReprogrammingFileDialog>
            {
                { x => x.Software, software },
                { x => x.Selection, CurrentSelection },
                { x => x.Address, initialAddress }
            };
            var dialog = await Dialogs.ShowAsync<ReprogrammingFileDialog>(ApsMonitor.Resources.MonitorResources.Text("Change file"), parameters,
                new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false, CloseOnEscapeKey = false });
            var result = await dialog.Result;
            if (result is { Canceled: false, Data: ReprogrammingSelection selection })
            {
                _selections[software.Id] = selection;
                if (!string.IsNullOrWhiteSpace(selection.Target.Address))
                {
                    TargetIp = selection.Target.Address;
                }
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _editing = false; }
    }

    private async Task Send8ACommand()
    {
        var targetAddress = !string.IsNullOrWhiteSpace(TargetIp)
            ? TargetIp.Trim()
            : (!string.IsNullOrWhiteSpace(Monitor.IpAddress) ? Monitor.IpAddress : "192.168.1.10");

        bool? confirmed = await Dialogs.ShowMessageBoxAsync(ApsMonitor.Resources.MonitorResources.Text("Confirm 8A command"),
            ApsMonitor.Resources.MonitorResources.Format("Confirm8ACommandMessage",targetAddress) +
            ApsMonitor.Resources.MonitorResources.Text("The device will check for files in /mnt/artifacts/update and begin the firmware update."),
            yesText: ApsMonitor.Resources.MonitorResources.Text("Send 8A command"), cancelText: ApsMonitor.Resources.MonitorResources.Text("Cancel"));
        if (confirmed != true) return;

        _error = null;
        _starting = true;
        try
        {
            var result = await Programmer.SendReprogramming8ACommandAsync(targetAddress);
            if (result.Success)
            {
                await Dialogs.ShowMessageBoxAsync(ApsMonitor.Resources.MonitorResources.Text("8A command response (success)"),
                    ApsMonitor.Resources.MonitorResources.Format("Device response: {0}",result.Message),
                    yesText: ApsMonitor.Resources.MonitorResources.Text("OK"));
            }
            else
            {
                _error = ApsMonitor.Resources.MonitorResources.Format("8A command failed: {0}",result.Message);
                await Dialogs.ShowMessageBoxAsync(ApsMonitor.Resources.MonitorResources.Text("8A command response (failure)"),
                    ApsMonitor.Resources.MonitorResources.Format("Device response: {0}",result.Message),
                    yesText: ApsMonitor.Resources.MonitorResources.Text("OK"));
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task Start()
    {
        if (_selected is null || CurrentSelection is not { } selection || Busy) return;
        var software = _selected;
        _error = null; _starting = true;
        try
        {
            var targetAddress = !string.IsNullOrWhiteSpace(TargetIp) ? TargetIp.Trim() : selection.Target.Address;
            var target = selection.Target with { Address = targetAddress };

            string details = selection.Image is null
                ? selection.FileSummary
                : $"{selection.FileName}; firma {selection.Signature}; {selection.Image.Length} bytes; CRC32 {ReprogrammingProtocol.Crc32(selection.Image):X8}; bloque {selection.BlockSize} B.";
            
            string portInfo = software.Kind == "Communications"
                ? ApsMonitor.Resources.MonitorResources.Format("SFTP port 22, user '{0}', remote path '{1}'",selection.SftpUser,selection.RemotePath)
                : ApsMonitor.Resources.MonitorResources.Format("SEPSA UDP port {0} (Node 2 - Control board)",target.UdpPort);

            string monitorWarning = Monitor.IsMonitoring
                ? ApsMonitor.Resources.MonitorResources.Text("MonitoringPauseNotice")
                : "";

            bool? confirmed = await Dialogs.ShowMessageBoxAsync(ApsMonitor.Resources.MonitorResources.Text("Confirm firmware update"),
                ApsMonitor.Resources.MonitorResources.Format("FirmwareDestinationMessage",software.Id,software.Description,target.Address) +
                $"Canal: {portInfo}.\n" +
                $"{details}\n" +
                ApsMonitor.Resources.MonitorResources.Format("ConfirmFirmwareUpdateMessage",monitorWarning),
                yesText: ApsMonitor.Resources.MonitorResources.Text("Start"), cancelText: ApsMonitor.Resources.MonitorResources.Text("Cancel"));
            if (confirmed != true) return;

            if (software.Kind == "Communications")
                await Programmer.UploadCommunicationsAsync(target, 22, selection.HostKey, selection.Files,
                    selection.SftpUser, selection.SftpPassword, selection.RemotePath, trigger8ACommand: true);
            else
                await Programmer.UploadControlAsync(target, software.Kind == "FPGA", selection.Signature, selection.Image!, selection.BlockSize);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _starting = false; }
    }

    public void Dispose()
    {
        _disposed = true;
        Programmer.Changed -= Update;
        Monitor.OnStateChanged -= Update;
        DhcpService.OnLeasesChanged -= OnLeasesChanged;
    }
}
