@code {
    private List<SignalValue> _currentValues = new();
    private Dictionary<int, double>? _previousValues;
    private bool _isLoading = false;
    private string _searchString = "";
    private readonly SessionParserService _parser = new();

    // ── Estado del Buffer Circular (puerto 8080) ─────────────────────────────────
    private bool _showCircularPanel = false;
    private string _boardHost = "192.168.15.1";
    private int _boardHttpPort = 8080;
    private bool _isFetchingBuffer = false;
    private bool _isLoadingRangeSummary = false;
    private bool _isDownloadingFromBuffer = false;
    private bool _autoRefreshBuffer = false;
    private string? _bufferError;

    private CircularSessionInfoDto? _bufferInfo;
    private CircularRangeSummaryDto? _rangeSummary;
    private CircularReplayStatusDto? _replayStatus;

    private ulong _selectedFromUs;
    private ulong _selectedToUs;
    private double _rangeStartPct = 0.0;
    private double _rangeEndPct = 100.0;
    private string _fromInputText = "";
    private string _toInputText = "";
    private string _selectedSourceType = "all";

    private float _replaySpeed = 1.0f;
    private string _replayTargetIp = "127.0.0.1";
    private ushort _replayTargetPort = 50002;
    private bool _replayLoop = false;
    private bool _isReplayBusy = false;

    private System.Threading.Timer? _autoRefreshTimer;
    private CancellationTokenSource? _rangeSummaryCts;

    private Func<SignalValue, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (x.Tag.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.Nombre.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    };

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(MonitorState.IpAddress))
        {
            _boardHost = MonitorState.IpAddress;
        }

        SessionState.OnStateChanged += SyncValues;
        if (SessionState.IsLoaded) SyncValues();
    }

    private async Task ToggleCircularPanel()
    {
        _showCircularPanel = !_showCircularPanel;
        if (_showCircularPanel && _bufferInfo == null && !_isFetchingBuffer)
        {
            await FetchCircularSessionInfoAsync();
        }
    }

    private async Task FetchCircularSessionInfoAsync()
    {
        if (_isFetchingBuffer) return;
        _isFetchingBuffer = true;
        _bufferError = null;
        StateHasChanged();

        try
        {
            bool hadPreviousRange = _bufferInfo != null && _selectedToUs > _selectedFromUs;
            bool wasAtRightEdge = _rangeEndPct >= 99.5;

            var info = await CircularClient.GetSessionInfoAsync(_boardHost, _boardHttpPort, 60);
            _bufferInfo = info;

            if (_bufferInfo != null && _bufferInfo.TotalFrames > 0)
            {
                if (!hadPreviousRange)
                {
                    _rangeStartPct = 0.0;
                    _rangeEndPct = 100.0;
                    _selectedFromUs = _bufferInfo.StartTimestampUs;
                    _selectedToUs = _bufferInfo.EndTimestampUs;
                }
                else if (wasAtRightEdge)
                {
                    _selectedToUs = _bufferInfo.EndTimestampUs;
                    _selectedFromUs = Math.Clamp(_selectedFromUs, _bufferInfo.StartTimestampUs, _selectedToUs);
                    RecalculatePercentagesFromTimestamps();
                }
                else
                {
                    _selectedFromUs = Math.Clamp(_selectedFromUs, _bufferInfo.StartTimestampUs, _bufferInfo.EndTimestampUs);
                    _selectedToUs = Math.Clamp(_selectedToUs, _selectedFromUs, _bufferInfo.EndTimestampUs);
                    RecalculatePercentagesFromTimestamps();
                }

                SyncTextInputsFromTimestamps();
                await RefreshRangeSummaryAsync();
            }

            try
            {
                _replayStatus = await CircularClient.GetReplayStatusAsync(_boardHost, _boardHttpPort);
            }
            catch { }
        }
        catch (Exception ex)
        {
            _bufferError = $"No se pudo conectar con http://{_boardHost}:{_boardHttpPort}/api/session/info ({ex.Message})";
        }
        finally
        {
            _isFetchingBuffer = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnAutoRefreshChanged(bool enabled)
    {
        _autoRefreshBuffer = enabled;
        _autoRefreshTimer?.Dispose();
        _autoRefreshTimer = null;

        if (enabled)
        {
            _autoRefreshTimer = new System.Threading.Timer(async _ =>
            {
                if (!_autoRefreshBuffer || _isFetchingBuffer) return;
                await InvokeAsync(FetchCircularSessionInfoAsync);
            }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        }
    }

    private void OnStartPercentChanged(double newStartPct)
    {
        if (_bufferInfo == null) return;
        _rangeStartPct = Math.Clamp(newStartPct, 0.0, Math.Max(0.0, _rangeEndPct - 0.5));
        UpdateTimestampsFromPercentages();
        QueueRangeSummaryUpdate();
    }

    private void OnEndPercentChanged(double newEndPct)
    {
        if (_bufferInfo == null) return;
        _rangeEndPct = Math.Clamp(newEndPct, Math.Min(100.0, _rangeStartPct + 0.5), 100.0);
        UpdateTimestampsFromPercentages();
        QueueRangeSummaryUpdate();
    }

    private void OnBucketClicked(int bucketIndex)
    {
        if (_bufferInfo == null || bucketIndex < 0 || bucketIndex >= _bufferInfo.TimelineBuckets.Count)
            return;

        var b = _bufferInfo.TimelineBuckets[bucketIndex];
        ulong midClick = b.StartTimestampUs + (b.EndTimestampUs - b.StartTimestampUs) / 2;
        ulong distToStart = midClick > _selectedFromUs ? midClick - _selectedFromUs : _selectedFromUs - midClick;
        ulong distToEnd = midClick > _selectedToUs ? midClick - _selectedToUs : _selectedToUs - midClick;

        if (distToStart <= distToEnd)
        {
            _selectedFromUs = Math.Min(b.StartTimestampUs, _selectedToUs);
        }
        else
        {
            _selectedToUs = Math.Max(b.EndTimestampUs, _selectedFromUs);
        }

        RecalculatePercentagesFromTimestamps();
        SyncTextInputsFromTimestamps();
        QueueRangeSummaryUpdate();
    }

    private void ApplyQuickRangeSeconds(ulong seconds)
    {
        if (_bufferInfo == null) return;
        _selectedToUs = _bufferInfo.EndTimestampUs;
        ulong deltaUs = seconds * 1_000_000UL;
        _selectedFromUs = _bufferInfo.EndTimestampUs > deltaUs
            ? Math.Max(_bufferInfo.StartTimestampUs, _bufferInfo.EndTimestampUs - deltaUs)
            : _bufferInfo.StartTimestampUs;

        RecalculatePercentagesFromTimestamps();
        SyncTextInputsFromTimestamps();
        QueueRangeSummaryUpdate();
    }

    private void SelectFullBufferRange()
    {
        if (_bufferInfo == null) return;
        _selectedFromUs = _bufferInfo.StartTimestampUs;
        _selectedToUs = _bufferInfo.EndTimestampUs;
        _rangeStartPct = 0.0;
        _rangeEndPct = 100.0;
        SyncTextInputsFromTimestamps();
        QueueRangeSummaryUpdate();
    }

    private void OnFromTextChanged(string value)
    {
        _fromInputText = value;
        if (_bufferInfo == null) return;
        if (DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var dt))
        {
            ulong us = CircularBufferClientService.LocalDateTimeToTimestampUs(dt);
            _selectedFromUs = Math.Clamp(us, _bufferInfo.StartTimestampUs, _selectedToUs);
            RecalculatePercentagesFromTimestamps();
            QueueRangeSummaryUpdate();
        }
    }

    private void OnToTextChanged(string value)
    {
        _toInputText = value;
        if (_bufferInfo == null) return;
        if (DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var dt))
        {
            ulong us = CircularBufferClientService.LocalDateTimeToTimestampUs(dt);
            _selectedToUs = Math.Clamp(us, _selectedFromUs, _bufferInfo.EndTimestampUs);
            RecalculatePercentagesFromTimestamps();
            QueueRangeSummaryUpdate();
        }
    }

    private void OnSourceTypeChanged(string newType)
    {
        _selectedSourceType = newType;
        QueueRangeSummaryUpdate();
    }

    private void UpdateTimestampsFromPercentages()
    {
        if (_bufferInfo == null) return;
        ulong span = _bufferInfo.EndTimestampUs > _bufferInfo.StartTimestampUs
            ? _bufferInfo.EndTimestampUs - _bufferInfo.StartTimestampUs
            : 0UL;

        _selectedFromUs = _bufferInfo.StartTimestampUs + (ulong)(span * (_rangeStartPct / 100.0));
        _selectedToUs = _bufferInfo.StartTimestampUs + (ulong)(span * (_rangeEndPct / 100.0));
        if (_selectedToUs < _selectedFromUs)
            _selectedToUs = _selectedFromUs;

        SyncTextInputsFromTimestamps();
    }

    private void RecalculatePercentagesFromTimestamps()
    {
        if (_bufferInfo == null || _bufferInfo.EndTimestampUs <= _bufferInfo.StartTimestampUs)
        {
            _rangeStartPct = 0.0;
            _rangeEndPct = 100.0;
            return;
        }

        double span = _bufferInfo.EndTimestampUs - _bufferInfo.StartTimestampUs;
        _rangeStartPct = Math.Clamp((_selectedFromUs - _bufferInfo.StartTimestampUs) / span * 100.0, 0.0, 100.0);
        _rangeEndPct = Math.Clamp((_selectedToUs - _bufferInfo.StartTimestampUs) / span * 100.0, 0.0, 100.0);
    }

    private void SyncTextInputsFromTimestamps()
    {
        _fromInputText = FormatUsDateTime(_selectedFromUs);
        _toInputText = FormatUsDateTime(_selectedToUs);
    }

    private void QueueRangeSummaryUpdate()
    {
        _rangeSummaryCts?.Cancel();
        _rangeSummaryCts?.Dispose();
        _rangeSummaryCts = new CancellationTokenSource();
        var token = _rangeSummaryCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(180, token);
                await InvokeAsync(() => RefreshRangeSummaryAsync(token));
            }
            catch (OperationCanceledException) { }
        }, token);
    }

    private async Task RefreshRangeSummaryAsync(CancellationToken ct = default)
    {
        if (_bufferInfo == null) return;
        _isLoadingRangeSummary = true;
        StateHasChanged();

        try
        {
            _rangeSummary = await CircularClient.GetRangeSummaryAsync(
                _boardHost,
                _boardHttpPort,
                _selectedFromUs,
                _selectedToUs,
                _selectedSourceType,
                null,
                ct);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al consultar resumen de franja: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _isLoadingRangeSummary = false;
            StateHasChanged();
        }
    }

    private async Task LoadSelectedRangeIntoMonitorAsync()
    {
        if (_bufferInfo == null) return;
        _isDownloadingFromBuffer = true;
        StateHasChanged();

        try
        {
            var signals = await DataService.GetSignalsAsync();
            if (signals.Count == 0)
            {
                Snackbar.Add("No hay señales configuradas en el proyecto actual.", Severity.Warning);
                return;
            }

            // Si el usuario tiene "all", pedimos las tramas de la franja y el parser decodifica las de Control/PTE
            var sessionDto = await CircularClient.DownloadSessionJsonAsync(
                _boardHost,
                _boardHttpPort,
                _selectedFromUs,
                _selectedToUs,
                _selectedSourceType);

            if (sessionDto?.Frames == null || sessionDto.Frames.Count == 0)
            {
                Snackbar.Add("No se encontraron tramas en la franja seleccionada.", Severity.Warning);
                return;
            }

            var dataset = _parser.ParseCircularFrames(sessionDto.Frames, signals);
            if (dataset == null || dataset.FrameCount == 0)
            {
                Snackbar.Add("La franja descargada no contiene tramas de control decodificables para las señales actuales.", Severity.Warning);
                return;
            }

            string label = $"Buffer {_boardHost} ({FormatUsTimeOnly(_selectedFromUs)}–{FormatUsTimeOnly(_selectedToUs)})";
            SessionState.LoadSession(dataset, signals, label);
            Snackbar.Add($"Sesión del buffer circular cargada ({dataset.FrameCount:N0} snapshots de señales).", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar franja del buffer circular: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDownloadingFromBuffer = false;
            StateHasChanged();
        }
    }

    private async Task DownloadSelectedRangeFileAsync(string format)
    {
        if (_bufferInfo == null) return;
        _isDownloadingFromBuffer = true;
        StateHasChanged();

        try
        {
            var (bytes, fileName, contentType) = await CircularClient.DownloadSessionBytesAsync(
                _boardHost,
                _boardHttpPort,
                format,
                _selectedFromUs,
                _selectedToUs,
                _selectedSourceType);

            await JS.InvokeVoidAsync("apsMonitor.downloadBase64File", fileName, contentType, Convert.ToBase64String(bytes));
            Snackbar.Add($"Archivo {fileName} descargado ({CircularBufferClientService.FormatBytes((ulong)bytes.Length)}).", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error descargando {format.ToUpperInvariant()}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDownloadingFromBuffer = false;
            StateHasChanged();
        }
    }

    private async Task DownloadSelectedRangeAsDatAsync()
    {
        if (_bufferInfo == null) return;
        _isDownloadingFromBuffer = true;
        StateHasChanged();

        try
        {
            var sessionDto = await CircularClient.DownloadSessionJsonAsync(
                _boardHost,
                _boardHttpPort,
                _selectedFromUs,
                _selectedToUs,
                _selectedSourceType);

            if (sessionDto?.Frames == null || sessionDto.Frames.Count == 0)
            {
                Snackbar.Add("No hay tramas en la franja seleccionada para exportar a .dat.", Severity.Warning);
                return;
            }

            byte[] datBytes = _parser.ConvertCircularFramesToDatBytes(sessionDto.Frames);
            if (datBytes.Length == 0)
            {
                Snackbar.Add("No se encontraron tramas compatibles con formato .dat en el rango.", Severity.Warning);
                return;
            }

            string fileName = $"sesion_buffer_{DateTime.Now:yyyyMMdd_HHmmss}.dat";
            await JS.InvokeVoidAsync("apsMonitor.downloadBase64File", fileName, "text/plain;charset=utf-8", Convert.ToBase64String(datBytes));
            Snackbar.Add($"Archivo {fileName} exportado correctamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exportando .DAT: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDownloadingFromBuffer = false;
            StateHasChanged();
        }
    }

    private async Task StartBoardReplayAsync()
    {
        if (_bufferInfo == null) return;
        _isReplayBusy = true;
        StateHasChanged();

        try
        {
            var res = await CircularClient.StartReplayAsync(
                _boardHost,
                _boardHttpPort,
                _selectedFromUs,
                _selectedToUs,
                _selectedSourceType,
                _replaySpeed,
                _replayTargetIp,
                _replayTargetPort,
                _replayLoop);

            _replayStatus = await CircularClient.GetReplayStatusAsync(_boardHost, _boardHttpPort);
            Snackbar.Add($"Replay iniciado en placa ({res?.ReplayInfo?.TotalFrames ?? 0:N0} tramas a {_replaySpeed}x).", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo iniciar el replay: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isReplayBusy = false;
            StateHasChanged();
        }
    }

