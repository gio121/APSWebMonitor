    private double GetMemoryUsagePercent()
    {
        if (_bufferInfo == null || _bufferInfo.TotalCapacityBytes == 0) return 0;
        return Math.Clamp((double)_bufferInfo.UsedBytes / _bufferInfo.TotalCapacityBytes * 100.0, 0.0, 100.0);
    }

