@page "/sesiones"
@rendermode InteractiveServer
@using ApsMonitor.Models
@using ApsMonitor.Services
@using System.Text
@inject SessionStateService SessionState
@inject ApsDataService DataService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IDisposable

<div class="d-flex justify-space-between align-center mb-4 mt-n2">
    <MudText Typo="Typo.h5" Class="fw-bold">Gestión de Sesiones</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="AbrirSelectorDat" Disabled="@_isLoading">
        @if (_isLoading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>Procesando...</span>
        }
        else
        {
            <span>Cargar Nueva Sesión (.dat)</span>
        }
    </MudButton>
</div>

@if (!SessionState.IsLoaded)
{
    <MudPaper Class="pa-8 d-flex flex-column align-center justify-center session-empty" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Large" Color="Color.Primary" Class="mb-4" Style="font-size: 64px;" />
        <MudText Typo="Typo.h6" Class="mb-2">No hay ninguna sesión activa</MudText>
        <MudText Typo="Typo.body2" Class="text-muted">Sube un archivo .dat para analizar las tramas y ver los valores de las señales</MudText>
    </MudPaper>
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 h-100" Elevation="0" Style="background-color: #1a222c; border: 1px solid rgba(255,255,255,0.05);">
                <MudText Typo="Typo.subtitle2" Class="text-muted mb-2">DETALLES DEL ARCHIVO</MudText>
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.body2">Nombre:</MudText>
                        <MudText Typo="Typo.body2" Class="fw-bold">@SessionState.FileName</MudText>
                    </div>
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.body2">Tramas:</MudText>
                        <MudText Typo="Typo.body2">@SessionState.Frames?.Count.ToString("N0")</MudText>
                    </div>
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.body2">Hora Fin:</MudText>
                        <MudText Typo="Typo.body2">@FormatAbsoluteTime(SessionState.Frames!.Last())</MudText>
                    </div>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 h-100 d-flex flex-column justify-center" Elevation="0" Style="background-color: #1a222c; border: 1px solid rgba(255,255,255,0.05);">
                <MudText Typo="Typo.subtitle2" Class="text-muted mb-2">POSICIÓN ACTUAL</MudText>
                <div class="d-flex align-center gap-4">
                    <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">@FormatAbsoluteTime(SessionState.Frames![SessionState.CurrentFrame])</MudText>
                    <MudText Typo="Typo.subtitle1" Class="text-muted">/ @FormatAbsoluteTime(SessionState.Frames!.Last())</MudText>
                    <MudSpacer />
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Text">Trama @(SessionState.CurrentFrame + 1)</MudChip>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
    <div>
        <MudTextField @bind-Value="_searchString" Immediate="true" Placeholder="Buscar señal..." 
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" 
                      IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" 
                      Style="max-width:300px; background-color:#1a222c;" />
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="text-muted">Despliega un nodo para ver sus valores en tiempo real</MudText>
    </div>

    <MudExpansionPanels MultiExpansion="true" Class="nodes-container">
        @foreach (var group in _currentValues.Where(v => _quickFilter(v)).GroupBy(v => v.NodoNumero).OrderBy(g => g.Key))
        {
            var nodeNum = group.Key;
            var nodeDesc = group.First().NodoDescripcion;
            var changingCount = group.Count(v => v.HasChanged);

            <MudExpansionPanel Class="node-panel mb-2 rounded-lg">
                <TitleContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Router" Color="Color.Info" Class="mr-3" />
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">Nodo @nodeNum: @nodeDesc</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">@group.Count() señales en este nodo</MudText>
                        </div>
                        @if (changingCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.Timeline">
                                @changingCount variando
                            </MudChip>
                        }
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudPaper Elevation="0" Class="pa-2 mt-2" Style="background-color: #1a222c;">
                        <MudDataGrid T="SignalValue" Items="@group" Dense="true" Hover="true" Elevation="0">
                            <Columns>
                                <PropertyColumn Property="x => x.Tag" Title="Tag" CellStyle="width: 150px;" HeaderStyle="width: 150px;" />
                                <PropertyColumn Property="x => x.Nombre" Title="Nombre" CellStyle="width: 350px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" HeaderStyle="width: 350px;" />
                                <TemplateColumn Title="Valor" CellStyle="width: 250px;" HeaderStyle="width: 250px;">
                                    <CellTemplate>
                                        <div class="@(context.Item.HasChanged ? "value-changed" : "")" style="width: 230px; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            @context.Item.FormattedValue
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.Unidad" Title="Unidad" Width="80px" />
                                <TemplateColumn Title="Raw Value" CellStyle="width: 120px;" HeaderStyle="width: 120px;">
                                    <CellTemplate>
                                        <div style="font-variant-numeric: tabular-nums;">
                                            @context.Item.RawValue
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    </MudPaper>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

<InputFile id="datFileInput" OnChange="CargarDat" Accept=".dat" style="display:none" />

<style>
    .session-empty {
        border: 2px dashed rgba(255,255,255,0.1);
        background-color: #1a222c;
        border-radius: 12px;
        min-height: 400px;
    }
    .nodes-container {
        background: transparent !important;
    }
    .node-panel {
        background-color: #1a222c !important;
        border: 1px solid rgba(255,255,255,0.05);
        color: #e2e8f0 !important;
    }
    .node-panel:hover {
        border-color: rgba(59, 130, 246, 0.3);
    }
    .text-muted {
        color: #94a3b8 !important;
    }
    .value-changed {
        color: #3b82f6 !important;
        text-shadow: 0 0 8px rgba(59, 130, 246, 0.4);
    }
    .mud-table-root .mud-table-head .mud-table-cell {
        background-color: #1a222c !important;
        color: #94a3b8;
        font-weight: 500;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
</style>

@code {
    private List<SignalValue> _currentValues = new();
    private Dictionary<int, double>? _previousValues;
    private bool _isLoading = false;
    private string _searchString = "";
    private readonly SessionParserService _parser = new();

    private Func<SignalValue, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (x.Tag.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.Nombre.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    };

    protected override void OnInitialized()
    {
        SessionState.OnStateChanged += SyncValues;
        if (SessionState.IsLoaded) SyncValues();
    }

    private void SyncValues()
    {
        InvokeAsync(() => {
            UpdateCurrentValues();
            StateHasChanged();
        });
    }

    private async Task AbrirSelectorDat()
    {
        await JS.InvokeVoidAsync("eval", "document.getElementById('datFileInput').click()");
    }

    private async Task CargarDat(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _isLoading = true;
        StateHasChanged();

        try
        {
            var signals = await DataService.GetSignalsAsync();
            if (signals.Count == 0)
            {
                Snackbar.Add("No hay señales configuradas.", Severity.Warning);
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            
            var frames = _parser.Parse(ms.ToArray(), signals);

            if (frames.Count == 0)
            {
                Snackbar.Add("El archivo no contiene tramas válidas.", Severity.Warning);
                return;
            }

            SessionState.LoadSession(frames, signals, file.Name);
            Snackbar.Add($"Sesión cargada correctamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void UpdateCurrentValues()
    {
        if (!SessionState.IsLoaded) return;

        var values = SessionState.GetCurrentValues();

        if (_currentValues.Count != SessionState.Signals.Count)
        {
            _currentValues.Clear();
            foreach (var signal in SessionState.Signals)
            {
                _currentValues.Add(new SignalValue
                {
                    Id = signal.Id,
                    Tag = signal.Tag,
                    Nombre = signal.Nombre,
                    TipoVariable = signal.TipoVariable,
                    Unidad = signal.Unidad ?? "",
                    NodoNumero = signal.NodoNumero,
                    NodoDescripcion = signal.NodoDescripcion
                });
            }
        }

        foreach (var cv in _currentValues)
        {
            var signal = SessionState.Signals.FirstOrDefault(s => s.Id == cv.Id);
            if (signal == null) continue;

            double value = values.TryGetValue(signal.Id, out var v) ? v : 0;
            bool changed = _previousValues != null 
                && _previousValues.TryGetValue(signal.Id, out var prev) 
                && Math.Abs(prev - value) > 0.00001;

            string formattedValue;
            if (signal.IsAscii)
            {
                formattedValue = ((char)Math.Max(0, Math.Min(255, value))).ToString();
            }
            else if (signal.BitCount > 1 && signal.BitTextoActivo.Any(t => !string.IsNullOrEmpty(t)))
            {
                var activeBits = new List<string>();
                int intVal = (int)value;
                for (int i = 0; i < 16; i++)
                {
                    if ((intVal & (1 << i)) != 0 && !string.IsNullOrEmpty(signal.BitTextoActivo[i]))
                    {
                        activeBits.Add(signal.BitTextoActivo[i]!);
                    }
                }
                formattedValue = activeBits.Count > 0 ? string.Join(", ", activeBits) : "0 (Todo OK)";
            }
            else
            {
                formattedValue = value.ToString(signal.Formato) + (string.IsNullOrEmpty(signal.Unidad) ? "" : " " + signal.Unidad);
            }

            cv.FormattedValue = formattedValue;
            cv.RawValue = value;
            cv.HasChanged = changed;
        }

        _previousValues = new Dictionary<int, double>(values);
    }

    private string FormatTime(TimeSpan ts) => ts.ToString(@"mm\:ss\.ff");

    private string FormatAbsoluteTime(SessionFrame? frame)
    {
        if (frame == null) return "00:00:00.000";
        return frame.AbsoluteTimestamp.ToString("HH:mm:ss.fff");
    }

    public void Dispose()
    {
        SessionState.OnStateChanged -= SyncValues;
    }

    private class SignalValue
    {
        public int Id { get; set; }
        public string Tag { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string TipoVariable { get; set; } = "";
        public string Unidad { get; set; } = "";
        public string FormattedValue { get; set; } = "";
        public double RawValue { get; set; }
        public bool HasChanged { get; set; }
        public bool IsAscii { get; set; }
        public int NodoNumero { get; set; }
        public string NodoDescripcion { get; set; } = "";
    }
}
