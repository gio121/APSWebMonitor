            </MudButton>
            @if (!_showCircularPanel)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Memory" OnClick="ToggleCircularPanel">
                    Abrir Buffer Circular en Placa (8080)
                </MudButton>
            }
        </div>
    </MudPaper>
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 h-100" Elevation="0" Style="background-color: var(--mud-palette-surface); border: 1px solid var(--mud-palette-lines-default);">
                <MudText Typo="Typo.subtitle2" Class="text-muted mb-2">DETALLES DE LA SESIÓN ACTIVA</MudText>
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.body2">Origen:</MudText>
