@code {
    [Parameter] public int WindowId { get; set; }
    
    private Window? _window;
    private List<SinopticoElement> _elements = new();
    private List<FailureCategoryConfig> _failureCategories = new();
    private bool _showFailures = true;
    private Dictionary<string, string> _lastStopPerCategory = new();
    private HashSet<string> _previousFailureKeys = new();
    private bool _statusMapped = false;
    private bool _isAdminMode = false;

    private class StatusDisplayInfo
    {
        public string Text = "IDLE";
        public string Css = "status-off";
        public string BtnCss = "btn-off";
        public string Icon = Icons.Material.Filled.MoreHoriz;
        public bool ShowReset = false;
    }

    private StatusDisplayInfo GetStatusInfo(FailureCategoryConfig category, Dictionary<int, double> values, int displayCount)
    {
        var info = new StatusDisplayInfo();
        info.ShowReset = displayCount >= 5;

        if (!category.StatusSignalId.HasValue || !values.TryGetValue(category.StatusSignalId.Value, out var statusVal))
            return info;

        int intStatus = (int)Math.Truncate(statusVal);
        var statusSig = SessionState.Signals.FirstOrDefault(s => s.Id == category.StatusSignalId.Value);

        // Si es una señal de status estándar (in, ac, dc), usamos la lógica de valores fijos del Inversor
        if (statusSig != null && (statusSig.Tag.EndsWith("_in", StringComparison.OrdinalIgnoreCase) || 
                                 statusSig.Tag.EndsWith("_ac", StringComparison.OrdinalIgnoreCase) || 
                                 statusSig.Tag.EndsWith("_dc", StringComparison.OrdinalIgnoreCase)))
        {
            switch (intStatus)
            {
                case 1:
                case 6:
                    info.Text = "Stop"; info.Css = "status-warn"; info.BtnCss = "btn-warn"; info.Icon = Icons.Material.Filled.Stop;
                    break;
                case 2:
                case 3:
                    info.Text = "Failure"; info.Css = "status-stop"; info.BtnCss = "btn-stop"; info.Icon = Icons.Material.Filled.Warning;
                    if (intStatus == 3) info.ShowReset = true;
                    break;
                case 5:
                    info.Text = "En ciclo"; info.Css = "status-run"; info.BtnCss = "btn-run"; info.Icon = Icons.Material.Filled.PlayArrow;
                    break;
                case 0:
                case 4:
                default:
                    info.Text = "OFF"; info.Css = "status-off"; info.BtnCss = "btn-off"; info.Icon = Icons.Material.Filled.PowerOff;
                    break;
            }
        }
        else
        {
            // Lógica por bits para otras señales
            long longVal = (long)intStatus;
            bool IsBitActive(int bit) => (longVal & (1L << bit)) != 0;

            if (IsBitActive(5))
            {
                info.Text = "En ciclo"; info.Css = "status-run"; info.BtnCss = "btn-run"; info.Icon = Icons.Material.Filled.PlayArrow;
            }
            else if (IsBitActive(2) || IsBitActive(3))
            {
                info.Text = "Stop"; info.Css = "status-warn"; info.BtnCss = "btn-warn"; info.Icon = Icons.Material.Filled.Stop;
            }
            else if (IsBitActive(1) || IsBitActive(6))
            {
                info.Text = "Failure"; info.Css = "status-stop"; info.BtnCss = "btn-stop"; info.Icon = Icons.Material.Filled.Warning;
            }
            else if (IsBitActive(0) || IsBitActive(4))
            {
                info.Text = "OFF"; info.Css = "status-off"; info.BtnCss = "btn-off"; info.Icon = Icons.Material.Filled.PowerOff;
            }
        }

        return info;
    }

    private struct ActiveFailure
    {
        public string Tag;
        public int BitIndex;
        public string Description;
    }
    
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var allWindows = await DataService.GetWindowsAsync();
        _window = allWindows.FirstOrDefault(w => w.Id == WindowId);

        if (_window == null)
        {
            Snackbar.Add("La ventana no existe", Severity.Error);
            NavigationManager.NavigateTo("/ventanas");
            return;
        }

        if (authState.User.IsInRole("Mantenimiento") && !_window.PermitirMantenimiento)
        {
            Snackbar.Add("No estás autorizado para ver esta ventana", Severity.Warning);
            NavigationManager.NavigateTo("/ventanas");
            return;
        }
        
        if (!string.IsNullOrWhiteSpace(_window.ContentJson))
        {
            try
            {
                _elements = JsonSerializer.Deserialize<List<SinopticoElement>>(_window.ContentJson) ?? new();
            }
            catch
            {
                _elements = new();
            }

            try
            {
                if (!string.IsNullOrWhiteSpace(_window.FailuresConfigJson) && _window.FailuresConfigJson != "[]")
                {
                    _failureCategories = JsonSerializer.Deserialize<List<FailureCategoryConfig>>(_window.FailuresConfigJson) ?? GetDefaultCategories();
                    
                    // Auto-mapear StatusSignalId si está null (para configuraciones antiguas)
                    foreach (var cat in _failureCategories)
                    {
                        if (!cat.StatusSignalId.HasValue && SessionState.Signals.Any())
                        {
                            if (cat.Name.Equals("Inversor", StringComparison.OrdinalIgnoreCase))
                                cat.StatusSignalId = SessionState.Signals.FirstOrDefault(s => s.Tag.Equals("status_ac", StringComparison.OrdinalIgnoreCase))?.Id;
                            else if (cat.Name.Equals("Chopper", StringComparison.OrdinalIgnoreCase))
                                cat.StatusSignalId = SessionState.Signals.FirstOrDefault(s => s.Tag.Equals("status_in", StringComparison.OrdinalIgnoreCase))?.Id;
                            else if (cat.Name.Equals("LVPS", StringComparison.OrdinalIgnoreCase))
                                cat.StatusSignalId = SessionState.Signals.FirstOrDefault(s => s.Tag.Equals("status_dc", StringComparison.OrdinalIgnoreCase))?.Id;
                        }
                    }
                }
                else
                {
                    _failureCategories = GetDefaultCategories();
                }
            }
            catch
            {
                _failureCategories = GetDefaultCategories();
            }
        }
        
        SessionState.OnStateChanged += SyncValues;
    }

    private List<FailureCategoryConfig> GetDefaultCategories()
    {
        var inversor = new FailureCategoryConfig { Name = "Inversor" };
        var lvps = new FailureCategoryConfig { Name = "LVPS" };
        var chopper = new FailureCategoryConfig { Name = "Chopper" };

        if (SessionState.Signals.Any())
        {
            // Contadores (Mantenemos estos porque son útiles y específicos)
            inversor.CountSignalId = SessionState.Signals.FirstOrDefault(s => s.Tag.Equals("nfails_ac", StringComparison.OrdinalIgnoreCase))?.Id;
            chopper.CountSignalId = SessionState.Signals.FirstOrDefault(s => s.Tag.Equals("nfails_in", StringComparison.OrdinalIgnoreCase))?.Id;
            lvps.CountSignalId = SessionState.Signals.FirstOrDefault(s => s.Tag.Equals("nfails_dc", StringComparison.OrdinalIgnoreCase))?.Id;

            inversor.StatusSignalId = SessionState.Signals.FirstOrDefault(s => s.Tag.Equals("status_ac", StringComparison.OrdinalIgnoreCase))?.Id;
            chopper.StatusSignalId = SessionState.Signals.FirstOrDefault(s => s.Tag.Equals("status_in", StringComparison.OrdinalIgnoreCase))?.Id;
            lvps.StatusSignalId = SessionState.Signals.FirstOrDefault(s => s.Tag.Equals("status_dc", StringComparison.OrdinalIgnoreCase))?.Id;

            // Dejamos las listas de señales de detalle VACÍAS por defecto para que el usuario elija exactamente cuáles quiere
            inversor.SignalIds = new List<int>();
            lvps.SignalIds = new List<int>();
            chopper.SignalIds = new List<int>();
        }

        return new List<FailureCategoryConfig> { inversor, lvps, chopper };
    }

    private int GetTotalCount(Dictionary<int, double> values, Dictionary<string, List<ActiveFailure>> activeFailures)
    {
        int total = 0;
        foreach (var category in _failureCategories)
        {
            if (category.CountSignalId.HasValue && values.TryGetValue(category.CountSignalId.Value, out var val))
            {
                total += (int)val;
            }
            else if (activeFailures.TryGetValue(category.Name, out var list))
            {
                total += list.Count;
            }
        }
        return total;
    }

    private void TogglePlay()
    {
        if (SessionState.IsPlaying) SessionState.Pause();
        else SessionState.Play();
    }

    private void OnSliderChanged(int value)
    {
        SessionState.SeekTo(value);
    }

    private string FormatTime(TimeSpan ts)
    {
        return $"{(int)ts.TotalMinutes:D2}:{ts.Seconds:D2}";
    }

    private void SyncValues()
    {
        // Lazy auto-mapping: si la sesión se cargó después de OnInitializedAsync, mapear StatusSignalId ahora
        if (!_statusMapped && SessionState.Signals.Any())
        {
            _statusMapped = true;
            foreach (var cat in _failureCategories)
            {
                if (!cat.StatusSignalId.HasValue)
                {
                    if (cat.Name.Equals("Inversor", StringComparison.OrdinalIgnoreCase))
                        cat.StatusSignalId = SessionState.Signals.FirstOrDefault(s => s.Tag.Equals("status_ac", StringComparison.OrdinalIgnoreCase))?.Id;
                    else if (cat.Name.Equals("Chopper", StringComparison.OrdinalIgnoreCase))
                        cat.StatusSignalId = SessionState.Signals.FirstOrDefault(s => s.Tag.Equals("status_in", StringComparison.OrdinalIgnoreCase))?.Id;
                    else if (cat.Name.Equals("LVPS", StringComparison.OrdinalIgnoreCase))
                        cat.StatusSignalId = SessionState.Signals.FirstOrDefault(s => s.Tag.Equals("status_dc", StringComparison.OrdinalIgnoreCase))?.Id;
                }
            }
        }

        // Detect new failures for Last Stop tracking
        try
        {
            var values = SessionState.GetCurrentValues();
            var currentFailures = GetActiveFailures(values);
            var currentKeys = new HashSet<string>();
            foreach (var kvp in currentFailures)
            {
                foreach (var f in kvp.Value)
                {
                    var key = $"{kvp.Key}|{f.Tag}|{f.BitIndex}";
                    currentKeys.Add(key);
                    if (!_previousFailureKeys.Contains(key))
                    {
                        // New failure detected — update Last Stop for this category
                        _lastStopPerCategory[kvp.Key] = f.Description;
                    }
                }
            }
            _previousFailureKeys = currentKeys;
        }
        catch { /* Ignore during init */ }

        InvokeAsync(StateHasChanged);
    }

    private bool IsBarraVisible(SinopticoElement el, Dictionary<int, double> values)
    {
        if (el.Type != "Barra") return true;
        if (!el.CommandSignalId.HasValue) return true;
        
        if (values.TryGetValue(el.CommandSignalId.Value, out double val))
        {
            if (el.CommandSignalBit.HasValue)
            {
                long longVal = (long)Math.Truncate(val);
                return (longVal & (1L << el.CommandSignalBit.Value)) != 0;
            }
            return val != 0;
        }
        return false;
    }

    private bool IsElementActive(SinopticoElement el, Dictionary<int, double> values)
    {
        if (!el.StateSignalId.HasValue || !el.StateSignalBit.HasValue) return true;
        if (values.TryGetValue(el.StateSignalId.Value, out double val))
        {
            long longVal = (long)Math.Truncate(val);
            return (longVal & (1L << el.StateSignalBit.Value)) != 0;
        }
        return false;
    }

    private string GetSignalValueText(int? signalId, Dictionary<int, double> currentValues)
    {
        if (!SessionState.IsLoaded || !signalId.HasValue) return "--";

        if (currentValues.TryGetValue(signalId.Value, out double val))
        {
            var sig = SessionState.Signals.FirstOrDefault(s => s.Id == signalId.Value);
            if (sig != null)
            {
                if (sig.IsAscii)
                {
                    return ((char)Math.Max(0, Math.Min(255, val))).ToString();
                }
                // Si tiene lógica binaria y textos activos
                if (sig.BitCount > 1 && sig.BitTextoActivo.Any(t => !string.IsNullOrEmpty(t)))
                {
                    var activeBits = new List<string>();
                    int intVal = (int)val;
                    for (int i = 0; i < 16; i++)
                    {
                        if ((intVal & (1 << i)) != 0 && !string.IsNullOrEmpty(sig.BitTextoActivo[i]))
                        {
                            activeBits.Add(sig.BitTextoActivo[i]!);
                        }
                    }
                    return activeBits.Count > 0 ? string.Join(", ", activeBits) : "0 (Todo OK)";
                }
                
                return val.ToString(sig.Formato) + (string.IsNullOrWhiteSpace(sig.Unidad) ? "" : $" {sig.Unidad}");
            }
            return val.ToString("0.00");
        }
        return "--";
    }

    public void Dispose()
    {
        SessionState.OnStateChanged -= SyncValues;
    }

    private string GetIconForType(string type) => SinopticoIconProvider.GetIcon(type);

    private string GetBoxColor(SinopticoElement el, Dictionary<int, double> values)
    {
        // 1. Dynamic rules priority
        if (el.BoxColorRules != null && el.BoxColorRules.Count > 0)
        {
            foreach (var rule in el.BoxColorRules)
            {
                if (rule.SignalId.HasValue && values.TryGetValue(rule.SignalId.Value, out double ruleVal))
                {
                    bool isActive;
                    if (rule.SignalBit.HasValue)
                    {
                        long longVal = (long)Math.Truncate(ruleVal);
                        isActive = (longVal & (1L << rule.SignalBit.Value)) != 0;
                    }
                    else
                    {
                        isActive = ruleVal != 0;
                    }

                    if (isActive) return rule.Color;
                }
            }
            return el.Color;
        }

        // 2. Legacy fallback
        var targetSignalId = el.StateSignalId ?? el.SignalId;
        if (targetSignalId.HasValue && values.TryGetValue(targetSignalId.Value, out double stateVal))
        {
            bool isActive;
            if (el.StateSignalBit.HasValue)
            {
                long longVal = (long)Math.Truncate(stateVal);
                isActive = (longVal & (1L << el.StateSignalBit.Value)) != 0;
            }
            else
            {
                isActive = stateVal != 0;
            }

            if (isActive) return el.ActiveColor;
        }
        return el.Color;
    }

    private (string Icon, string Color) GetContactorState(SinopticoElement el, Dictionary<int, double> values)
    {
        bool? stateActive = null;
        bool? commandActive = null;

        // Check State Bit
        if (el.StateSignalId.HasValue && el.StateSignalBit.HasValue)
        {
            if (values.TryGetValue(el.StateSignalId.Value, out double sVal))
            {
                long longVal = (long)Math.Truncate(sVal);
                stateActive = (longVal & (1L << el.StateSignalBit.Value)) != 0;
            }
        }

        // Check Command Bit
        if (el.CommandSignalId.HasValue && el.CommandSignalBit.HasValue)
        {
            if (values.TryGetValue(el.CommandSignalId.Value, out double cVal))
            {
                long longVal = (long)Math.Truncate(cVal);
                commandActive = (longVal & (1L << el.CommandSignalBit.Value)) != 0;
            }
        }

        // Determine true state and discrepancy
        bool finalActive = false;
        bool hasDiscrepancy = false;

        if (stateActive.HasValue && commandActive.HasValue)
        {
            finalActive = stateActive.Value;
            hasDiscrepancy = stateActive.Value != commandActive.Value;
        }
        else if (stateActive.HasValue)
        {
            finalActive = stateActive.Value;
        }
        else if (commandActive.HasValue)
        {
            finalActive = commandActive.Value;
        }

        // Determine Icon (based on finalActive: false = Open, true = Closed)
        string iconName;
        if (el.Type == "Contactor V") 
            iconName = finalActive ? "Contactor V_Closed" : "Contactor V";
        else
            iconName = finalActive ? "Contactor_Closed" : "Contactor";

        string icon = SinopticoIconProvider.GetIcon(iconName);

        // Determine Color (based on Discrepancy)
        string color = hasDiscrepancy ? el.ErrorColor : el.Color;

        return (icon, color);
    }

    private string GetIconMarkup(SinopticoElement el, Dictionary<int, double> currentValues)
    {
        var icon = SinopticoIconProvider.GetIcon(el.Type);
        var color = el.Color;
        
        // Lógica de tema: si el color es el "por defecto" (blanco/negro/naranja), lo ajustamos al tema
        if (SessionState.IsDarkMode)
        {
            if (color.ToLower() == "#000000" || color.ToLower() == "black" || color.ToLower() == "#ff9800")
                color = "#ffffff";
        }
        else
        {
            if (color.ToLower() == "#ffffff" || color.ToLower() == "white" || color.ToLower() == "#ff9800")
                color = "#000000";
        }

        if (el.Type == "Contactor" || el.Type == "Contactor V")
        {
            var state = GetContactorState(el, currentValues);
            icon = state.Icon;
            color = state.Color;
            
            if (SessionState.IsDarkMode)
            {
                if (color.ToLower() == "#000000" || color.ToLower() == "black" || color.ToLower() == "#ff9800")
                    color = "#ffffff";
            }
            else
            {
                if (color.ToLower() == "#ffffff" || color.ToLower() == "white" || color.ToLower() == "#ff9800")
                    color = "#000000";
            }
        }

        if (string.IsNullOrEmpty(icon)) return "";

        if (icon.StartsWith("<svg"))
        {
            var svg = icon.Replace("<svg", "<svg width='100%' height='100%' preserveAspectRatio='none' style='display: block;'");
            return svg.Replace("currentColor", color).Replace("#000000", color).Replace("#ffffff", color).Replace("white", color);
        }
        else if (icon.StartsWith("<path"))
        {
            return $"<svg viewBox='0 0 24 24' width='100%' height='100%' preserveAspectRatio='none' style='display: block;'><g fill='{color}'>{icon}</g></svg>";
        }
        else
        {
            return $"<svg viewBox='0 0 24 24' width='100%' height='100%' preserveAspectRatio='none' style='display: block;'><path d='{icon}' fill='{color}' /></svg>";
        }
    }

    private Dictionary<string, List<ActiveFailure>> GetActiveFailures(Dictionary<int, double> values)
    {
        var categorized = new Dictionary<string, List<ActiveFailure>>();
        if (!SessionState.IsLoaded || _window == null) return categorized;

        foreach (var category in _failureCategories)
        {
            if (!categorized.ContainsKey(category.Name))
                categorized[category.Name] = new List<ActiveFailure>();

            foreach (var sigId in category.SignalIds)
            {
                var sig = SessionState.Signals.FirstOrDefault(s => s.Id == sigId);
                if (sig != null && values.TryGetValue(sig.Id, out double val))
                {
                    if (val == 0) continue;

                    int intVal = (int)Math.Truncate(val);
                    bool bitAdded = false;

                    // Siempre intentamos desglosar por bits primero
                    for (int i = 0; i < sig.BitCount; i++)
                    {
                        if ((intVal & (1 << i)) != 0)
                        {
                            var bitText = (sig.BitTextoActivo != null && sig.BitTextoActivo.Length > i) ? sig.BitTextoActivo[i] : null;
                            
                            // Si tiene texto, lo añadimos
                            if (!string.IsNullOrWhiteSpace(bitText))
                            {
                                categorized[category.Name].Add(new ActiveFailure
                                {
                                    Tag = sig.Tag,
                                    BitIndex = i,
                                    Description = bitText
                                });
                                bitAdded = true;
                            }
                            else
                            {
                                // Si NO tiene texto pero la señal es "virgen" (no tiene ningún texto configurado),
                                // mostramos el fallback genérico para que el usuario siempre vea algo
                                bool hasAnyBitTextDefined = sig.BitTextoActivo?.Any(t => !string.IsNullOrWhiteSpace(t)) ?? false;
                                if (!hasAnyBitTextDefined)
                                {
                                    categorized[category.Name].Add(new ActiveFailure
                                    {
                                        Tag = sig.Tag,
                                        BitIndex = i,
                                        Description = $"Bit {i} activo en {sig.Nombre}"
                                    });
                                    bitAdded = true;
                                }
                            }
                        }
                    }

                    // Si no se añadió nada (porque no había bits con texto o es una señal analógica), lo añadimos como valor puro
                    if (!bitAdded)
                    {
                        categorized[category.Name].Add(new ActiveFailure
                        {
                            Tag = sig.Tag,
                            BitIndex = -1,
                            Description = $"{sig.Nombre}: {val.ToString(sig.Formato)} {sig.Unidad}"
                        });
                    }
                }
            }
        }

        return categorized;
    }
}
