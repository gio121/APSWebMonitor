@page "/sinoptico/ver/{WindowId:int}"
@attribute [Authorize]
@using System.Text.Json
@using ApsMonitor.Models
@using ApsMonitor.Services
@inject ApsDataService DataService
@inject NavigationManager NavigationManager
@inject SessionStateService SessionState
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@implements IDisposable
@rendermode InteractiveServer

<div class="sinoptico-viewer-layout">
    @{
        var currentValues = SessionState.GetCurrentValues();
        var dialogFailures = GetActiveFailures(currentValues);
        var totalFailures = GetTotalCount(currentValues, dialogFailures);
    }
    
    <div class="main-view">
        <div class="editor-header d-flex align-center px-4">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" OnClick="@(() => NavigationManager.NavigateTo("/ventanas"))" />
            <MudText Typo="Typo.h6" Class="ml-2 flex-grow-1">@(_window?.Nombre ?? "Cargando...")</MudText>
            
            @if (totalFailures > 0)
            {
                <div class="header-status-badge @(_showFailures ? "active" : "")" @onclick="() => _showFailures = !_showFailures">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                    <span>AVISO: @totalFailures FALLOS</span>
                </div>
            }
            <MudIconButton Icon="@(_showFailures ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" 
                           Color="Color.Inherit" 
                           OnClick="() => _showFailures = !_showFailures" />
            
            <AuthorizeView Roles="Administrador">
                <MudIconButton Icon="@(_isAdminMode ? Icons.Material.Filled.AdminPanelSettings : Icons.Material.Outlined.AdminPanelSettings)" 
                               Color="@(_isAdminMode ? Color.Warning : Color.Inherit)" 
                               OnClick="@(() => _isAdminMode = !_isAdminMode)" 
                               Class="ml-2"
                               Title="@(_isAdminMode ? "Desactivar Modo Admin" : "Activar Modo Admin")" />
            </AuthorizeView>
            <MudIconButton Icon="@(SessionState.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
                           Color="Color.Inherit" 
                           OnClick="@SessionState.ToggleDarkMode" 
                           Class="ml-2"
                           Title="@(SessionState.IsDarkMode ? "Modo Claro" : "Modo Oscuro")" />
        </div>

        <!-- Panel de Fallos Superior Plegable -->
        <div class="failures-top-panel @(_showFailures ? "expanded" : "collapsed")">
            <div class="panel-content-wrapper">
                <div class="d-flex gap-4 p-4 failures-horizontal-scroll">
                    @foreach (var category in _failureCategories)
                    {
                        var catFailures = dialogFailures.ContainsKey(category.Name) ? dialogFailures[category.Name] : new List<ActiveFailure>();
                        var displayCount = 0;
                        if (category.CountSignalId.HasValue && currentValues.TryGetValue(category.CountSignalId.Value, out var sigVal))
                            displayCount = (int)sigVal;
                        else
                            displayCount = catFailures.Count;

                        var lastStop = _lastStopPerCategory.GetValueOrDefault(category.Name, "");
                        var failuresList = string.Join(", ", catFailures.Select(f => f.Description));
                        var maxFails = 100;
                        var pct = maxFails > 0 ? Math.Max(0, (int)(((maxFails - displayCount) / (double)maxFails) * 100)) : 100;

                        var statusInfo = GetStatusInfo(category, currentValues, displayCount);

                        <div class="ind-card">
                            <!-- Header -->
                            <div class="ind-card-header">
                                <span class="ind-card-title">@category.Name.ToUpper()</span>
                                <span class="ind-card-badge">@displayCount</span>
                            </div>

                            <!-- Status Row -->
                            <div class="ind-row">
                                <span class="ind-label">Status</span>
                                <div class="ind-field @statusInfo.Css">
                                    @statusInfo.Text
                                </div>
                                <div class="ind-status-text-btn @statusInfo.BtnCss">
                                    <MudIcon Icon="@statusInfo.Icon" Size="Size.Small" />
                                </div>
                            </div>

                            <!-- Last Stop Row -->
                            <div class="ind-row">
                                <span class="ind-label">Last Stop:</span>
                                <div class="ind-field ind-field-laststop">@(string.IsNullOrEmpty(lastStop) ? "—" : lastStop)</div>
                            </div>

                            <!-- Failures Row -->
                            <div class="ind-row">
                                <span class="ind-label">Failures:</span>
                                <div class="ind-field">@(string.IsNullOrEmpty(failuresList) ? "" : failuresList)</div>
                            </div>

                            <!-- Failures Counter Row -->
                            <div class="ind-row">
                                <span class="ind-label">Failures Counter:</span>
                                <div class="ind-counter-box">@displayCount</div>
                                @if (statusInfo.ShowReset)
                                {
                                    <button class="ind-btn-reset">Reset</button>
                                }
                            </div>

                            <!-- Scrollable Detail Area -->
                            <div class="ind-detail-scroll">
                                @foreach (var fail in catFailures)
                                {
                                    <div class="ind-detail-entry">
                                        @if (_isAdminMode)
                                        {
                                            <span class="mini-tag">@fail.Tag</span>
                                        }
                                        <span class="mini-desc">@fail.Description</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="editor-container @(SessionState.IsDarkMode ? "dark-theme" : "light-theme")" style="min-width: 100%; width: fit-content;">
            <div class="main-canvas-area">
                <div class="canvas mx-auto" style="width: @(_elements.Any() ? _elements.Max(e => e.X + e.Width) + 100 : 800)px; height: @(_elements.Any() ? _elements.Max(e => e.Y + e.Height) + 100 : 600)px;">
                    @foreach (var el in _elements)
                    {
                        if (el.Type == "ACpresence" && !IsElementActive(el, currentValues)) continue;
                        if (el.Type == "Barra" && !IsBarraVisible(el, currentValues)) continue;

                        <div class="canvas-element" style="left: @(el.X)px; top: @(el.Y)px; width: @(el.Width)px; height: @(el.Height)px; transform: rotate(@(el.Rotation)deg);">
                            @if (el.Type == "Etiqueta")
                            {
                                var textColor = el.Color;
                                if (SessionState.IsDarkMode)
                                {
                                    if (textColor.ToLower() == "#000000" || textColor.ToLower() == "black" || textColor.ToLower() == "#ff9800")
                                        textColor = "#ffffff";
                                }
                                else
                                {
                                    if (textColor.ToLower() == "#ffffff" || textColor.ToLower() == "white" || textColor.ToLower() == "#ff9800")
                                        textColor = "#000000";
                                }
                                <div class="element-content label-content d-flex align-center justify-center p-1" 
                                     style="color: @textColor; font-size: @(el.FontSize)px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @el.Text
                                </div>
                            }
                            else if (el.Type == "Señal")
                            {
                                var sigColor = el.Color;
                                if (SessionState.IsDarkMode)
                                {
                                    if (sigColor.ToLower() == "#000000" || sigColor.ToLower() == "black" || sigColor.ToLower() == "#ff9800")
                                        sigColor = "#ffffff";
                                }
                                else
                                {
                                    if (sigColor.ToLower() == "#ffffff" || sigColor.ToLower() == "white" || sigColor.ToLower() == "#ff9800")
                                        sigColor = "#000000";
                                }
                                <div class="element-content signal-content d-flex flex-row flex-wrap align-center justify-center p-1" 
                                     style="border-color: @(sigColor + "44"); color: @sigColor; gap: 4px; overflow: hidden;">
                                    <span class="signal-name text-truncate" style="font-size: @(Math.Round(el.FontSize * 0.7))px; max-width: 100%; line-height: 1;">@el.Text</span>
                                    <span class="signal-value fw-bold text-truncate" style="font-size: @(el.FontSize)px; font-variant-numeric: tabular-nums; line-height: 1;">
                                        @GetSignalValueText(el.SignalId, currentValues)
                                    </span>
                                </div>
                            }
                            else if (el.Type == "Caja")
                            {
                                <div class="element-content box-content d-flex align-center justify-center shadow-sm" 
                                     style="border-color: @el.Color; color: #111827; background-color: @(GetBoxColor(el, currentValues)) !important; font-weight: 500;">
                                    @el.Text
                                </div>
                            }
                            else if (el.Type == "Linea H" || el.Type == "Linea V")
                            {
                                var lineColor = el.Color;
                                if (SessionState.IsDarkMode)
                                {
                                    if (lineColor.ToLower() == "#000000" || lineColor.ToLower() == "black" || lineColor.ToLower() == "#ff9800")
                                        lineColor = "#ffffff";
                                }
                                else
                                {
                                    if (lineColor.ToLower() == "#ffffff" || lineColor.ToLower() == "white" || lineColor.ToLower() == "#ff9800")
                                        lineColor = "#000000";
                                }
                                <div class="element-content line-content" style="background-color: @lineColor;"></div>
                            }
                            else if (el.Type == "Barra")
                            {
                                var val = 0.0;
                                if (el.SignalId.HasValue && currentValues.TryGetValue(el.SignalId.Value, out var sigVal))
                                    val = sigVal;
                                
                                var max = el.MaxValue;
                                if (el.StateSignalId.HasValue && currentValues.TryGetValue(el.StateSignalId.Value, out var maxSigVal))
                                    max = maxSigVal;

                                var pct = max != 0 ? Math.Clamp((val / max) * 100, 0, 100) : 0;
                                var barColor = el.Color;
                                if (SessionState.IsDarkMode && (barColor.ToLower() == "#000000" || barColor.ToLower() == "black"))
                                    barColor = "#3b82f6";

                                <div class="element-content progress-container d-flex align-center gap-2" style="color: @barColor;">
                                    <div class="progress-track flex-grow-1">
                                        <div class="progress-fill" style="width: @(pct)%; background-color: @barColor;"></div>
                                    </div>
                                    @if (el.FontSize > 0)
                                    {
                                        <span class="progress-text" style="font-size: @(el.FontSize)px; min-width: 3.5ch;">@Math.Round(pct)%</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="element-content icon-content">
                                    @((MarkupString)GetIconMarkup(el, currentValues))
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- El panel lateral anterior ha sido eliminado y movido arriba -->
</div>

<style>
    .sinoptico-viewer-layout {
        min-height: calc(100vh - 96px);
        display: flex;
        flex-direction: column;
        overflow: auto; /* Permitir scroll tanto vertical como horizontal */
        background-color: #0d1117;
        margin-top: -65px;
    }

    .main-view {
        display: flex;
        flex-direction: column;
    }

    /* ESTILOS DEL PANEL SUPERIOR */
    .failures-top-panel {
        background: rgba(22, 27, 34, 0.95);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(12px);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        z-index: 100;
    }

    .failures-top-panel.collapsed {
        max-height: 0;
        opacity: 0;
    }

    .failures-top-panel.expanded {
        max-height: 600px;
        opacity: 1;
    }

    .failures-horizontal-scroll {
        overflow-x: auto;
    }

    /* ===== INDUSTRIAL CARD ===== */
    .ind-card {
        width: 360px;
        min-width: 360px;
        max-width: 360px;
        height: 320px;
        background: #1a1f2b;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        flex-shrink: 0;
        overflow: hidden;
    }

    .ind-card.has-errors {
        border-left: 4px solid #f44336;
    }

    .ind-card.is-ok {
        border-left: 4px solid #4caf50;
    }

    .ind-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .ind-card-title {
        font-size: 14px;
        font-weight: 800;
        color: #e6edf3;
        letter-spacing: 1px;
    }

    .ind-card-badge {
        font-size: 13px;
        font-weight: 800;
        color: #fff;
        background: #30363d;
        padding: 2px 10px;
        border-radius: 12px;
        min-width: 28px;
        text-align: center;
    }

    .has-errors .ind-card-badge { background: #f44336; }

    /* Row layout */
    .ind-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ind-label {
        font-size: 12px;
        font-weight: 700;
        color: #58a6ff;
        min-width: 120px;
        flex-shrink: 0;
    }

    .ind-field {
        flex: 1;
        background: #0d1117;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 4px;
        padding: 5px 10px;
        font-size: 12px;
        color: #c9d1d9;
        text-align: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-height: 28px;
    }

    .ind-field.status-run {
        color: #4caf50;
        font-weight: bold;
    }

    .ind-field.status-stop {
        color: #f44336;
        font-weight: bold;
    }

    .ind-field.status-warn {
        color: #fbc02d;
        font-weight: bold;
    }

    .ind-field.status-off {
        color: #8b949e;
        font-weight: bold;
    }

    .ind-field-laststop {
        text-align: left;
        max-width: 260px;
        background: #2d333b;
    }

    /* Buttons */
    .ind-btn-toggle {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        opacity: 0.8;
    }

    .ind-status-text-btn {
        min-width: 85px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 11px;
        padding: 0 8px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        border: 1px solid rgba(255,255,255,0.1);
    }
    
    .btn-run { color: #4caf50; border-color: rgba(76, 175, 80, 0.2); }
    .btn-stop { color: #f44336; border-color: rgba(244, 67, 54, 0.2); }
    .btn-warn { color: #fbc02d; border-color: rgba(251, 192, 45, 0.2); }
    .btn-off { color: #8b949e; border-color: rgba(139, 148, 158, 0.2); }

    .ind-btn-reset {
        padding: 4px 16px;
        background: #f44336;
        color: #fff;
        border: none;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        cursor: pointer;
        flex-shrink: 0;
        transition: background 0.2s;
    }

    .ind-btn-reset:hover {
        background: #d32f2f;
    }

    /* Counter */
    .ind-counter-box {
        background: #0d1117;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 4px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: bold;
        color: #e6edf3;
        text-align: center;
        min-width: 40px;
        flex-shrink: 0;
    }

    .ind-pct {
        font-size: 12px;
        font-weight: bold;
        color: #c9d1d9;
        min-width: 50px;
        text-align: center;
        flex-shrink: 0;
    }

    .ind-progress {
        flex: 1;
        height: 10px;
        background: #0d1117;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 5px;
        overflow: hidden;
    }

    .ind-progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #4caf50, #81c784);
        border-radius: 5px;
        transition: width 0.3s ease;
    }

    /* Scrollable detail area */
    .ind-detail-scroll {
        background: #0d1117;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 6px;
        min-height: 60px;
        max-height: 120px;
        overflow-y: auto;
        padding: 8px;
    }

    .ind-detail-entry {
        display: flex;
        gap: 8px;
        font-size: 11px;
        margin-bottom: 3px;
    }

    .mini-tag { color: #58a6ff; font-family: monospace; font-weight: bold; }
    .mini-desc { color: #e6edf3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* ESTILOS HEADER */
    .header-status-badge {
        background: rgba(244, 67, 54, 0.15);
        color: #f44336;
        border: 1px solid rgba(244, 67, 54, 0.3);
        padding: 4px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-center: center;
        transition: all 0.2s;
        margin-right: 12px;
    }

    .header-status-badge:hover {
        background: rgba(244, 67, 54, 0.25);
    }

    .header-status-badge.active {
        background: #f44336;
        color: #fff;
    }

    .editor-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        height: 56px;
        background-color: #161b22;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        color: #e6edf3;
    }

    /* TEMA CLARO / OSCURO DINAMICO */
    .editor-container.light-theme {
        background-color: #ffffff;
        background-image: radial-gradient(circle at 2px 2px, rgba(0,0,0,0.1) 1px, transparent 0);
        background-size: 32px 32px;
    }
    .editor-container.dark-theme {
        background-color: #0d1117;
        background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.05) 1px, transparent 0);
        background-size: 32px 32px;
    }

    .editor-container.light-theme .label-content { color: #111827; }
    .editor-container.dark-theme .label-content { color: #e2e8f0; }

    .editor-container.light-theme .signal-content {
        background-color: rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.1);
        color: #111827;
    }
    .editor-container.dark-theme .signal-content {
        background-color: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: #e2e8f0;
    }

    .editor-container.light-theme .signal-name { color: #4b5563; }
    .editor-container.dark-theme .signal-name { color: #94a3b8; }
    
    .editor-container.light-theme .box-content {
        background-color: rgba(0,0,0,0.03);
        border: 1px solid rgba(0,0,0,0.1);
        color: #111827;
    }
    .editor-container.dark-theme .box-content {
        background-color: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: #e2e8f0;
    }

    .main-canvas-area {
        width: 100%;
        min-width: fit-content;
        display: flex;
        justify-content: flex-start; /* Cambiado a flex-start para evitar recortes en el scroll */
        padding: 40px; /* Más margen para que no quede pegado a los bordes */
    }
    .canvas {
        min-width: 100%;
        min-height: 100%;
        background-color: transparent;
        position: relative;
    }
    
    .canvas-element {
        position: absolute;
        user-select: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .element-content {
        width: 100%;
        height: 100%;
    }
    .label-content {
        color: #111827; /* Dark text for light theme */
        text-align: center;
        line-height: 1;
    }
    .signal-content {
        background-color: rgba(0,0,0,0.05); /* Darker background for light theme */
        border: 1px solid rgba(0,0,0,0.1);
        border-radius: 4px;
        padding: 8px;
        color: #111827;
    }
    .signal-name {
        font-size: 10px;
        color: #4b5563;
    }
    .signal-value {
        font-size: 16px;
    }
    .icon-content {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }
    .icon-content svg {
        width: 100% !important;
        height: 100% !important;
    }
    .line-content {
        background-color: var(--mud-palette-warning);
        width: 100%;
        height: 100%;
    }
    .box-content {
        background-color: rgba(255,255,255,0.05);
        border: 1px solid rgba(0,0,0,0.1);
        border-radius: 4px;
        color: #111827;
        font-size: 14px;
        text-align: center;
        padding: 4px;
        overflow: hidden;
    }

    /* Progress Bar */
    .progress-container {
        padding: 4px;
        width: 100%;
        height: 100%;
    }
    .progress-track {
        height: 12px;
        background-color: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 4px;
        overflow: hidden;
        position: relative;
    }
    .light-theme .progress-track {
        background-color: rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.1);
    }
    .progress-fill {
        height: 100%;
        width: 0%;
        transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 2px;
        position: relative;
    }
    .progress-fill::after {
        content: "";
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        animation: progress-shimmer 2s infinite;
    }
    @@keyframes progress-shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }
    .progress-text {
        font-weight: bold;
        font-variant-numeric: tabular-nums;
    }

    /* Persistent Failure Side Panel */
    .failures-side-panel {
        position: relative;
        height: 100%;
        transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: #0f1218;
        border-left: 1px solid rgba(255,255,255,0.05);
        z-index: 100;
        display: flex;
    }

    .failures-side-panel.expanded {
        width: 380px;
    }

    .failures-side-panel.collapsed {
        width: 0px;
    }

    .panel-container {
        width: 380px;
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .panel-toggle-handle {
        position: absolute;
        left: -32px;
        top: 80px;
        width: 32px;
        height: 48px;
        background: #1e293b;
        border: 1px solid rgba(255,255,255,0.1);
        border-right: none;
        border-radius: 8px 0 0 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #94a3b8;
        transition: all 0.2s;
        z-index: 101;
    }

    .panel-toggle-handle:hover {
        background: #334155;
        color: #fff;
    }

    .panel-toggle-handle.has-errors {
        background: #b91c1c;
