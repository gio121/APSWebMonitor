@page "/sinoptico/ver/{WindowId:int}"
@using System.Text.Json
@using ApsMonitor.Models
@using ApsMonitor.Services
@inject ApsDataService DataService
@inject NavigationManager NavigationManager
@inject SessionStateService SessionState
@implements IDisposable
@rendermode InteractiveServer

<div class="sinoptico-wrapper ml-n4 mr-n8 mt-n8">
    <div class="editor-header d-flex justify-space-between align-center px-4 py-2">
        <div class="d-flex align-center">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" OnClick="@(() => NavigationManager.NavigateTo("/ventanas"))" />
            <MudText Typo="Typo.h6" Class="fw-bold ml-2">@(_window?.Nombre ?? "Cargando...")</MudText>
            <MudText Typo="Typo.caption" Class="text-muted ml-2 mt-1">(@(_window?.Tipo ?? "Sinóptico"))</MudText>
        </div>
        <div>
            <!-- Botones adicionales en modo visualización (ej. Actualizar, Fullscreen) podrían ir aquí -->
        </div>
    </div>

    <div class="editor-container d-flex justify-center align-center">
        <!-- CENTER PANEL: CANVAS -->
        <div class="main-canvas-area flex-grow-1">
            <div class="canvas mx-auto">
                @foreach (var el in _elements)
                {
                    <div class="canvas-element" 
                         style="left: @(el.X)px; top: @(el.Y)px; width: @(el.Width)px; height: @(el.Height)px; transform: rotate(@(el.Rotation)deg);">
                        
                        @if (el.Type == "Etiqueta")
                        {
                            <div class="element-content label-content d-flex align-center justify-center p-1" 
                                 style="color: @el.Color; font-size: @(el.FontSize)px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @el.Text
                            </div>
                        }
                        else if (el.Type == "Señal")
                        {
                            <div class="element-content signal-content d-flex flex-column" style="border-color: @(el.Color + "44"); color: @el.Color;">
                                <span class="signal-name" style="font-size: @(Math.Round(el.FontSize * 0.7))px;">@el.Text</span>
                                <span class="signal-value fw-bold" style="font-size: @(el.FontSize)px; font-variant-numeric: tabular-nums;">
                                    @GetSignalValueText(el.SignalId)
                                </span>
                            </div>
                        }
                        else if (el.Type == "Comando")
                        {
                            <div class="element-content command-content d-flex align-center justify-center" style="border-color: @el.Color; color: @el.Color;">
                                @el.Text
                            </div>
                        }
                        else if (el.Type == "Caja")
                        {
                            <div class="element-content box-content d-flex align-center justify-center shadow-sm" 
                                 style="border-color: @el.Color; color: #111827; background-color: #f0f4f8; font-weight: 500;">
                                @el.Text
                            </div>
                        }
                        else if (el.Type == "Linea H" || el.Type == "Linea V")
                        {
                            <div class="element-content line-content" style="background-color: @el.Color;"></div>
                        }
                        else
                        {
                            <div class="element-content icon-content">
                                @((MarkupString)GetIconMarkup(el))
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .sinoptico-wrapper {
        height: calc(100vh - 96px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .editor-header {
        border-bottom: 1px solid rgba(255,255,255,0.05);
        background-color: #151921;
        height: 60px;
        flex-shrink: 0;
    }
    .editor-container {
        flex-grow: 1;
        background-color: #0f1218;
        overflow: auto;
    }
    .main-canvas-area {
        position: relative;
        overflow: auto;
        width: 100%;
        height: 100%;
        display: flex;
        /* Centrar o dejar al inicio según preferencia, usamos flex start/center auto márgenes el canvas */
    }
    .canvas {
        min-width: 100%;
        min-height: 100%;
        background-color: transparent;
        position: relative;
    }
    
    /* Elements on Canvas */
    .canvas-element {
        position: absolute;
        user-select: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .element-content {
        width: 100%;
        height: 100%;
    }
    .label-content {
        color: #e2e8f0;
        text-align: center;
        line-height: 1;
    }
    .signal-content {
        background-color: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 4px;
        padding: 8px;
        color: #e2e8f0;
    }
    .signal-name {
        font-size: 10px;
        color: #94a3b8;
    }
    .signal-value {
        font-size: 16px;
    }
    .icon-content {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }
    .icon-content svg {
        width: 100% !important;
        height: 100% !important;
    }
    .line-content {
        background-color: var(--mud-palette-warning);
        width: 100%;
        height: 100%;
    }
    .command-content {
        background-color: #0d1a10;
        border: 1px solid #2e7d32;
        border-radius: 6px;
        color: #4caf50;
        font-weight: 500;
        font-size: 14px;
        text-align: center;
        padding: 4px;
        cursor: pointer;
    }
    .box-content {
        background-color: #f0f4f8;
        border: 1px solid rgba(0,0,0,0.1);
        border-radius: 4px;
        color: #111827;
        font-size: 14px;
        text-align: center;
        padding: 4px;
        overflow: hidden;
    }
</style>

@code {
    [Parameter] public int WindowId { get; set; }
    
    private Window? _window;
    private List<SinopticoElement> _elements = new();
    
    protected override async Task OnInitializedAsync()
    {
        var allWindows = await DataService.GetWindowsAsync();
        _window = allWindows.FirstOrDefault(w => w.Id == WindowId);
        
        if (_window != null && !string.IsNullOrWhiteSpace(_window.ContentJson))
        {
            try
            {
                _elements = JsonSerializer.Deserialize<List<SinopticoElement>>(_window.ContentJson) ?? new();
            }
            catch
            {
                _elements = new();
            }
        }
        
        SessionState.OnStateChanged += SyncValues;
    }

    private void SyncValues()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetSignalValueText(int? signalId)
    {
        if (!SessionState.IsLoaded || !signalId.HasValue) return "--";

        var values = SessionState.GetCurrentValues();
        if (values.TryGetValue(signalId.Value, out double val))
        {
            var sig = SessionState.Signals.FirstOrDefault(s => s.Id == signalId.Value);
            if (sig != null)
            {
                if (sig.IsAscii)
                {
                    return ((char)Math.Max(0, Math.Min(255, val))).ToString();
                }
                // Si tiene lógica binaria y textos activos
                if (sig.BitCount > 1 && sig.BitTextoActivo.Any(t => !string.IsNullOrEmpty(t)))
                {
                    var activeBits = new List<string>();
                    int intVal = (int)val;
                    for (int i = 0; i < 16; i++)
                    {
                        if ((intVal & (1 << i)) != 0 && !string.IsNullOrEmpty(sig.BitTextoActivo[i]))
                        {
                            activeBits.Add(sig.BitTextoActivo[i]!);
                        }
                    }
                    return activeBits.Count > 0 ? string.Join(", ", activeBits) : "0 (Todo OK)";
                }
                
                return val.ToString(sig.Formato) + (string.IsNullOrWhiteSpace(sig.Unidad) ? "" : $" {sig.Unidad}");
            }
            return val.ToString("0.00");
        }
        return "--";
    }

    public void Dispose()
    {
        SessionState.OnStateChanged -= SyncValues;
    }

    private string GetIconForType(string type) => SinopticoIconProvider.GetIcon(type);

    private (string Icon, string Color) GetContactorState(SinopticoElement el)
    {
        bool? stateActive = null;
        bool? commandActive = null;

        var values = SessionState.GetCurrentValues();

        // Check State Bit
        if (el.StateSignalId.HasValue && el.StateSignalBit.HasValue)
        {
            if (values.TryGetValue(el.StateSignalId.Value, out double val))
            {
                stateActive = ((int)val & (1 << el.StateSignalBit.Value)) != 0;
            }
        }

        // Check Command Bit
        if (el.CommandSignalId.HasValue && el.CommandSignalBit.HasValue)
        {
            if (values.TryGetValue(el.CommandSignalId.Value, out double val))
            {
                commandActive = ((int)val & (1 << el.CommandSignalBit.Value)) != 0;
            }
        }

        // Determine true state and discrepancy
        bool finalActive = false;
        bool hasDiscrepancy = false;

        if (stateActive.HasValue && commandActive.HasValue)
        {
            finalActive = stateActive.Value;
            hasDiscrepancy = stateActive.Value != commandActive.Value;
        }
        else if (stateActive.HasValue)
        {
            finalActive = stateActive.Value;
        }
        else if (commandActive.HasValue)
        {
            finalActive = commandActive.Value;
        }

        // Determine Icon (based on finalActive: false = Open, true = Closed)
        string iconName;
        if (el.Type == "Contactor V") 
            iconName = finalActive ? "Contactor V_Closed" : "Contactor V";
        else
            iconName = finalActive ? "Contactor_Closed" : "Contactor";

        string icon = SinopticoIconProvider.GetIcon(iconName);

        // Determine Color (based on Discrepancy)
        string color = hasDiscrepancy ? el.ErrorColor : el.Color;

        return (icon, color);
    }

    private string GetIconMarkup(SinopticoElement el)
    {
        var icon = SinopticoIconProvider.GetIcon(el.Type);
        var color = el.Color;
        
        if (el.Type == "Contactor" || el.Type == "Contactor V")
        {
            var state = GetContactorState(el);
            icon = state.Icon;
            color = state.Color;
        }

        if (string.IsNullOrEmpty(icon)) return "";

        if (icon.StartsWith("<svg"))
        {
            var svg = icon.Replace("<svg", "<svg width='100%' height='100%' preserveAspectRatio='none' style='display: block;'");
            return svg.Replace("currentColor", color).Replace("#000000", color);
        }
        else if (icon.StartsWith("<path"))
        {
            return $"<svg viewBox='0 0 24 24' width='100%' height='100%' preserveAspectRatio='none' style='display: block;'><g fill='{color}'>{icon}</g></svg>";
        }
        else
        {
            return $"<svg viewBox='0 0 24 24' width='100%' height='100%' preserveAspectRatio='none' style='display: block;'><path d='{icon}' fill='{color}' /></svg>";
        }
    }
}
