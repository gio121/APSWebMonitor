@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using ApsMonitor.Models
@using ApsMonitor.Services
@inject ApsDataService DataService
@inject SessionStateService SessionState
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<MudText Typo="Typo.h5" Class="fw-bold mb-4 mt-n2">Panel de Control</MudText>

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <!-- Top Summary Cards -->
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 dashboard-card" Elevation="0">
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.FitScreen" Size="Size.Small" Color="Color.Default" Class="mr-2 text-muted" />
                    <MudText Typo="Typo.body2" Class="text-muted">@(_isAdmin ? "Ventanas (Total)" : "Ventanas Activas")</MudText>
                </div>
                <MudText Typo="Typo.h4" Class="fw-bold">@(_isAdmin ? _filteredWindows.Count : _filteredWindows.Count(w => w.IsActive))</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 dashboard-card" Elevation="0">
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Sensors" Size="Size.Small" Color="Color.Default" Class="mr-2 text-muted" />
                    <MudText Typo="Typo.body2" Class="text-muted">Señales</MudText>
                </div>
                <MudText Typo="Typo.h4" Class="fw-bold">@_signals.Count</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 dashboard-card" Elevation="0">
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Small" Color="Color.Default" Class="mr-2 text-muted" />
                    <MudText Typo="Typo.body2" Class="text-muted">Comandos</MudText>
                </div>
                <MudText Typo="Typo.h4" Class="fw-bold">4</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 dashboard-card border-left-error" Elevation="0" Style="border-left: 3px solid #ef4444;">
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Error" Class="mr-2" />
                    <MudText Typo="Typo.body2" Class="text-muted">Alarmas</MudText>
                </div>
                <MudText Typo="Typo.h4" Class="fw-bold text-error">@_activeAlarmCount</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <!-- Ventanas -->
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 mb-6 dashboard-card" Elevation="0" Style="height: 420px; overflow-y: auto;">
                <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4">@(_isAdmin ? "Ventanas" : "Ventanas Activas")</MudText>
                <MudList T="Window" Dense="true" Class="pa-0">
                    @foreach (var window in (_isAdmin ? _filteredWindows : _filteredWindows.Where(w => w.IsActive)))
                    {
                        <div class="pa-3 mb-3 d-flex align-center justify-space-between list-item-card rounded @(!window.IsActive ? "inactive-window" : "")">
                            <div>
                                <MudText Typo="Typo.body1" Class="fw-bold">@window.Nombre</MudText>
                                <MudText Typo="Typo.body2" Class="text-muted">@window.Descripcion</MudText>
                            </div>
                            <div class="d-flex gap-2">
                                @if (!window.IsActive)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Filled">Inactiva</MudChip>
                                }
                                <MudChip T="string" Size="Size.Small" Color="@(window.Tipo == "Sinóptico" ? Color.Info : Color.Default)" Variant="Variant.Filled">
                                    @window.Tipo
                                </MudChip>
                            </div>
                        </div>
                    }
                </MudList>
            </MudPaper>
        </MudItem>

        <!-- Señales -->
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 mb-6 dashboard-card" Elevation="0" Style="height: 420px; overflow-y: auto;">
                <div class="d-flex align-center mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Insights" Color="Color.Info" Size="Size.Small" Class="mr-2" />
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Señales en Tiempo Real</MudText>
                </div>
                
                <MudSimpleTable Dense="true" Hover="true" Class="signals-table" Style="background: transparent;">
                    <tbody>
                        @foreach (var signal in _signals)
                        {
                            var currentVal = GetCurrentValue(signal);
                            <tr>
                                <td class="border-b-0 py-3">
                                    <MudText Typo="MudBlazor.Typo.body2" Class="fw-bold">@signal.Nombre <span class="text-muted fw-normal">[@signal.Tag]</span></MudText>
                                </td>
                                <td class="border-b-0 text-end py-3">
                                    @if (signal.TipoVariable == "UINT8")
                                    {
                                        <MudChip T="string" Size="MudBlazor.Size.Small" Color="@(currentVal == 1 ? MudBlazor.Color.Success : MudBlazor.Color.Dark)" Variant="MudBlazor.Variant.Filled" Class="rounded">
                                            @(currentVal == 1 ? "ON" : "OFF")
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudText Typo="MudBlazor.Typo.body2" Class="fw-bold">@FormatValue(currentVal, signal)</MudText>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>

        <!-- Ultimos Eventos -->
        <MudItem xs="12" Class="mt-6">
            <MudPaper Class="pa-4 dashboard-card" Elevation="0" Style="max-height: 250px; overflow-y: auto;">
                <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4">Últimos Eventos</MudText>
                <MudList T="EventMessage" Dense="true" Class="pa-0">
                    @foreach (var ev in _events)
                    {
                        <div class="pa-3 mb-2 d-flex align-center justify-space-between list-item-card rounded">
                            <MudText Typo="Typo.body2">@ev.Mensaje</MudText>
                            <div class="d-flex align-center">
                                <MudText Typo="Typo.caption" Class="text-muted mr-3">@DateTime.Now.ToString("d/M/yyyy, HH:mm:ss")</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(ev.Estado == "OK" ? Color.Success : Color.Error)" Variant="Variant.Filled">
                                    @ev.Estado
                                </MudChip>
                            </div>
                        </div>
                    }
                </MudList>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<style>
    .dashboard-card {
        border: 1px solid rgba(255,255,255,0.05);
        background-color: #1a222c;
    }
    .text-muted {
        color: #94a3b8 !important;
    }
    .text-error {
        color: #ef4444 !important;
    }
    .list-item-card {
        background-color: #212a36;
        border: 1px solid rgba(255,255,255,0.02);
    }
    .list-item-card.inactive-window {
        opacity: 0.55;
        border-left: 3px solid #64748b;
    }
    .signals-table .mud-table-cell {
        border-bottom: 1px solid rgba(255,255,255,0.05) !important;
    }
    .signals-table tr:last-child .mud-table-cell {
        border-bottom: none !important;
    }
</style>

@code {
    private List<Window> _windows = new();
    private List<Window> _filteredWindows = new();
    private List<Signal> _signals = new();
    private List<EventMessage> _events = new();
    private bool _isLoading = true;
    private bool _isAdmin = false;
    private string _currentRole = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("Administrador");
        _currentRole = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";

        _windows = await DataService.GetWindowsAsync();
        _filteredWindows = _isAdmin ? _windows : _windows.Where(CanCurrentRoleSeeWindow).ToList();
        _signals = await DataService.GetSignalsAsync();
        _events = await DataService.GetEventsAsync();
        _isLoading = false;

        // Use a stored delegate so we can unsubscribe the exact same handler on dispose.
        _onStateChangedHandler = () => InvokeAsync(StateHasChanged);
        SessionState.OnStateChanged += _onStateChangedHandler;
    }

    private double GetCurrentValue(Signal signal)
    {
        if (SessionState.IsLoaded)
        {
            var values = SessionState.GetCurrentValues();
            return values.TryGetValue(signal.Id, out var val) ? val : 0;
        }
        return signal.ValorActual;
    }

    private bool CanCurrentRoleSeeWindow(Window window)
    {
        return window.IsActive && window.IsRoleAllowed(_currentRole);
    }

    private string FormatValue(double value, Signal signal)
    {
        return value.ToString(signal.Formato) + (string.IsNullOrWhiteSpace(signal.Unidad) ? "" : $" {signal.Unidad}");
    }

    private int _activeAlarmCount => GetActiveAlarmCount();

    private int GetActiveAlarmCount()
    {
        int count = 0;
        foreach (var signal in _signals)
        {
            if (signal.BitEsAlarma == null) continue;
            double rawValue = GetCurrentValue(signal);
            int intVal = (int)rawValue;
            for (int i = 0; i < signal.BitCount && i < signal.BitEsAlarma.Length; i++)
            {
                if (signal.BitEsAlarma[i] && ((intVal >> i) & 1) == 1)
                {
                    count++;
                }
            }
        }
        return count;
    }

    private Action? _onStateChangedHandler;

    public void Dispose()
    {
        if (_onStateChangedHandler != null)
            SessionState.OnStateChanged -= _onStateChangedHandler;
    }
}
