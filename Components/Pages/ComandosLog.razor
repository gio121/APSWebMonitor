@* @page "/comandos/log"
@rendermode InteractiveServer

<MudText Typo="Typo.h5" Class="fw-bold mb-4 mt-n2">Log de Comandos</MudText>

<MudText Typo="Typo.h5" Class="fw-bold mb-4 mt-n2">Log de Comandos</MudText>

<!-- CMD Window Simulation -->
<div class="cmd-window-wrapper">
    <div class="cmd-titlebar">
        <div class="d-flex align-center">
            <svg viewBox="0 0 16 16" width="14" height="14" class="mr-2" fill="white"><path d="M0 2.5A1.5 1.5 0 0 1 1.5 1h13A1.5 1.5 0 0 1 16 2.5v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 13.5v-11zM1.5 2a.5.5 0 0 0-.5.5v11a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-11a.5.5 0 0 0-.5-.5h-13z"/><path d="M4.146 5.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 1 1-.708-.708L6.793 8.5 4.146 5.854a.5.5 0 0 1 0-.708zM8.5 11.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1H9a.5.5 0 0 1-.5-.5z"/></svg>
            <span>Símbolo del sistema - SCADA</span>
        </div>
        <div class="cmd-controls">
            <span class="cmd-ctrl">&#x2012;</span>
            <span class="cmd-ctrl">&#x25A1;</span>
            <span class="cmd-ctrl cmd-close" @onclick="LimpiarConsola">&#x2715;</span>
        </div>
    </div>

<!-- Terminal -->
<div class="console-container">
    <div class="console-body" id="consoleBody">
        @foreach (var line in _logsFiltrados)
        {
            <div class="console-line">
                <span class="console-msg">@line.Message</span>
            </div>
        }
        @if (!_logsFiltrados.Any())
        {
            <div class="console-line">
                <span class="console-msg text-muted">Sin entradas de log.</span>
            </div>
        }
    </div>

    <!-- Input -->
    <div class="console-input-area d-flex align-center">
        <span class="console-prompt">C:\SCADA&gt;</span>
        <input class="console-input" @bind="_comandoActual" @bind:event="oninput" @onkeydown="OnKeyDown" autofocus />
    </div>
</div>
</div>
<style>
    .cmd-window-wrapper {
        border: 1px solid #444;
        box-shadow: 2px 2px 10px rgba(0,0,0,0.5);
    }
    .cmd-titlebar {
        background-color: #000000;
        color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 12px;
        padding: 0 0 0 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 30px;
        user-select: none;
    }
    .cmd-controls {
        display: flex;
        height: 100%;
    }
    .cmd-ctrl {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 45px;
        height: 100%;
        cursor: default;
    }
    .cmd-ctrl:hover {
        background-color: #333;
    }
    .cmd-close:hover {
        background-color: #e81123 !important;
    }

    .console-container {
        background-color: #0c0c0c;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 200px);
        overflow: hidden;
        font-family: 'Consolas', 'Lucida Console', monospace;
        font-size: 14px;
        padding: 5px;
    }
    .console-body {
        overflow-y: auto;
    }
    .console-line {
        padding: 0;
        margin: 0;
        line-height: 1.2;
    }
    .console-msg {
        color: #cccccc;
    }
    .console-input-area {
        padding: 0;
        background-color: transparent;
        margin-top: 5px;
    }
    .console-prompt {
        color: #cccccc;
        margin-right: 5px;
    }
    .console-input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: #cccccc;
        font-family: inherit;
        font-size: 14px;
        caret-color: #cccccc;
    }
    .console-body::-webkit-scrollbar {
        width: 15px;
    }
    .console-body::-webkit-scrollbar-track {
        background: #000;
        border-left: 1px solid #333;
    }
    .console-body::-webkit-scrollbar-thumb {
        background: #4d4d4d;
    }
    .console-body::-webkit-scrollbar-thumb:hover {
        background: #666;
    }
</style>

@code {
    private string _filtro = "Todos";
    private string _comandoActual = "";
    private List<LogEntry> _logs = new();

    private IEnumerable<LogEntry> _logsFiltrados =>
        _filtro == "Todos" ? _logs : _logs.Where(l => l.Level == _filtro);

    protected override void OnInitialized()
    {
        // Entradas de ejemplo emulando formato cmd
        _logs = new List<LogEntry>
        {
            new(DateTime.Now, "INFO", "Microsoft Windows [Versión 10.0.19045.3803]"),
            new(DateTime.Now, "INFO", "(c) Microsoft Corporation. Todos los derechos reservados."),
            new(DateTime.Now, "INFO", ""),
            new(DateTime.Now, "INFO", "C:\\SCADA> SCADA_Service.exe --start"),
            new(DateTime.Now, "INFO", "Iniciando servicios del monitor APS... OK"),
            new(DateTime.Now, "INFO", "Cargando configuración de red... OK"),
            new(DateTime.Now, "INFO", "Escuchando en el puerto 502..."),
        };
    }

    private void SetFiltro(string filtro) => _filtro = filtro;

    private void LimpiarConsola()
    {
        _logs.Clear();
    }

    private void EnviarComando()
    {
        if (string.IsNullOrWhiteSpace(_comandoActual)) return;

        _logs.Add(new LogEntry(DateTime.Now, "CMD", $"C:\\SCADA> {_comandoActual}"));
        if (_comandoActual.ToLower() == "cls" || _comandoActual.ToLower() == "clear")
        {
            LimpiarConsola();
        }
        else
        {
            _logs.Add(new LogEntry(DateTime.Now, "OUT", $"Comando no reconocido o simulado: '{_comandoActual}'"));
        }
        _comandoActual = "";
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            EnviarComando();
        }
    }

    private record LogEntry(DateTime Timestamp, string Level, string Message);
}
 *@