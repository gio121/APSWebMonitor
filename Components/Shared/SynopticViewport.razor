@using ApsMonitor.Models
@using System.Text.Json
@inject IJSRuntime JS
@implements IAsyncDisposable

<section @ref="_root" class="synoptic-viewport @(DarkMode ? "is-dark" : "")" aria-label="@Ui["Synoptic work area"]">
    <div class="synoptic-scroll" tabindex="0" aria-label="@Ui["Synoptic canvas. Control plus wheel to zoom; Space plus drag to pan."]">
        <div class="synoptic-surface">
            <div class="synoptic-canvas">@ChildContent</div>
        </div>
    </div>
    <div class="synoptic-tools" role="toolbar" aria-label="@Ui["Synoptic zoom"]">
        <button type="button" data-view-action="out" title="@Ui["Zoom out"]" aria-label="@Ui["Zoom out"]">−</button>
        <label class="synoptic-percentage"><input type="number" value="100" min="10" max="400" step="1" inputmode="decimal" aria-label="@Ui["Zoom level"]" /><span aria-hidden="true">%</span></label>
        <button type="button" data-view-action="in" title="@Ui["Zoom in"]" aria-label="@Ui["Zoom in"]">+</button>
        <button type="button" data-view-action="center">@Ui["Center synoptic"]</button>
    </div>
</section>

@code {
    [Parameter] public IReadOnlyList<SinopticoElement> Elements { get; set; } = Array.Empty<SinopticoElement>();
    [Parameter] public bool Editable { get; set; }
    [Parameter] public bool DarkMode { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<SynopticEdit> EditCommitted { get; set; }
    [Parameter] public EventCallback<SynopticDrop> PaletteDropped { get; set; }
    [Parameter] public EventCallback<string?> SelectionChanged { get; set; }
    private ElementReference _root;
    private IJSObjectReference? _module, _controller;
    private DotNetObjectReference<SynopticViewport>? _reference;
    private string? _geometry;
    private bool _disposed;
    private readonly SemaphoreSlim _interopGate = new(1, 1);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        await _interopGate.WaitAsync();
        if (_disposed) { _interopGate.Release(); return; }
        var geometry = Elements.Select(e => new { e.Id, e.X, e.Y, e.Width, e.Height, e.Rotation, e.StrokeWidth, e.ProportionalScale }).ToArray();
        var snapshot = JsonSerializer.Serialize(geometry);
        try
        {
            if (_controller is null)
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/synoptic-viewport.js");
                if (_disposed) return;
                _reference ??= DotNetObjectReference.Create(this);
                _controller = await _module.InvokeAsync<IJSObjectReference>("create", _root, geometry, Editable, _reference);
                if (_disposed) return;
            }
            else if (_geometry != snapshot)
                // Keep the array as one JS argument instead of expanding params object[].
                await _controller.InvokeVoidAsync("update", (object)geometry);
            _geometry = snapshot;
        }
        catch (JSDisconnectedException) { }
        finally { _interopGate.Release(); }
    }

    [JSInvokable] public Task CommitEdit(SynopticEdit edit) => _disposed ? Task.CompletedTask : EditCommitted.InvokeAsync(edit);
    [JSInvokable] public Task DropPalette(SynopticDrop point) => _disposed ? Task.CompletedTask : PaletteDropped.InvokeAsync(point);
    [JSInvokable] public Task Select(string? id) => _disposed ? Task.CompletedTask : SelectionChanged.InvokeAsync(id);

    public async Task<SynopticPoint?> CenterAsync() => _controller is null ? null : await _controller.InvokeAsync<SynopticPoint>("center");

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _interopGate.WaitAsync();
        try
        {
            if (_controller is not null) { await _controller.InvokeVoidAsync("dispose"); await _controller.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _reference?.Dispose(); _interopGate.Release(); }
    }
}
