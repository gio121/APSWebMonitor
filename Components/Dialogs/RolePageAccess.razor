@inject PageAccessService Access
@inject ISnackbar Snackbar

<MudPaper Class="admin-card" Elevation="0">
    <MudText Typo="Typo.h6" Class="fw-bold">@Ui["Roles and tab access"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">@Ui["Select a role and enable the sections its users can access. Permissions are saved automatically."]</MudText>
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="6">
            <MudSelect T="string" Value="@_selectedRole" ValueChanged="SelectRoleAsync" Label="@Ui["Configure role permissions"]" Variant="Variant.Outlined" Disabled="_saving">
                @foreach (var role in _roles)
                {
                    <MudSelectItem T="string" Value="@role">@MonitorLocalization.RoleName(role)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <div class="create-role">
                <MudTextField @bind-Value="_newRole" Label="@Ui["New role name"]" MaxLength="40" Immediate="true" Variant="Variant.Outlined" Disabled="_saving" />
                <MudButton OnClick="CreateRoleAsync" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_saving || string.IsNullOrWhiteSpace(_newRole))" StartIcon="@Icons.Material.Outlined.Add">@Ui["Create role"]</MudButton>
            </div>
        </MudItem>
    </MudGrid>
    @if (_selectedRole == "Administrador")
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">@Ui["The administrator retains full access. Administration and synoptic editing are restricted to this role."]</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-4">@Ui["{0} of {1} tabs enabled. Assign this role in Manage users.", _permissions?.Count(x => x.Value) ?? 0, PageAccessService.Pages.Length]</MudText>
    }
    @if (_permissions is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudGrid Spacing="2">
            @foreach (var item in PageAccessService.Pages)
            {
                <MudItem xs="12" sm="6" md="4">
                    <div class="page-permission">
                    <MudSwitch T="bool" Color="Color.Primary" Label="@item.Name" Value="@_permissions[item.Key]" ValueChanged="@(value => SaveAsync(item.Key, value))" Disabled="@(_saving || _selectedRole == "Administrador")" />
                    </div>
                </MudItem>
            }
        </MudGrid>
    }
</MudPaper>

@code {
    private Dictionary<string, bool>? _permissions;
    private bool _saving;
    private List<string> _roles = new();
    private string _selectedRole = "Mantenimiento";
    private string _newRole = "";
    protected override async Task OnInitializedAsync()
    {
        _roles = await Access.GetRolesAsync();
        _permissions = await Access.GetAsync(_selectedRole);
    }
    private async Task SelectRoleAsync(string role)
    {
        if (_saving) return;
        _saving = true;
        try
        {
            var permissions = await Access.GetAsync(role);
            _selectedRole = role;
            _permissions = permissions;
        }
        catch (Exception) { Snackbar.Add(ApsMonitor.Resources.MonitorResources.Text("Unable to load role permissions."), Severity.Error); }
        finally { _saving = false; }
    }
    private async Task CreateRoleAsync()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            _selectedRole = await Access.CreateRoleAsync(_newRole);
            _roles = await Access.GetRolesAsync();
            _permissions = await Access.GetAsync(_selectedRole);
            _newRole = "";
            Snackbar.Add(ApsMonitor.Resources.MonitorResources.Text("Role created. Enable the tabs it can access."), Severity.Success);
        }
        catch (ArgumentException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception) { Snackbar.Add(ApsMonitor.Resources.MonitorResources.Text("Unable to create the role. Check that its name is unique."), Severity.Error); }
        finally { _saving = false; }
    }
    private async Task SaveAsync(string key, bool allowed)
    {
        _saving = true;
        try
        {
            await Access.SetAsync(_selectedRole, key, allowed);
            _permissions = await Access.GetAsync(_selectedRole);
            Snackbar.Add(ApsMonitor.Resources.MonitorResources.Text("Permission updated."), Severity.Success);
        }
        catch (Exception) { Snackbar.Add(ApsMonitor.Resources.MonitorResources.Text("Unable to save the permission. Please try again."), Severity.Error); }
        finally { _saving = false; }
    }
}
