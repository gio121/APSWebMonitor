@using ApsMonitor.Models
@inject ISnackbar Snackbar

<MudDialog Class="trdp-dialog">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Info" />
            <MudText Typo="Typo.h6">@(IsNew ? "Nuevo Mapping" : "Editar Mapping")</MudText>
            @if (!string.IsNullOrEmpty(FixedTarget))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">→ @FixedTarget</MudChip>
            }
            @if (Link.SumToCurrent)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">+= Sumar</MudChip>
            }
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <!-- Tipo -->
            <MudItem xs="12">
                <MudSelect Value="Link.Type" Label="Tipo de mapping *" Variant="Variant.Outlined"
                           Margin="Margin.Dense" FullWidth="true" AnchorOrigin="Origin.BottomCenter"
                           T="string" ValueChanged="OnTypeChanged">
                    <MudSelectItem Value='"analog"'>Analog – escalar variable analógica</MudSelectItem>
                    <MudSelectItem Value='"max_value"'>Max value – mayor valor entre 2 o más variables</MudSelectItem>
                    <MudSelectItem Value='"formula"'>Formula – expresión matemática / aritmética</MudSelectItem>
                    <MudSelectItem Value='"rising_edge_increment"'>Rising edge increment – sumar valor en flanco 0→1</MudSelectItem>
                    <MudSelectItem Value='"bit_to_bit"'>Bit to bit – copiar un bit</MudSelectItem>
                    <MudSelectItem Value='"condition_to_bit"'>Condition to bit – condición → bit</MudSelectItem>
                    <MudSelectItem Value='"logic_to_bit"'>Logic to bit – OR/AND de múltiples fuentes</MudSelectItem>
                    <MudSelectItem Value='"constant"'>Constant – valor fijo</MudSelectItem>
                    <MudSelectItem Value='"direct_copy"'>Direct copy – copia directa de bytes</MudSelectItem>
                    <MudSelectItem Value='"sequence"'>Sequence – life-counter incremental</MudSelectItem>
                </MudSelect>
            </MudItem>

            <!-- Source (single-source types) -->
            @if (Link.Type is "analog" or "bit_to_bit" or "condition_to_bit" or "direct_copy" or "rising_edge_increment")
            {
                <MudItem xs="12" sm="6">
                    <MudAutocomplete Value="Link.SourceControlVar"
                                     ValueChanged="OnSourceControlVarChanged"
                                     Label="Variable de control (source) *"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                     SearchFunc="SearchControlVars" ShowProgressIndicator="true"
                                     Placeholder="Escribir tag de señal…" MaxItems="40" T="string"
                                     HelperText="Se auto-cargarán la escala y offset por defecto (si existen)" />
                </MudItem>
            }

            <!-- ── max_value: 2 o más variables ────────────────────────── -->
            @if (Link.Type == "max_value")
            {
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-3" Style="background:#111827; border:1px solid rgba(255,255,255,0.06); border-radius:8px;">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2" Style="color:#38bdf8;">
                            Variables a comparar (calcula el mayor valor)
                        </MudText>
                        <div class="d-flex gap-2 align-center mb-2 flex-wrap">
                            <div class="flex-grow-1" style="min-width:240px;">
                                <MudAutocomplete @bind-Value="_selectedVarToAdd"
                                                 Label="Seleccionar variable para añadir"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                                 SearchFunc="SearchControlVars" ShowProgressIndicator="true"
                                                 Placeholder="Escribir tag de señal…" MaxItems="40" T="string" />
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add" OnClick="AddMaxValueVar"
                                       Disabled="@string.IsNullOrWhiteSpace(_selectedVarToAdd)">
                                Añadir
                            </MudButton>
                        </div>

                        @if (Link.SourceControlVars is { Count: > 0 })
                        {
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var v in Link.SourceControlVars)
                                {
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled"
                                             OnClose="@(() => RemoveMaxValueVar(v))">
                                        @v
                                    </MudChip>
                                }
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="trdp-muted">
                                No se ha añadido ninguna variable. Añade al menos 2 variables.
                            </MudText>
                        }

                        @if ((Link.SourceControlVars?.Count ?? 0) < 2)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                Se requieren al menos 2 variables para elegir el mayor valor.
                            </MudAlert>
                        }
                    </MudPaper>
                </MudItem>
            }

            <!-- ── formula: expresión matemática ────────────────────────── -->
            @if (Link.Type == "formula")
            {
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-3" Style="background:#111827; border:1px solid rgba(255,255,255,0.06); border-radius:8px;">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1" Style="color:#38bdf8;">
                            Fórmula de cálculo
                        </MudText>
                        <MudTextField @bind-Value="Link.Formula"
                                      Label="Expresión *"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                      Placeholder="p.ej. POTENCIA * delta_h o (v1 + v2) / 2"
                                      HelperText="Operadores: +, -, *, /, (, ). Funciones: max(a,b), min(a,b), abs(x)." />

                        <!-- Asistente de Fórmula -->
                        <MudPaper Elevation="0" Class="pa-3 mt-2" Style="background:#0f172a; border:1px solid rgba(56,189,248,0.2); border-radius:8px;">
                            <div class="d-flex align-center justify-space-between mb-2">
                                <div class="d-flex align-center gap-1">
                                    <MudIcon Icon="@Icons.Material.Filled.Functions" Size="Size.Small" Style="color:#38bdf8;" />
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color:#38bdf8;">
                                        Asistente de Fórmula
                                    </MudText>
                                </div>
                                <MudText Typo="Typo.caption" Class="trdp-muted">
                                    Haz clic para insertar en la fórmula
                                </MudText>
                            </div>

                            <!-- Deltas de tiempo -->
                            <div class="mb-2">
                                <MudText Typo="Typo.caption" Class="fw-bold d-block mb-1" Style="color:#a78bfa;">
                                    ⏱️ Variable delta de tiempo transcurrido (para integrar energía, distancia, etc.):
                                </MudText>
                                <div class="d-flex flex-wrap gap-1">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                                             OnClick="@(() => InsertFormulaToken("delta_s"))">
                                        delta_s (seg)
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                                             OnClick="@(() => InsertFormulaToken("delta_m"))">
                                        delta_m (min)
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                                             OnClick="@(() => InsertFormulaToken("delta_h"))">
                                        delta_h (horas)
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                                             OnClick="@(() => InsertFormulaToken("delta_ms"))">
                                        delta_ms (ms)
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined"
                                             OnClick="@(() => InsertFormulaToken("* delta_s"))">
                                        * delta_s
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined"
                                             OnClick="@(() => InsertFormulaToken("* delta_h"))">
                                        * delta_h (ej. kWh)
                                    </MudChip>
                                </div>
                            </div>

                            <!-- Operadores y funciones matemáticas -->
                            <div class="mb-2">
                                <MudText Typo="Typo.caption" Class="fw-bold d-block mb-1" Style="color:#94a3b8;">
                                    Operadores y Funciones:
                                </MudText>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var op in new[] { "+", "-", "*", "/", "(", ")", "max(", "min(", "abs(" })
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                                 OnClick="@(() => InsertFormulaToken(op))">
                                            @op
                                        </MudChip>
                                    }
                                </div>
                            </div>

                            <!-- Recomendación de variables de control -->
                            @if (ControlVariables.Count > 0 || ControlVarTags.Count > 0)
                            {
                                <div>
                                    <div class="d-flex align-center justify-space-between mb-1">
                                        <MudText Typo="Typo.caption" Class="fw-bold" Style="color:#38bdf8;">
                                            Variables de control:
                                        </MudText>
                                        <MudTextField @bind-Value="_formulaVarFilter" Placeholder="Buscar variable de control…"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                                      Style="max-width:200px; font-size:0.75rem;" Class="my-0 py-0" />
                                    </div>
                                    <div class="d-flex flex-wrap gap-1" style="max-height:110px; overflow-y:auto;">
                                        @foreach (var tag in FilteredControlVars)
                                        {
                                            <MudTooltip Text="@GetControlVarTooltip(tag)">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                                                         OnClick="@(() => InsertFormulaToken(tag))">
                                                    @tag
                                                </MudChip>
                                            </MudTooltip>
                                        }
                                    </div>
                                </div>
                            }
                        </MudPaper>
                    </MudPaper>
                </MudItem>
            }

            <!-- Source bit (bit_to_bit / rising_edge_increment) -->
            @if (Link.Type is "bit_to_bit" or "rising_edge_increment")
            {
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_sourceBit" Label="Bit origen (0-15) *"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Min="0" Max="15" />
                </MudItem>
            }

            <!-- Target bit (bit-based types) -->
            @if (Link.Type is "bit_to_bit" or "condition_to_bit" or "logic_to_bit")
            {
                <MudItem xs="12" sm="@(Link.Type == "logic_to_bit" ? 12 : 6)">
                    <MudNumericField @bind-Value="_targetBit" Label="Bit destino (0-15)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Min="0" Max="15" />
                </MudItem>
            }

            <!-- Rising edge increment parameters -->
            @if (Link.Type == "rising_edge_increment")
            {
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_increment" Label="Valor a sumar en flanco *"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Format="G6"
                                     Placeholder="1.0" HelperText="Cantidad a sumar a la variable al activarse el bit (0→1)" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-end pb-1">
                    <MudCheckBox @bind-Value="Link.Invert" Label="Invertir flanco (detectar flanco de 1 a 0)" Color="Color.Info" />
                </MudItem>
            }

            <!-- Analog / Max Value / Formula scaling & offset -->
            @if (Link.Type is "analog" or "max_value" or "formula")
            {
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_scale" Label="Escala (scale)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Format="G6"
                                     HelperText="Multiplicador aplicado al valor" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_offset" Label="Offset"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Format="G6"
                                     HelperText="Sumando aplicado al resultado" />
                </MudItem>
            }

            <!-- Constant value -->
            @if (Link.Type == "constant")
            {
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_constValue" Label="Valor constante"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                </MudItem>
            }

            <!-- Direct copy length -->
            @if (Link.Type == "direct_copy")
            {
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_length" Label="Longitud (bytes)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Min="1" />
                </MudItem>
            }

            <!-- Sumar al valor actual (+=) -->
            @if (Link.Type is "analog" or "max_value" or "formula" or "constant" or "direct_copy")
            {
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-3" Style="background:#111827; border:1px solid rgba(255,255,255,0.06); border-radius:8px;">
                        <div class="d-flex align-center gap-2">
                            <MudCheckBox @bind-Value="Link.SumToCurrent" Color="Color.Primary" />
                            <div>
                                <MudText Typo="Typo.body2" Class="fw-bold">Sumar al valor actual (+=)</MudText>
                                <MudText Typo="Typo.caption" Class="trdp-muted">
                                    Suma el resultado del cálculo o mapeo al valor acumulado de la variable destino en cada ciclo (en lugar de sobrescribirlo).
                                </MudText>
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
            }

            <!-- Condition to bit -->
            @if (Link.Type == "condition_to_bit")
            {
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="Link.Condition" Label="Condición" Variant="Variant.Outlined"
                               Margin="Margin.Dense" FullWidth="true" T="string">
                        <MudSelectItem Value='"equals"'>equals – igual a valor</MudSelectItem>
                        <MudSelectItem Value='"in_list"'>in_list – está en lista de valores</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @if (Link.Condition == "equals")
                {
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="_condValue" Label="Valor de comparación"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                    </MudItem>
                }
                else if (Link.Condition == "in_list")
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_valuesText" Label="Lista de valores (separados por coma)"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                      Placeholder="1, 76, 77, 78" HelperText="Enteros separados por coma" />
                    </MudItem>
                }

                <MudItem xs="12" sm="6" Class="d-flex align-end pb-1">
                    <MudCheckBox @bind-Value="Link.Invert" Label="Invertir condición (NOT: se cumple si no coincide)" Color="Color.Info" />
                </MudItem>
            }

            <!-- set_only flag & bit negation for bit_to_bit -->
            @if (Link.Type == "bit_to_bit")
            {
                <MudItem xs="12" sm="6">
                    <MudCheckBox @bind-Value="Link.SetOnly" Label="set_only (solo activar, no resetear)" Color="Color.Info" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudCheckBox @bind-Value="Link.Invert" Label="Invertir bit (NOT: bit 0 → 1, bit 1 → 0)" Color="Color.Info" />
                </MudItem>
            }
            else if (Link.Type == "condition_to_bit")
            {
                <MudItem xs="12" sm="6">
                    <MudCheckBox @bind-Value="Link.SetOnly" Label="set_only (solo activar, no resetear)" Color="Color.Info" />
                </MudItem>
            }

            <!-- ── logic_to_bit ─────────────────────────────────────────── -->
            @if (Link.Type == "logic_to_bit")
            {
                <MudItem xs="12">
                    <div class="d-flex align-center gap-3 mb-2">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color:#38bdf8;">Operador lógico</MudText>
                        <MudSelect @bind-Value="Link.Operator" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Style="max-width:140px" T="string">
                            <MudSelectItem Value='"OR"'>OR (cualquiera)</MudSelectItem>
                            <MudSelectItem Value='"AND"'>AND (todas)</MudSelectItem>
                        </MudSelect>
                    </div>
                </MudItem>

                <MudItem xs="12">
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color:#38bdf8;">
                            Entradas (@(Link.Inputs?.Count ?? 0))
                        </MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddInput">
                            Añadir entrada
                        </MudButton>
                    </div>

                    @if (Link.Inputs is { Count: > 0 })
                    {
                        @foreach (var (inp, idx) in Link.Inputs.Select((x, i) => (x, i)))
                        {
                            <MudPaper Elevation="0" Class="pa-3 mb-2" Style="background:#111827; border:1px solid rgba(255,255,255,0.06); border-radius:8px;">
                                <MudGrid Spacing="2">
                                    <!-- Modo: bit o condición -->
                                    <MudItem xs="12" sm="2">
                                        <MudSelect Value="@(inp.SourceBit.HasValue ? "bit" : "condition")"
                                                   ValueChanged="@((string m) => OnInputModeChanged(inp, m))"
                                                   Label="Modo" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" T="string">
                                            <MudSelectItem Value='"bit"'>Bit</MudSelectItem>
                                            <MudSelectItem Value='"condition"'>Condición</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>

                                    <!-- Source var -->
                                    <MudItem xs="12" sm="4">
                                        <MudAutocomplete Value="inp.SourceControlVar"
                                                         ValueChanged="@((string v) => inp.SourceControlVar = v)"
                                                         Label="Variable control" Variant="Variant.Outlined"
                                                         Margin="Margin.Dense" FullWidth="true"
                                                         SearchFunc="SearchControlVars" MaxItems="40" T="string" />
                                    </MudItem>

                                    @if (inp.SourceBit.HasValue)
                                    {
                                        <!-- Bit mode -->
                                        <MudItem xs="12" sm="2">
                                            <MudNumericField Value="@(inp.SourceBit ?? 0)"
                                                             ValueChanged="@((int b) => inp.SourceBit = b)"
                                                             Label="Bit (0-15)" Variant="Variant.Outlined"
                                                             Margin="Margin.Dense" FullWidth="true" Min="0" Max="15" />
                                        </MudItem>
                                        <MudItem xs="12" sm="3" Class="d-flex align-center">
                                            <MudCheckBox @bind-Value="inp.Invert" Label="Invertir (NOT: si bit=0)" Color="Color.Warning" Dense="true" />
                                        </MudItem>
                                    }
                                    else
                                    {
                                        <!-- Condition mode -->
                                        <MudItem xs="12" sm="2">
                                            <MudSelect Value="@(inp.Condition ?? "equals")"
                                                       ValueChanged="@((string c) => inp.Condition = c)"
                                                       Label="Cond." Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" T="string">
                                                <MudSelectItem Value='"equals"'>==</MudSelectItem>
                                                <MudSelectItem Value='"in_list"'>in</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="2">
                                            @if (inp.Condition == "in_list")
                                            {
                                                <MudTextField Value="@ValuesToText(inp.Values)"
                                                              ValueChanged="@((string t) => inp.Values = TextToValues(t))"
                                                              Label="Valores" Variant="Variant.Outlined"
                                                              Margin="Margin.Dense" FullWidth="true"
                                                              Placeholder="1, 76, 77" />
                                            }
                                            else
                                            {
                                                <MudNumericField Value="@(inp.Value ?? 0)"
                                                                 ValueChanged="@((double v) => inp.Value = v)"
                                                                 Label="Valor" Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense" FullWidth="true" />
                                            }
                                        </MudItem>
                                        <MudItem xs="12" sm="2" Class="d-flex align-center">
                                            <MudCheckBox @bind-Value="inp.Invert" Label="NOT" Color="Color.Warning" Dense="true" />
                                        </MudItem>
                                    }

                                    <MudItem xs="12" sm="1" Class="d-flex align-center justify-end">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                       Size="Size.Small" OnClick="@(() => Link.Inputs!.RemoveAt(idx))" />
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="trdp-muted">Sin entradas. Añade al menos 2.</MudText>
                    }
                </MudItem>
            }

            <!-- Comment -->
            <MudItem xs="12">
                <MudTextField @bind-Value="Link.Comment" Label="Comentario (opcional)"
                              Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton Color="Color.Info" Variant="Variant.Filled" OnClick="Submit"
                   StartIcon="@Icons.Material.Filled.Save">Guardar</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .trdp-muted { color: #94a3b8 !important; }
    .trdp-dialog .mud-dialog-content { max-height: 80vh; overflow-y: auto; }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public TrdpVariableLink Link { get; set; } = new();
    [Parameter] public bool IsNew { get; set; } = true;
    /// <summary>Pre-set target_comms_var (shown read-only). If empty, the target is free.</summary>
    [Parameter] public string FixedTarget { get; set; } = string.Empty;
    [Parameter] public List<string> ControlVarTags { get; set; } = new();
    [Parameter] public List<TrdpControlVariable> ControlVariables { get; set; } = new();
    [Parameter] public List<Signal> Signals { get; set; } = new();

    // Numeric helpers
    private double _scale      { get => Link.Scale     ?? 1.0; set => Link.Scale     = value; }
    private double _offset     { get => Link.Offset    ?? 0.0; set => Link.Offset    = value; }
    private double _constValue { get => Link.Value     ?? 0.0; set => Link.Value     = value; }
    private double _condValue  { get => Link.Value     ?? 0.0; set => Link.Value     = value; }
    private double _increment  { get => Link.Increment ?? 1.0; set => Link.Increment = value; }
    private int    _sourceBit  { get => Link.SourceBit   ?? 0; set => Link.SourceBit   = value; }
    private int    _targetBit  { get => Link.TargetBit   ?? 0; set => Link.TargetBit   = value; }
    private int    _length     { get => Link.Length    ?? 1;   set => Link.Length    = value; }
    private string _valuesText = "";
    private string _selectedVarToAdd = "";
    private string _formulaVarFilter = "";

    private IEnumerable<string> ControlVarNames
    {
        get
        {
            if (ControlVariables is { Count: > 0 })
            {
                return ControlVariables.Select(v => v.Id).Where(id => !string.IsNullOrWhiteSpace(id)).Distinct().OrderBy(id => id);
            }
            return ControlVarTags;
        }
    }

    private IEnumerable<string> FilteredControlVars =>
        string.IsNullOrWhiteSpace(_formulaVarFilter)
            ? ControlVarNames.Take(40)
            : ControlVarNames.Where(t => t.Contains(_formulaVarFilter, StringComparison.OrdinalIgnoreCase)).Take(40);

    private string GetControlVarTooltip(string varName)
    {
        var cv = ControlVariables?.FirstOrDefault(c => string.Equals(c.Id, varName, StringComparison.OrdinalIgnoreCase));
        if (cv != null)
        {
            var desc = string.IsNullOrEmpty(cv.Description) ? "" : $"{cv.Description} | ";
            var unit = string.IsNullOrEmpty(cv.Unit) ? "" : $" [{cv.Unit}]";
            return $"{desc}Tipo: {cv.Type}, Offset: {cv.Offset} (bit {cv.VarOffsetBits}){unit}";
        }
        return varName;
    }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(FixedTarget))
            Link.TargetCommsVar = FixedTarget;

        // Init condition text for in_list
        _valuesText = Link.Values is { Count: > 0 }
            ? string.Join(", ", Link.Values.Select(v => ((int)v).ToString()))
            : "";

        // Default logic_to_bit
        if (Link.Type == "logic_to_bit")
        {
            Link.Operator ??= "OR";
            Link.Inputs ??= new();
        }
        else if (Link.Type == "max_value")
        {
            Link.SourceControlVars ??= new();
        }
        else if (Link.Type == "rising_edge_increment")
        {
            Link.Increment ??= 1.0;
        }
    }

    private void OnSourceControlVarChanged(string val)
    {
        Link.SourceControlVar = val;
        ApplyDefaultsForVariable(val);
    }

    private void ApplyDefaultsForVariable(string? varName)
    {
        if (string.IsNullOrWhiteSpace(varName)) return;

        // 1. Check ControlVariables configured in TRDP session
        var ctrlVar = ControlVariables?.FirstOrDefault(c => string.Equals(c.Id, varName, StringComparison.OrdinalIgnoreCase));
        if (ctrlVar != null && (ctrlVar.Scale.HasValue || ctrlVar.OffsetVal.HasValue))
        {
            if (ctrlVar.Scale.HasValue) _scale = ctrlVar.Scale.Value;
            if (ctrlVar.OffsetVal.HasValue) _offset = ctrlVar.OffsetVal.Value;
            Link.Scale = _scale;
            Link.Offset = _offset;
            return;
        }

        // 2. Check Signals in database
        var sig = Signals?.FirstOrDefault(s => string.Equals(s.Tag, varName, StringComparison.OrdinalIgnoreCase) ||
                                               string.Equals(s.Nombre, varName, StringComparison.OrdinalIgnoreCase));
        if (sig != null)
        {
            _scale = sig.Escala;
            _offset = sig.Offset;
            Link.Scale = _scale;
            Link.Offset = _offset;
        }
    }

    private void AddMaxValueVar()
    {
        if (string.IsNullOrWhiteSpace(_selectedVarToAdd)) return;
        Link.SourceControlVars ??= new();
        if (!Link.SourceControlVars.Contains(_selectedVarToAdd, StringComparer.OrdinalIgnoreCase))
        {
            Link.SourceControlVars.Add(_selectedVarToAdd);
            // If it's the first variable added and scale/offset are at defaults, populate defaults
            if (Link.SourceControlVars.Count == 1 && (!Link.Scale.HasValue || Link.Scale == 1.0) && (!Link.Offset.HasValue || Link.Offset == 0.0))
            {
                ApplyDefaultsForVariable(_selectedVarToAdd);
            }
        }
        _selectedVarToAdd = "";
        StateHasChanged();
    }

    private void RemoveMaxValueVar(string varName)
    {
        Link.SourceControlVars?.Remove(varName);
        StateHasChanged();
    }

    private void InsertFormulaTag(string tag) => InsertFormulaToken(tag);

    private void InsertFormulaToken(string token)
    {
        if (string.IsNullOrEmpty(Link.Formula))
        {
            Link.Formula = token;
        }
        else
        {
            var needsSpace = !token.StartsWith(" ") && !token.StartsWith(")") && !token.StartsWith(",") &&
                             !Link.Formula.EndsWith(" ") && !Link.Formula.EndsWith("(") && !Link.Formula.EndsWith(",");
            Link.Formula += (needsSpace ? " " : "") + token;
        }
        StateHasChanged();
    }

    private void OnTypeChanged(string newType)
    {
        Link.Type = newType;
        if (newType is "constant" or "sequence" or "max_value" or "formula") Link.SourceControlVar = null;
        if (newType is not ("bit_to_bit" or "condition_to_bit" or "logic_to_bit" or "rising_edge_increment"))
        { Link.SourceBit = null; Link.TargetBit = null; Link.SetOnly = false; Link.Invert = false; }
        if (newType is not ("analog" or "max_value" or "formula")) { Link.Scale = null; Link.Offset = null; }
        if (newType != "constant")      Link.Value = null;
        if (newType != "direct_copy")   Link.Length = null;
        if (newType != "condition_to_bit") { Link.Condition = null; Link.Values = null; }
        if (newType == "logic_to_bit")  { Link.Operator ??= "OR"; Link.Inputs ??= new(); }
        else                            { Link.Operator = null; Link.Inputs = null; }
        if (newType == "max_value")     { Link.SourceControlVars ??= new(); }
        else                            { Link.SourceControlVars = null; }
        if (newType != "formula")       { Link.Formula = null; }
        if (newType == "rising_edge_increment") { Link.Increment ??= 1.0; Link.SourceBit ??= 0; }
        else                                    { Link.Increment = null; }
        if (newType is not ("analog" or "max_value" or "formula" or "constant" or "direct_copy"))
        {
            Link.SumToCurrent = false;
        }
    }

    private void AddInput()
    {
        Link.Inputs ??= new();
        Link.Inputs.Add(new TrdpLogicInput { SourceControlVar = "", Condition = "equals", Value = 0 });
        StateHasChanged();
    }

    private void OnInputModeChanged(TrdpLogicInput inp, string mode)
    {
        if (mode == "bit") { inp.SourceBit = 0; inp.Condition = null; inp.Value = null; inp.Values = null; }
        else               { inp.SourceBit = null; inp.Condition = "equals"; inp.Value = 0; }
        StateHasChanged();
    }

    private Task<IEnumerable<string>> SearchControlVars(string value, CancellationToken ct)
    {
        var baseList = ControlVarNames;
        var results = string.IsNullOrWhiteSpace(value)
            ? baseList
            : baseList.Where(t => t.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(results.Take(40));
    }

    private static string ValuesToText(List<double>? vals)
        => vals is { Count: > 0 } ? string.Join(", ", vals.Select(v => ((int)v).ToString())) : "";

    private static List<double> TextToValues(string text)
        => text.Split(',', StringSplitOptions.RemoveEmptyEntries)
               .Select(s => double.TryParse(s.Trim(), out var d) ? d : 0)
               .ToList();

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (!string.IsNullOrEmpty(FixedTarget))
            Link.TargetCommsVar = FixedTarget;

        if (string.IsNullOrWhiteSpace(Link.TargetCommsVar))
        {
            Snackbar.Add("La variable de dataset destino es obligatoria.", Severity.Warning);
            return;
        }
        if (Link.Type == "rising_edge_increment")
        {
            if (string.IsNullOrWhiteSpace(Link.SourceControlVar))
            {
                Snackbar.Add("rising_edge_increment requiere una variable de control origen.", Severity.Warning);
                return;
            }
            Link.Increment ??= _increment;
        }
        if (Link.Type == "logic_to_bit" && (Link.Inputs == null || Link.Inputs.Count < 2))
        {
            Snackbar.Add("logic_to_bit requiere al menos 2 entradas.", Severity.Warning);
            return;
        }
        if (Link.Type == "max_value" && (Link.SourceControlVars == null || Link.SourceControlVars.Count < 2))
        {
            Snackbar.Add("max_value requiere al menos 2 variables de control a comparar.", Severity.Warning);
            return;
        }
        if (Link.Type == "formula" && string.IsNullOrWhiteSpace(Link.Formula))
        {
            Snackbar.Add("Debe introducir una fórmula matemática.", Severity.Warning);
            return;
        }

        // Sync in_list values for condition_to_bit
        if (Link.Type == "condition_to_bit" && Link.Condition == "in_list")
        {
            Link.Values = TextToValues(_valuesText);
            Link.Value  = null;
        }
        else if (Link.Type == "condition_to_bit" && Link.Condition == "equals")
        {
            Link.Values = null;
        }

        MudDialog.Close(DialogResult.Ok(Link));
    }
}
