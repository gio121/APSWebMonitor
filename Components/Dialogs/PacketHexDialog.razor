@using ApsMonitor.Models
@using System.Text
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog Class="packet-hex-dialog" Style="min-width: 600px; max-width: 850px; background: #19212d;">
    <TitleContent>
        <div class="d-flex align-center justify-space-between">
            <MudText Typo="Typo.h6" Class="fw-bold d-flex align-center gap-2" Style="color:#38bdf8;">
                <MudIcon Icon="@Icons.Material.Filled.Terminal" />
                Detalle Hexadecimal de Trama #@Packet.Index
            </MudText>
            <div class="d-flex align-center gap-2">
                <MudChip T="string" Color="@(Packet.Protocol == "UDP" ? Color.Primary : Color.Secondary)" Size="Size.Small" Variant="Variant.Filled">
                    @Packet.Protocol
                </MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                    @Packet.Payload.Length Bytes
                </MudChip>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="mb-3 d-flex flex-wrap gap-3 pa-2 rounded" style="background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.05);">
            <div>
                <span class="text-caption text-muted">Origen: </span>
                <span class="text-caption fw-bold" style="color:#e2e8f0;">@Packet.SourceIp:@Packet.SourcePort</span>
            </div>
            <div>
                <span class="text-caption text-muted">Destino: </span>
                <span class="text-caption fw-bold" style="color:#38bdf8;">@Packet.DestinationIp:@Packet.DestinationPort</span>
            </div>
            <div>
                <span class="text-caption text-muted">Timestamp: </span>
                <span class="text-caption fw-bold" style="color:#a78bfa;">@Packet.Timestamp.ToString("HH:mm:ss.fff") (+@Packet.RelativeTime.ToString(@"hh\:mm\:ss\.fff"))</span>
            </div>
            <div>
                <span class="text-caption text-muted">Info: </span>
                <span class="text-caption fw-bold" style="color:#f59e0b;">@Packet.Info</span>
            </div>
        </div>

        <div class="d-flex justify-space-between align-center mb-2">
            <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color:#94a3b8;">
                Volcado Hexadecimal & ASCII (Payload)
            </MudText>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyHex">
                    Copiar Hex
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Code" OnClick="CopyAscii">
                    Copiar ASCII
                </MudButton>
            </div>
        </div>

        <div class="pa-3 rounded overflow-auto" style="background:#0f172a; max-height: 420px; font-family: 'Consolas', 'Courier New', monospace; font-size: 0.85rem; border: 1px solid rgba(255,255,255,0.1);">
            <pre style="margin: 0; color: #cbd5e1; white-space: pre;">@BuildHexDump(Packet.Payload)</pre>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="Close">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .packet-hex-dialog .mud-dialog-title {
        border-bottom: 1px solid rgba(255,255,255,0.06);
        padding: 16px 24px;
    }
    .packet-hex-dialog .mud-dialog-actions {
        border-top: 1px solid rgba(255,255,255,0.06);
        padding: 12px 24px;
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ReplayPacket Packet { get; set; } = new();

    private void Close() => MudDialog.Close();

    private async Task CopyHex()
    {
        string hex = Convert.ToHexString(Packet.Payload);
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", hex);
        Snackbar.Add("Payload HEX copiado al portapapeles", Severity.Success);
    }

    private async Task CopyAscii()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Packet.PayloadAscii);
        Snackbar.Add("ASCII copiado al portapapeles", Severity.Success);
    }

    private static string BuildHexDump(byte[] data)
    {
        if (data == null || data.Length == 0) return "-- Payload Vacío --";

        var sb = new StringBuilder();
        sb.AppendLine("OFFSET    00 01 02 03 04 05 06 07  08 09 0A 0B 0C 0D 0E 0F   ASCII");
        sb.AppendLine("----------------------------------------------------------------------");

        for (int i = 0; i < data.Length; i += 16)
        {
            sb.AppendFormat("{0:X8}  ", i);

            // Hex bytes
            for (int j = 0; j < 16; j++)
            {
                if (i + j < data.Length)
                    sb.AppendFormat("{0:X2} ", data[i + j]);
                else
                    sb.Append("   ");

                if (j == 7) sb.Append(' ');
            }

            sb.Append("  |");

            // ASCII representation
            for (int j = 0; j < 16 && (i + j) < data.Length; j++)
            {
                byte b = data[i + j];
                sb.Append(b >= 32 && b <= 126 ? (char)b : '.');
            }

            sb.AppendLine("|");
        }

        return sb.ToString();
    }
}
