@using ApsMonitor.Models
@inject ApsDataService DataService

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_draft.Nombre" Label="Nombre del comando" Required="true" Immediate="true" Variant="Variant.Outlined" Class="mb-3" />
        <MudSelect T="int?" @bind-Value="_draft.FrameType" Label="Tipo de comando" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem T="int?" Value="@((int?)0x6A)">6A · Modificación de variable</MudSelectItem>
            <MudSelectItem T="int?" Value="@((int?)0x7A)">7A · Comando interno</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="_subcommandHex" Label="Subcomando hexadecimal" HelperText="0000–FFFF; se admite el prefijo 0x" Immediate="true" Variant="Variant.Outlined" Class="mb-3" />
        @if (_draft.FrameType == 0x6A)
        {
            <MudSelect T="int?" @bind-Value="_draft.SignalId" Label="Variable asociada de control" Required="true" Variant="Variant.Outlined" Class="mb-3">
                @foreach (var signal in _signals)
                {
                    <MudSelectItem T="int?" Value="@((int?)signal.Id)">@signal.BindingLabel · @signal.TipoVariable</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="double?" @bind-Value="_draft.VariableValue" Label="Valor a escribir" HelperText="Valor bruto de protocolo, sin aplicar escala ni offset. Se codifica según el tipo de la variable." Required="true" Immediate="true" Variant="Variant.Outlined" Class="mb-3" />
        }
        <MudSelect T="string" @bind-Value="_draft.Estilo" Label="Estilo visual" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem Value='@("success")'>Verde</MudSelectItem>
            <MudSelectItem Value='@("warning")'>Naranja</MudSelectItem>
            <MudSelectItem Value='@("destructive")'>Rojo</MudSelectItem>
            <MudSelectItem Value='@("default")'>Predeterminado</MudSelectItem>
        </MudSelect>
        <MudCheckBox @bind-Value="_draft.RequiereConfirmacion" Label="Requiere confirmación" />
        <MudText Typo="Typo.caption">Destino: control (nodo 2). Solo se envía con monitorización activa.</MudText>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">Cancelar</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ScadaCommand Command { get; set; } = new();
    private ScadaCommand _draft = new();
    private List<Signal> _signals = [];
    private string _subcommandHex = "";
    private string? _error;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _draft = System.Text.Json.JsonSerializer.Deserialize<ScadaCommand>(System.Text.Json.JsonSerializer.Serialize(Command))!;
        _draft.FrameType ??= 0x7A;
        _subcommandHex = _draft.Subcommand?.ToString("X4") ?? "";
        _signals = (await DataService.GetSignalsAsync(includeDeleted: true)).Where(s => s.NodoNumero == 2).OrderBy(s => s.Tag).ToList();
    }

    private async Task Submit()
    {
        if (_saving) return;
        _saving = true; _error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_draft.Nombre)) throw new ArgumentException("Indique el nombre del comando.");
            string hex = _subcommandHex.Trim();
            if (hex.StartsWith("0x", StringComparison.OrdinalIgnoreCase)) hex = hex[2..];
            if (!ushort.TryParse(hex, System.Globalization.NumberStyles.AllowHexSpecifier, System.Globalization.CultureInfo.InvariantCulture, out var subcommand))
                throw new ArgumentException("Subcomando hexadecimal no válido (0000–FFFF).");
            _draft.Subcommand = subcommand;
            if (_draft.FrameType == 0x7A) { _draft.SignalId = null; _draft.VariableValue = null; }
            _ = ControlCommandProtocol.Build(_draft, _signals.FirstOrDefault(s => s.Id == _draft.SignalId));
            _draft.Tipo = _draft.FrameType == 0x6A ? "Modificación de Variables" : "Interna";
            if (string.IsNullOrWhiteSpace(_draft.CommandValue)) _draft.CommandValue = $"CONTROL_{Guid.NewGuid():N}";
            if (_draft.Id > 0) await DataService.UpdateCommandAsync(_draft);
            else await DataService.AddCommandAsync(_draft);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
    private void Cancel() => MudDialog.Cancel();
}
