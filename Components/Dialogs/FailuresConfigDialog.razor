@using System.Text.Json
@using ApsMonitor.Models
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4 text-muted">Configura las categorías de fallos que aparecerán en el diálogo de estado. Agrega las señales correspondientes a cada categoría.</MudText>
        
        @if (Categories.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">No hay categorías configuradas. Presiona "Añadir Categoría" para empezar.</MudAlert>
        }

        <div style="max-height: 50vh; overflow-y: auto; padding-right: 8px;">
            @foreach (var category in Categories)
            {
                <MudPaper @key="category.Id" Class="pa-4 mb-4" Elevation="0" Outlined="true" Style="background-color: rgba(255,255,255,0.02)">
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudTextField @bind-Value="category.Name" Label="Nombre de Categoría" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1 mr-4" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveCategory(category))" />
                    </div>

                    <div class="mt-4">
                        <MudText Typo="Typo.caption" Class="fw-bold text-uppercase d-block mb-1">Señal de Estado (Bits de Color)</MudText>
                        <MudAutocomplete T="Signal" 
                                         Label="Opcional: Señal de estado (status_ac, status_dc, etc)..." 
                                         Value="@(AvailableSignals.FirstOrDefault(s => s.Id == category.StatusSignalId))"
                                         SearchFunc="@SearchSignals"
                                         ToStringFunc="@(s => s == null ? "Ninguna" : s.BindingLabel + " - " + s.Nombre)"
                                         ValueChanged="@((s) => category.StatusSignalId = s?.Id)"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" MaxItems="1000" />
                    </div>

                    <div class="mt-4">
                        <MudText Typo="Typo.caption" Class="fw-bold text-uppercase d-block mb-1">Señal de Contador (Badge)</MudText>
                        <MudAutocomplete T="Signal" 
                                         Label="Opcional: Señal para el conteo total..." 
                                         Value="@(AvailableSignals.FirstOrDefault(s => s.Id == category.CountSignalId))"
                                         SearchFunc="@SearchSignals"
                                         ToStringFunc="@(s => s == null ? "Ninguna (usar suma de bits)" : s.BindingLabel + " - " + s.Nombre)"
                                         ValueChanged="@((s) => category.CountSignalId = s?.Id)"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" MaxItems="1000" />
                    </div>

                    <MudText Typo="Typo.caption" Class="fw-bold text-uppercase mt-4 d-block">Señales de Detalle (Descriptivas)</MudText>
                    
                    @if (category.SignalIds.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 my-2 pa-2 rounded" style="background: rgba(0,0,0,0.1); border: 1px solid var(--mud-palette-lines-default);">
                            @foreach (var sigId in category.SignalIds.ToList())
                            {
                                var sig = AvailableSignals.FirstOrDefault(s => s.Id == sigId);
                                <MudChip T="int" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" OnClose="@(() => category.SignalIds.Remove(sigId))" Class="ma-0">
                                    @(sig?.Tag ?? $"ID:{sigId}")
                                </MudChip>
                            }
                        </div>
                    }

                    <div class="mt-4">
                        <MudExpansionPanels Elevation="0">
                            <MudExpansionPanel Text="Gestionar señales de detalle..." Style="background: transparent; border: 1px solid var(--mud-palette-lines-default);">
                                <TitleContent>
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.body2">Añadir / Filtrar señales de detalle</MudText>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <div class="pa-2">
                                        <MudTextField @bind-Value="_searchTerms[category.Id]" 
                                                     Label="Filtrar señales para añadir..." 
                                                     Variant="Variant.Outlined" Margin="Margin.Dense" 
                                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.FilterList"
                                                     Placeholder="Escribe para buscar..." 
                                                     Immediate="true" />
                                        
                                        <div class="mt-2 rounded border border-solid border-white-5" style="height: 250px; overflow-y: auto; background: #1a1a1a;">
                                            @{
                                                var term = _searchTerms.GetValueOrDefault(category.Id) ?? "";
                                                var filtered = AvailableSignals.Where(s => 
                                                    string.IsNullOrEmpty(term) || 
                                                    (s.Tag?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) || 
                                                    (s.Nombre?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
                                            }
                                            <MudVirtualize Items="@filtered.ToList()" Context="sig">
                                                <div class="d-flex align-center px-2 py-1 border-b border-solid border-white-5 hover:bg-white-5">
                                                    <div class="flex-grow-1 overflow-hidden">
                                                        <MudText Typo="Typo.caption" Class="fw-bold">@sig.Tag</MudText>
                                                        <MudText Typo="Typo.caption" Class="d-block text-truncate" Style="opacity: 0.6">@sig.Nombre</MudText>
                                                    </div>
                                                    @if (category.SignalIds.Contains(sig.Id))
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                                    }
                                                    else
                                                    {
                                                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Small" OnClick="@(() => AddSignalToCategory(category, sig))" />
                                                    }
                                                </div>
                                            </MudVirtualize>
                                            @if (!filtered.Any())
                                            {
                                                <div class="pa-4 text-center">
                                                    <MudText Typo="Typo.caption" Class="text-muted">No se encontraron señales</MudText>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </ChildContent>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </div>

                    @* ── Subcomandos Start/Stop/Reset ── *@
                    <div class="mt-4">
                        <MudExpansionPanels Elevation="0">
                            <MudExpansionPanel Style="background: transparent; border: 1px solid var(--mud-palette-lines-default);">
                                <TitleContent>
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Small" Class="mr-2" />
                                        <MudText Typo="Typo.body2">Subcomandos Start / Stop / Reset</MudText>
                                        @if (!string.IsNullOrEmpty(category.StopSubCmd) || !string.IsNullOrEmpty(category.StartSubCmd))
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="ml-2">Configurado</MudChip>
                                        }
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <div class="pa-2">
                                        <MudText Typo="Typo.caption" Class="mb-2 d-block" Style="opacity: 0.6">
                                            Configura los subcomandos SEPSA para arrancar/parar/resetear este converter. Valores en hexadecimal (ej: 0x0005).
                                        </MudText>
                                        <div class="d-flex gap-2 mb-2">
                                            <MudTextField @bind-Value="category.CmdFrameType" Label="FrameType Cmd" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                                         Placeholder="0x7A" Style="max-width: 120px" />
                                            <MudTextField @bind-Value="category.StopSubCmd" Label="Stop SubCmd" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                                         Placeholder="ej: 0x0005" Class="flex-grow-1" />
                                            <MudTextField @bind-Value="category.StartSubCmd" Label="Start SubCmd" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                                         Placeholder="ej: 0x0006" Class="flex-grow-1" />
                                        </div>
                                        <div class="d-flex gap-2">
                                            <MudTextField @bind-Value="category.ResetFrameType" Label="FrameType Reset" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                                         Placeholder="0x2A" Style="max-width: 120px" />
                                            <MudTextField @bind-Value="category.ResetSubCmd" Label="Reset SubCmd" Variant="Variant.Outlined" Margin="Margin.Dense" 
                                                         Placeholder="ej: 0x0004" Class="flex-grow-1" />
                                        </div>
                                        <div class="d-flex justify-end mt-2">
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" 
                                                       StartIcon="@Icons.Material.Filled.AutoFixHigh"
                                                       OnClick="@(() => ResetToStandardDefaults(category))">
                                                Asignar valores estándar (@category.Name)
                                            </MudButton>
                                        </div>
                                    </div>
                                </ChildContent>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </div>
                </MudPaper>
            }
        </div>

        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Class="mt-2 w-100" OnClick="AddCategory">Añadir Categoría</MudButton>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string ConfigJson { get; set; } = "[]";
    [Parameter] public List<Signal> AvailableSignals { get; set; } = new();

    private List<FailureCategoryConfig> Categories { get; set; } = new();
    private Dictionary<string, string> _searchTerms = new();

    protected override void OnInitialized()
    {
        LoadConfig();
    }

    protected override void OnParametersSet()
    {
        if (Categories.Count == 0 && string.IsNullOrWhiteSpace(ConfigJson))
        {
            LoadConfig();
        }
    }

    private void LoadConfig()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(ConfigJson))
            {
                Categories = JsonSerializer.Deserialize<List<FailureCategoryConfig>>(ConfigJson) ?? new();
            }
        }
        catch
        {
            Categories = new();
        }
        
        if (Categories.Count == 0)
        {
            var inversor = new FailureCategoryConfig { Name = "Inversor" };
            var lvps = new FailureCategoryConfig { Name = "LVPS" };
            var chopper = new FailureCategoryConfig { Name = "Chopper" };

            inversor.SignalIds = new List<int>();
            lvps.SignalIds = new List<int>();
            chopper.SignalIds = new List<int>();

            Categories.Add(inversor);
            Categories.Add(lvps);
            Categories.Add(chopper);
        }

        // Aplicar valores por defecto para señales de estado, contadores y subcomandos
        foreach (var cat in Categories)
        {
            ApplyDefaultsIfEmpty(cat);
            if (!_searchTerms.ContainsKey(cat.Id))
                _searchTerms[cat.Id] = "";
        }
    }

    private void ApplyDefaultsIfEmpty(FailureCategoryConfig cat)
    {
        string name = cat.Name?.Trim() ?? "";
        if (name.Equals("Inversor", StringComparison.OrdinalIgnoreCase))
        {
            cat.StatusSignalId ??= AvailableSignals.FirstOrDefault(s => s.Tag.Equals("status_ac", StringComparison.OrdinalIgnoreCase))?.Id;
            cat.CountSignalId ??= AvailableSignals.FirstOrDefault(s => s.Tag.Equals("nfails_ac", StringComparison.OrdinalIgnoreCase))?.Id;
            if (string.IsNullOrWhiteSpace(cat.CmdFrameType)) cat.CmdFrameType = "0x7A";
            if (string.IsNullOrWhiteSpace(cat.StopSubCmd)) cat.StopSubCmd = "0x0005";
            if (string.IsNullOrWhiteSpace(cat.StartSubCmd)) cat.StartSubCmd = "0x0006";
            if (string.IsNullOrWhiteSpace(cat.ResetFrameType)) cat.ResetFrameType = "0x2A";
            if (string.IsNullOrWhiteSpace(cat.ResetSubCmd)) cat.ResetSubCmd = "0x0004";
        }
        else if (name.Equals("LVPS", StringComparison.OrdinalIgnoreCase))
        {
            cat.StatusSignalId ??= AvailableSignals.FirstOrDefault(s => s.Tag.Equals("status_dc", StringComparison.OrdinalIgnoreCase))?.Id;
            cat.CountSignalId ??= AvailableSignals.FirstOrDefault(s => s.Tag.Equals("nfails_dc", StringComparison.OrdinalIgnoreCase))?.Id;
            if (string.IsNullOrWhiteSpace(cat.CmdFrameType)) cat.CmdFrameType = "0x7A";
            if (string.IsNullOrWhiteSpace(cat.StopSubCmd)) cat.StopSubCmd = "0x0003";
            if (string.IsNullOrWhiteSpace(cat.StartSubCmd)) cat.StartSubCmd = "0x0004";
            if (string.IsNullOrWhiteSpace(cat.ResetFrameType)) cat.ResetFrameType = "0x2A";
            if (string.IsNullOrWhiteSpace(cat.ResetSubCmd)) cat.ResetSubCmd = "0x0001";
        }
        else if (name.Equals("Chopper", StringComparison.OrdinalIgnoreCase))
        {
            cat.StatusSignalId ??= AvailableSignals.FirstOrDefault(s => s.Tag.Equals("status_in", StringComparison.OrdinalIgnoreCase))?.Id;
            cat.CountSignalId ??= AvailableSignals.FirstOrDefault(s => s.Tag.Equals("nfails_in", StringComparison.OrdinalIgnoreCase))?.Id;
            if (string.IsNullOrWhiteSpace(cat.CmdFrameType)) cat.CmdFrameType = "0x7A";
            if (string.IsNullOrWhiteSpace(cat.StopSubCmd)) cat.StopSubCmd = "0x00FE";
            if (string.IsNullOrWhiteSpace(cat.StartSubCmd)) cat.StartSubCmd = "0x00FF";
            if (string.IsNullOrWhiteSpace(cat.ResetFrameType)) cat.ResetFrameType = "0x2A";
            if (string.IsNullOrWhiteSpace(cat.ResetSubCmd)) cat.ResetSubCmd = "0x0000";
        }
        else
        {
            if (string.IsNullOrWhiteSpace(cat.CmdFrameType)) cat.CmdFrameType = "0x7A";
            if (string.IsNullOrWhiteSpace(cat.ResetFrameType)) cat.ResetFrameType = "0x2A";
        }
    }

    private void ResetToStandardDefaults(FailureCategoryConfig cat)
    {
        cat.StatusSignalId = null;
        cat.CountSignalId = null;
        cat.CmdFrameType = "";
        cat.StopSubCmd = "";
        cat.StartSubCmd = "";
        cat.ResetFrameType = "";
        cat.ResetSubCmd = "";
        ApplyDefaultsIfEmpty(cat);
        StateHasChanged();
    }

    private void AddCategory()
    {
        var newCat = new FailureCategoryConfig { Name = "Nueva Categoría" };
        ApplyDefaultsIfEmpty(newCat);
        _searchTerms[newCat.Id] = "";
        Categories.Add(newCat);
        StateHasChanged();
    }

    private void RemoveCategory(FailureCategoryConfig category)
    {
        Categories.Remove(category);
        StateHasChanged();
    }

    private void AddSignalToCategory(FailureCategoryConfig category, Signal? signal)
    {
        if (signal != null && !category.SignalIds.Contains(signal.Id))
        {
            category.SignalIds.Add(signal.Id);
            StateHasChanged();
        }
    }

    private async Task<IEnumerable<Signal>> SearchSignals(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return AvailableSignals;

        return AvailableSignals.Where(x => 
            (x.Nombre?.Contains(value, StringComparison.InvariantCultureIgnoreCase) ?? false) || 
            (x.Tag?.Contains(value, StringComparison.InvariantCultureIgnoreCase) ?? false));
    }

    private void Submit()
    {
        var finalJson = JsonSerializer.Serialize(Categories);
        MudDialog.Close(DialogResult.Ok(finalJson));
    }

    private void Cancel() => MudDialog.Cancel();
}
