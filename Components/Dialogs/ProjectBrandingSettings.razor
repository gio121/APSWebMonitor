@inject ProjectBrandingService Branding
<PendingFormChanges Dirty="@(_loaded && (_name != _originalBranding?.ProjectName || _logo != _originalBranding?.LogoDataUrl))" />
@inject ISnackbar Snackbar
@inject ProjectDatabaseService Projects

<MudPaper Class="admin-card" Elevation="0">
    <div class="branding-heading">
        <div class="branding-icon"><MudIcon Icon="@Icons.Material.Outlined.Palette" /></div>
        <div>
            <MudText Typo="Typo.h6" Class="fw-bold">@Ui["Project image and name"]</MudText>
            <MudText Typo="Typo.body2" Class="branding-muted">@Ui["The identity shown in the monitor header."]</MudText>
        </div>
    </div>
    @if (!_loaded)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <fieldset disabled="@_busy" style="border:0;padding:0;margin:0;min-width:0">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <div class="branding-preview">
                        <span class="preview-label">@Ui["Preview"]</span>
                        <img src="@(_logo ?? "SepsaMedha.jpg")" alt="@Ui["Project image preview"]" style="width:100%;max-width:180px;height:90px;object-fit:contain" />
                        <MudText Class="mt-2" Style="overflow-wrap:anywhere">@_name</MudText>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_name" Label="@Ui["Project name"]" MaxLength="80" Required="true" RequiredError="@Ui["Required"]" Immediate="true" Variant="Variant.Outlined" Class="mb-4" />
                    <label for="project-logo" class="image-label">@Ui["Project image"]</label>
                    <div class="image-upload"><InputFile @key="_fileKey" id="project-logo" OnChange="SelectImage" accept="image/png,image/jpeg,image/webp" /></div>
                    <MudText Typo="Typo.caption" Class="branding-muted d-block mb-2">@Ui["PNG, JPG or WebP · Up to 2 MiB"]</MudText>
                    <MudButton OnClick="UseDefaultImage" Size="Size.Small" Disabled="@(_logo is null)">@Ui["Use default image"]</MudButton>
                </MudItem>
            </MudGrid>
        </fieldset>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
        <div class="branding-actions">
            <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Save" Disabled="@(_busy || string.IsNullOrWhiteSpace(_name))">@Ui["Save branding"]</MudButton>
            <MudButton OnClick="Discard" Disabled="_busy">@Ui["Discard changes"]</MudButton>
        </div>
    }
</MudPaper>

@code {
    private string _name = "APS Monitor";
    private string? _logo, _error;
    private bool _busy, _loaded;
    private int _fileKey;
    private string _projectId = "";
    private string? _draftPath;
    private ProjectBrandingView? _originalBranding;

    protected override async Task OnInitializedAsync()
    {
        _projectId = Projects.Current?.Id ?? "";
        _draftPath = Projects.Current?.DatabasePath;
        await Branding.LoadAsync();
        Discard();
        _loaded = true;
    }
    private void Discard()
    {
        _originalBranding = Branding.Current;
        _name = Branding.Current.ProjectName;
        _logo = Branding.Current.LogoDataUrl;
        _error = null;
        _fileKey++;
    }
    private void UseDefaultImage() { _logo = null; _error = null; _fileKey++; }
    private async Task SelectImage(InputFileChangeEventArgs args)
    {
        _busy = true; _error = null;
        try
        {
            await using var stream = args.File.OpenReadStream(ProjectBrandingService.MaximumImageBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _logo = ProjectBrandingService.CreateImageDataUrl(buffer.ToArray());
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
    private async Task Save()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            await Branding.SaveAsync(_name, _logo, _projectId, _originalBranding, _draftPath);
            _originalBranding = Branding.Current;
            _name = Branding.Current.ProjectName;
            Snackbar.Add(ApsMonitor.Resources.MonitorResources.Text("Project image and name updated."), Severity.Success);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
