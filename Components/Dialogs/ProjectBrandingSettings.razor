@inject ProjectBrandingService Branding
@inject ISnackbar Snackbar

<MudPaper Class="pa-6 settings-card" Elevation="0">
    <MudText Typo="Typo.h6" Class="fw-bold mb-4">Imagen y nombre del proyecto</MudText>
    @if (!_loaded)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <fieldset disabled="@_busy" style="border:0;padding:0;margin:0;min-width:0">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <div style="text-align:center;padding:16px;border:1px solid #334155;border-radius:8px">
                        <img src="@(_logo ?? "SepsaMedha.jpg")" alt="Vista previa de la imagen del proyecto" style="width:100%;max-width:180px;height:90px;object-fit:contain" />
                        <MudText Class="mt-2" Style="overflow-wrap:anywhere">@_name</MudText>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_name" Label="Nombre del proyecto" MaxLength="80" Required="true" Immediate="true" Variant="Variant.Outlined" Class="mb-4" />
                    <label for="project-logo">Imagen del proyecto (PNG, JPG o WebP, hasta 2 MiB)</label>
                    <InputFile @key="_fileKey" id="project-logo" OnChange="SelectImage" accept="image/png,image/jpeg,image/webp" class="d-block mt-2 mb-3" />
                    <MudButton OnClick="UseDefaultImage" Size="Size.Small" Disabled="@(_logo is null)">Usar imagen predeterminada</MudButton>
                </MudItem>
            </MudGrid>
        </fieldset>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
        <MudStack Row="true" Class="mt-4" Spacing="2">
            <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_busy || string.IsNullOrWhiteSpace(_name))">Guardar personalización</MudButton>
            <MudButton OnClick="Discard" Disabled="_busy">Descartar cambios</MudButton>
        </MudStack>
    }
</MudPaper>

@code {
    private string _name = "APS Monitor";
    private string? _logo, _error;
    private bool _busy, _loaded;
    private int _fileKey;

    protected override async Task OnInitializedAsync()
    {
        await Branding.LoadAsync();
        Discard();
        _loaded = true;
    }
    private void Discard()
    {
        _name = Branding.Current.ProjectName;
        _logo = Branding.Current.LogoDataUrl;
        _error = null;
        _fileKey++;
    }
    private void UseDefaultImage() { _logo = null; _error = null; _fileKey++; }
    private async Task SelectImage(InputFileChangeEventArgs args)
    {
        _busy = true; _error = null;
        try
        {
            await using var stream = args.File.OpenReadStream(ProjectBrandingService.MaximumImageBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _logo = ProjectBrandingService.CreateImageDataUrl(buffer.ToArray());
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
    private async Task Save()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            await Branding.SaveAsync(_name, _logo);
            _name = Branding.Current.ProjectName;
            Snackbar.Add("Imagen y nombre del proyecto actualizados.", Severity.Success);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
