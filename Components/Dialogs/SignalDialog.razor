@inject ISnackbar Snackbar
@using ApsMonitor.Models
@using ApsMonitor.Services
@inject ApsDataService DataService
@inject IJSRuntime JS
<PendingFormChanges Dirty="@(_originalForm is not null && _originalForm != FormSnapshot())" />

<MudDialog Class="signal-dialog">
    <DialogContent>
        <MudTabs @bind-ActivePanelIndex="_activeTab" Rounded="true" ApplyEffectsToContainer="true"
                 Color="Color.Dark" Class="mb-4">

            
            <MudTabPanel Text="General">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="4">
                        <MudNumericField Value="Signal.NodoNumero"
                                         ValueChanged="@((int v) => OnNodeNumberChanged(v))"
                                         Label="@Ui["Node number *"]"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         FullWidth="true"
                                         Required="true"
                                         Min="0" />
                    </MudItem>
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="Signal.NodoDescripcion"
                                      Label="@Ui["Node name *"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true"
                                      Required="true" RequiredError="@Ui["Required"]"
                                      Placeholder="@Ui["E.g. Control, Power..."]" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudDivider Class="my-2" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="Signal.Nombre"
                                      Label="@Ui["Signal name *"]"
                                      Required="true" RequiredError="@Ui["Required"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="Signal.Tag"
                                      Label="Tag *"
                                      Required="true" RequiredError="@Ui["Required"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Signal.DescripcionEs"
                                      Label="@Ui["Description (ES)"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Signal.DescripcionEn"
                                      Label="Description (EN)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Signal.Unidad"
                                      Label="@Ui["Unit"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Signal.Formato"
                                      Label="@Ui["Format"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true"
                                      Placeholder="0.1" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudNumericField @bind-Value="Signal.ValorInicial"
                                         Label="@Ui["Initial value"]"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         FullWidth="true" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            
            <MudTabPanel Text="@Ui["Protocol"]">
                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudSelect T="string" Value="@Signal.TipoVariable"
                                   Label="@Ui["Variable type"]"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   FullWidth="true"
                                   ValueChanged="@OnTipoChanged">
                            <MudSelectItem Value="@("UINT16")">UINT16 (2 bytes)</MudSelectItem>
                            <MudSelectItem Value="@("UINT8")">UINT8 (1 byte)</MudSelectItem>
                            <MudSelectItem Value="@("INT16")">INT16 (2 bytes)</MudSelectItem>
                            <MudSelectItem Value="@("FLOAT32")">FLOAT32 (4 bytes)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudNumericField @bind-Value="Signal.BytePosicion"
                                         Label="@Ui["Byte in frame (position)"]"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         FullWidth="true"
                                         Min="0" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="Signal.Escala"
                                         Label="@Ui["Scale (multiplier)"]"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="Signal.Offset"
                                         Label="@Ui["Offset (added)"]"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudCheckBox @bind-Value="Signal.IsAscii" Label="@Ui["ASCII reading"]" Color="Color.Info" Dense="true" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            
            <MudTabPanel Text="@($"Bits ({Signal.BitCount})")">
                <MudText Typo="Typo.body2" Class="text-muted mb-4">
                    Configure descriptions for each active/inactive bit. Only applies when the signal is used
                    as a digital status variable. Current type: <strong>@Signal.TipoVariable</strong>
                    @Ui["= {0} configurable bits.", Signal.BitCount]
                </MudText>

                <div style="overflow-y:auto; max-height:340px;">
                    @for (int i = 0; i < Signal.BitCount; i++)
                    {
                        var bitIndex = i; // capture for lambda
                        <div class="bit-row d-flex align-center mb-2">
                            <MudText Typo="Typo.body2" Class="bit-label text-muted">Bit @bitIndex</MudText>
                            <MudTextField Value="@Signal.BitTextoActivo[bitIndex]"
                                          ValueChanged="@((string v) => Signal.BitTextoActivo[bitIndex] = v)"
                                          Placeholder="@Ui["Active bit text (1)"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="mx-2 flex-1" />
                            <MudTextField Value="@Signal.BitTextoInactivo[bitIndex]"
                                          ValueChanged="@((string v) => Signal.BitTextoInactivo[bitIndex] = v)"
                                          Placeholder="@Ui["Inactive bit text (0)"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="flex-1" />
                            <MudCheckBox T="bool" Value="@Signal.BitEsAlarma[bitIndex]"
                                         ValueChanged="@((bool v) => Signal.BitEsAlarma[bitIndex] = v)"
                                         Color="Color.Error"
                                         Dense="true"
                                         Class="ml-2"
                                         Label="@Ui["Alarm"]" />
                        </div>
                    }
                </div>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Class="mr-2">@Ui["Cancel"]</MudButton>
        <MudButton Color="Color.Info" Variant="Variant.Filled" OnClick="Submit">@Ui["Save"]</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .signal-dialog .mud-dialog-title {
        border-bottom: 1px solid var(--mud-palette-lines-default);
        padding-bottom: 12px;
    }
    .signal-dialog .mud-dialog-actions {
        border-top: 1px solid var(--mud-palette-lines-default);
        padding: 16px;
    }
    .formula-card {
        background-color: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 6px;
    }
    .bit-row {
        gap: 8px;
    }
    .bit-label {
        min-width: 48px;
    }
    .text-muted {
        color: var(--mud-palette-text-secondary) !important;
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Signal Signal { get; set; } = new Signal { Escala = 1, Formato = "0.1", ValorInicial = 0 };

    private int _activeTab = 0;
    private bool IsEditMode => Signal.Id > 0;
    private string? _originalForm;
    private string FormSnapshot() => System.Text.Json.JsonSerializer.Serialize(Signal);

    protected override void OnParametersSet()
    {
        // Ensure arrays are always size 16 (in case the object came from DB without them)
        Signal.BitTextoActivo   ??= new string?[16];
        Signal.BitTextoInactivo ??= new string?[16];
        
        var activo = Signal.BitTextoActivo;
        if (activo.Length < 16) { Array.Resize(ref activo, 16); Signal.BitTextoActivo = activo; }
        
        var inactivo = Signal.BitTextoInactivo;
        if (inactivo.Length < 16) { Array.Resize(ref inactivo, 16); Signal.BitTextoInactivo = inactivo; }

        Signal.BitEsAlarma ??= new bool[16];
        var alarma = Signal.BitEsAlarma;
        if (alarma.Length < 16) { Array.Resize(ref alarma, 16); Signal.BitEsAlarma = alarma; }
        _originalForm ??= FormSnapshot();
    }

    private async Task OnNodeNumberChanged(int newNumber)
    {
        Signal.NodoNumero = newNumber;
        
        // Si no tenemos descripción y el número es > 0, intentamos buscar una descripción existente
        if (string.IsNullOrWhiteSpace(Signal.NodoDescripcion) || Signal.Id == 0)
        {
            var existingSignals = await DataService.GetSignalsAsync();
            var existingNode = existingSignals.FirstOrDefault(s => s.NodoNumero == newNumber);
            if (existingNode != null)
            {
                Signal.NodoDescripcion = existingNode.NodoDescripcion;
            }
        }
    }

    private void OnTipoChanged(string newTipo)
    {
        Signal.TipoVariable = newTipo;
        StateHasChanged();
    }

    private async Task Submit()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Signal.Nombre) || string.IsNullOrWhiteSpace(Signal.Tag))
            {
                _activeTab = 0; // jump to General tab to show validation
                return;
            }

            if (IsEditMode)
                await DataService.UpdateSignalAsync(Signal);
            else
                await DataService.AddSignalAsync(Signal);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Cancel()
    {
        if (_originalForm != FormSnapshot() && !await JS.InvokeAsync<bool>("confirm", ApsMonitor.Resources.MonitorResources.Text("Discard unsaved form changes?"))) return;
        MudDialog.Cancel();
    }
}
