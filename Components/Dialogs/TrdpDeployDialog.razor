@using ApsMonitor.Models
@using ApsMonitor.Services
@inject ISnackbar Snackbar
@inject TrdpBackendService BackendService
@inject TrdpConfigService TrdpConfigService

<MudDialog Class="trdp-deploy-dialog">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@_titleIcon" Style="@_titleIconStyle" />
            <MudText Typo="Typo.h6">@_title</MudText>
        </div>
    </TitleContent>
    <DialogContent>

        @if (_phase == Phase.Form)
        {
            <MudGrid Spacing="3">
                <!-- Device IP -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_deviceUrl"
                                  Label="@Ui["Device IP address or hostname"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                  Placeholder="192.168.15.1"
                                  HelperText="@Ui["Direct SFTP transfer (port 22) and restart through SSH / ControlManager."]"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Router" />
                </MudItem>

                @if (Mode == DeployMode.Send)
                {
                    <!-- Restart option -->
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-3" Style="background:var(--mud-palette-background); border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <div class="d-flex align-center gap-3">
                                <MudCheckBox @bind-Value="_restartService" Color="Color.Warning" />
                                <div>
                                    <MudText Typo="Typo.body2" Class="fw-bold">@Ui["Restart ecnmanager service"]</MudText>
                                    <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                                        @Ui["The backend will execute"] <code>systemctl restart ecnmanager</code> after saving.
                                        The configuration will take effect immediately.
                                    </MudText>
                                </div>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <!-- Config summary -->
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-3" Style="background:var(--mud-palette-background); border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <MudText Typo="Typo.caption" Style="color:#64748b;" Class="mb-1">@Ui["CONFIGURATION TO SEND"]</MudText>
                            <div class="d-flex gap-2 flex-wrap mt-1">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                    @Config!.Networks.Count networks
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">
                                    @Config!.CommsDatasets.Count datasets
                                </MudChip>
                                @if (Config!.UseDynamicMapping)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                        dynamic_mapping
                                    </MudChip>
                                }
                                <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Outlined">
                                    @Config!.Nombre
                                </MudChip>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <!-- Warning -->
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="rounded-lg">
                            @Ui["The file"] <code>/mnt/artifacts/ecnmanager.json</code> on the device will be
                            updated through SFTP and the service restarted to apply the changes.
                        </MudAlert>
                    </MudItem>
                }
                else if (Mode == DeployMode.Receive)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true" Class="rounded-lg">
                            @Ui["Will read"] <code>/mnt/artifacts/ecnmanager.json</code> from the device through SFTP and import it
                            as a new configuration in the local database.
                        </MudAlert>
                    </MudItem>
                }
                else if (Mode == DeployMode.SetMode)
                {
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-3" Style="background:var(--mud-palette-background); border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <MudText Typo="Typo.body2" Class="mb-2 fw-bold">@Ui["New mode:"]</MudText>
                            <div class="d-flex gap-3">
                                <MudChip T="string"
                                         Color="@(NewMode ? Color.Success : Color.Default)"
                                         Variant="@(NewMode ? Variant.Filled : Variant.Outlined)"
                                         Size="Size.Medium"
                                         OnClick="@(() => NewMode = true)">
                                    <MudIcon Icon="@Icons.Material.Filled.AutoMode" Class="mr-1" />
                                    Dynamic mapping
                                </MudChip>
                                <MudChip T="string"
                                         Color="@(!NewMode ? Color.Warning : Color.Default)"
                                         Variant="@(!NewMode ? Variant.Filled : Variant.Outlined)"
                                         Size="Size.Medium"
                                         OnClick="@(() => NewMode = false)">
                                    <MudIcon Icon="@Icons.Material.Filled.SettingsInputComponent" Class="mr-1" />
                                    Legacy
                                </MudChip>
                            </div>
                        </MudPaper>
                    </MudItem>
                    <!-- Restart option -->
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-3" Style="background:var(--mud-palette-background); border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <div class="d-flex align-center gap-3">
                                <MudCheckBox @bind-Value="_restartService" Color="Color.Warning" />
                                <div>
                                    <MudText Typo="Typo.body2" Class="fw-bold">@Ui["Restart ecnmanager service"]</MudText>
                                    <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                                        @Ui["The backend will execute"] <code>systemctl restart ecnmanager</code> @Ui["to apply the mode change immediately."]
                                    </MudText>
                                </div>
                            </div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="rounded-lg">
                            @Ui["Changing the mode requires a service restart to take effect on the device."]
                        </MudAlert>
                    </MudItem>
                }
                else if (Mode == DeployMode.Restart)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="rounded-lg">
                            @Ui["An immediate restart command will be sent to the service"] <code>ecnmanager</code> @Ui["on the communications board through SSH ("]<code>systemctl restart ecnmanager</code>@Ui[") and a UDP command to ControlManager (port 50001)."]
                        </MudAlert>
                    </MudItem>
                }
                else if (Mode == DeployMode.ResetCosmos)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Error" Dense="true" Class="rounded-lg">
                            @Ui["This action resets the accumulated energy counters ("]<code>all_out_energy</code>, <code>ac_out_energy</code>@Ui["), contactor operations ("]<code>hv_in_k_op_nmbr</code>, <code>ac_out_k_op_nmbr</code>@Ui[") and operating hours in"] <code>cosmos_data.txt</code> @Ui["through the SEPSA protocol (UDP 50001) and a direct datagram (UDP 50003)."]
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        }
        else if (_phase == Phase.Working)
        {
            <div class="d-flex flex-column align-center py-6 gap-4">
                <MudProgressCircular Color="Color.Info" Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.body1" Style="color:var(--mud-palette-text-secondary);">@_workingMessage</MudText>
            </div>
        }
        else if (_phase == Phase.Done)
        {
            <div class="d-flex flex-column align-center py-4 gap-3">
                <MudIcon Icon="@(_resultOk ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                         Style="@($"font-size:3.5rem; color:{(_resultOk ? "#22c55e" : "#ef4444")}")" />
                <MudText Typo="Typo.h6" Style="@($"color:{(_resultOk ? "#22c55e" : "#ef4444")}")">
                    @(_resultOk ? Ui["Operation completed"] : Ui["Error"])
                </MudText>
                <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary); text-align:center; max-width:440px; white-space:pre-wrap; word-break:break-all;">
                    @_resultMessage
                </MudText>
                @if (_resultOk && (Mode == DeployMode.Send || Mode == DeployMode.SetMode) && _restartService)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.RestartAlt">
                        @Ui["ecnmanager restarted"]
                    </MudChip>
                }
            </div>
        }

    </DialogContent>
    <DialogActions>
        @if (_phase == Phase.Form)
        {
            <MudButton OnClick="Cancel" Variant="Variant.Text">@Ui["Cancel"]</MudButton>
            <MudButton Color="Color.Info" Variant="Variant.Filled"
                       StartIcon="@_actionIcon" OnClick="Execute"
                       Disabled="@string.IsNullOrWhiteSpace(_deviceUrl)">
                @_actionLabel
            </MudButton>
        }
        else if (_phase == Phase.Done)
        {
            <MudButton OnClick="Close" Variant="Variant.Filled"
                       Color="@(_resultOk ? Color.Success : Color.Default)">
                @Ui["Close"]
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<style>
    .trdp-deploy-dialog .mud-dialog-content { min-width: 480px; }
    code {
        background: rgba(255,255,255,0.07);
        border-radius: 4px;
        padding: 1px 5px;
        font-size: .82em;
        color: #7dd3fc;
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    public enum DeployMode { Send, Receive, SetMode, Restart, ResetCosmos }

    [Parameter] public DeployMode Mode    { get; set; } = DeployMode.Send;
    [Parameter] public TrdpSessionConfig? Config { get; set; }
    /// <summary>Initial value for the mode toggle (only used in SetMode).</summary>
    [Parameter] public bool NewMode       { get; set; } = true;
    [Parameter] public string DefaultUrl  { get; set; } = string.Empty;

    // ── Internal state ─────────────────────────────────────────────────────
    private enum Phase { Form, Working, Done }
    private Phase  _phase          = Phase.Form;
    private string _deviceUrl      = string.Empty;
    private bool   _restartService = true;
    private string _workingMessage = "Conectando…";
    private bool   _resultOk;
    private string _resultMessage  = string.Empty;

    // ── Computed UI strings ────────────────────────────────────────────────
    private string _title => Mode switch
    {
        DeployMode.Send    => ApsMonitor.Resources.MonitorResources.Text("Send configuration to device"),
        DeployMode.Receive => ApsMonitor.Resources.MonitorResources.Text("Read configuration from device"),
        DeployMode.SetMode => ApsMonitor.Resources.MonitorResources.Text("Change mapping mode"),
        DeployMode.Restart => ApsMonitor.Resources.MonitorResources.Text("Restart ECNManager service_Text"),
        DeployMode.ResetCosmos => "Resetear contadores Cosmos (cosmos_data.txt)",
        _                  => ApsMonitor.Resources.MonitorResources.Text("TRDP backend")
    };
    private string _titleIcon => Mode switch
    {
        DeployMode.Send    => Icons.Material.Filled.Upload,
        DeployMode.Receive => Icons.Material.Filled.Download,
        DeployMode.SetMode => Icons.Material.Filled.Tune,
        DeployMode.Restart => Icons.Material.Filled.RestartAlt,
        DeployMode.ResetCosmos => Icons.Material.Filled.CleaningServices,
        _                  => Icons.Material.Filled.Hub
    };
    private string _titleIconStyle => "color:#38bdf8; font-size:1.6rem;";
    private string _actionIcon => Mode switch
    {
        DeployMode.Send    => Icons.Material.Filled.Send,
        DeployMode.Receive => Icons.Material.Filled.CloudDownload,
        DeployMode.SetMode => Icons.Material.Filled.SettingsInputComponent,
        DeployMode.Restart => Icons.Material.Filled.RestartAlt,
        DeployMode.ResetCosmos => Icons.Material.Filled.DeleteSweep,
        _                  => Icons.Material.Filled.Done
    };
    private string _actionLabel => Mode switch
    {
        DeployMode.Send    => ApsMonitor.Resources.MonitorResources.Text("Send"),
        DeployMode.Receive => ApsMonitor.Resources.MonitorResources.Text("Read and import"),
        DeployMode.SetMode => ApsMonitor.Resources.MonitorResources.Text("Apply mode"),
        DeployMode.Restart => ApsMonitor.Resources.MonitorResources.Text("Restart"),
        DeployMode.ResetCosmos => "Resetear a 0",
        _                  => ApsMonitor.Resources.MonitorResources.Text("Execute")
    };

    protected override void OnInitialized()
    {
        _deviceUrl = DefaultUrl;
        _restartService = (Mode == DeployMode.SetMode || Mode == DeployMode.Send);
    }

    private void Cancel() => MudDialog.Cancel();
    private void Close()  => MudDialog.Close(DialogResult.Ok(_resultOk));

    private async Task Execute()
    {
        _phase          = Phase.Working;
        _workingMessage = Mode switch
        {
            DeployMode.Send    => ApsMonitor.Resources.MonitorResources.Text("Sending configuration…"),
            DeployMode.Receive => ApsMonitor.Resources.MonitorResources.Text("Reading device configuration…"),
            DeployMode.SetMode => ApsMonitor.Resources.MonitorResources.Text("Applying mode…"),
            _                  => ApsMonitor.Resources.MonitorResources.Text("Processing…")
        };
        StateHasChanged();

        switch (Mode)
        {
            case DeployMode.Send:
                await ExecuteSend();
                break;
            case DeployMode.Receive:
                await ExecuteReceive();
                break;
            case DeployMode.SetMode:
                await ExecuteSetMode();
                break;
            case DeployMode.Restart:
                await ExecuteRestart();
                break;
            case DeployMode.ResetCosmos:
                await ExecuteResetCosmos();
                break;
        }

        _phase = Phase.Done;
        StateHasChanged();
    }

    private async Task ExecuteSend()
    {
        if (Config is null) { Fail(ApsMonitor.Resources.MonitorResources.Text("No configuration selected.")); return; }
        var result = await BackendService.SendConfigAsync(_deviceUrl, Config, _restartService);
        if (result.IsSuccess)
        {
            _resultOk      = true;
            _resultMessage = result.Data?.Message ?? ApsMonitor.Resources.MonitorResources.Text("Configuration sent successfully.");
        }
        else
        {
            Fail(result.Error);
        }
    }

    private async Task ExecuteReceive()
    {
        var result = await BackendService.GetConfigAsync(_deviceUrl);
        if (!result.IsSuccess) { Fail(result.Error); return; }

        try
        {
            var cfg = TrdpConfigService.ImportFromJson(result.Data!, ApsMonitor.Resources.MonitorResources.Format("Device {0}",_deviceUrl));
            _resultOk      = true;
            _resultMessage = ApsMonitor.Resources.MonitorResources.Format("Configuration imported from device: {0} networks, {1} datasets.",cfg.Networks.Count,cfg.CommsDatasets.Count);
            MudDialog.Close(DialogResult.Ok(cfg));
            return;
        }
        catch (Exception ex)
        {
            Fail(ApsMonitor.Resources.MonitorResources.Format("The received JSON is invalid: {0}",ex.Message));
        }
    }

    private async Task ExecuteSetMode()
    {
        var modeLabel = NewMode ? "dynamic mapping" : "legacy";
        if (_restartService)
            _workingMessage = ApsMonitor.Resources.MonitorResources.Format("Applying {0} mode and restarting ecnmanager…",modeLabel);
        StateHasChanged();

        var result = await BackendService.SetModeAsync(_deviceUrl, NewMode, _restartService);
        if (result.IsSuccess)
        {
            _resultOk = true;
            var baseMsg = result.Data?.Message
                ?? ApsMonitor.Resources.MonitorResources.Format("Mode changed to {0} successfully.",modeLabel);
            _resultMessage = _restartService
                ? ApsMonitor.Resources.MonitorResources.Format("EcnmanagerRestartDetails",baseMsg)
                : baseMsg;
        }
        else
        {
            Fail(result.Error);
        }
    }

    private async Task ExecuteRestart()
    {
        _workingMessage = ApsMonitor.Resources.MonitorResources.Text("Restarting ecnmanager service…");
        StateHasChanged();
        var result = await BackendService.RestartEcnManagerAsync(_deviceUrl);
        if (result.IsSuccess)
        {
            _resultOk = true;
            _resultMessage = ApsMonitor.Resources.MonitorResources.Text("ecnmanager service restarted successfully.");
        }
        else
        {
            Fail(result.Error);
        }
    }

    private async Task ExecuteResetCosmos()
    {
        _workingMessage = ApsMonitor.Resources.MonitorResources.Text("Sending reset command to cosmos_data.txt...");
        StateHasChanged();
        var result = await BackendService.ResetCosmosDataAsync(_deviceUrl);
        if (result.IsSuccess)
        {
            _resultOk = true;
            _resultMessage = result.Data ?? ApsMonitor.Resources.MonitorResources.Text("cosmos_data counters reset to 0 successfully.");
        }
        else
        {
            Fail(result.Error);
        }
    }

    private void Fail(string msg)
    {
        _resultOk      = false;
        _resultMessage = msg;
    }
}
