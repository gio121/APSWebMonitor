@using MudBlazor
@using ApsMonitor.Models
@inject ISnackbar Snackbar

<MudDialog Class="trdp-rule-dialog">
    <TitleContent>
        <div class="d-flex align-center justify-space-between gap-2 flex-wrap">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Rule" Color="Color.Info" />
                <MudText Typo="Typo.h6" Class="fw-bold">
                    @(IsNew ? Ui["New control rule (control_commands)"] : Ui["Edit rule '{0}'", Rule.Id])
                </MudText>
                @if (!Rule.Deletable)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                        @Ui["System / Cannot be deleted"]
                    </MudChip>
                }
            </div>
            <MudCheckBox @bind-Value="Rule.Enabled" Label="@Ui["Rule enabled (enabled)"]" Color="Color.Success" />
        </div>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Dark" Class="mb-3">

                <!-- ─── Tab 1: Identificación y Disparador ──────────────── -->
                <MudTabPanel Text="@Ui["Trigger and source"]" Icon="@Icons.Material.Filled.FlashOn">
                    <MudGrid Spacing="2" Class="pt-3">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Rule.Id" Label="@Ui["Rule ID *"]" Required="true" RequiredError="@Ui["Required"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Disabled="@(!Rule.Deletable && !IsNew)"
                                          Placeholder="E.g. stop_ac" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="Rule.Trigger" Label="@Ui["Trigger *"]" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
                                <MudSelectItem Value="@("rising_edge")">@Ui["rising_edge (Rising edge 0→1)"]</MudSelectItem>
                                <MudSelectItem Value="@("falling_edge")">@Ui["falling_edge (Falling edge 1→0)"]</MudSelectItem>
                                <MudSelectItem Value="@("on_change")">@Ui["on_change (When the value changes)"]</MudSelectItem>
                                <MudSelectItem Value="@("condition_true")">@Ui["condition_true / level_high (While true)"]</MudSelectItem>
                                <MudSelectItem Value="@("condition_false")">@Ui["condition_false / level_low (While false)"]</MudSelectItem>
                                <MudSelectItem Value="@("always")">@Ui["always (On every received packet / continuous)"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="Rule.Description" Label="@Ui["Rule description"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Lines="2"
                                          Placeholder="@Ui["E.g. AC STOP command to TCMS (cmd_aps bit 0 to 1)"]" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color:#38bdf8;">@Ui["Dataset source variable"]</MudText>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="Rule.SrcVar" Label="@(Rule.ActionType == "rtc_update" ? Ui["Source variable (optional for rtc_update)"] : "Variable Origen (src_var) *")"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" FullWidth="true">
                                @foreach (var v in DatasetVariables)
                                {
                                    <MudSelectItem Value="@v.Id">@v.Id (@v.Type)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudNumericField @bind-Value="Rule.Bit" Label="@Ui["Specific bit (0–15)"]"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Min="0" Max="15" Clearable="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3" Class="d-flex align-center pt-2">
                            <MudCheckBox @bind-Value="Rule.InvertBit" Label="@Ui["Invert bit"]" Color="Color.Info" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="Rule.Condition" Label="@Ui["Comparison condition (optional)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" FullWidth="true">
                                <MudSelectItem Value="@("equals")">equals (=)</MudSelectItem>
                                <MudSelectItem Value="@("not_equals")">not_equals (≠)</MudSelectItem>
                                <MudSelectItem Value="@("greater_than")">greater_than (&gt;)</MudSelectItem>
                                <MudSelectItem Value="@("less_than")">less_than (&lt;)</MudSelectItem>
                                <MudSelectItem Value="@("greater_or_equal")">greater_or_equal (≥)</MudSelectItem>
                                <MudSelectItem Value="@("less_or_equal")">less_or_equal (≤)</MudSelectItem>
                                <MudSelectItem Value="@("in_list")">@Ui["in_list (In list)"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            @if (Rule.Condition == "in_list")
                            {
                                <MudTextField Value="_valueListText" ValueChanged="@((string s) => UpdateValueList(s))"
                                              Label="@Ui["Values (comma-separated)"]" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Placeholder="E.g. 1, 2, 5" />
                            }
                            else
                            {
                                <MudNumericField @bind-Value="Rule.Value" Label="@Ui["Comparison value"]"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Format="G" />
                            }
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- ─── Tab 2: Condiciones Cruzadas con Control ──────────── -->
                <MudTabPanel Text="@Ui["Control conditions"]" Icon="@Icons.Material.Filled.AltRoute">
                    <div class="d-flex justify-space-between align-center my-2">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color:#38bdf8;">
                            @Ui["Additional ControlFrame conditions ({0})", Rule.ControlConditions.Count]
                        </MudText>
                        <div class="d-flex align-center gap-2">
                            <MudSelect @bind-Value="Rule.LogicOp" Label="@Ui["Logical operator"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:120px;">
                                <MudSelectItem Value="@("AND")">AND</MudSelectItem>
                                <MudSelectItem Value="@("OR")">OR</MudSelectItem>
                            </MudSelect>
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add" OnClick="AddControlCondition">
                                @Ui["New condition"]
                            </MudButton>
                        </div>
                    </div>

                    @if (Rule.ControlConditions.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="trdp-muted">
                            @Ui["No control variable conditions (the rule is evaluated using only the source variable)."]
                        </MudText>
                    }
                    else
                    {
                        @foreach (var (cc, idx) in Rule.ControlConditions.Select((c, i) => (c, i)))
                        {
                            <div class="d-flex align-center gap-2 mb-2 pa-2 rounded trdp-cond-row">
                                <MudSelect @bind-Value="cc.ControlVar" Label="@Ui["Control variable"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex:2;">
                                    @foreach (var cv in ControlVariables)
                                    {
                                        <MudSelectItem Value="@cv">@cv</MudSelectItem>
                                    }
                                </MudSelect>

                                <MudSelect @bind-Value="cc.Condition" Label="@Ui["Condition"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex:1;">
                                    <MudSelectItem Value="@("equals")">=</MudSelectItem>
                                    <MudSelectItem Value="@("not_equals")">≠</MudSelectItem>
                                    <MudSelectItem Value="@("greater_than")">&gt;</MudSelectItem>
                                    <MudSelectItem Value="@("less_than")">&lt;</MudSelectItem>
                                </MudSelect>

                                <MudNumericField @bind-Value="cc.Value" Label="@Ui["Expected value"]" Variant="Variant.Outlined" Margin="Margin.Dense" Format="G" Style="flex:1;" />

                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveControlCondition(idx))" />
                            </div>
                        }
                    }
                </MudTabPanel>

                <!-- ─── Tab 3: Action and timer ─────────────────────── -->
                <MudTabPanel Text="@Ui["Action and timer"]" Icon="@Icons.Material.Filled.Send">
                    <MudGrid Spacing="2" Class="pt-3">
                        <MudItem xs="12" sm="6">
                            <MudNumericField Value="Rule.MinIntervalMs" ValueChanged="@((int v) => { Rule.MinIntervalMs = v; Rule.IntervalMs = v; })"
                                             Label="@Ui["Interval / minimum interval (min_interval_ms) *"]" Required="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Min="0"
                                             HelperText="@Ui["Transmission period / interval between consecutive transmissions to Control in milliseconds"]" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSelect Value="Rule.ActionType" ValueChanged="@((string a) => OnActionTypeChanged(a))"
                                       Label="@Ui["Action type *"]" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
                                <MudSelectItem Value="@("send_scmd")">@Ui["send_scmd (SCMD command to Control)"]</MudSelectItem>
                                <MudSelectItem Value="@("rtc_update")">@Ui["rtc_update (RTC time synchronisation)"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color:#38bdf8;">
                                @(Rule.ActionType == "rtc_update" ? Ui["RTC time update parameters"] : Ui["SCMD command parameters"])
                            </MudText>
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="Rule.Command.FrameType" Label="@Ui["Frame type *"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Placeholder="0x7A" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="Rule.Command.SubCmd" Label="@Ui["Subcommand (Sub Cmd) *"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                          Placeholder="@(Rule.ActionType == "rtc_update" ? "0xFE01" : "0x0005")" />
                        </MudItem>

                        @if (Rule.ActionType != "rtc_update")
                        {
                            <MudItem xs="12" sm="4" Class="d-flex align-center pt-2">
                                <MudCheckBox @bind-Value="Rule.Command.Use16BitData" Label="@Ui["Use 16-bit data"]" Color="Color.Info" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="Rule.Command.Data" Label="@Ui["Constant data (Data)"]"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Format="G"
                                                 Disabled="@(!string.IsNullOrEmpty(Rule.Command.DataFromVar))" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudSelect @bind-Value="Rule.Command.DataFromVar" Label="@Ui["Dynamic variable data (optional)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" FullWidth="true">
                                    <MudSelectItem Value="@("")">@Ui["(None - Use constant)"]</MudSelectItem>
                                    @foreach (var v in DatasetVariables)
                                    {
                                        <MudSelectItem Value="@v.Id">@v.Id</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                        else
                        {
                            <MudItem xs="12" sm="4">
                                <MudSelect Value="@(Rule.TimeVar ?? Rule.Command.TimeVar)" ValueChanged="@((string s) => { Rule.TimeVar = s; Rule.Command.TimeVar = s; })"
                                           Label="@Ui["Time variable (time_var)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" FullWidth="true">
                                    @foreach (var v in DatasetVariables)
                                    {
                                        <MudSelectItem Value="@v.Id">@v.Id</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                    </MudGrid>
                </MudTabPanel>

            </MudTabs>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">@Ui["Cancel"]</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Save">@Ui["Save rule"]</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .trdp-rule-dialog { min-width: 620px; }
    .trdp-cond-row { background: rgba(255,255,255,0.03); border: 1px solid var(--mud-palette-lines-default); }
    .trdp-muted { color: var(--mud-palette-text-secondary) !important; }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public TrdpControlCommandRule Rule { get; set; } = new();
    [Parameter] public List<TrdpDatasetVariable> DatasetVariables { get; set; } = new();
    [Parameter] public List<string> ControlVariables { get; set; } = new();
    [Parameter] public bool IsNew { get; set; } = true;

    private MudForm _form = null!;
    private string _valueListText = string.Empty;

    protected override void OnInitialized()
    {
        Rule ??= new TrdpControlCommandRule();
        Rule.Command ??= new TrdpScmdAction();
        Rule.ControlConditions ??= new List<TrdpControlCondition>();

        if (Rule.ActionType == "rtc_update" && string.IsNullOrWhiteSpace(Rule.Command.SubCmd))
        {
            Rule.Command.SubCmd = "0xFE01";
        }

        if (Rule.ValueList != null && Rule.ValueList.Count > 0)
            _valueListText = string.Join(", ", Rule.ValueList);
    }

    private void OnActionTypeChanged(string actionType)
    {
        Rule.ActionType = actionType;
        if (actionType == "rtc_update")
        {
            Rule.Trigger = "always";
            if (string.IsNullOrWhiteSpace(Rule.Command.SubCmd) || Rule.Command.SubCmd == "0x0005")
            {
                Rule.Command.SubCmd = "0xFE01";
            }
            if (string.IsNullOrWhiteSpace(Rule.Command.FrameType))
            {
                Rule.Command.FrameType = "0x7A";
            }
        }
    }

    private void UpdateValueList(string text)
    {
        _valueListText = text;
        if (string.IsNullOrWhiteSpace(text))
        {
            Rule.ValueList = null;
            return;
        }
        Rule.ValueList = text.Split(',')
            .Select(s => double.TryParse(s.Trim(), out var d) ? d : (double?)null)
            .Where(d => d.HasValue)
            .Select(d => d!.Value)
            .ToList();
    }

    private void AddControlCondition()
    {
        Rule.ControlConditions.Add(new TrdpControlCondition
        {
            ControlVar = ControlVariables.FirstOrDefault() ?? "",
            Condition  = "equals",
            Value      = 1
        });
    }

    private void RemoveControlCondition(int index)
    {
        if (index >= 0 && index < Rule.ControlConditions.Count)
            Rule.ControlConditions.RemoveAt(index);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(Rule.Id))
        {
            Snackbar.Add(ApsMonitor.Resources.MonitorResources.Text("The rule ID is required."), Severity.Error);
            return;
        }
        if (Rule.ActionType != "rtc_update" && string.IsNullOrWhiteSpace(Rule.SrcVar))
        {
            Snackbar.Add(ApsMonitor.Resources.MonitorResources.Text("Select a source variable."), Severity.Error);
            return;
        }

        MudDialog.Close(DialogResult.Ok(Rule));
    }
}
