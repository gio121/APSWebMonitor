@using ApsMonitor.Components.Pages
@using MudBlazor

<MudDialog Class="packet-sender-dialog" Style="min-width: 850px; max-width: 1400px; width: 95vw; background: var(--mud-palette-surface);">
    <TitleContent>
        <div class="d-flex align-center justify-space-between">
            <MudText Typo="Typo.h6" Class="fw-bold d-flex align-center gap-2" Style="color:#38bdf8;">
                <MudIcon Icon="@Icons.Material.Filled.FastForward" />
                Reproductor de Paquetes Wireshark & Packet Sender
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Close" Color="Color.Inherit" />
        </div>
    </TitleContent>
    <DialogContent>
        <PacketSenderPanel DefaultAdapterIp="@DefaultAdapterIp" DefaultAdapterName="@DefaultAdapterName" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="Close">Cerrar Ventana</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .packet-sender-dialog .mud-dialog-title {
        border-bottom: 1px solid var(--mud-palette-lines-default);
        padding: 12px 20px;
    }
    .packet-sender-dialog .mud-dialog-content {
        padding: 16px 20px;
        max-height: 85vh;
        overflow-y: auto;
    }
    .packet-sender-dialog .mud-dialog-actions {
        border-top: 1px solid var(--mud-palette-lines-default);
        padding: 10px 20px;
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? DefaultAdapterIp { get; set; }
    [Parameter] public string? DefaultAdapterName { get; set; }

    private void Close() => MudDialog.Close();
}
