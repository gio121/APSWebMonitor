@inject ProjectNavigationService ProjectNavigation
@implements IDisposable

@if (_navigationUnavailable)
{
    <p>@Ui["Unable to open the selector automatically. Follow the link to continue."]</p>
}
<a href="/proyectos" target="_top">@Ui["Open project selector"]</a>

@code {
    [Parameter] public bool Replace { get; set; } = true;
    private readonly CancellationTokenSource _stop = new();
    private bool _disposed;
    private bool _navigationUnavailable;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var opened = await ProjectNavigation.OpenAsync(Replace, _stop.Token);
        if (!opened && !_disposed)
        {
            _navigationUnavailable = true;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _stop.Cancel();
        _stop.Dispose();
    }
}
