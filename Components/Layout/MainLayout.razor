@inherits LayoutComponentBase
@inject SessionStateService _sessionState
@inject CustomAuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@implements IDisposable

<MonitorThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudDrawer Class="monitor-sidebar" @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Never" Variant="DrawerVariant.Persistent">
        <div class="px-4 py-4 d-flex align-center justify-space-between logo-header">
            <ProjectIdentity />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Inherit" Size="Size.Small" OnClick="@(() => _drawerOpen = false)" Title="Ocultar panel" />
        </div>
        
        <NavMenu />
        <MonitorThemeToggle />
        
        <div class="mt-auto px-4 py-4 d-flex align-center user-footer">
            <AuthorizeView>
                <Authorized>
                    <div>
                        <MudText Typo="Typo.body2" Class="fw-bold">@context.User.Identity?.Name</MudText>
                        <MudText Typo="Typo.caption" Class="text-muted">@(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "")</MudText>
                    </div>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Size="Size.Small" OnClick="HandleLogout" />
                </Authorized>
            </AuthorizeView>
        </div>
    </MudDrawer>

    <MudMainContent>
        @if (!_drawerOpen)
        {
            <div class="px-4 pt-2">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = true)" Title="Mostrar panel lateral" />
            </div>
        }
        <div class="@(_sessionState.IsLoaded ? "px-8 pt-4 pb-24" : "px-8 pt-4")">
            @Body
        </div>
        <SessionPlayerBar />
    </MudMainContent>
</MudLayout>
<DeviceConnectionStatus />

<style>
    .logo-header {
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }
    .user-footer {
        border-top: 1px solid var(--mud-palette-lines-default);
    }
    .text-muted {
        color: var(--mud-palette-text-secondary) !important;
    }
</style>

@code {
    private bool _drawerOpen = true;

    protected override void OnInitialized()
    {
        _sessionState.OnStateChanged += RefreshSession;
    }

    private void RefreshSession() => _ = InvokeAsync(StateHasChanged);

    private async Task HandleLogout()
    {
        await AuthProvider.LogoutAsync();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        _sessionState.OnStateChanged -= RefreshSession;
    }

}
