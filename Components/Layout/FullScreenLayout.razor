@inherits LayoutComponentBase

<MudThemeProvider @ref="@_themeProvider" @bind-IsDarkMode="@_isDarkMode" Theme="ApsMudTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Never">
        <div class="px-4 py-6 d-flex flex-column align-center justify-center logo-header">
            <img src="SepsaMedha.jpg" style="width: 100%; max-width: 200px; height: auto; border-radius: 4px;" class="mb-2" alt="Logo" />
            <MudText Typo="Typo.h6" Class="fw-bold" Color="Color.Primary">APS Monitor</MudText>
            <MudText Typo="Typo.caption" Class="text-muted text-uppercase" Style="letter-spacing: 1px;">SISTEMA SCADA</MudText>
        </div>
        
        <NavMenu />
        
        <div class="mt-auto px-4 py-4 d-flex align-center user-footer">
            <div>
                <MudText Typo="Typo.body2" Class="fw-bold">Administrador</MudText>
                <MudText Typo="Typo.caption" Class="text-muted">Administrador</MudText>
            </div>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Size="Size.Small" />
        </div>
    </MudDrawer>

    <MudMainContent>
        <!-- Retirado px-8 pt-8 para usar el 100% de la pantalla sin márgenes globales -->
        <div class="h-100">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<style>
    .logo-header {
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .user-footer {
        border-top: 1px solid rgba(255,255,255,0.05);
    }
    .text-muted {
        color: #94a3b8 !important;
    }
</style>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private MudThemeProvider? _themeProvider;

    public static readonly MudTheme ApsMudTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#3b82f6",
            Secondary = "#ef4444",
            Background = "#151921",
            AppbarBackground = "#151921",
            DrawerBackground = "#19212d",
            Surface = "#1f2937",
            TextPrimary = "#e2e8f0",
            TextSecondary = "#94a3b8",
            Success = "#22c55e",
            Error = "#ef4444",
            LinesDefault = "rgba(255,255,255,0.05)",
            TableLines = "rgba(255,255,255,0.05)"
        },
    };
}