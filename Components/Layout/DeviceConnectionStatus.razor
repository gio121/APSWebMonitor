@implements IAsyncDisposable
@inject MonitorStateService Monitor
@inject SessionStateService Session
@inject TlsSecurityService TlsSecurity
@inject IDialogService DialogService

<footer class="device-connection-status" aria-label="@Ui["Live device connection status"]" role="status" aria-live="polite">
    <button type="button"
            class="device-tls-badge @(TlsSecurity.UseTls ? "tls-active" : "tls-traditional")"
            @onclick="OpenTlsSettingsAsync"
            title="Haz clic para configurar el modo de comunicación (Tradicional vs TLS / mTLS y certificados)">
        <span class="device-status-dot @(TlsSecurity.UseTls ? "online" : "traditional-dot")" aria-hidden="true"></span>
        <span>Modo: @TlsSecurity.ModeDisplayName</span>
    </button>
    <span class="device-status-item" title="@Description(_state.Communications)">
        <span class="device-status-dot @StatusClass(_state.Communications)" aria-hidden="true"></span>
        <span>@Ui["Communications"]</span>
        <span class="device-status-accessible">: @StatusText(_state.Communications)</span>
    </span>
    <span class="device-status-item" title="@Description(_state.Control)">
        <span class="device-status-dot @StatusClass(_state.Control)" aria-hidden="true"></span>
        <span>Control</span>
        <span class="device-status-accessible">: @StatusText(_state.Control)</span>
    </span>
    @if (Session.IsLoaded)
    {
        <span>@Ui["Session playback"]</span>
    }
</footer>

@code {
    private readonly CancellationTokenSource _stop = new();
    private Task? _refresh;
    private (bool Communications, bool Control) _state;

    protected override void OnInitialized()
    {
        _state = CurrentConnections;
        TlsSecurity.OnChanged += OnTlsChanged;
        Session.OnStateChanged += OnSessionChanged;
        _refresh = RefreshAsync();
    }

    private void OnTlsChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnSessionChanged() => _ = InvokeAsync(() =>
    {
        _state = CurrentConnections;
        StateHasChanged();
    });

    private (bool Communications, bool Control) CurrentConnections => Session.IsLoaded ? Session.DeviceConnections : Monitor.DeviceConnections;
    private string StatusClass(bool connected) => connected ? "online" : "offline";
    private string StatusText(bool connected) => connected ? Ui["connected"] : Ui["disconnected"];

    private async Task OpenTlsSettingsAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };
        await DialogService.ShowAsync<TlsSettingsDialog>("Seguridad de Comunicaciones", options);
    }

    private string Description(bool connected) => Session.IsLoaded
        ? connected ? Ui["Session: response received from this device."] : Ui["Session: no response received from this device yet."]
        : connected
        ? ApsMonitor.Resources.MonitorResources.Text("Connected: SEPSA response received within the last 3 seconds.")
        : ApsMonitor.Resources.MonitorResources.Text("Connection unconfirmed: no recent SEPSA responses received.");

    private async Task RefreshAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
                await InvokeAsync(() =>
                {
                    var next = CurrentConnections;
                    if (next == _state) return;
                    _state = next;
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        TlsSecurity.OnChanged -= OnTlsChanged;
        Session.OnStateChanged -= OnSessionChanged;
        await _stop.CancelAsync();
        if (_refresh is not null) await _refresh;
        _stop.Dispose();
    }
}
