@using ApsMonitor.Services
@using ApsMonitor.Models
@inject SessionStateService SessionState
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (SessionState.IsLoaded)
{
    @if (_minimized)
    {
        <div class="session-player-minimized" style="bottom: calc(@(_barBottomPx + 20)px + var(--device-status-height));">
            <MudIconButton Icon="@Icons.Material.Filled.PlayCircle" Color="Color.Primary" Size="Size.Large" 
                           OnClick="@(() => _minimized = false)" Title="@Ui["Show player"]" />
        </div>
    }
    else
    {
        <div @ref="_bar" class="session-player-global-bar" style="bottom: calc(@(_barBottomPx)px + var(--device-status-height));">
            <MudPaper Elevation="25" Class="session-player-content">
                

                <!-- Info y Controles -->
                <div class="session-player-transport">
                    <MudIconButton Icon="@Icons.Material.Filled.FirstPage" Size="Size.Small" OnClick="SessionState.GoToStart" Title="@Ui["Go to start"]" />
                    <MudIconButton Icon="@Icons.Material.Filled.NavigateBefore" Size="Size.Small" OnClick="SessionState.PreviousFrame" Title="@Ui["Previous frame"]" />
                    
                    @if (SessionState.IsPlaying)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Pause" Color="Color.Warning" Size="Size.Medium" OnClick="SessionState.Pause" Title="@Ui["Pause"]" />
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" Size="Size.Medium" OnClick="SessionState.Play" Title="@Ui["Play"]" />
                    }
                    
                    <MudIconButton Icon="@Icons.Material.Filled.NavigateNext" Size="Size.Small" OnClick="SessionState.NextFrame" Title="@Ui["Next frame"]" />
                    <MudIconButton Icon="@Icons.Material.Filled.LastPage" Size="Size.Small" OnClick="SessionState.GoToEnd" Title="@Ui["Go to end"]" />
                    
                    <MudDivider Vertical="true" Class="mx-2" Style="height:24px;" />
                    
                    <MudText Typo="Typo.caption" Class="text-muted session-player-filename">@SessionState.FileName</MudText>
                </div>

                <!-- Slider Temporal -->
                <div class="session-player-timeline">
                    <MudText Typo="Typo.caption" Style="min-width:70px;">@FormatTime(SessionState.CurrentFrame)</MudText>
                    <MudSlider T="int" Value="SessionState.CurrentFrame" 
                               ValueChanged="OnSliderChanged" 
                               Min="0" Max="@(SessionState.Dataset!.FrameCount - 1)" 
                               Step="1" Color="Color.Primary" Class="ma-0" />
                    <MudText Typo="Typo.caption" Style="min-width:60px; text-align:right;">@FormatTime(SessionState.Dataset.FrameCount - 1)</MudText>
                </div>

                <!-- Velocidad -->
                <div class="session-player-speeds">
                    @foreach (var speed in SessionState.Velocidades.Where(s => s <= 10))
                    {
                        <MudChip T="double" Size="Size.Small" 
                                 Color="@(SessionState.VelocidadActual == speed ? Color.Primary : Color.Default)" 
                                 Variant="Variant.Filled" 
                                 OnClick="@(() => { SessionState.VelocidadActual = speed; if(SessionState.IsPlaying) SessionState.SeekTo(SessionState.CurrentFrame); })"
                                 Style="cursor:pointer; scale: 0.8;">@(speed)x</MudChip>
                    }
                </div>

                <!-- Minimizar -->
                <div class="session-player-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Minimize" Size="Size.Small" Color="Color.Default" 
                               OnClick="@(() => _minimized = true)" Title="@Ui["Minimise player"]" />

                <!-- Botón Cerrar Sesión -->
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="CloseSession" Title="@Ui["Close session"]" />
                </div>
            </MudPaper>
        </div>
    }
}

<style>
    .session-player-global-bar {
        position: fixed;
        left: 0;
        right: 0;
        z-index: 2000;
        padding: 8px 16px;
        background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.5) 100%);
        transition: bottom 0.05s ease-out;
    }
    .session-player-global-bar .mud-paper {
        background-color: var(--mud-palette-surface) !important;
        border-top: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 12px;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.5);
    }
    .session-player-content {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 16px;
        padding: 8px 16px;
        box-sizing: border-box;
    }
    .session-player-transport, .session-player-timeline, .session-player-speeds, .session-player-actions {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 4px;
        min-width: 0;
    }
    .session-player-transport { flex: 0 1 auto; min-width: 320px; max-width: 40%; }
    .session-player-transport .mud-icon-button, .session-player-actions .mud-icon-button { flex-shrink: 0; }
    .session-player-filename { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
    .session-player-timeline { flex: 1; min-width: 240px; gap: 8px; }
    .session-player-timeline .mud-slider { min-width: 0; flex: 1; }
    .session-player-speeds, .session-player-actions { flex: none; }
    .session-player-minimized {
        position: fixed;
        right: 24px;
        z-index: 2000;
        background-color: var(--mud-palette-surface);
        border-radius: 50%;
        box-shadow: 0 4px 16px rgba(0,0,0,0.6);
        border: 1px solid rgba(59, 130, 246, 0.3);
    }
    .mud-main-content:has(.sinoptico-viewer-layout) .session-player-minimized { left: 24px; right: auto; }
    .drag-handle {
        cursor: grab;
        padding: 4px 2px;
        border-radius: 4px;
        display: flex;
        align-items: center;
    }
    .drag-handle:hover {
        background-color: rgba(255,255,255,0.08);
    }
    .drag-handle:active {
        cursor: grabbing;
    }
    .text-muted {
        color: var(--mud-palette-text-secondary) !important;
    }
</style>

@code {
    private ElementReference _bar;
    private IJSObjectReference? _module, _scaler;
    private readonly SemaphoreSlim _interopGate = new(1, 1);
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await _interopGate.WaitAsync();
        try
        {
            if (_disposed) return;
            if (SessionState.IsLoaded && !_minimized)
            {
                if (_scaler is not null) return;
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/session-player.js");
                _scaler = await _module.InvokeAsync<IJSObjectReference>("create", _bar);
            }
            else if (_scaler is not null)
            {
                await _scaler.InvokeVoidAsync("dispose");
                await _scaler.DisposeAsync();
                _scaler = null;
            }
        }
        catch (JSDisconnectedException) { }
        finally { _interopGate.Release(); }
    }
    private bool _minimized = false;
    private int _barBottomPx = 0;
    private bool _isDragging = false;
    private double _dragStartY;
    private int _dragStartBottom;

    protected override void OnInitialized()
    {
        _minimized = IsSynopticViewer();
        SessionState.OnStateChanged += Refresh;
        NavigationManager.LocationChanged += LocationChanged;
    }

    private bool IsSynopticViewer() => NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
        .StartsWith("sinoptico/ver/", StringComparison.OrdinalIgnoreCase);

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _minimized = IsSynopticViewer();
        Refresh();
    }
    
    private void StartDrag(MouseEventArgs e)
    {
        _isDragging = true;
        _dragStartY = e.ClientY;
        _dragStartBottom = _barBottomPx;
    }

    private void OnSliderChanged(int val)
    {
        SessionState.SeekTo(val);
    }

    private void CloseSession()
    {
        SessionState.CloseSession();
    }

    private string FormatTime(int frameIndex)
    {
        if (SessionState.Dataset == null || frameIndex < 0 || frameIndex >= SessionState.Dataset.FrameCount) 
            return "00:00:00.000";
        return SessionState.Dataset.AbsoluteTimestamps[frameIndex].ToString("HH:mm:ss.fff");
    }

    private string FormatDuration(TimeSpan ts)
    {
        return ts.ToString(@"mm\:ss\.ff");
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        SessionState.OnStateChanged -= Refresh;
        NavigationManager.LocationChanged -= LocationChanged;
        await _interopGate.WaitAsync();
        try
        {
            if (_scaler is not null) { await _scaler.InvokeVoidAsync("dispose"); await _scaler.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _interopGate.Release(); }
    }
}
