@using ApsMonitor.Services
@using ApsMonitor.Models
@inject SessionStateService SessionState
@implements IDisposable

@if (SessionState.IsLoaded)
{
    @if (_minimized)
    {
        <div class="session-player-minimized" style="bottom: @(_barBottomPx)px;">
            <MudIconButton Icon="@Icons.Material.Filled.PlayCircle" Color="Color.Primary" Size="Size.Large" 
                           OnClick="@(() => _minimized = false)" Title="Mostrar reproductor" />
        </div>
    }
    else
    {
        <div class="session-player-global-bar" style="bottom: @(_barBottomPx)px;">
            <MudPaper Elevation="25" Class="pa-2 px-4 d-flex align-center gap-4">
                <!-- Drag Handle -->
                <div class="drag-handle" @onmousedown="StartDrag" title="Arrastrar para mover">
                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Style="color: #64748b;" />
                </div>

                <!-- Info y Controles -->
                <div class="d-flex align-center gap-2" style="min-width: 320px;">
                    <MudIconButton Icon="@Icons.Material.Filled.FirstPage" Size="Size.Small" OnClick="SessionState.GoToStart" Title="Ir al inicio" />
                    <MudIconButton Icon="@Icons.Material.Filled.NavigateBefore" Size="Size.Small" OnClick="SessionState.PreviousFrame" Title="Trama anterior" />
                    
                    @if (SessionState.IsPlaying)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Pause" Color="Color.Warning" Size="Size.Medium" OnClick="SessionState.Pause" Title="Pausar" />
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" Size="Size.Medium" OnClick="SessionState.Play" Title="Reproducir" />
                    }
                    
                    <MudIconButton Icon="@Icons.Material.Filled.NavigateNext" Size="Size.Small" OnClick="SessionState.NextFrame" Title="Siguiente trama" />
                    <MudIconButton Icon="@Icons.Material.Filled.LastPage" Size="Size.Small" OnClick="SessionState.GoToEnd" Title="Ir al final" />
                    
                    <MudDivider Vertical="true" Class="mx-2" Style="height:24px;" />
                    
                    <MudText Typo="Typo.caption" Class="text-muted d-none d-sm-block">@SessionState.FileName</MudText>
                </div>

                <!-- Slider Temporal -->
                <div class="d-flex align-center gap-3 flex-grow-1">
                    <MudText Typo="Typo.caption" Style="min-width:70px;">@FormatTime(SessionState.CurrentFrame)</MudText>
                    <MudSlider T="int" Value="SessionState.CurrentFrame" 
                               ValueChanged="OnSliderChanged" 
                               Min="0" Max="@(SessionState.Dataset!.FrameCount - 1)" 
                               Step="1" Color="Color.Primary" Class="ma-0" />
                    <MudText Typo="Typo.caption" Style="min-width:60px; text-align:right;">@FormatTime(SessionState.Dataset.FrameCount - 1)</MudText>
                </div>

                <!-- Velocidad -->
                <div class="d-flex align-center gap-1 d-none d-md-flex">
                    @foreach (var speed in SessionState.Velocidades.Where(s => s <= 10))
                    {
                        <MudChip T="double" Size="Size.Small" 
                                 Color="@(SessionState.VelocidadActual == speed ? Color.Primary : Color.Default)" 
                                 Variant="Variant.Filled" 
                                 OnClick="@(() => { SessionState.VelocidadActual = speed; if(SessionState.IsPlaying) SessionState.SeekTo(SessionState.CurrentFrame); })"
                                 Style="cursor:pointer; scale: 0.8;">@(speed)x</MudChip>
                    }
                </div>

                <!-- Minimizar -->
                <MudIconButton Icon="@Icons.Material.Filled.Minimize" Size="Size.Small" Color="Color.Default" 
                               OnClick="@(() => _minimized = true)" Title="Minimizar reproductor" />

                <!-- Botón Cerrar Sesión -->
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="CloseSession" Title="Cerrar sesión" />
            </MudPaper>
        </div>
    }
}

<style>
    .session-player-global-bar {
        position: fixed;
        left: 0;
        right: 0;
        z-index: 2000;
        padding: 8px 16px;
        background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.5) 100%);
        transition: bottom 0.05s ease-out;
    }
    .session-player-global-bar .mud-paper {
        background-color: #1a212d !important;
        border-top: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 12px;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.5);
    }
    .session-player-minimized {
        position: fixed;
        right: 24px;
        z-index: 2000;
        background-color: #1a212d;
        border-radius: 50%;
        box-shadow: 0 4px 16px rgba(0,0,0,0.6);
        border: 1px solid rgba(59, 130, 246, 0.3);
    }
    .drag-handle {
        cursor: grab;
        padding: 4px 2px;
        border-radius: 4px;
        display: flex;
        align-items: center;
    }
    .drag-handle:hover {
        background-color: rgba(255,255,255,0.08);
    }
    .drag-handle:active {
        cursor: grabbing;
    }
    .text-muted {
        color: #94a3b8 !important;
    }
</style>

@code {
    private bool _minimized = false;
    private int _barBottomPx = 0;
    private bool _isDragging = false;
    private double _dragStartY;
    private int _dragStartBottom;

    protected override void OnInitialized()
    {
        SessionState.OnStateChanged += () => InvokeAsync(StateHasChanged);
    }

    private void StartDrag(MouseEventArgs e)
    {
        _isDragging = true;
        _dragStartY = e.ClientY;
        _dragStartBottom = _barBottomPx;
    }

    private void OnSliderChanged(int val)
    {
        SessionState.SeekTo(val);
    }

    private void CloseSession()
    {
        SessionState.CloseSession();
    }

    private string FormatTime(int frameIndex)
    {
        if (SessionState.Dataset == null || frameIndex < 0 || frameIndex >= SessionState.Dataset.FrameCount) 
            return "00:00:00.000";
        return SessionState.Dataset.AbsoluteTimestamps[frameIndex].ToString("HH:mm:ss.fff");
    }

    private string FormatDuration(TimeSpan ts)
    {
        return ts.ToString(@"mm\:ss\.ff");
    }

    public void Dispose()
    {
        SessionState.OnStateChanged -= StateHasChanged;
    }
}
